  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E AP"
  _shortName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E AP"
  _description: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D M61\u0441 \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u0441 \u0437\u0430\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u043C \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0443\u0440\u043E\u043D\u0430, \u043E\u0431\u043B\u0430\u0434\u0430\u044F \u0432 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438 \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u044F \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>IV (41)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435 (53)"
