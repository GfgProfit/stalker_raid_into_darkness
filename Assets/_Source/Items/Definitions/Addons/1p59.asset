  m_Name: 1p59
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: bc51d0c36a074b842b48c995f834c171
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B 1\u041F59 \"\u0413\u0438\u043F\u0435\u0440\u043E\u043D\""
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B 1\u041F59 \"\u0413\u0438\u043F\u0435\u0440\u043E\u043D\""
  _description: "\u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432
    \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u043F\u0430\u043D\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \"\u0413\u0438\u043F\u0435\u0440\u043E\u043D\"- \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430
    \u0446\u0435\u043B\u0435\u0439 \u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
    \u0438\u0437 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445
    \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0432\u0432\u043E\u0434 \u0443\u0433\u043B\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F
    \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
    \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0434\u043E \u0446\u0435\u043B\u0438.
    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437
    \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438
    \u043F\u0430\u043D\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u0440\u0438\u0446\u0435\u043B\u0430 1\u041F59 \"\u0413\u0438\u043F\u0435\u0440\u043E\u043D\"
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0438\u0437 \u0421\u0412\u0414
    \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441\u043E
    \u0448\u0442\u0430\u0442\u043D\u044B\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C
    \u041F\u0421\u041E-1 \u0432 1,3\u20262 \u0440\u0430\u0437\u0430 (\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432
    \u0446\u0435\u043B\u0438) \u0437\u0430 \u0441\u0447\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E
    \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F, \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0434\u0430\u043B\u044C\u043D\u043E\u043C\u0435\u0440\u0430,
    \u0441\u043E\u0432\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439
    \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0434\u043E \u0446\u0435\u043B\u0438 \u0438 \u0432\u0432\u043E\u0434\u0430 \u0443\u0433\u043B\u043E\u0432
    \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u0448\u043A\u0430\u043B\u044B \u0432\u0432\u043E\u0434\u0430 \u0443\u0433\u043B\u043E\u0432
    \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0432
    \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0430."
