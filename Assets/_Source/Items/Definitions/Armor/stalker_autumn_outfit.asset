  m_Name: stalker_autumn_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7b881acfc6d44fb498ef5ac3e81b6d1c
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041B\u0435\u0441\u043D\u0430\u044F \u0437\u0430\u0440\u044F\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041B\u0435\u0441\u043D\u0430\u044F \u0437\u0430\u0440\u044F\xBB"
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439 \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043D\u0430 \u0431\u0430\u0437\u0435 \xAB\u0417\u0430\u0440\u0438\xBB. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C \u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0432\u043E\u0438\u0441\u043F\u0435\u0447\u0451\u043D\u043D\u044B\u0445 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u0437\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\u043C\u0438 \u0438\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438, \u0442\u0430\u043A \u043A\u0430\u043A \u0435\u0433\u043E \u043E\u0441\u043E\u0431\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0437\u043E\u043D\u044B \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u043B\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439, \u043D\u043E \u0438 \u0434\u0430\u0436\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u0438\u0445 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u043D\u0430 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0435\u0440\u0438\u043E\u0434\u044B \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \xAB\u041B\u0435\u0441\u043D\u0430\u044F \u0437\u0430\u0440\u044F\xBB \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0447\u0443\u0442\u044C \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E - \u0438 \u044D\u0442\u043E-\u0442\u043E \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B. \u0418 \u0445\u043E\u0442\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0442\u0435\u0445\u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u0443 \xAB\u0417\u0430\u0440\u0438\xBB, \u043E\u043D \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
