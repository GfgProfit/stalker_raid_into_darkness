  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B 1\u041F76 \"\u0420\u0430\u043A\u0443\u0440\u0441-\u0410\" (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \"\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442\")"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B 1\u041F76 \"\u0420\u0430\u043A\u0443\u0440\u0441-\u0410\" (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \"\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442\")"
  _description: "\u041F\u0440\u0438\u0446\u0435\u043B \u0438\u043C\u0435\u0435\u0442 \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u0438 \u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u043E\u0433\u043E \u0431\u043E\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u043E\u0431\u0437\u043E\u0440 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0435\u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C \u0433\u043B\u0430\u0437\u043E\u043C \u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u0446\u0435\u043B \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u0438 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0446\u0435\u043B\u0438. \u0421 \u0446\u0435\u043B\u044C\u044E \u043C\u0438\u043D\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u0435\u0441\u0430 \u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043E\u0432 \u0432 \u043F\u0440\u0438\u0446\u0435\u043B\u0435 1\u041F76 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u044B \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0449\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0430 \u043F\u0440\u0438\u0437\u043C\u0435 \u041F\u0435\u0445\u0430\u043D\u0430 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0432\u044B\u0432\u0435\u0440\u043A\u0438 \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u0430. \u0421\u0435\u0442\u043A\u0430 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u0440\u0438\u0442\u0438\u0435\u0432\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C."
