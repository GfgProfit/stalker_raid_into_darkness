  m_ActivationSlot: {fileID: 114350483966680535}
  m_BlockName: Apply source curves and constraints
  m_HLSLCode: "void UpdateGazirovka10(inout VFXAttributes attributes, in VFXSampler2D curves, in float stepTime)\r\n{\r\n    float u = (saturate(attributes.age / attributes.lifetime) * 255.0f + 0.5f) / 256.0f;\r\n    float4 sizeAndAngular = SampleTexture(curves, float2(u, 0.7769231f), 0.0f);\r\n    float3 linearVelocity = SampleTexture(curves, float2(u, 0.7923077f), 0.0f).xyz;\r\n    float4 sizeAndAngularMax = SampleTexture(curves, float2(u, 0.8076923f), 0.0f);\r\n    float3 linearVelocityMax = SampleTexture(curves, float2(u, 0.8230769f), 0.0f).xyz;\r\n    uint particleSeed = attributes.seed;\r\n    float sizeChoice = ToFloat01(AnotherHash(particleSeed ^ 8293u));\r\n    float spinChoice = ToFloat01(AnotherHash(particleSeed ^ 72103u));\r\n    float3 velocityChoice = float3(ToFloat01(AnotherHash(particleSeed ^ 987823u)), ToFloat01(AnotherHash(particleSeed ^ 76447u)), ToFloat01(AnotherHash(particleSeed ^ 98117u)));\r\n    sizeAndAngular = lerp(sizeAndAngular, sizeAndAngularMax, float4(sizeChoice, sizeChoice, sizeChoice, spinChoice));\r\n    linearVelocity = lerp(linearVelocity, linearVelocityMax, velocityChoice);\r\n    float4 tint = SampleTexture(curves, float2(u, 0.8384615f), 0.0f);\r\n    attributes.scaleX = sizeAndAngular.x;\r\n    attributes.scaleY = sizeAndAngular.y;\r\n    attributes.angularVelocityZ = sizeAndAngular.w;\r\n    attributes.color = tint.rgb;\r\n    attributes.alpha = tint.a;\r\n    attributes.velocity = linearVelocity;\r\n    if (attributes.age + stepTime >= 2.0f)\r\n    {\r\n        attributes.alive = false;\r\n    }\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: UpdateGazirovka10
    selectedIndex: 0
