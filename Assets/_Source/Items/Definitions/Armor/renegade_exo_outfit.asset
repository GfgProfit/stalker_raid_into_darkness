  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: renegade_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3d35b8657244db74dae8b754a440c240
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432"
  _shortName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432"
  _description: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432, \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0445
    \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u0430\u043C\u0438 \u0435\u0449\u0451
    \u0432 2011 \u0433\u043E\u0434\u0443, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u043B\u0438 \u043F\u043E\u043C\u043E\u0447\u044C
    \u0432 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u043C \u0448\u0442\u0443\u0440\u043C\u0435
    \u0431\u0430\u0437\u044B \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB,
    \u0442\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u044B\u0431\u0438\u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u0441 \u0411\u043E\u043B\u043E\u0442. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
    \u043F\u043B\u0430\u043D\u0430\u043C \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432
    \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u0443\u0436\u0434\u0435\u043D\u043E
    \u0441\u0431\u044B\u0442\u044C\u0441\u044F - \u0438 \u0432\u0441\u0451 \u043F\u043E
    \u0432\u0438\u043D\u0435 \u043D\u0435\u0431\u0435\u0437\u044B\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430, \u043A \u0443\u0441\u043B\u0443\u0433\u0430\u043C
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u0440\u0438\u0431\u0435\u0433\u043B\u043E
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E
    \u043D\u0435\u0431\u0430\xBB. \u0423\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0435
    \u043E\u0442\u0449\u0435\u043F\u0435\u043D\u0446\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u044B, \u0440\u0432\u0443\u0442\u0441\u044F
    \u0432 \u0431\u043E\u0439 \u0441 \u043D\u0435\u0438\u0441\u0442\u043E\u0432\u044B\u043C
    \u0436\u0435\u043B\u0430\u043D\u0438\u0435\u043C \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u0442\u044C
    \u0432\u0441\u0435\u0445 \u0438\u0445 \u0432\u0440\u0430\u0433\u0430\u043C \u0437\u0430
    \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u043D\u043E\u0435 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 - \u0430 \u044D\u0442\u043E
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u0441\u0435."
