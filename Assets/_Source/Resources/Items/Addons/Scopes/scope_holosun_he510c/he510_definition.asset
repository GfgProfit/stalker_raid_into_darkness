  m_Name: he510
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 43fb054a0e26ab0488efc9929d2c2d00
  _displayName: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Holosun HE510C"
  _shortName: HE510C
  _description: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1\xD7, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Holosun \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438, \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u044B \u0438 \u0434\u0440\u0443\u0433\u043E\u0435 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 Multi-Reticle System (MRS), \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443 \u0442\u0440\u0435\u043C\u044F \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438 \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438: \u0442\u043E\u0447\u043A\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C 2 MOA, \u043A\u043E\u043B\u044C\u0446\u043E\u043C \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C 65 MOA \u0438 \u0438\u0445 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0435\u0439. \u0418\u043C\u0435\u0435\u0442 12 \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u044F\u0440\u043A\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F 2 \u0440\u0435\u0436\u0438\u043C\u0430 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u0438 \u0441 \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C\u0438 \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0435\u043D\u0438\u044F. \u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0430\u044F \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F \u043F\u0430\u043D\u0435\u043B\u044C Solar Failsafe \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0443 \u044F\u0440\u043A\u043E\u0441\u0442\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F Shake Awake \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443 \u043F\u0440\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u0438 \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0435\u0451 \u043F\u0440\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430 \u0438 \u043E\u0441\u043D\u0430\u0449\u0451\u043D \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u0442\u0438\u0442\u0430\u043D\u043E\u0432\u044B\u043C \u043A\u043E\u0436\u0443\u0445\u043E\u043C. \u0418\u043C\u0435\u0435\u0442 \u0432\u043B\u0430\u0433\u043E\u0437\u0430\u0449\u0438\u0442\u0443 \u043F\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443 IP67 \u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043F\u043B\u0430\u043D\u043A\u0438 Picatinny. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR2032, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0434\u043E 50 000 \u0447\u0430\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0440\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u044F\u0440\u043A\u043E\u0441\u0442\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E, \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043F\u043E\u043B\u0435\u043C \u0437\u0440\u0435\u043D\u0438\u044F \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
