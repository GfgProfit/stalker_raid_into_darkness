#define USE_FPTL_LIGHTLIST 1
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Lighting/Lighting.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Material/Material.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Material/NormalBuffer.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Lighting/LightLoop/LightLoopDef.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Material/BuiltinGIUtilities.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/Lighting/ScreenSpaceLighting/RayMarchingFallbackHierarchy.cs.hlsl"
#undef USE_FPTL_LIGHTLIST

#if defined(GI_REPROJECT) && (defined(PROBE_VOLUMES_L1) || defined(PROBE_VOLUMES_L2))
static const float MIN_SKY_IRRADIANCE_FRACTION = 0.125f;

void EvaluateSsgiProbeAndSky(float3 positionWS, float3 normalWS, float3 backNormalWS, float3 viewDir, float2 positionSS, uint renderingLayer, out float3 diffuseLighting, out float3 backDiffuseLighting, int fallbackHierarchy)
{
    EvaluateAdaptiveProbeVolume(positionWS, normalWS, backNormalWS, viewDir, positionSS, renderingLayer, diffuseLighting, backDiffuseLighting);
    if ((fallbackHierarchy & RAYMARCHINGFALLBACKHIERARCHY_SKY) != 0)
    {
        float3 skyLighting = max(EvaluateAmbientProbe(normalWS), 0.0f);
        float skyLuminance = max(Luminance(skyLighting), 1e-5f);
        float probeLuminance = max(Luminance(diffuseLighting), 0.0f);
        float skyFill = max(MIN_SKY_IRRADIANCE_FRACTION - probeLuminance / skyLuminance, 0.0f);
        diffuseLighting += skyLighting * skyFill;
    }
}

#define EvaluateAdaptiveProbeVolume(a, b, c, d, e, f, g, h) EvaluateSsgiProbeAndSky(a, b, c, d, e, f, g, h, _RayMarchingFallbackHierarchy)
#endif

#include_with_pragmas "Packages/com.unity.render-pipelines.high-definition/Runtime/Lighting/ScreenSpaceLighting/ScreenSpaceGlobalIllumination.compute"

#if defined(GI_REPROJECT) && (defined(PROBE_VOLUMES_L1) || defined(PROBE_VOLUMES_L2))
#undef EvaluateAdaptiveProbeVolume
#endif
