  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_desert_eagle_nimble_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: d4c3b1f035a9dc742a9a2ecfa06ac3cd
  _displayName: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 Desert Eagle \xAB\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u042F\u0441\u0442\u0440\u0435\u0431\xBB"
  _shortName: IMI DE SH
  _description: "\u041C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043D\u0430 \u0431\u0430\u0437\u0435 Desert Eagle Mark XIX, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0433\u043E \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Magnum Research \u043F\u0440\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0438 \u0438\u0437\u0440\u0430\u0438\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F Israel Military Industries (IMI). \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043E\u0442\u0432\u043E\u0434\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0433\u043E \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u043E\u0434\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (SA). \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439 \u0431\u0435\u0437 \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438. \u041D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0433\u043E \u0441\u0442\u0432\u043E\u043B\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0430 \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043F\u043B\u0430\u043D\u043A\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 Picatinny \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0445 \u0438 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432. \u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043E\u0441\u043D\u0430\u0449\u0451\u043D \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C \u0444\u043B\u0430\u0436\u043A\u043E\u0432\u044B\u043C \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C, \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0438 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438. \u041C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0430\u044F \u0443\u0433\u043B\u043E\u0432\u0430\u0442\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0443\u043D\u0430\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u044B \u043E\u0442 \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u043C\u043E\u0434\u0435\u043B\u0438 Desert Eagle."
