  _sourceReport: "MO2 profile: 1v2(DX11) (v_12gb) 2.5, \u0412\u0441\u0435 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E
    (168), active mods: 173, indexed files: 13898\r\n[bobbing_effector] <- Base Anomaly
    :: configs/misc/effectors.ltx\r\n_bobbing._walkAmplitude = 0.005  <- [bobbing_effector]
    walk_amplitude\r\n_bobbing._runAmplitude = 0.0075  <- [bobbing_effector] run_amplitude\r\n_bobbing._limpAmplitude
    = 0.011  <- [bobbing_effector] limp_amplitude\r\n_bobbing._walkSpeed = 6.26 
    <- [bobbing_effector] walk_speed\r\n_bobbing._runSpeed = 6.74  <- [bobbing_effector]
    run_speed\r\n_bobbing._limpSpeed = 4.6  <- [bobbing_effector] limp_speed\r\n_bobbing._crouchFactor
    = 0.75  <- EffectorBobbing.cpp CROUCH_FACTOR (hardcoded)\r\n_bobbing._speedReminder
    = 5  <- EffectorBobbing.cpp SPEED_REMINDER (hardcoded)\r\n_bobbing._headBobFactor
    = 1  <- user.ltx head_bob_factor (engine default 1)\r\n_fall._speed = 3.5  <-
    EffectorFall.cpp FALL_SPEED (hardcoded)\r\n_fall._maxDistance = 0.15  <- EffectorFall.cpp
    FALL_MAXDIST (hardcoded)\r\n_fall._crashSpeedMax = 41  <- [actor] ph_crash_speed_max
    (gcontact_Power = contact speed / max)\r\nscripts/camera_reanim_project.script
    <- [\u041A\u0430\u043C\u0435\u0440\u0430] ReanimationProject INERTIA_V1.2\r\n_anm._tiredPower
    = 0.25  <- camera_reanim_project.script db.actor.power threshold\r\n_anm._landingSpeed
    = 5  <- camera_reanim_project.script actor_on_land fall_speed threshold\r\n_anm._landingCooldown
    = 1  <- camera_reanim_project.script tg_anim1_delay (ms)\r\n_anm._sprintStep
    <- anims\\camera_effects\\sprint_crp.anm ([\u041A\u0430\u043C\u0435\u0440\u0430]
    ReanimationProject INERTIA_V1.2)\r\n_anm._moveStep <- anims\\camera_effects\\move_crp.anm
    ([\u041A\u0430\u043C\u0435\u0440\u0430] ReanimationProject INERTIA_V1.2)\r\n_anm._tiredStep
    <- anims\\camera_effects\\tired_crp.anm ([\u041A\u0430\u043C\u0435\u0440\u0430]
    ReanimationProject INERTIA_V1.2)\r\n_anm._jump <- anims\\camera_effects\\jump_crp.anm
    ([\u041A\u0430\u043C\u0435\u0440\u0430] ReanimationProject INERTIA_V1.2)\r\n_anm._crouch
    <- anims\\camera_effects\\crouch_crp.anm ([\u041A\u0430\u043C\u0435\u0440\u0430]
    ReanimationProject INERTIA_V1.2)\r\n_anm._stand <- anims\\camera_effects\\stand_crp.anm
    ([\u041A\u0430\u043C\u0435\u0440\u0430] ReanimationProject INERTIA_V1.2)\r\n_anm._landing
    <- anims\\camera_effects\\landing_crp1.anm ([\u041A\u0430\u043C\u0435\u0440\u0430]
    ReanimationProject INERTIA_V1.2)\r\n_anm._landing <- anims\\camera_effects\\landing_crp2.anm
    ([\u041A\u0430\u043C\u0435\u0440\u0430] ReanimationProject INERTIA_V1.2)\r\n_anm._strafeLeft
    <- anims\\camera_effects\\actor_move\\strafe_left.anm (Base Anomaly)\r\n_anm._strafeRight
    <- anims\\camera_effects\\actor_move\\strafe_right.anm (Base Anomaly)\r\naxr_options.ltx
    crpmcm/moving = True, crpmcm/jump_land = True, crpmcm/crouch = True\r\nUnity
    adaptation: bob phase follows the body locomotion cycle (BodyAnimation) instead
    of the global CEffectorBobbing timer; frequency then follows the Swm legs clips,
    amplitude stays X-Ray.\r\nUnity adaptation: bobbing fades out while the actor
    has no ground contact; X-Ray keeps it while mcAnyMove is set in the air.\r\nX-Ray:
    mcAnyMove is cleared when actual velocity < 0.2 m/s (Actor_Movement.cpp), so
    pushing into a wall stops the bob and the legs steps.\r\n"
