  m_Name: banditmerc_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 32a54ad32c4dc74478a07159555544e8
  _displayName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0431\u0430\u043D\u0434\u0438\u0442\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D"
  _shortName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0431\u0430\u043D\u0434\u0438\u0442\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D"
  _description: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438 \u0438 \xAB\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\xBB \u043F\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u0432 \u0440\u0443\u043A\u0438 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u0417\u0430 \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u0437\u044F\u0442\u044B \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0430\u0440\u043C\u0438\u0439. \u041F\u043E \u0438\u0440\u043E\u043D\u0438\u0438 \u0441\u0443\u0434\u044C\u0431\u044B, \u0442\u043E\u0442, \u043A\u0442\u043E \u043F\u0440\u043E\u0434\u0430\u043B \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B, \u043F\u043E\u0445\u043E\u0436\u0435, \u0440\u0435\u0448\u0438\u043B \u043D\u0430\u0436\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0438\u0445 \u0434\u043E\u0432\u0435\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438, \u0442\u0430\u043A \u043A\u0430\u043A \u043F\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0443. \u0417\u0430\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u0434\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E. \u0414\u0430 \u0438, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0442\u043E, \u0447\u0442\u043E \u0435\u0441\u0442\u044C - \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u0432\u044B\u0434\u0430\u0432\u0430\u0435\u043C\u043E\u0439 \u0440\u044F\u0434\u043E\u0432\u044B\u043C \u0412\u0421\u0423 \u0432\u043D\u0443\u0442\u0440\u0438 \u0417\u043E\u043D\u044B."
