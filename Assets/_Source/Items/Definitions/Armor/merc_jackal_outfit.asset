  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: a79543813aeda0043ad2c22109d1ae56
  _displayName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \xAB\u0428\u0430\u043A\u0430\u043B\xBB"
  _shortName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \xAB\u0428\u0430\u043A\u0430\u043B\xBB"
  _description: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432,
    \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u044B\u0439 \u0432 \u0447\u0435\u0441\u0442\u044C
    \u043F\u043E\u0433\u0438\u0431\u0448\u0435\u0433\u043E \u043B\u0438\u0434\u0435\u0440\u0430
    \u0433\u0440\u0443\u043F\u043F\u044B \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432,
    \u0446\u0435\u043B\u044C\u044E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0431\u044B\u043B\u043E
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0430
    \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E \u043F\u043E\u0434
    \u0438\u043D\u0434\u0435\u043A\u0441\u043E\u043C X-8 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0442 \u0442\u043E\u043C\u0443 \u043D\u0430\u0437\u0430\u0434. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443
    \u043E\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439 \u0417\u043E\u043D\u044B,
    \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
    \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430\u043C\u0438 \u043A\u043E\u0441\u0442\u044E\u043C\u0430
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0435\u0433\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
    \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u0430\u044F \u0441 \u0443\u043C\u043E\u043C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0432\u0435\u0441\u0430, \u0447\u0442\u043E \u0432\u043A\u0443\u043F\u0435 \u0441
    \u0435\u0433\u043E \u0432\u043F\u043E\u043B\u043D\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439
    \u0446\u0435\u043D\u043E\u0439 \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u043E\u0441\u0442\u044E\u043C
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u043C
    \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0441\u0440\u0435\u0434\u0438 \u043E\u043F\u044B\u0442\u043D\u044B\u0445
    \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432."
