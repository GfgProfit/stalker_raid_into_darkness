  m_Name: ammo_7.62x54_7h1
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: ffb2775c2a07a234d8b65165d2a5d608
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x54 \u043C\u043C R \u0422-46\u041C \u0433\u0436"
  _shortName: "\u0422-46\u041C"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62x54 \u043C\u043C R \u0441 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u043F\u0443\u043B\u0435\u0439 \u0422-46\u041C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043F\u043E\u043B\u0451\u0442\u0430 \u043F\u0443\u043B\u0438, \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0433\u043D\u044F \u0438 \u0446\u0435\u043B\u0435\u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0432 \u0431\u043E\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u0422-46 \u0441 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 9,6 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441\u043E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0438 \u043F\u0438\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C \u0432 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u043E\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F, \u043E\u0431\u0440\u0430\u0437\u0443\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0439 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F \u0441\u043B\u0435\u0434, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0443 \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E \u043F\u0443\u043B\u0438 \u043D\u0430 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 825\u2013855 \u043C/\u0441 \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430 \u041F\u041A. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u0448\u0438\u043D\u044B \u043F\u0443\u043B\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 \u0421\u0412\u0414, \u0421\u0412-98, \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 \u041F\u041A, \u041F\u041A\u041C \u0438 \u0434\u0440\u0443\u0433\u043E\u043C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u043C \u043E\u0440\u0443\u0436\u0438\u0438. \u041E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C, \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C\u044B\u043C \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u043C\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C."
