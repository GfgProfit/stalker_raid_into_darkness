  m_Name: wpn_glock18_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: dd3b19d542143ec4993fa351ebc75e70
  _displayName: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 Glock 18C"
  _shortName: G18C
  _description: "\u0410\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9\xD719 \u043C\u043C Parabellum, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Glock GmbH \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u0432 1996 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 Glock 18, \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u043E\u043C \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0435 Glock 17. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0445\u043E\u0434\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u0439 Safe Action. \u0420\u0430\u043C\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430, \u0441\u0442\u0432\u043E\u043B \u0438 \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u2014 \u0438\u0437 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0433\u0430\u0437\u043E\u0432\u044B\u0439 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440, \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0449\u0438\u0439 \u043F\u043E\u0434\u0431\u0440\u043E\u0441 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u043E\u0433\u043D\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u043D\u0430 \u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0437\u0430\u0442\u0432\u043E\u0440\u0430-\u043A\u043E\u0436\u0443\u0445\u0430. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C \u043E\u043A\u043E\u043B\u043E 1200 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 114 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u2014 204 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u2014 590 \u0433. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u0434\u0432\u0443\u0445\u0440\u044F\u0434\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0448\u0442\u0430\u0442\u043D\u043E\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 19 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B \u043D\u0430 17, 24, 31 \u0438 33 \u043F\u0430\u0442\u0440\u043E\u043D\u0430. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u0430, \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0435\u043C\u043F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u0435\u0442 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0440\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u043E\u0433\u043D\u0435."
