  m_Name: helm_ranger
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3e5118e007a9e784892d5ce7a13ab474
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-10\u0420"
  _shortName: HEAVY
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043D\u0430 \u0431\u0430\u0437\u0435 \u0413\u041F-10, \u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0441 \u0446\u0435\u043B\u044C\u044E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u043E\u0442 \u043F\u0441\u0438-\u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0451\u0440\u043E\u0432 \u0438 \u043F\u043E\u043B\u0442\u0435\u0440\u0433\u0435\u0439\u0441\u0442\u043E\u0432. \u0418 \u0445\u043E\u0442\u044F \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B, \u043C\u044F\u0433\u043A\u043E \u0433\u043E\u0432\u043E\u0440\u044F, \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u044B\u0435, \u0434\u0430\u043D\u043D\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u0435 \u043E\u0442 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u0441\u0438- \u0438 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0433\u0440\u043E\u0437."
