  m_Name: monolith_nbc_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3fe975b9c6ba0634fa660c0a09dd03eb
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417 \xAB\u0427\u0435\u0440\u043D\u043E\u0431\u044B\u043B\u044C\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417 \xAB\u0427\u0435\u0440\u043D\u043E\u0431\u044B\u043B\u044C\xBB"
  _description: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417 (\u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439, \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0438 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B) \u0441 \u0436\u0438\u043B\u0435\u0442\u043E\u043C \u0438\u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u0430, \u0430\u0441\u0441\u043E\u0446\u0438\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0441 \u0444\u0430\u043D\u0430\u0442\u0438\u043A\u0430\u043C\u0438 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u044C\u044F\u043D\u043E \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442 \u0446\u0435\u043D\u0442\u0440 \u0417\u043E\u043D\u044B \u043E\u0442 \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0447\u0438\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043D\u0430\u0447\u0430\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u0420\u0425\u0411\u0417 \u043F\u043E\u0441\u043B\u0435 \u043B\u0438\u043A\u0432\u0438\u0434\u0430\u0446\u0438\u0438 \u0427\u0435\u0440\u043D\u043E\u0431\u044B\u043B\u044C\u0441\u043A\u043E\u0439 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B \u0432 1986 \u0433\u043E\u0434\u0443 \u0434\u043B\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0440\u0430\u0431\u043E\u0442 \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0427\u0417\u041E, \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0447\u0435\u0433\u043E \u0438\u0445 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0436\u0435\u043B\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0435\u0433\u043E. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439 \u0442\u043E, \u043A\u0430\u043A \u0442\u0430\u043A\u043E\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u043E\u0432 \u0431\u044B\u043B\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E \u0432 \u0417\u043E\u043D\u0435 \u0438 \u043F\u043E\u043F\u0430\u043B\u043E \u0432 \u0440\u0443\u043A\u0438 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB. \u0412 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0442\u0430\u043A\u0436\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5, \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0441 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u043C\u0438."
