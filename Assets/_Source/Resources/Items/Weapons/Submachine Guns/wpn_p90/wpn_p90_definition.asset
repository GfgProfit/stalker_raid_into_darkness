  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_p90_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 0847cbf7fc1b0184796bc79d42c6eb8a
  _displayName: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 FN P90"
  _shortName: FN P90
  _description: "\u0411\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 \u043F\u043E\u0434 \u043C\u0430\u043B\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0432\u044B\u0441\u043E\u043A\u043E\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u043E\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 5,7x28 \u043C\u043C NATO, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 FN Herstal \u0432 \u043A\u043E\u043D\u0446\u0435 1980-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0438 \u0441\u0435\u0440\u0438\u0439\u043D\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u0441 1990 \u0433\u043E\u0434\u0430. \u0421\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0441\u044F \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F \u0441\u0430\u043C\u043E\u043E\u0431\u043E\u0440\u043E\u043D\u044B (PDW \u2014 Personal Defence Weapon) \u0434\u043B\u044F \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u0439 \u0431\u043E\u0435\u0432\u044B\u0445 \u043C\u0430\u0448\u0438\u043D, \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D \u043F\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0431\u0443\u043B\u043B-\u043F\u0430\u043F \u0441 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u044B\u0445 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0430, \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0430 \u0432\u0435\u0434\u0451\u0442\u0441\u044F \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0430. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u043D\u0430\u0434 \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u043E\u0439 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 50 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0412\u044B\u0431\u0440\u043E\u0441 \u0441\u0442\u0440\u0435\u043B\u044F\u043D\u044B\u0445 \u0433\u0438\u043B\u044C\u0437 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u043D\u0438\u0437, \u0430 \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u043E\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0448\u0430\u043C\u0438, \u0442\u0430\u043A \u0438 \u043B\u0435\u0432\u0448\u0430\u043C\u0438. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C 850\u20131100 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 264 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u044F \u2014 505 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 \u043E\u043A\u043E\u043B\u043E 2,8 \u043A\u0433. \u0412 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u043C \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0431\u0435\u0437 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u0441 \u0442\u0440\u0438\u0442\u0438\u0435\u0432\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F, \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 200 \u043C\u0435\u0442\u0440\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u043C\u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u043C\u0438, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430."
