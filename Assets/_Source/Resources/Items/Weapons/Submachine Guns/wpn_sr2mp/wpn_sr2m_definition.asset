  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_sr2m_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: aab9cf1111fd589458f3712239245f74
  _displayName: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 \u0421\u04202\u041C\u041F \xAB\u0412\u0435\u0440\u0435\u0441\u043A\xBB"
  _shortName: "\u0412\u0435\u0440\u0435\u0441\u043A"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x21 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u043D\u0430\u0443\u0447\u043D\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u043E\u043C \u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0430\u0448\u0438\u043D\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F (\u0426\u041D\u0418\u0418\u0422\u041E\u0427\u041C\u0410\u0428) \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043E\u043F\u044B\u0442\u043D\u043E-\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \xAB\u0412\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u0435-\u0410\xBB \u0432 2010\u20132011 \u0433\u043E\u0434\u0430\u0445. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u044E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430 \u0421\u04202\u041C \xAB\u0412\u0435\u0440\u0435\u0441\u043A\xBB, \u0441\u0435\u0440\u0438\u0439\u043D\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0441 2012 \u0433\u043E\u0434\u0430. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043E\u0442\u0432\u043E\u0434\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C \u0433\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u0440\u0448\u043D\u044F \u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0434\u0430\u043D\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u044B \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0435\u043D\u043E \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C. \u041E\u0440\u0443\u0436\u0438\u0435 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u044B\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C, \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u044F\u0442\u044C\u044E \u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0444\u043B\u0430\u0436\u043A\u043E\u0432\u044B\u043C\u0438 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C \u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u043E\u0433\u043D\u044F. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u0434\u0432\u0443\u0445\u0440\u044F\u0434\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 20 \u0438\u043B\u0438 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0432 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u044F\u0442\u0438. \u0413\u043B\u0430\u0432\u043D\u044B\u043C\u0438 \u043E\u0442\u043B\u0438\u0447\u0438\u044F\u043C\u0438 \u0421\u04202\u041C\u041F \u043E\u0442 \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u043B\u0430\u043D\u043A\u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 Picatinny \u043D\u0430 \u043A\u0440\u044B\u0448\u043A\u0435 \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0438 \u0446\u0435\u0432\u044C\u0435, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0448\u0442\u0430\u0442\u043D\u043E\u0433\u043E \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044F \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0430 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u043E\u0439 \u0444\u043E\u0440\u043C\u044B, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0441\u043E \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u043C \u0448\u043B\u0435\u043C\u043E\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0441\u0438\u043B\u043E\u0432\u044B\u0445 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440."
