  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: caebf45627febf64cbe508d201df2754
  _displayName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432"
  _shortName: LIGHT
  _description: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438 \u0438 \xAB\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\xBB \u043F\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u0432 \u0440\u0443\u043A\u0438 \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432. \u0417\u0430 \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u0437\u044F\u0442\u044B \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0430\u0440\u043C\u0438\u0439. \u041D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u043D \u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043E\u0442 \u043C\u0430\u043B\u044B\u0445 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432 \u043E\u0440\u0443\u0436\u0438\u044F, \u043F\u043E\u0440\u0435\u0437\u043E\u0432 \u0438 \u0448\u0440\u0430\u043F\u043D\u0435\u043B\u0438. \u041E\u0434\u043D\u0430\u043A\u043E \u0432 \u043D\u0451\u043C \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u0435\u0449\u0430\u0442\u044C \u0437\u043E\u043D\u044B \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0444\u043E\u043D\u043E\u043C \u0438\u043B\u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F."
