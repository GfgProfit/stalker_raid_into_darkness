  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043D\u0430\u0431\u043E\u0440 Trijicon. (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438/\u0412\u0438\u0432\u0435\u0440)"
  _shortName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043D\u0430\u0431\u043E\u0440 Trijicon. (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438/\u0412\u0438\u0432\u0435\u0440)"
  _description: "\u0414\u0430\u043D\u043D\u044B\u0439 \u043D\u0430\u0431\u043E\u0440
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0434\u0432\u0443\u0445
    \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    Trijicon \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u0441 \u043F\u043B\u0430\u043D\u043A\u043E\u0439
    \u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438/\u0412\u0438\u0432\u0435\u0440
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0434\u0432\u0430
    \u043F\u0440\u0438\u0446\u0435\u043B\u0430: Trijicon Acog BAC 5.56 BDC \u0438
    Trijicon RMR. \u0414\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u043E\u043D\u043E\u0432\u043A\u0430
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0435\u0441\u0442\u0438
    \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C
    \u043A\u0430\u043A \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u0442\u0430\u043A \u0438 \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0445
    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
