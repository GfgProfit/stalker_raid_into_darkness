  _definitionId: dd7683cc35a975247ade358caf15f1a7
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0442\u0435\u0440 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0442\u0435\u0440 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _description: "\u042D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u044B\u0439 \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u0438\u043A\u0430\u043C\u0438 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u0430\xBB. \u0414\u043B\u044F \u043F\u043E\u0448\u0438\u0432\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0442\u043A\u0430\u043D\u044C, \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C \xAB\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442\xBB, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u0451\u043C \u043F\u0440\u043E\u0431 \u0438 \u043E\u0448\u0438\u0431\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F, \u0435\u0441\u0442\u044C \u043B\u0438 \u0443 \u043D\u0435\u0433\u043E \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B."
