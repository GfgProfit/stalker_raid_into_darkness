  m_Name: isg_scientific_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5825057c882eeab4f8f0a4df3c3f7336
  _displayName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u0418\u0418\u0413"
  _shortName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u0418\u0418\u0413"
  _description: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \xAB\u0421\u0415\u0412\u042B\xBB,
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u044B\u0439 \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0445 \u043A\u0438\u0435\u0432\u0441\u043A\u0438\u0445
    \u041D\u0418\u0418 \u043F\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u0437\u0430\u043A\u0430\u0437\u0443. \u041A\u043E\u0441\u0442\u044E\u043C \u0438\u043C\u0435\u0435\u0442
    \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u0434\u044B\u0445\u0430\u043D\u0438\u044F \u0438 \u0432\u043D\u0435\u0448\u043D\u0435\u0435
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435,
    \u0447\u0442\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u043B\u0443\u0447\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442
    \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438 \u0438 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043F\u043E
    \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438 \xAB\u0421\u0415\u0412\u042B\xBB.
    \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0438\u043C\u0435\u044E\u0449\u0438\u0439\u0441\u044F
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u043D\u0435 \u0442\u0430\u043A
    \u0445\u043E\u0440\u043E\u0448, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u043D\u0435
    \u0441\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
    \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u0432 \u0441\u043B\u0443\u0447\u0430\u0435
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043E\u043A."
