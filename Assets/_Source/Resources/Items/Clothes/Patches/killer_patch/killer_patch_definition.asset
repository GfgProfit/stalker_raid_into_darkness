  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u041D\u0430\u0451\u043C."
  _description: "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C \u043D\u0430\u0448\u0438\u0432\u043A\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0445\u0438\u0449\u043D\u0430\u044F \u043F\u0442\u0438\u0446\u0430 \u0441\u0438\u043D\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430 \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C \u0444\u043E\u043D\u0435. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043D\u0430 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432 \u043A\u0430\u043A \u043D\u0430 \u0433\u0440\u0443\u043F\u043F\u0443 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445, \u0440\u0430\u0441\u0447\u0451\u0442\u043B\u0438\u0432\u044B\u0445 \u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u043E\u043B\u0434\u0430\u0442 \u0443\u0434\u0430\u0447\u0438, \u0433\u043E\u0442\u043E\u0432\u044B\u0445 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0438\u043B\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0441\u0432\u043E\u044E \u0446\u0435\u043B\u044C \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432."
