  m_Name: dolg_nosorog_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: b92439bf00996b944af94a41527523c4
  _displayName: "\u041F\u0421\u0417-10\u0414 \xAB\u041D\u043E\u0441\u043E\u0440\u043E\u0433\xBB"
  _shortName: EXO
  _description: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0435 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0438\u0437 \u0445\u043E\u0440\u043E\u0448\u043E \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0442\u044F\u0436\u0451\u043B\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430-\u043F\u043E\u0434\u0434\u043E\u0441\u043F\u0435\u0448\u043D\u0438\u043A\u0430 \u0438 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u0430 M10 \u0447\u0435\u0448\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430. \u041F\u043E \u0441\u043B\u0443\u0445\u0430\u043C, \u0438\u0434\u0435\u044F \u0438 \u0440\u0430\u043D\u043D\u0438\u0435 \u043D\u0430\u0431\u0440\u043E\u0441\u043A\u0438 \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u0438 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u043C\u0443 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0443 \u043F\u043E \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0443 \u041A\u043B\u044B\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0433\u0438\u0431\u0435\u043B\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0432 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043E\u043A \u0432 \u0417\u043E\u043D\u0435.\n\u0415\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u0442\u043E \xAB\u041D\u043E\u0441\u043E\u0440\u043E\u0433\xBB \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u0432 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u043C \u0442\u0430\u043D\u043A\u043E\u043C, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u043C \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0443\u0440\u043E\u043D, \u0438\u043C\u0435\u044F \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441.\n\u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u044B\u043C \u0446\u0435\u043D\u043D\u044B\u043C \u0447\u043B\u0435\u043D\u0430\u043C \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043E\u043A \u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439 - \u0438 \u0434\u0430\u0436\u0435 \u043F\u043E\u0442\u043E\u043C \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u043C \u0435\u0433\u043E \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0441\u0442\u0438 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443."
