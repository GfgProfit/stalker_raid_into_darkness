  m_Name: ecolog_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 229612070aca6c74ebc4be407927756f
  _displayName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442"
  _shortName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442"
  _description: "\u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438 \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044B. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0431\u0438\u0442\u044C \u043C\u0435\u043B\u043A\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C, \u0430 \u0435\u0433\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u0435 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u044B, \u043E\u0431\u043B\u0435\u0433\u0447\u0430\u044E\u0449\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u0443 \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C, \u043C\u043E\u0433\u0443\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u043F\u043E\u043C\u043E\u0447\u044C \u043F\u0440\u0438 \u043E\u0431\u043E\u0440\u043E\u043D\u0435 \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u043B\u0430\u0433\u0435\u0440\u044F. \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0440\u0430\u0431\u043E\u0442 \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u044B\u0445 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432 \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u043B\u044F \u043F\u043E\u043C\u043E\u0449\u0438 \u0432 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0435 \u0442\u044F\u0436\u0451\u043B\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u0431\u0430\u0442\u0430\u0440\u0435\u0439 \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432 \u0421\u0418\u041C\u041A, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u043D\u0430\u0443\u0447\u043D\u044B\u043C \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F\u043C \u0432\u043D\u0443\u0442\u0440\u0438 \u0417\u043E\u043D\u044B."
