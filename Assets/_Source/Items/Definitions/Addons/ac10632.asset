  _definitionId: 867a7f373388760469fc24ccebf9f005
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Barska ELECTRO SIGHT AC10632"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Barska ELECTRO SIGHT AC10632"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF> \u2022 <color=#8C8C8C>\u0432\u0441\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u041D\u0410\u0422\u041E\n\n<color=#AAAAAA>\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B ELECTRO SIGHT 1x22x33 \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F. \u0423\u0434\u0430\u0440\u043E\u043F\u0440\u043E\u0447\u043D\u044B\u0439, \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u0432\u0441\u0435 \u0432\u0438\u0434\u044B \u043E\u0440\u0443\u0436\u0438\u044F \u0441 \u043F\u043B\u0430\u043D\u043A\u043E\u0439 \xAB\u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438\xBB. \u0412\u044B\u0431\u043E\u0440 \u0443\u0440\u043E\u0432\u043D\u044F \u044F\u0440\u043A\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438 (7 \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439) \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B \u043F\u0440\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0443\u0440\u043E\u0432\u043D\u044F\u0445 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435: <color=#AAAAAA>\u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 (\u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435: <color=#AAAAAA>\u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435"
