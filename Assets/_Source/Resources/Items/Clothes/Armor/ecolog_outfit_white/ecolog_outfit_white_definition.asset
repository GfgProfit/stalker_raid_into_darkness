  _definitionId: 97f34eddca4b1bd419c7df28cec33e7c
  _displayName: "\u0421\u0421\u041F-99 \xAB\u0410\u043B\u043C\u0430\u0437\xBB"
  _shortName: HEAVY
  _description: "\u0421\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B, \u043A\u043E\u0441\u0442\u044E\u043C \u0421\u0421\u041F-99 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F\u043C\u0438 \u0443\u0447\u0451\u043D\u044B\u0445 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u044E\u0449\u0438\u043C\u0438 \u0441 \u043D\u0438\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u0421\u043E\u0437\u0434\u0430\u043D \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u0434\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u0438 \u0438\u043C\u0435\u0435\u0442 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u0438 \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0438 \u043A\u043E\u043D\u0434\u0438\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u0442\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438. \u0410 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0434\u0430\u0451\u0442 \u0435\u0449\u0451 \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0445\u0438\u043C\u0438\u043A\u0430\u0442\u043E\u0432 \u0438 \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440. \u041D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0431\u043E\u0435\u0432\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0438 \u043E\u0442 \u043F\u0443\u043B\u044C, \u043D\u0438 \u043E\u0442 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432."
