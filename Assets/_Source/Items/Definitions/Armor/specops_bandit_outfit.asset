  m_Name: specops_bandit_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3f9954516f19f1f439a357bf8f3db829
  _displayName: "\xAB\u0411\u0435\u0440\u0438\u043B\u043B-5\u041C\xBB \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430"
  _shortName: "\xAB\u0411\u0435\u0440\u0438\u043B\u043B-5\u041C\xBB \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430"
  _description: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u0433\u043E
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430 \u0441\u0435\u0440\u0438\u0438
    \u041F\u04215 \u0441 \u0431\u0435\u0440\u0438\u043B\u043B\u0438\u0435\u0432\u044B\u043C
    \u043D\u0430\u043F\u044B\u043B\u0435\u043D\u0438\u0435\u043C, \u043F\u043E\u043F\u0430\u0432\u0448\u0438\u0439
    \u0432 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435
    \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
    \u0433\u0440\u044F\u0437\u043D\u044B\u0435 \u0441\u0434\u0435\u043B\u043A\u0438.
    \u0418 \u0445\u043E\u0442\u044F \u043D\u0430 \u043D\u0451\u043C \u0438\u043C\u0435\u044E\u0442\u0441\u044F
    \u0441\u043B\u0435\u0434\u044B \u0434\u043E\u043B\u0433\u043E\u0433\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u043E\u043A, \u043E\u043D \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u0437\u0430\u0449\u0438\u0442\u044B
    \u0438 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u0422\u0435\u043C
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E
    \u0432\u0431\u043B\u0438\u0437\u0438 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439."
