  m_Name: wpn_sig220_nimble_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c1c898fc55d0726419c65a0499079506
  _displayName: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 SIG Sauer P220R"
  _shortName: P220R
  _description: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u043E-\u0433\u0435\u0440\u043C\u0430\u043D\u0441\u043A\u043E\u0439 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D .45 ACP (11,43x23 \u043C\u043C), \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439 \u0441\u043E\u0431\u043E\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E SIG Sauer P220, \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0443\u044E\u0441\u044F \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 2000-\u0445 \u0433\u043E\u0434\u043E\u0432. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0445\u043E\u0434\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA). \u0420\u0430\u043C\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u2014 \u0438\u0437 \u043D\u0435\u0440\u0436\u0430\u0432\u0435\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C, \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u2014 \u0438\u0437 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430. \u0413\u043B\u0430\u0432\u043D\u044B\u043C \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C \u043E\u0442 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E P220 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F \u043F\u043E\u0434 \u0441\u0442\u0432\u043E\u043B\u043E\u043C \u0434\u043B\u044F \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0440\u044B\u0447\u0430\u0433\u043E\u043C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u043F\u0443\u0441\u043A\u0430 \u043A\u0443\u0440\u043A\u0430, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430, \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 112 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 196 \u043C\u043C. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u043D\u043E\u0440\u044F\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0448\u0442\u0430\u0442\u043D\u043E\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 8 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0412\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0440\u0430\u043C\u043A\u0430 \u0441 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043B\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0439 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0445 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 P220."
