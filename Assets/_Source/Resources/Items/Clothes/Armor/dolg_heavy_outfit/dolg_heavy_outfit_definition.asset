  m_Name: dolg_heavy_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 06e6335cb0d67cb4980e6e79aa56eea9
  _displayName: "\u041F\u0421\u0417-9\u0434 \xAB\u0411\u0440\u043E\u043D\u044F \"\u0414\u043E\u043B\u0433\u0430\"\xBB"
  _shortName: MEDIUM
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0439 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0445 \u041D\u0418\u0418 \u0432 \u041A\u0438\u0435\u0432\u0435, \u043F\u0435\u0440\u0432\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u0441\u043E\u0431\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430 \u0441\u0435\u0440\u0438\u0438 \u041F\u04213-9, \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B. \u0412 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u043C \u0434\u0438\u0437\u0430\u0439\u043D \u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0433\u043E\u0434\u043E\u043C, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0435 \u043C\u0435\u043D\u044F\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439 \u0434\u0435\u043D\u044C \u0432\u0435\u0440\u0441\u0438\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u043A\u0430\u043A \u0438 \u043E\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043D\u043E\u0439 \u043F\u0443\u043B\u0438, \u0442\u0430\u043A \u0438 \u043E\u0442 \u0443\u0436\u0430\u0441\u043E\u0432 \u0417\u043E\u043D\u044B. \u0413\u043B\u0430\u0432\u043D\u044B\u043C\u0438 \u0436\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0435\u0433\u043E \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u043A\u043E\u0441\u0442\u044C, \u0446\u0435\u043D\u0430 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432, \u043C\u0435\u043D\u0435\u0435 \u0441\u0442\u043E\u0439\u043A\u0438\u0445 \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C, \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C - \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0431\u043E\u0439\u0446\u0443, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043A\u0430 \u0447\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B \u0441\u0435\u0431\u044F \u043A\u0430\u043A\u0438\u043C-\u043B\u0438\u0431\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C."
