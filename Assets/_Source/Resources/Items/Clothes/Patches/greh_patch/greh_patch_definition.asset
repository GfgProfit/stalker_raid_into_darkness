  _definitionId: 38fb35f5980977b4a81db04a55b54d3b
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \xAB\u0413\u0440\u0435\u0445\u0430\xBB"
  _shortName: "\u0413\u0440\u0435\u0445"
  _description: "\u0414\u0430\u043D\u043D\u0443\u044E \u043D\u0430\u0448\u0438\u0432\u043A\u0443 \u0443\u0436\u0435 \u0441\u0430\u043C\u0443 \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0432 \u0440\u0443\u043A\u0430\u0445. \u041D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C \u0444\u043E\u043D\u0435 \u0432 \u043B\u0435\u0432\u043E\u043C \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0443\u0433\u043B\u0443 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D \u0437\u043C\u0435\u0439, \u0430 \u0432 \u043F\u0440\u0430\u0432\u043E\u043C - \u043F\u0440\u0430\u0432\u043E\u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u043A\u0440\u0435\u0441\u0442. \u041F\u043E \u0446\u0435\u043D\u0442\u0440\u0443 \u0436\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430 \u0437\u0430\u0442\u043C\u0435\u0432\u0430\u044E\u0449\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430, \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E \xAB\u0413\u0420\u0415\u0425\xBB \u043D\u0430 \u043D\u0435\u0439. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430\u0448\u0438\u0432\u043A\u0438 \u0432 \u0440\u0443\u043A\u0430\u0445 \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0443\u043C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F."
