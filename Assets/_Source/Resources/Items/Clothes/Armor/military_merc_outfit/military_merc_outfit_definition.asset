  _definitionId: 09142c30a21a7a34da6e22a039058e17
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u0421\u041A\u0410\u0422-9\xBB \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u0411\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u0421\u041A\u0410\u0422-9\xBB \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _description: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C, \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0434\u043B\u044F \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0417\u043E\u043D\u044B. \u0414\u0430\u043D\u043D\u044B\u0439 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0432 \u0437\u043E\u043D\u0430\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438. \u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B: \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0441\u0435\u0440\u0438\u0438 \u041F\u0421\u0417-12\u043F, \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u0438 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C. \u041F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u043F\u0443\u043B\u044C \u0438 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0443\u0434\u043E\u0431\u0435\u043D \u0438 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043E\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C\u0438 \u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u043E\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u0432 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C \u0438\u0442\u043E\u0433\u0435 \u043F\u0430\u0440\u0442\u0438\u0438 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u043E\u0432 \u043D\u0430\u0447\u0430\u043B\u0438 \u0443\u0442\u0435\u043A\u0430\u0442\u044C \u0438 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0440\u044B\u043D\u043E\u043A \u0417\u043E\u043D\u044B."
