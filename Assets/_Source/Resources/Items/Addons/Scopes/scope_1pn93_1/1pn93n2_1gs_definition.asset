  _definitionId: bb42dc9b48c7cee4e82a8b3b37f82fe9
  _displayName: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B 1\u041F\u041D93-1 \xAB\u041C\u0430\u0433\u043D\u0443\u0441-3\xBB"
  _shortName: "\u041C\u0430\u0433\u043D\u0443\u0441-3"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 4x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u041A\u0411 \xAB\u0422\u043E\u0447\u043F\u0440\u0438\u0431\u043E\u0440\xBB \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E-\u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F 2+, \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0441\u043B\u0430\u0431\u044B\u0439 \u0441\u0432\u0435\u0442 \u041B\u0443\u043D\u044B \u0438 \u0437\u0432\u0451\u0437\u0434. \u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u0441\u043E \u0448\u0442\u0430\u0442\u043D\u044B\u043C \u0431\u043E\u043A\u043E\u0432\u044B\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u0410\u041A-74\u041C, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u0410\u0421 \xAB\u0412\u0430\u043B\xBB \u0438 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0412\u0421\u0421 \xAB\u0412\u0438\u043D\u0442\u043E\u0440\u0435\u0437\xBB \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F\u0445. \u0418\u043C\u0435\u0435\u0442 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u0443\u044E \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438, \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0432\u044B\u0432\u0435\u0440\u043A\u0438 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u044F\u0440\u043A\u0438\u0445 \u0437\u0430\u0441\u0432\u0435\u0442\u043E\u043A. \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F \u0440\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u043E 350 \u043C\u0435\u0442\u0440\u043E\u0432 \u043F\u0440\u0438 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041F\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430 AA, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E \u0434\u043E 10 \u0447\u0430\u0441\u043E\u0432 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B. \u041C\u0430\u0441\u0441\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 1 \u043A\u0433."
