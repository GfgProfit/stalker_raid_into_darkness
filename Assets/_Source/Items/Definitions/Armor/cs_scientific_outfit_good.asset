  m_Name: cs_scientific_outfit_good
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 157ef62493a9ec8448255f3fdafa5f6d
  _displayName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u0427\u041D-4\u0430 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB"
  _shortName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u0427\u041D-4\u0430 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB"
  _description: "\u041D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0432\u0435\u0440\u0441\u0438\u044F \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0421\u0415\u0412\u0410\xBB,
    \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u041D\u043E\u0432\u0438\u043A\u043E\u0432\u044B\u043C, \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u043C
    \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB.
    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435 \u0438\u043C
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
    \u0441\u043D\u0438\u0437\u0438\u043B\u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    \u043A \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u043C
    - \u0437\u0430\u0442\u043E \u0432\u0441\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u044B\u0448\u043B\u0438 \u043D\u0430
    \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C. \u0412\u0434\u043E\u0431\u0430\u0432\u043E\u043A
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439
    \u0441\u0442\u043E\u043B\u044C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E
    \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0438 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u043B\u0435\u0439. \u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E
    \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0441\u0440\u0435\u0434\u0438
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439-\u0432\u0435\u0442\u0435\u0440\u0430\u043D\u043E\u0432
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438."
