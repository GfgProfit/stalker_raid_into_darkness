  m_Name: stalker_graphite_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 635a7b40d40430b4ebe28d385b5a81a7
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0413\u0440\u0430\u0444\u0438\u0442\xBB"
  _shortName: MEDIUM
  _description: "\xAB\u0413\u0440\u0430\u0444\u0438\u0442\xBB \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0439 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0435\u0439 \xAB\u0417\u0430\u0440\u0438\xBB. \u041A\u0430\u043A \u0438 \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0441 \xAB\u041C\u0435\u0434\u0432\u0435\u0434\u0435\u043C\xBB, \u0435\u0433\u043E \u043D\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0438 - \u044D\u0442\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u043C\u0435\u0442\u043E\u0434\u043E\u0432 \u043F\u0440\u043E\u0431 \u0438 \u043E\u0448\u0438\u0431\u043E\u043A, \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0432\u0448\u0438\u0445\u0441\u044F \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u043B\u0430\u0447\u0435\u0432\u043D\u043E \u0434\u043B\u044F \u043F\u0430\u0440\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0430\u043C\u043E\u043D\u0430\u0434\u0435\u044F\u043D\u043D\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u0440\u0435\u0448\u0438\u0432\u0448\u0438\u0445 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043C\u0435\u0440\u044B \u043F\u0441\u0438-\u0448\u0442\u043E\u0440\u043C\u0430. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0438\u0445 \u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u0437\u0430\u0449\u0438\u0442\u0443 \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u0432 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u043C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0434\u043E\u0431\u0430\u0432\u043E\u043A \u0445\u043E\u0442\u044C \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432 \u043A \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0443, \u043D\u043E \u043C\u0430\u043B\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u0435\u043D \u043F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u0441 \u0432\u044B\u0441\u043E\u043A\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C\u0438 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430\u043C\u0438. \u041A \u0442\u043E\u043C\u0443 \u0436\u0435 \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u043C, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u043E\u0441\u0442\u044E\u043C \u0432 \u0434\u0430\u043B\u044C\u043D\u0438\u0439 \u0443\u0433\u043E\u043B \u0438 \u0437\u0430\u0431\u044B\u0442\u044C \u043E \u043D\u0451\u043C."
