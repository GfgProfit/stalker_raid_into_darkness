  _definitionId: 09bc735509362dd4196601745af0c596
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB"
  _shortName: "\u0427\u041D"
  _description: "\u0414\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u0448\u0438\u0432\u043A\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u0432\u0435\u0442 \u043D\u0430 \u0444\u043E\u043D\u0435 \u0447\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430 \u0438 \u043F\u0430\u0440\u044B \u043F\u0442\u0438\u0446. \u0415\u0451 \u0437\u0430\u0434\u0443\u043C\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0438\u0434\u0435\u044F\u0445 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 - \u0438\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u0435 \u0417\u043E\u043D\u0443 \u0438 \u0438\u0437\u0431\u0435\u0436\u0430\u043D\u0438\u0435 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u043E\u0432. \xAB\u0427\u0438\u0441\u0442\u043E\u0435 \u043D\u0435\u0431\u043E\xBB \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F \u0432 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0435\u0440\u0435 \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u0438 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u043A\u0430\u043A \u0432\u044B\u0431\u0440\u043E\u0441\u043E\u0432, \u0442\u0430\u043A \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u044F\u0432\u043B\u0435\u043D\u0438\u0439. \u041D\u043E \u043B\u0438\u0448\u044C \u043C\u0430\u043B\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432 \u0432\u0435\u0440\u0438\u0442, \u0447\u0442\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0435 \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
