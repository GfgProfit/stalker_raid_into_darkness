  m_ActivationSlot: {fileID: 114350483966679799}
  m_BlockName: Initialize particle
  m_HLSLCode: "void InitGazirovka3(inout VFXAttributes attributes)\r\n{\r\n    uint seed = attributes.seed;\r\n    float3 randomValue = float3(ToFloat01(AnotherHash(seed ^ 543341u)), ToFloat01(AnotherHash(seed ^ 311743u)), ToFloat01(AnotherHash(seed ^ 98867u)));\r\n    attributes.lifetime = 3.0f;\r\n    attributes.size = 1.0f;\r\n    attributes.angleZ = lerp(0.0f, 0.0f, randomValue.z);\r\n    float3 offset = float3(0.0f, 1.0f, 0.0f);\r\n    float azimuth = randomValue.x * 6.28318531f;\r\n    float y = 2.0f * randomValue.y - 1.0f;\r\n    float radius = pow(lerp(0.004629631f, 1.0f, randomValue.z), 0.33333333f) * 3.0f;\r\n    float radial = sqrt(max(0.0f, 1.0f - y*y));\r\n    attributes.position = offset + float3(radial*cos(azimuth), y, radial*sin(azimuth)) * radius;\r\n    attributes.gazirovkaForceVelocity = 0.0f;\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitGazirovka3
    selectedIndex: 0
