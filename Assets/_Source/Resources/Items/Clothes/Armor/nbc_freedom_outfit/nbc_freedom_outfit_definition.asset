  m_Name: nbc_freedom_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: fa2798cccedd8d34f944e0f0a04d3ed0
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: MEDIUM
  _description: "\u041C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043C\u0430\u0441\u0442\u0435\u0440\u0430\u043C\u0438 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u0420\u0425\u0411\u0417, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0430\u043C\u0438. \u041F\u0440\u043E\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0435 \u0438\u043C\u0438 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u043F\u0443\u0441\u0442\u044C \u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u043D\u0430 \u043E\u0431\u0449\u0438\u0445 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u0445 \u0437\u0430\u0449\u0438\u0442\u044B \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u043E\u043C, \u043D\u043E \u043D\u0435 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0438 \u0431\u0435\u0437 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u0432 - \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u0431\u044B\u043B\u0438 \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u044B \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C. \u041A\u0430\u043A \u0438 \u0441 \u043F\u0440\u043E\u0447\u0438\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u043C\u0438, \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5. \xAB\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0441\u0440\u0435\u0434\u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u0432\u0432\u0438\u0434\u0443 \u0435\u0433\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439 \u0445\u0438\u043C- \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430\u043B\u0438\u0447\u0438\u044F \u043F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0432\u0435\u0441\u0430."
