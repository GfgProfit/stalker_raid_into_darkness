  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 87a7aa728b1296d4bbe24493c675a64a
  _displayName: "\u041F\u04215-\u0420 \xAB\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\xBB"
  _shortName: "\u041F\u04215-\u0420 \xAB\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\xBB"
  _description: "\u0421\u0442\u0430\u0440\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0414\u043E\u043B\u0433\u0430\xBB, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u0441 \u041F\u04215-\u041C \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432 \xAB\u0414\u043E\u043B\u0433\u0430\xBB \u0432 \u043F\u0435\u0440\u0432\u044B\u0435 \u0433\u043E\u0434\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438. \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043B\u0438\u0448\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0435 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0417\u043E\u043D\u044B, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u0443\u044E \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u0431\u043E\u0439\u0446\u043E\u0432, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0445 \u041F\u04215-\u0420. \u041D\u0430 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B \u041F\u04215-\u0420 \xAB\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\xBB \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F \u043B\u0438\u0448\u044C \u043D\u043E\u0432\u0438\u0447\u043A\u0430\u043C \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445."
