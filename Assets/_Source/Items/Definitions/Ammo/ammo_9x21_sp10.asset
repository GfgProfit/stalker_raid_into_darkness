  m_Name: ammo_9x21_sp10
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 00af584c456c01a4a87b281eaf0e0a8c
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9x21 \u0421\u041F-10"
  _shortName: "9x21 \u0421\u041F-10"
  _description: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D \u0441 \u043F\u0443\u043B\u0435\u0439 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.
    \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439
    \u0441\u0438\u043B\u044B, \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u043E\u0439
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B. \u041D\u043E\u0441\u043E\u0432\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0442\u0435\u0440\u043C\u043E\u0443\u043F\u0440\u043E\u0447\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442
    \u0438\u0437 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0447\u0435\u043C\u0443 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u0443\u043B\u0438.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>II
    (25)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0448\u0435
    \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E (37)"
