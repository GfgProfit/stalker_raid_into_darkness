  m_Name: ammo_5.56x45_ap
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 3ecb9b8f26186f04e85ab761f212d76e
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 5.56x45 \u043C\u043C M856A1"
  _shortName: M856A1
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,56x45 \u043C\u043C \u041D\u0410\u0422\u041E, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0441 \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u043C M855A1 Enhanced Performance Round. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043F\u043E\u043B\u0451\u0442\u0430 \u043F\u0443\u043B\u0438, \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0433\u043D\u044F \u0438 \u0446\u0435\u043B\u0435\u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A \u0438 \u0440\u0443\u0447\u043D\u044B\u0445 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 3,6 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441 \u043C\u0435\u0434\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0438 \u043F\u0438\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C \u0432 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u043E\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0439 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F \u0441\u043B\u0435\u0434 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u043E\u0442 70 \u0434\u043E 900 \u043C\u0435\u0442\u0440\u043E\u0432. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 945 \u043C/\u0441 \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0438 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 24 \u043C\u0435\u0442\u0440\u043E\u0432 \u043E\u0442 \u0434\u0443\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0440\u0435\u0437\u0430. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u0448\u0438\u043D\u044B \u043F\u0443\u043B\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u043D\u043D\u0438\u043C M856 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u043A\u0435 \u0448\u0442\u0430\u0442\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 M855A1 \u0438 \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u043E\u0433\u043E \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u0430. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0430\u0445 M4/M4A1, \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 M16 \u0438 \u0440\u0443\u0447\u043D\u044B\u0445 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 M249. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u0435\u043D \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0431\u0440\u043E\u043D\u0435\u043F\u043B\u0438\u0442."
