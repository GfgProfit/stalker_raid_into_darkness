  m_Name: ps01
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 141ad6a26409c1440ae80f784d023420
  _displayName: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u041F\u0421\u041E-1\u041C"
  _shortName: "\u041F\u0421\u041E-1\u041C"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u0431\u0430\u0437\u0435 \u041F\u0421\u041E-1 \u0434\u043B\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0414\u0440\u0430\u0433\u0443\u043D\u043E\u0432\u0430 \u0421\u0412\u0414. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0434\u043E \u043D\u0438\u0445 \u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C 24 \u043C\u043C \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 \u0441 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u043C, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u0438 \u0441\u0442\u0430\u0434\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0434\u0430\u043B\u044C\u043D\u043E\u043C\u0435\u0440\u043E\u043C, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u043C \u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0434\u043E \u0446\u0435\u043B\u0438 \u0432\u044B\u0441\u043E\u0442\u043E\u0439 1,7 \u043C\u0435\u0442\u0440\u0430. \u0418\u043C\u0435\u0435\u0442 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u044B\u0432\u0435\u0440\u043A\u0438, \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443 \u0441\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0438 \u0448\u0442\u0430\u0442\u043D\u043E\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0442\u0438\u043F\u0430 \xAB\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442\xBB. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u041F\u0421\u041E-1, \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F \u041F\u0421\u041E-1\u041C \u043B\u0438\u0448\u0435\u043D\u0430 \u043B\u044E\u043C\u0438\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u043E\u0433\u043E \u044D\u043A\u0440\u0430\u043D\u0430 \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432 \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F. \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 4x, \u0443\u0433\u043B\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u2014 6\xB0, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 620 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u043E\u0439 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u043D\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0438 \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438."
