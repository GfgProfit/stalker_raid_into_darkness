  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: b2160470b0f80c6469c672ec17e100b5
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0423\u0421\u041F-1 \xAB\u0422\u044E\u043B\u044C\u043F\u0430\u043D\xBB (1\u041F29)"
  _shortName: "\u0423\u0421\u041F-1"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u0432 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0410\u041A \u0438 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432 \u0420\u041F\u041A-74\u041D \u0438 \u041F\u041A\u041C\u041D. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0432 \u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0438 \u043D\u043E\u0447\u044C\u044E \u043F\u043E \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u044B\u043C \u0446\u0435\u043B\u044F\u043C. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u0440\u0438\u0437\u043C\u0435\u043D\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439, \u0434\u0430\u043B\u044C\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0439 \u0448\u043A\u0430\u043B\u043E\u0439 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 \u0432 \u0432\u0438\u0434\u0435 \u043F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u043E\u0433\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F. \u041F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u0440\u0438\u0442\u0438\u0435\u0432\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C, \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0438\u043C \u0431\u0430\u0442\u0430\u0440\u0435\u0439. \u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0448\u0442\u0430\u0442\u043D\u043E\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u043E\u0440\u0443\u0436\u0438\u044F. \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F 8 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432 \u043F\u0440\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0438 4x. \u041C\u0430\u0441\u0441\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 800 \u0433\u0440\u0430\u043C\u043C\u043E\u0432."
