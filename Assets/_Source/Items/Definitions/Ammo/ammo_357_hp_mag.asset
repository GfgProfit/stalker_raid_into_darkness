  m_Name: ammo_357_hp_mag
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 2f74e31d9b1521148a0ea43a08f2289f
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .357 HP"
  _shortName: .357 HP
  _description: ".357 \u041D\u0420 - \u043F\u0430\u0442\u0440\u043E\u043D \u0441
    \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439.
    \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0442\u0430\u043A\u0438\u0445 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u043F\u0443\u043B\u044F
    \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u043B\u0430\u0441\u044C, \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044F
    \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435,
    \u043D\u043E \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0432\u044B\u0437\u044B\u0432\u0430\u043B\u0430
    \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0442\u043A\u0430\u043D\u0435\u0439.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>II
    (20)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (126)"
