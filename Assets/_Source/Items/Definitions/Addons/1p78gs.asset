  _description: "\u041F\u0440\u0438\u0446\u0435\u043B \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    1\u041F78-1 \u0441 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C\u044E
    2.8 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439
