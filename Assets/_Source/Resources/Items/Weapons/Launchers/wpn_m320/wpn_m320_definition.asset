  m_Name: wpn_m320_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 9e53ede77812c7548bd6df465ebb8258
  _displayName: "40-\u043C\u043C \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 Heckler & Koch M320"
  _shortName: M320
  _description: "\u041E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0439 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043F\u043E\u0434 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B 40x46 \u043C\u043C NATO, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Heckler & Koch \u043D\u0430 \u0431\u0430\u0437\u0435 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 AG36. \u0412 \u0434\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435, \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0435 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u043E\u0439, \u0431\u0435\u0437 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u0438\u043B\u0438 \u043A\u0430\u0440\u0430\u0431\u0438\u043D. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442: \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0440\u0443\u0447\u043D\u0443\u044E, \u0437\u0430 \u0441\u0447\u0451\u0442 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043D\u0438\u044F \u043A\u0430\u0437\u0451\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0438 \u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0432 \u0441\u0442\u0432\u043E\u043B. \u0413\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u0438\u043C\u0435\u0435\u0442 \u043D\u0430\u0440\u0435\u0437\u043D\u043E\u0439 \u0441\u0442\u0432\u043E\u043B \u0434\u043B\u0438\u043D\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 215 \u043C\u043C, \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0438 \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u0442\u0432\u043E\u043B, \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u043B\u0438\u043D\u044B, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0435, \u0434\u044B\u043C\u043E\u0432\u044B\u0435, \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435, \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0438 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 40x46 \u043C\u043C. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0441 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0441 \u043F\u043B\u0435\u0447\u0430, \u0430 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0430 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442 \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043F\u0440\u0438 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430\u043C\u0438 \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F, M320 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435 \u0443\u0434\u043E\u0431\u043D\u043E\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u043E\u0439, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u0438\u043D\u043D\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043A\u0430\u043A \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430."
