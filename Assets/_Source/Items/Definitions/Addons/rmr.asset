  m_Name: rmr
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 47a9dcca3036c484a875295e2c1a2df4
  _displayName: Trijicon RMR Red Dot Sight
  _shortName: Trijicon RMR Red Dot Sight
  _description: "Trijicon RMR \u0432\u043E\u0441\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u044B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0440\u0435\u0434\u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432: \u0438\u0445 \u0442\u0430\u043A\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442 \u0432 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0435 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0441\u0432\u043E\u0438 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u044B, \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u043F\u0440\u043E\u0447\u043D\u044B \u0438 \u043D\u0430\u0434\u0435\u0436\u043D\u044B. \u041F\u043E \u0441\u0432\u043E\u0438\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044B Trijicon \u0432\u043E \u043C\u043D\u043E\u0433\u043E\u043C \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 ACOG. \u0422\u0430\u043A\u0438\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0438 \u0438 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F\u0445. \u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B\u0430 Trijicon \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438 \u0438 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438. \u0422\u0430\u043A\u0436\u0435 \u0435\u0441\u0442\u044C \u0441\u0432\u0435\u0442\u043E\u0432\u043E\u0439 \u0434\u0430\u0442\u0447\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B. \u041D\u0435\u043C\u0430\u043B\u043E\u0432\u0430\u0436\u043D\u043E\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 - \u044D\u0442\u043E \u0442\u043E, \u0447\u0442\u043E \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0430 \u043B\u044E\u0431\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435, \u0431\u0443\u0434\u044C \u0442\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442, \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430, \u043A\u0430\u0440\u0430\u0431\u0438\u043D, \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u0430\u0440\u0431\u0430\u043B\u0435\u0442. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0430 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043A\u0438."
