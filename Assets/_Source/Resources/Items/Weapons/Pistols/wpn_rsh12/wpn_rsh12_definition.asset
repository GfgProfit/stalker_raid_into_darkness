  m_Name: wpn_rsh12_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 2d313b54ebbeb5b42b4fa24b2745d267
  _displayName: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u0420\u0428-12"
  _shortName: "\u0420\u0428-12"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 12,7x55 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0442\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0431\u044E\u0440\u043E \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F (\u0426\u041A\u0418\u0411 \u0421\u041E\u041E) \u0434\u043B\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0441\u0438\u043B\u043E\u0432\u044B\u0445 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440 \u0420\u043E\u0441\u0441\u0438\u0438. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0441 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043D\u044B\u043C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043E\u043C \u0428\u0410\u041A-12 (\u0410\u0428-12). \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA), \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0440\u0430\u043C\u043A\u043E\u0439 \u0438 \u043E\u0442\u043A\u0438\u0434\u043D\u044B\u043C \u043F\u044F\u0442\u0438\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u043C \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043E\u043C \u0441 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u044D\u043A\u0441\u0442\u0440\u0430\u043A\u0446\u0438\u0435\u0439 \u0441\u0442\u0440\u0435\u043B\u044F\u043D\u044B\u0445 \u0433\u0438\u043B\u044C\u0437. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0438\u0436\u043D\u0435\u0439 \u043A\u0430\u043C\u043E\u0440\u044B \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430, \u0447\u0442\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435 \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u0437\u0430 \u0441\u0447\u0451\u0442 \u043D\u0438\u0437\u043A\u043E\u0433\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043E\u0441\u0438 \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C \u0440\u0443\u0447\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C, \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0438 \u043F\u043B\u0430\u043D\u043A\u0430\u043C\u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 Picatinny \u043D\u0430\u0434 \u0438 \u043F\u043E\u0434 \u0441\u0442\u0432\u043E\u043B\u043E\u043C. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0441\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0430 \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041C\u0430\u0441\u0441\u0430 \u043D\u0435\u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 2\u20132,2 \u043A\u0433. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0442\u0434\u0430\u0447\u0443, \u0430 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442 \u0420\u0428-12 \u043E\u0442 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0445 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432 \u0438 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u043E\u0432."
