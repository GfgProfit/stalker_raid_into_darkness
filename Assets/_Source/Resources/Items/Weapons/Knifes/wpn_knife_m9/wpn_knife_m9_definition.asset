  m_Name: wpn_knife_m9_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5a88cd1704678fd438a1469c42bfccc6
  _displayName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0448\u0442\u044B\u043A-\u043D\u043E\u0436 M9"
  _shortName: M9
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043C\u043D\u043E\u0433\u043E\u0446\u0435\u043B\u0435\u0432\u043E\u0439 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0448\u0442\u044B\u043A-\u043D\u043E\u0436, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Phrobis III \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0427\u0430\u0440\u043B\u044C\u0437\u0430 \xAB\u041C\u0438\u043A\u043A\u0438\xBB \u0424\u0438\u043D\u043D\u0430 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0430\u0440\u043C\u0438\u0438 \u0421\u0428\u0410 \u0432 1986 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u0448\u0442\u044B\u043A-\u043D\u043E\u0436\u0430 M7. \u0412\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F\u043C\u0438 Buck Knives, LanCay \u0438 Ontario Knife Company. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 M16 \u0438 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u044B M4, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E \u043D\u043E\u0436\u0430. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u0438\u0437 \u043D\u0435\u0440\u0436\u0430\u0432\u0435\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441 \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439 \u0437\u0430\u0442\u043E\u0447\u043A\u043E\u0439, \u0441\u043A\u043E\u0441\u043E\u043C \u043E\u0431\u0443\u0445\u0430, \u0434\u043E\u043B\u043E\u043C \u0438 \u043F\u0438\u043B\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u0437\u0443\u0431\u044C\u044F\u043C\u0438 \u043D\u0430 \u043E\u0431\u0443\u0445\u0435. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 305 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u043A\u043B\u0438\u043D\u043A\u0430 \u2014 178 \u043C\u043C. \u0420\u0443\u043A\u043E\u044F\u0442\u044C \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0443\u0434\u0430\u0440\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430 \u0438 \u0438\u043C\u0435\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0435 \u0440\u0438\u0444\u043B\u0435\u043D\u0438\u0435, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0433\u0430\u0440\u0434\u0443 \u0441 \u043A\u043E\u043B\u044C\u0446\u043E\u043C \u0434\u043B\u044F \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0438 \u0438 \u043F\u043E\u0434\u043F\u0440\u0443\u0436\u0438\u043D\u0435\u043D\u043D\u044B\u0439 \u0444\u0438\u043A\u0441\u0430\u0442\u043E\u0440 \u0432 \u043D\u0430\u0432\u0435\u0440\u0448\u0438\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C\u0438 \u043D\u043E\u0436\u043D\u0430\u043C\u0438 \u0441 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u043C\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0448\u0442\u044B\u043A-\u043D\u043E\u0436 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043A\u0443\u0441\u0430\u0447\u0435\u043A \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0438. \u0421\u043E\u0447\u0435\u0442\u0430\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430."
