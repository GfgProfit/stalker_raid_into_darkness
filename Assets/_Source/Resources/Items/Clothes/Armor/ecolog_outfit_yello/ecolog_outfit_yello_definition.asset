  m_Name: ecolog_outfit_yello_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c49188fae0fd3f5468e2964934c774ec
  _displayName: "\u0421\u0421\u041F-99 \xAB\u0422\u043E\u043F\u0430\u0437\xBB"
  _shortName: HEAVY
  _description: "\u0421\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B, \u043A\u043E\u0441\u0442\u044E\u043C \u0421\u0421\u041F-99 \xAB\u0422\u043E\u043F\u0430\u0437\xBB \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F\u043C\u0438 \u0443\u0447\u0451\u043D\u044B\u0445 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u044E\u0449\u0438\u043C\u0438 \u0441 \u043D\u0438\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u0418\u043C\u0435\u0435\u0442 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u0438 \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0438 \u043A\u043E\u043D\u0434\u0438\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u0442\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0445 \u0432 \u0437\u043E\u043D\u0430\u0445 \u0441 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043E\u0439, \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C. \u041D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0431\u043E\u0435\u0432\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0438 \u043E\u0442 \u043F\u0443\u043B\u044C, \u043D\u0438 \u043E\u0442 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432."
