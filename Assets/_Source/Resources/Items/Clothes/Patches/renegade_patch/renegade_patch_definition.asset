  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432"
  _shortName: "\u0420\u0435\u043D\u0435\u0433."
  _description: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u043D\u0430\u0448\u0438\u0432\u043A\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D \u0436\u0451\u043B\u0442\u044B\u0439 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u043D\u0430 \u0437\u0435\u043B\u0451\u043D\u043E\u043C \u0449\u0438\u0442\u0435. \u0421\u0430\u043C\u043E \u0435\u0451 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0443 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0446\u0435\u043B\u044C, \u043E\u0434\u043D\u0430\u043A\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u0430\u043B\u043E \u043A\u0442\u043E \u043F\u043E\u0432\u0435\u0440\u0438\u0442 \u0432 \u043F\u043E\u0434\u043E\u0431\u043D\u0443\u044E \u0441\u043F\u043B\u043E\u0447\u0451\u043D\u043D\u043E\u0441\u0442\u044C \u0435\u0451 \u043D\u044B\u043D\u0435\u0448\u043D\u0438\u0445 \u0447\u043B\u0435\u043D\u043E\u0432, \u0440\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u043A\u0440\u043E\u043C\u0435 \u0438\u0445 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F \u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u044F \u0432\u044B\u0436\u0438\u0442\u044C. \u0412 \u043D\u0430\u0448\u0438 \u0434\u043D\u0438 \u0434\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u0448\u0438\u0432\u043A\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430 \u0441\u0440\u0435\u0434\u0438 \u0438\u0437\u0433\u043E\u0435\u0432 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u043E\u0442\u044A\u044F\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432\u2026 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u0437-\u0437\u0430 \u0438\u0445 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u043D\u043E\u0441\u0442\u0430\u043B\u044C\u0433\u0438\u0438 \u0438\u043B\u0438 \u0436\u0435 \u0441\u0442\u0438\u043B\u044F."
