  _displayName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C 9\u043C\u043C"
  _shortName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C 9\u043C\u043C"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C> 9 \u043C\u043C \u043A\u0430\u043B\u0438\u0431\u0440\n\n<color=#AAAAAA>\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C
    \u0434\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u043A\u0430\u043B\u0438\u0431\u0440\u0430
    9 \u043C\u043C. \u0410\u0440\u0445\u0430\u0438\u0447\u043D\u044B\u0439 \u043F\u043E
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0438 \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0442\u0435\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439. \u0421\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u043B\u043E\u0442\u043D\u043E \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0440\u0443\u043B\u043E\u043D \u043B\u0430\u0442\u0443\u043D\u043D\u043E\u0439
    \u0441\u0435\u0442\u043A\u0438. \u0412 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u0431\u043E\u0440\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u043D\u0430\u0431\u043E\u0440 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445
    \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C \u0441 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F\u043C\u0438
    \u0434\u043B\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u043F\u0443\u043B\u0438.
    \u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u0431\u043E\u044E \u043F\u0440\u043E\u0442\u0438\u0432
    \u043B\u0435\u0433\u043A\u043E \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0438 \u0434\u043B\u044F
    \u0442\u0438\u0445\u0438\u0445 \u0443\u0431\u0438\u0439\u0441\u0442\u0432.\n\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0413\u043B\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u043A\u0430:
    <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u0435"
