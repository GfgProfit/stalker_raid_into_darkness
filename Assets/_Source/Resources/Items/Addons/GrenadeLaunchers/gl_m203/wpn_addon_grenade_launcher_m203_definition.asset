  m_Name: wpn_addon_grenade_launcher_m203_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 3045b0c4dae47134895d0f9da88890f7
  _displayName: "40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 M203"
  _shortName: M203
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 M16. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u044B 40x46 \u043C\u043C \u043D\u0438\u0437\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0435, \u0434\u044B\u043C\u043E\u0432\u044B\u0435, \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0438 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0417\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441 \u043A\u0430\u0437\u0451\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u043F\u0443\u0442\u0451\u043C \u0441\u0434\u0432\u0438\u0433\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B, \u043E\u0433\u043D\u0435\u0432\u044B\u0445 \u0442\u043E\u0447\u0435\u043A \u0438 \u0446\u0435\u043B\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 M203 \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F."
