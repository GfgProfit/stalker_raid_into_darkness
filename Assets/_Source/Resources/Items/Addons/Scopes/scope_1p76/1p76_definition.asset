  m_Name: 1p76
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 94ac679431fcc2a48b2a24eeb4b81580
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B 1\u041F76 \xAB\u0420\u0430\u043A\u0443\u0440\u0441-\u0410\xBB"
  _shortName: "\u0420\u0430\u043A\u0443\u0440\u0441"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0448\u0438\u0440\u043E\u043A\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u041A\u0411 \xAB\u0422\u043E\u0447\u043F\u0440\u0438\u0431\u043E\u0440\xBB \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u041D\u043E\u0432\u043E\u0441\u0438\u0431\u0438\u0440\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0438 \u0440\u0443\u0447\u043D\u044B\u0435 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u044B \u0420\u041F\u041A, \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u044B\u0435 \u0448\u0442\u0430\u0442\u043D\u044B\u043C \u0431\u043E\u043A\u043E\u0432\u044B\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u0440\u0438\u0437\u043C\u0435\u043D\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u043C\u0443 \u043F\u043E\u043B\u044E \u0437\u0440\u0435\u043D\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0446\u0435\u043B\u0435\u0439 \u0438 \u0443\u0434\u043E\u0431\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0447\u0451\u0440\u043D\u044B\u043C \u0446\u0432\u0435\u0442\u043E\u043C \u043F\u0440\u0438 \u0434\u043D\u0435\u0432\u043D\u043E\u043C \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0438 \u0438 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0437\u0435\u043B\u0451\u043D\u044B\u043C \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0438 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0442\u0440\u0438\u0442\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u043E\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430, \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0435\u0433\u043E \u0431\u0430\u0442\u0430\u0440\u0435\u0439. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0435\u0441\u0442\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0443\u044E \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443 \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 13\xB0, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 500 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u043C\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C\u0438 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
