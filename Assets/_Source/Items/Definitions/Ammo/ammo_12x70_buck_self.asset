  m_Name: ammo_12x70_buck_self
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c014f2c3486c3984491fd3ccf2425043
  _displayName: "\u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u0430\u044F 12x70 \u043C\u043C \u0414\u0440\u043E\u0431\u044C"
  _shortName: "\u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u0430\u044F 12x70 \u043C\u043C \u0414\u0440\u043E\u0431\u044C"
  _description: "\u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 12-\u0433\u043E \u043A\u0430\u043B\u0438\u0431\u0440\u0430, \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0439 6 \u043C\u043C \u0434\u0440\u043E\u0431\u044C\u044E. \u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u043D\u0430 \u0431\u043B\u0438\u0437\u043A\u043E\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438 \u0440\u0443\u0436\u044C\u044F\u043C\u0438 \u0438 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430\u043C\u0438.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>\u043D\u0435\u0442 \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u044F\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0441\u0440\u0435\u0434\u043D\u0435\u0435\n\n<color=#AAAAAA>\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C:\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u043B\u0430\u043A\u043E \u0434\u0440\u043E\u0431\u0438, \u043D\u0438\u0437\u043A\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0438: (3)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (176)[16x11]"
