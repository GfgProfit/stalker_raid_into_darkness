  m_Name: helm_respirator_gp5
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b55ba199fa1659248890545069ade26c
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5"
  _shortName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5"
  _description: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0433\u043E \u0421\u043E\u044E\u0437\u0430 \u043E\u0442 \u0432\u044B\u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0440\u0430\u0434\u0438\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u043E\u0441\u0430\u0434\u043A\u043E\u0432 \u0438 \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0441\u044F \u0432 \u043F\u0435\u0440\u0438\u043E\u0434 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0432\u043E\u0439\u043D\u044B \u0441 1962 \u043F\u043E 1989 \u0433\u043E\u0434.\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0448\u043B\u0435\u043C-\u043C\u0430\u0441\u043A\u0443 \u0438\u0437 \u0431\u0435\u043B\u043E\u0439 \u0438 \u0447\u0451\u0440\u043D\u043E\u0439 \u0440\u0435\u0437\u0438\u043D\u044B, \u043B\u0438\u043D\u0437\u044B \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043E\u0431\u0436\u0438\u043C\u043D\u044B\u043C \u043E\u0431\u043E\u0434\u0430\u043C\u0438. \u0424\u0438\u043B\u044C\u0442\u0440\u044B \u0436\u0435 \u0431\u044B\u043B\u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u043B\u0438\u0431\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B, \u043B\u0438\u0431\u043E \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u043E\u0432 \u0441\u0445\u043E\u0436\u0435\u0439 \u0446\u0435\u043D\u043E\u0432\u043E\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u041F\u0411\u0424, \u0413\u041F-5 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438, \u043D\u043E \u0438 \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u0435."
