  m_Name: cs_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: fb017454a1c1bb047bf94e7da2c7daa3
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0427\u041D-5"
  _shortName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0427\u041D-5"
  _description: "\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u0432 \u0417\u043E\u043D\u0443 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C \u0438 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D \u041D\u043E\u0432\u0438\u043A\u043E\u0432\u044B\u043C \u043F\u043E\u0434 \u043D\u0443\u0436\u0434\u044B \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0427\u0438\u0441\u0442\u043E\u0435 \u043D\u0435\u0431\u043E\xBB. \u041E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u044B \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F\u0441\u044C \u043B\u0438\u0448\u044C \u0432 \u043A\u0440\u0438\u0437\u0438\u0441\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0431\u043E\u0439\u0446\u044B \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438 \u0441\u0435\u0431\u044F \u0438 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0445, \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430 \u0434\u043B\u044F \u043B\u0438\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F."
