  m_ActivationSlot: {fileID: 114350483966680273}
  m_BlockName: Limit new idle particles by quality
  m_HLSLCode: "void AdmitGazirovkaIdle7(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float density)\n{\n    uint address = counterOffset + 7u;\n    uint limit = max(1u, (uint)ceil(4.0f * saturate(density)));\n    uint previous;\n    InterlockedAdd(counters[address], 1u, previous);\n    attributes.alive = previous < limit;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[address], 0xffffffffu);\n    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: AdmitGazirovkaIdle7
    selectedIndex: 0
