  m_Name: ammo_9x18_pmm
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: af3d7a2dc1f22004395af0427ea92489
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9x18 \u043C\u043C \u041F\u041C\u041C \u0433\u0436"
  _shortName: "\u041F\u041C\u041C"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9x18 \u043C\u043C \u041F\u041C\u041C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 \u043A\u043E\u043D\u0446\u0435 1980-\u0445 \u2014 \u043D\u0430\u0447\u0430\u043B\u0435 1990-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0434\u043B\u044F \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u041C\u0430\u043A\u0430\u0440\u043E\u0432\u0430 \u041F\u041C\u041C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u043B\u0451\u0433\u043A\u0438\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u0448\u0442\u0430\u0442\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 9x18 \u043C\u043C \u041F\u041C \u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u043C \u0437\u0430\u0440\u044F\u0434\u043E\u043C \u0438 \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 5,5 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u041F\u0443\u043B\u044F \u0438\u043C\u0435\u0435\u0442 \u043A\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0441 \u043F\u043B\u043E\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439, \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044E \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u0438 \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u043E\u0432. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 420\u2013435 \u043C/\u0441, \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u2014 \u043E\u043A\u043E\u043B\u043E 500 \u0414\u0436, \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u041F\u041C. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u043E\u0440\u0443\u0436\u0438\u0438, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u043C \u043D\u0430 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u044B \u041F\u041C\u041C \u0438 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u044B-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u044B. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u043D\u0430\u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u043C \u043E\u0442\u0434\u0430\u0447\u0438."
