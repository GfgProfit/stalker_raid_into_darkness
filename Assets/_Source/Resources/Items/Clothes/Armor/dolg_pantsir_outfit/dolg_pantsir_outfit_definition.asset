  m_Name: dolg_pantsir_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 508acf0fcbbaf104d82848147dda314d
  _displayName: "\u041F\u0421\u0417-7\u043F \xAB\u041F\u0430\u043D\u0446\u0438\u0440\u044C\xBB"
  _shortName: "\u041F\u0421\u0417-7\u043F \xAB\u041F\u0430\u043D\u0446\u0438\u0440\u044C\xBB"
  _description: "\u0421\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439 \xAB\u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439\xBB \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u041F\u04215 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430\xBB, \u044F\u0432\u043B\u044F\u044F\u0441\u044C \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0438 \u043F\u0440\u043E\u0449\u0435 \u0432 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0438, \u0447\u0435\u043C \u043F\u043E\u043B\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u041F\u0421\u0417-9\u0434. \u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u0434\u043B\u044F \u0431\u043E\u0435\u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0439, \u0442\u0430\u043A \u043A\u0430\u043A \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u0438 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430 \u041F\u0421\u0417, \u043D\u043E \u0432 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C - \u0441\u0438\u043B\u044C\u043D\u043E \u0443\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0442\u043E\u043C\u0443. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0430 \u0432 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438 \u0438 \u0440\u0435\u043C\u043E\u043D\u0442\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043F\u043E\u0434\u0441\u043F\u043E\u0440\u044C\u0435\u043C \u0434\u043B\u044F \u0431\u043E\u0439\u0446\u043E\u0432 \xAB\u0414\u043E\u043B\u0433\u0430\xBB, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0438\u043B\u0438 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439. \u0412 \u0446\u0435\u043B\u043E\u043C, \u044D\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C, \u0434\u0430\u0436\u0435 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043F\u043E\u0434\u0432\u0435\u0440\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0443\u0433\u0440\u043E\u0437\u0430\u043C \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u044B."
