  m_Name: military_exo_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5a7d0f30d8999174b94171e4489d0364
  _displayName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442"
  _shortName: EXO
  _description: "\u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430. \u0412\u044B\u043F\u0443\u0449\u0435\u043D \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043F\u0430\u0440\u0442\u0438\u0435\u0439 \u043F\u043E \u0441\u043F\u0435\u0446\u0437\u0430\u043A\u0430\u0437\u0443 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u044B\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0430 \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443. \u0413\u043B\u0430\u0432\u043D\u043E\u0439 \u0435\u0433\u043E \u0437\u0430\u0434\u0430\u0447\u0435\u0439 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441\u0430, \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438 \u0438 \u043C\u0435\u0434\u043F\u043E\u043C\u043E\u0449\u0438 \u0432 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0440\u0435\u0439\u0434\u0430\u0445 \u0438 \u0441\u043F\u0435\u0446\u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u0445, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0445 \u0432\u0438\u0434\u043E\u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043E\u0432 \u0438 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432. \u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u044B \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432 \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0432 \u0440\u043E\u043B\u0438 \u043B\u0435\u0433\u043A\u043E\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u0438."
