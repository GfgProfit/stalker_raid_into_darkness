  m_Name: dolg_red_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 4b29144ad9a3c2f4db5f948dcc27f88d
  _displayName: "\u041F\u04215-\u041C \xAB\u0412\u0438\u0442\u044F\u0437\u044C\xBB"
  _shortName: MEDIUM
  _description: "\u0412 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u043C\u044B\u0441\u043B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u041F\u04215-\u041C \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430\xBB, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \xAB\u0414\u043E\u043B\u0433\u0430\xBB, \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u043E\u043C \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432 \u0438 \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u043E\u0439 \u0438\u0445 \u043B\u043E\u0433\u043E\u0432. \u0412 \u0441\u043B\u0443\u0447\u0430\u0435 \u0441 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u043E\u043B\u0435\u0439 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u0440\u0430\u0434\u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u043A \u0430\u0442\u0430\u043A\u0430\u043C \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432 \u0438 \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044E, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0442\u0435 \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F. \u0412 \u0446\u0435\u043B\u043E\u043C, \u041F\u04215-\u041C \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044F \u043D\u0430 \u0444\u043E\u043D\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0414\u043E\u043B\u0433\u0430\xBB."
