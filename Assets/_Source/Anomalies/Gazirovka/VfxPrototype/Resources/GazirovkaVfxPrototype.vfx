  m_HLSLCode: "void InitGazirovka4(inout VFXAttributes attributes)\r\n{\r\n    uint seed = attributes.seed;\r\n    float3 randomValue = float3(ToFloat01(AnotherHash(seed ^ 543341u)), ToFloat01(AnotherHash(seed ^ 311743u)), ToFloat01(AnotherHash(seed ^ 98867u)));\r\n    attributes.lifetime = 0.8f;\r\n    attributes.size = 1.0f;\r\n    attributes.angleZ = lerp(0.0f, 0.0f, randomValue.z);\r\n    float3 offset = float3(0.0f, 0.05f, 0.0f);\r\n    attributes.position = offset + (randomValue - 0.5f) * float3(1.4f, 0.1f, 1.4f);\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitGazirovka4
    selectedIndex: 0
