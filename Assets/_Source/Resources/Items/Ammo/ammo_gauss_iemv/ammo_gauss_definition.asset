  m_Name: ammo_gauss
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: e903f036ddcca8d40b1ec9abfd919fb4
  _displayName: "\u0417\u0430\u0432\u043E\u0434\u0441\u043A\u0430\u044F \u0433\u0430\u0443\u0441\u0441-\u043A\u0430\u0441\u0441\u0435\u0442\u0430 \u0418\u042D\u041C\u0412"
  _shortName: "\u0417\u0418\u042D\u041C\u0412"
  _description: "\u0412\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043A\u0430\u0441\u0441\u0435\u0442\u0430, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u0434\u043B\u044F \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \xAB\u0413\u0430\u0443\u0441\u0441\xBB, \u0442\u0430\u043A\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439 \u043A\u0430\u043A \xAB\u0418\u0437\u0434\u0435\u043B\u0438\u0435 \u211662\xBB. \u0421\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0435\u0441\u044F\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u0445 \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0435 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043A\u0430\u043F\u0441\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430 \xAB\u0412\u0441\u043F\u044B\u0448\u043A\u0430\xBB. \u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0445 \u043A\u0430\u0442\u0443\u0448\u0435\u043A, \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u044E\u0449\u0438\u0445 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u043D\u0430\u0440\u044F\u0434 \u0434\u043E \u0441\u0432\u0435\u0440\u0445\u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0435\u0439 \u0431\u0435\u0437 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u0430. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u044D\u0442\u043E\u043C\u0443 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u0443\u044E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C \u0446\u0435\u043B\u0438, \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430\u043C\u0438, \u0438 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F. \u0417\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u0435 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u044B \u043A\u0430\u0441\u0441\u0435\u0442\u044B. \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u0440\u0435\u0434\u043A\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u043A \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043A\u0440\u0430\u0439\u043D\u0435 \u0440\u0435\u0434\u043A\u0438 \u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E."
