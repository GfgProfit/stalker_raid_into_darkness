  m_Name: specter
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 0aea60fd72bbf20439531fbef8d7f762
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B ELCAN SpecterDR"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B ELCAN SpecterDR"
  _description: "\u0413\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B ELCAN SpecterDR 1-4x DFOV14-T1 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u043E\u0439 \u041A\u0430\u043D\u0430\u0434\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0441 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0434\u043D\u0438\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443 1\u0445 \u0438 4\u0445 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C. \u041F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0442\u043A\u0430 DFOV14-T1 \u0441 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u043D\u044B\u0445 \u0441 \u0443\u0447\u0435\u0442\u043E\u043C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u043F\u043E\u043B\u0435\u0442\u0430 \u043F\u0443\u043B\u0438 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,56 \u041D\u0410\u0422\u041E (.223 Rem), \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u044F \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u043B\u044E\u0431\u043E\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u0412\u0441\u0435 \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0440\u0438\u0446\u0435\u043B \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u043C \u043A\u0430\u043A \u0434\u043B\u044F \u0437\u0430\u0433\u043E\u043D\u043D\u043E\u0439 \u043E\u0445\u043E\u0442\u044B, \u0442\u0430\u043A \u0438 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0445\u043E\u0442\u044B \u0441 \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u043C \u0438\u043B\u0438 \u0441 \u0437\u0430\u0441\u0430\u0434\u043A\u043E\u0439. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 ELCAN SpecterDR \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u044E\u0442 \u043D\u0435\u0438\u0437\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0440\u0430\u0447\u043A\u0430 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0435 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0446\u0435\u043B\u0438, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0435\u0441\u044F \u043E\u0442 \u0432\u0430\u0441 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u043C \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0438. \u041E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u0432\u0435\u0442\u0430, \u0447\u0442\u043E \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438 \u0441 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u043C \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u043C \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u044F\u044E\u0449\u0435\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C, \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u043D\u044B\u043C \u043D\u0430 \u043B\u0438\u043D\u0437\u044B, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435 \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0435\u043A\u043B\u0430 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442 \u044F\u0440\u043A\u043E\u0435, \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u043E\u0435 \u0441 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u043E\u0439 \u0446\u0432\u0435\u0442\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0435\u0439 \u0431\u0435\u0437 \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u0438\u0439 \u043D\u0430 \u0432\u0441\u0435\u043C \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F. \u041A\u043E\u0440\u043F\u0443\u0441 \u043F\u0440\u0438\u0446\u0435\u043B\u0430 ELCAN SpecterDR \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D \u0438\u0437 \u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u0438 \u0432 \u0442\u043E\u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u043B\u0435\u0433\u043A\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0433\u043E \u043A \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u043C. \u041F\u043E\u043B\u043D\u0430\u044F \u0432\u043E\u0434\u043E\u043D\u0435\u043F\u0440\u043E\u043D\u0438\u0446\u0430\u0435\u043C\u043E\u0441\u0442\u044C \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0430 \u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0445 \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0412\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0430\u043D\u0442\u0438\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u044F \u043D\u0430\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0434\u0435\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043A\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0445\u043E\u0442\u044B \u0432 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443.(\u041F\u0440\u0438\u0446\u0435\u043B \u0438\u043C\u0435\u0435\u0442 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0441\u0432\u0435\u0440\u0445\u0443)."
