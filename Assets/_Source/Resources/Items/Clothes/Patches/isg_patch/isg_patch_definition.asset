  _definitionId: c48dd22cba8e5b54e9707cc9d4cc8217
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \xAB\u0418\u0418\u0413\xBB"
  _shortName: "\u0418\u0418\u0413"
  _description: "\u041D\u0430 \u0434\u0430\u043D\u043D\u043E\u0439 \u043D\u0430\u0448\u0438\u0432\u043A\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D \u0431\u0435\u043B\u044B\u0439 \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F, \u043E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0439 \u0441\u0442\u0438\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043F\u043E\u0434\u043E\u0431\u0438\u0435\u043C \u043B\u0430\u0432\u0440\u043E\u0432\u043E\u0433\u043E \u0432\u0435\u043D\u043A\u0430 - \u0432\u0441\u0451 \u044D\u0442\u043E \u043D\u0430 \u0430\u043B\u043E\u043C \u0444\u043E\u043D\u0435. \u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u043E\u0442 \u043D\u0435\u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430, \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043D\u0430\u0448\u0438\u0432\u043A\u0438 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C, \u0441\u043E\u043E\u0431\u0449\u0430\u044E\u0449\u0430\u044F \u043E \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438 \u043A \xAB\u0418\u043D\u0442\u0435\u0440\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439 \u0413\u0440\u0443\u043F\u043F\u0435 \u043F\u043E\u0434 \u043A\u0440\u044B\u043B\u043E\u043C \u041E\u041E\u041D\xBB."
