  _definitionId: 0481b615bbf011f41ac901426e15fb99
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .338 Lapua Magnum"
  _shortName: .338 Lapua Magnum
  _description: ".338 Lapua Magnum - \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D \u0441 \u0431\u0443\u0442\u044B\u043B\u043E\u0447\u043D\u043E\u0439
    \u0433\u0438\u043B\u044C\u0437\u043E\u0439 \u0431\u0435\u0437 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0435\u0439
    \u0437\u0430\u043A\u0440\u0430\u0438\u043D\u044B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B\u0439
    \u0434\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0445
    \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0445 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445
    \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u0412\u043E\u0439\u043D\u044B
    \u0432 \u0418\u0440\u0430\u043A\u0435 \u0438 \u0410\u0444\u0433\u0430\u043D\u0438\u0441\u0442\u0430\u043D\u0435
    \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u044D\u0442\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0435
    \u0432 \u0431\u043E\u044F\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C\u0438.
    \u0411\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441 .338 Lapua Magnum \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F: \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u0435\u0445\u043E\u0442\u043D\u044B\u0439
    \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0439,
    \u043D\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0439
    \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u0441\u0438\u043B\u044C\u043D\u043E
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>V
    (60)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (308)"
