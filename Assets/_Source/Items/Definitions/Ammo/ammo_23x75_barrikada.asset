  m_Name: ammo_23x75_barrikada
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 06c706ac77fc94c40bf4d1138f29be81
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 23x75 \u043C\u043C \"\u0411\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0430\""
  _shortName: "23x75 \u043C\u043C \"\u0411\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0430\""
  _description: "\u041F\u0430\u0442\u0440\u043E\u043D \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
    \u043E\u0441\u0442\u0440\u043E\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
    \u043F\u0443\u043B\u0435\u0439. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0430\u0432\u0442\u043E\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430
    \u043F\u0443\u0442\u0451\u043C \u0435\u0433\u043E \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
    \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0434\u043E 100 \u043C\u0435\u0442\u0440\u043E\u0432. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0438\u0437
    \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0430 \u041A\u0421-23.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>II
    (22)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (296)"
