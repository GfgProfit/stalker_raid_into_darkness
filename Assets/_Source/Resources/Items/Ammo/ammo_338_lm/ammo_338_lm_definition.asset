  m_Name: ammo_338_lm
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: edd5e6cd5aac0fe4f8a07cf7f6d49530
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .338 Lapua Magnum (8,6x70 \u043C\u043C)"
  _shortName: Lapua
  _description: "\u0424\u0438\u043D\u0441\u043A\u0438\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D .338 Lapua Magnum, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Lapua \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430 .338/416 \u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0432 1989 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0438 \u0441\u0432\u0435\u0440\u0445\u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0438 \u0446\u0435\u043B\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0437\u0430 \u043B\u0451\u0433\u043A\u0438\u043C\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438 \u043F\u0443\u043B\u044F\u043C\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043E\u0442 16,2 \u0434\u043E 19,4 \u0433\u0440\u0430\u043C\u043C\u0430 (250\u2013300 \u0433\u0440\u0430\u043D), \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u044B\u0435 \u043C\u0430\u0442\u0447\u0435\u0432\u044B\u0435, \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u0435 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B. \u0412 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u0441 \u043F\u0443\u043B\u0435\u0439 Scenar \u043C\u0430\u0441\u0441\u043E\u0439 16,2 \u0433\u0440\u0430\u043C\u043C\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 905 \u043C/\u0441, \u0430 \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 6630 \u0414\u0436. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0441\u0441\u0435 \u043F\u0443\u043B\u0438 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0443 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0443 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0441\u0442\u0438\u043B\u044C\u043D\u0443\u044E \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E, \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0435\u0442\u0440\u043E\u0432\u043E\u043C\u0443 \u0441\u043D\u043E\u0441\u0443 \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u0441\u0432\u044B\u0448\u0435 1000 \u043C\u0435\u0442\u0440\u043E\u0432. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E \u0438 .300 Winchester Magnum \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439 \u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430 \u0441\u0432\u0435\u0440\u0445\u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439, \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 Accuracy International AWM, AXMC, Sako TRG-42 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E, \u043C\u043E\u0449\u043D\u044B\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u0434\u043E 1500 \u043C\u0435\u0442\u0440\u043E\u0432 \u0438 \u0431\u043E\u043B\u0435\u0435."
