  _definitionId: 249140b692c64d8e9d447ad242a83005
  _displayName: "\u041C\u0430\u043B\u043E\u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u0421\u0420-3\u041C \xAB\u0412\u0438\u0445\u0440\u044C\xBB"
  _shortName: "\u0421\u0420-3\u041C"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u0430\u043B\u043E\u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9\xD739 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430\u043C\u0438 \u0426\u041D\u0418\u0418\u0442\u043E\u0447\u043C\u0430\u0448 \u043A\u0430\u043A \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0421\u0420-3 \xAB\u0412\u0438\u0445\u0440\u044C\xBB \u043D\u0430 \u0431\u0430\u0437\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0410\u0421 \xAB\u0412\u0430\u043B\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F, \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0430\u043D\u0442\u0438\u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u0448\u043D\u044F, \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C \u0438 \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u043E\u0432\u044B\u043C \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0433\u043D\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435 \u043F\u0430\u0442\u0440\u043E\u043D\u044B 9\xD739 \u043C\u043C \u0421\u041F-5, \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u0435 \u0421\u041F-6 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0421\u0420-3, \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0432\u043B\u0435\u0432\u043E \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u0430\u043C\u043E\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0441\u043A\u043B\u0430\u0434\u043D\u0443\u044E \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0443, \u0431\u043E\u043A\u043E\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u043D\u043E\u0447\u043D\u044B\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432 \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044F. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 10, 20 \u0438 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0410\u0421 \xAB\u0412\u0430\u043B\xBB \u0438 \u0412\u0421\u0421 \xAB\u0412\u0438\u043D\u0442\u043E\u0440\u0435\u0437\xBB. \u0421\u0442\u0432\u043E\u043B \u0434\u043B\u0438\u043D\u043E\u0439 156 \u043C\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u043E\u043A\u043E\u043B\u043E 295 \u043C/\u0441. \u041F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 400 \u043C\u0435\u0442\u0440\u043E\u0432. \u0414\u043B\u0438\u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 675 \u043C\u043C \u0441 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 410 \u043C\u043C \u0441\u043E \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C, \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0438 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044F \u2014 2,2 \u043A\u0433. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0441\u0442\u044C\u044E, \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043E\u0433\u043D\u0435\u0432\u043E\u0439 \u043C\u043E\u0449\u044C\u044E \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432 \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439, \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u043A\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432 \u0438\u043C\u0435\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u0443\u044E \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043F\u0443\u043B\u0438 \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
