  m_Name: merc_fighter_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5f0e196453d0d4a4a9136501e857db8a
  _displayName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \xAB\u0418\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C\xBB"
  _shortName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \xAB\u0418\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C\xBB"
  _description: "\u0410\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u0432\u0435\u0440\u0441\u0438\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u043E\u0433\u043E
    \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438. \xAB\u0418\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C\xBB
    \u0431\u044B\u043B \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D
    \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
    \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0442\u0435\u0440\u043C\u043E\u0437\u0430\u0449\u0438\u0442\u044B,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u043E\u0434\u0443\u043B\u0435\u0439. \u0426\u0435\u043D\u043E\u0439 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0441\u0442\u0430\u043B\u0438
    \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
    \u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u0432 \u0446\u0435\u043B\u043E\u043C.
    \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043C\u043E\u0436\u0435\u0442
    \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C
    \u0441\u0435\u0431\u044F \u0432 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u0445,
    \u0433\u0434\u0435 \u0432\u0430\u0436\u043D\u044B \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0432
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430\u043C\u0438
    \u0438 \u043A\u0438\u043B\u043B\u0435\u0440\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043D\u0430 \u043D\u0430\u0438\u043C\u0435\u043D\u0435\u0435
    \u043E\u0431\u043B\u0443\u0447\u0451\u043D\u043D\u044B\u0445 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F\u0445
    \u0417\u043E\u043D\u044B."
