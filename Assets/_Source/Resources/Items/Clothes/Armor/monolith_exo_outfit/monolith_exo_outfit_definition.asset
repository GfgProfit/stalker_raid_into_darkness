  m_Name: monolith_exo_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 104e567a21dd74e4abe345c091d9e537
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _shortName: EXO
  _description: "\u0412\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0430\u044F \u0431\u0440\u043E\u043D\u044F, \u0441\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430. \u0412 \u0441\u043E\u0441\u0442\u0430\u0432\u0435 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u044B, \u0431\u044B\u043B\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0440\u0430\u043D\u0435\u0435 \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0438 \u0441\u043F\u043B\u0430\u0432\u044B. \u0412\u0434\u043E\u0431\u0430\u0432\u043E\u043A \u043A \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u043C \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u0430\u043C \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437 \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u0442\u0435\u0439: \u044D\u043A\u0437\u043E\u0448\u043B\u0435\u043C, \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C \u0438\u0437 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0442\u043A\u0430\u043D\u0438 \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u0423\u0434\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043D\u043E\u0448\u0435\u043D\u0438\u044F \u044D\u0442\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u0441 \u0442\u0435\u043C, \u043A\u0430\u043A \u0435\u0441\u043B\u0438 \u0431\u044B\u0442\u044C \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D\u043D\u044B\u043C \u043F\u043E\u0434 \u0441\u0430\u043C\u0438\u043C \u0421\u0430\u0440\u043A\u043E\u0444\u0430\u0433\u043E\u043C. \u0422\u0435 \u0436\u0435, \u043A\u043E\u043C\u0443 \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C, \u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0443\u0436\u0430\u0441\u043D\u0443\u044E \u043A\u043B\u0430\u0443\u0441\u0442\u0440\u043E\u0444\u043E\u0431\u0438\u044E, \u0447\u0442\u043E, \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439 \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0441\u043B\u0443\u0433\u0438 \u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430."
