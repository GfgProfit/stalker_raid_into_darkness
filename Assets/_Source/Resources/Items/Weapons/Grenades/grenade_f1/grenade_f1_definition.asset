  m_Name: grenade_f1_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: cd9ab9aae55e9894489abffc723cbe86
  _displayName: "\u0420\u0443\u0447\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0424-1"
  _shortName: "\u0424-1"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u0440\u0443\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u0435\u0445\u043E\u0442\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u0430\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B F-1 \u043E\u0431\u0440\u0430\u0437\u0446\u0430 1915 \u0433\u043E\u0434\u0430 \u0438 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0432 1939 \u0433\u043E\u0434\u0443 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u043E\u043C \u0424. \u0418. \u0425\u0440\u0430\u043C\u0435\u0435\u0432\u044B\u043C. \u0418\u043C\u0435\u0435\u0442 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u043B\u0438\u0442\u043E\u0439 \u0447\u0443\u0433\u0443\u043D\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u044F\u0439\u0446\u0435\u0432\u0438\u0434\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u044B\u043C\u0438 \u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u043C\u0438 \u0431\u043E\u0440\u043E\u0437\u0434\u0430\u043C\u0438, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u043D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u043B\u0438\u043C\u043E\u043D\u043A\u0430\xBB. \u041C\u0430\u0441\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 600 \u0433. \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u043C \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u0438, \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0449\u0438\u0435\u0441\u044F \u043F\u0440\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0438 \u0447\u0443\u0433\u0443\u043D\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0437\u0430\u043F\u0430\u043B\u043E\u043C \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0420\u0413\u0414-5, \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0437\u043B\u0451\u0442\u0430 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0447\u0435\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F. \u0428\u0438\u0440\u043E\u043A\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u043B\u0430\u0441\u044C \u0432 \u0433\u043E\u0434\u044B \u0412\u0435\u043B\u0438\u043A\u043E\u0439 \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0432\u043E\u0439\u043D\u044B. \u041F\u0440\u043E\u0441\u0442\u043E\u0442\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0438 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u043B\u0438 \u0435\u0451 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u0441\u0438\u043B\u0430\u0445 \u0421\u0421\u0421\u0420, \u0420\u043E\u0441\u0441\u0438\u0438 \u0438 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445 \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043D\u044B\u0445 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432."
