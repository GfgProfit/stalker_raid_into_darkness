  m_Name: wpn_fn2000_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: a8f10567ddb53d9449e8c2958ec53bf2
  _displayName: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 FN F2000"
  _shortName: FN F2000
  _description: "\u0411\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u0430\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 \u043F\u043E\u0434 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 5,56\xD745 \u043C\u043C NATO, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 FN Herstal \u0432 1990-\u0445 \u0433\u043E\u0434\u0430\u0445 \u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u0432 2001 \u0433\u043E\u0434\u0443. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430 \u043F\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0431\u0443\u043B\u043B-\u043F\u0430\u043F, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u0440\u0438 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0445 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u0445 \u043E\u0440\u0443\u0436\u0438\u044F. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043E\u0442\u0432\u043E\u0434\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0445\u043E\u0434\u043E\u043C \u0433\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u0440\u0448\u043D\u044F \u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C. \u0421\u0442\u0432\u043E\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u2014 \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u044B\u0431\u0440\u043E\u0441\u0430 \u0441\u0442\u0440\u0435\u043B\u044F\u043D\u044B\u0445 \u0433\u0438\u043B\u044C\u0437 \u0432\u043F\u0435\u0440\u0451\u0434 \u0447\u0435\u0440\u0435\u0437 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0430\u043D\u0430\u043B, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0430\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441 \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u043B\u0435\u0447\u0430 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043E\u0440\u0443\u0436\u0438\u044F. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 400 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 688 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u043D\u0435\u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u2014 3,6 \u043A\u0433. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C\u044B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C 850 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 STANAG \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0412 \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430\u0446\u0438\u0438 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438 1,6\xD7, \u0440\u0430\u0437\u043C\u0435\u0449\u0451\u043D\u043D\u044B\u043C \u043F\u043E\u0434 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043A\u043E\u0436\u0443\u0445\u043E\u043C, \u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438. \u041C\u043E\u0434\u0443\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430 FN GL1."
