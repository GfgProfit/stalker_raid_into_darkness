  m_Name: kit_hunt
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 9ce1e5491e9c32c4db51ac4af8f9e155
  _displayName: "\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430-\u0440\u044E\u043A\u0437\u0430\u043A \xAB\u0422\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0435\u0440\xBB"
  _shortName: "\u0422\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0435\u0440"
  _description: "\u041C\u043D\u043E\u0433\u043E\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430-\u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0435\u0440, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043A\u0438 \u043B\u0438\u0447\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0439, \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F, \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0435\u0451 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0438 \u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0433\u043E \u0440\u044E\u043A\u0437\u0430\u043A\u0430 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C \u043F\u043B\u0435\u0447\u0435\u0432\u044B\u043C \u0440\u0435\u043C\u043D\u044F\u043C \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0440\u0443\u0447\u043A\u0430\u043C. \u0418\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0437 \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0439 \u0442\u043A\u0430\u043D\u0438, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0439 \u043D\u0430 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u0443\u044E \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u0438 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438. \u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u043C\u0430\u043D\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043C\u0435\u043B\u043A\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u0413\u0438\u0431\u043A\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043E\u0431\u043B\u0435\u0433\u0447\u0430\u0435\u0442 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043F\u0443\u0441\u0442\u0443\u044E \u0441\u0443\u043C\u043A\u0443 \u0434\u043B\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438 \u043C\u0435\u0441\u0442\u0430. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0435, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u0435 \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0443 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0432\u044B\u043B\u0430\u0437\u043E\u043A \u0432 \u0417\u043E\u043D\u0443, \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043A\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u0442\u0440\u043E\u0444\u0435\u0435\u0432. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E \u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438, \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0443 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0443\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0440\u0435\u0439\u0434\u043E\u0432\u044B\u043C \u0440\u044E\u043A\u0437\u0430\u043A\u0430\u043C."
