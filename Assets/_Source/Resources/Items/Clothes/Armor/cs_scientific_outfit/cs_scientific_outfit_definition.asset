  _definitionId: 17c1fbeb55aca5f43a076ae1cb5aa4f3
  _displayName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0427\u041D-4\u0430"
  _shortName: HEAVY
  _description: "\u041D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0421\u0415\u0412\u0410\xBB \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445 \u0433\u0440\u0443\u043F\u043F \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB, \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u0430\u044F \u0432 \u0417\u043E\u043D\u0443 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u0430\u043C\u0438. \u0412\u0441\u0451 \u0435\u0449\u0451 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0430 \u0437\u0430\u043F\u0430\u0445 \u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0437\u0435\u043C\u043B\u0438. \u0418\u043C\u0435\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438, \u043D\u043E \u0432 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C - \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0445\u0443\u0436\u0435 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438 \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0430."
