  m_Name: acog
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 47f9977e8eb796245ab8518ef902a33e
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B ACOG 3.5x"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B ACOG 3.5x"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C>\u0432\u0441\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438
    \u041D\u0410\u0422\u041E\n\n<color=#AAAAAA>\u0421\u044A\u0451\u043C\u043D\u044B\u0439
    \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B,
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A \u0441\u0442\u0440\u0430\u043D
    \u041D\u0410\u0422\u041E. ACOG \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043A\u0430\u043A Advanced Combat Optical Gunsight \u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0443 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0445
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Trijicon. \u041F\u0440\u0438\u0446\u0435\u043B\u044B
    \u044D\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043F\u043B\u0430\u043D\u043A\u0443 \xAB\u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438\xBB
    \u0438 \u0438\u043C\u0435\u044E\u0442 \u0442\u0440\u0438\u0442\u0438\u0435\u0432\u0443\u044E
    \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443. \u0414\u0430\u043D\u043D\u044B\u0439
    \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0441 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u043A\u043E\u0439 USMC \u0438 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C\u044E
    3.5\u0445.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435:
    <color=#AAAAAA>3.5x\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435:
    <color=#AAAAAA>\u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0422\u0438\u043F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u043A\u0438: <color=#AAAAAA>USMC"
