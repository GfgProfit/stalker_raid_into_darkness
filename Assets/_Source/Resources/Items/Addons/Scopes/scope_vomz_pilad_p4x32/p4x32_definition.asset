  m_Name: p4x32
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: b0e5637f4426a474c93c2d2bf6ddccb8
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0412\u041E\u041C\u0417 \xAB\u041F\u0438\u043B\u0430\u0434\xBB P4x32"
  _shortName: "\u041F\u0438\u043B\u0430\u0434"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0412\u043E\u043B\u043E\u0433\u043E\u0434\u0441\u043A\u0438\u043C \u043E\u043F\u0442\u0438\u043A\u043E-\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C (\u0412\u041E\u041C\u0417) \u043F\u043E\u0434 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 \xAB\u041F\u0438\u043B\u0430\u0434\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0438 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u044B \u0438 \u0434\u0440\u0443\u0433\u043E\u0435 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0435 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 32-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C \u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F\u0445, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u0435\u0441\u0442\u0438\u0435, Mil-Dot, \xAB\u043F\u0435\u043D\u0451\u043A\xBB \u0438 \u043F\u0430\u0440\u0430\u0431\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0443. \u0411\u0430\u0437\u043E\u0432\u0430\u044F \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442 \u0432\u0435\u0440\u0441\u0438\u0438 \u0441 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438. \u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F 6\xB0, \u0447\u0442\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 10,5 \u043C\u0435\u0442\u0440\u0430 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 100 \u043C\u0435\u0442\u0440\u043E\u0432. \u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u044B\u0432\u0435\u0440\u043A\u0438 \u0438\u043C\u0435\u044E\u0442 \u0446\u0435\u043D\u0443 \u0434\u0435\u043B\u0435\u043D\u0438\u044F 1/4 MOA. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043E\u0442 \u0432\u043B\u0430\u0433\u0438 \u0438 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0445 \u043E\u0442 \u221240 \u0434\u043E +50 \xB0C. \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0443\u0431\u043A\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 25,4 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u2014 270 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u2014 \u043E\u043A\u043E\u043B\u043E 300 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C\u044E \u043A \u043E\u0442\u0434\u0430\u0447\u0435 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
