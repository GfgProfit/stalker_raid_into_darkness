  m_Name: army_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 01bb7c1ff634b8f4aae6b7e1717bde90
  _displayName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442"
  _shortName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442"
  _description: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F
    \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u0432 \u0417\u043E\u043D\u0435, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C
    \u0431\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0430\u0448\u0438\u043D\u044B, \u0438\u0437-\u0437\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u0435\u043D\u0434\u0435\u0440
    \u043D\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443 \u043B\u0443\u0447\u0448\u0435\u0433\u043E
    \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0434\u043B\u044F
    \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445
    \u0432 \u0417\u043E\u043D\u0435 \u043E\u0442\u043E\u0448\u0451\u043B \u043A \u0441\u0430\u043C\u043E\u043C\u0443
    \u0434\u0435\u0448\u0451\u0432\u043E\u043C\u0443 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044E.
    \u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0431\u043E\u043B\u0435\u0435-\u043C\u0435\u043D\u0435\u0435
    \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043E\u0442 \u0443\u043A\u0443\u0441\u043E\u0432
    \u0438 \u0443\u0434\u0430\u0440\u043E\u0432 \u0441\u043B\u0430\u0431\u044B\u0445
    \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432. \u0412 \u0446\u0435\u043B\u043E\u043C,
    \u043E\u043D \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C \u043B\u0443\u0447\u0448\u0435
    \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u043A\u0443\u0440\u0442\u043E\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u043E\u0441\u044F\u0442 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u044B-\u043D\u043E\u0432\u0438\u0447\u043A\u0438,
    \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u043C\u043D\u043E\u0433\u043E\u043C."
