  m_Name: wpn_usp_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: adc639cabc58a5e438fedc34990eddea
  _displayName: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 Heckler & Koch USP45 Compact"
  _shortName: USP45C
  _description: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D .45 ACP (11,43x23 \u043C\u043C), \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Heckler & Koch \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u043E\u0441\u0435\u043D\u044C\u044E 1997 \u0433\u043E\u0434\u0430. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0443\u044E \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044E \u043F\u043E\u043B\u043D\u043E\u0440\u0430\u0437\u043C\u0435\u0440\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 USP45 (Universelle Selbstladepistole), \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0443\u044E \u0434\u043B\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u044B\u043D\u043A\u0430. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0445\u043E\u0434\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430 \u043F\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0411\u0440\u0430\u0443\u043D\u0438\u043D\u0433\u0430. \u0412 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA). \u0420\u0430\u043C\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0430\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0435\u043A\u043B\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u043E\u043C \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430, \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u2014 \u0438\u0437 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441 \u0430\u043D\u0442\u0438\u043A\u043E\u0440\u0440\u043E\u0437\u0438\u043E\u043D\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0431\u0443\u0444\u0435\u0440\u043D\u044B\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0441 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C \u0434\u0435\u043C\u043F\u0444\u0435\u0440\u043E\u043C \u043E\u0442\u0434\u0430\u0447\u0438, \u0440\u0443\u0447\u043D\u043E\u0439 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0441 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u043F\u0443\u0441\u043A\u0430 \u043A\u0443\u0440\u043A\u0430, \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044E\u044E \u0437\u0430\u0449\u0451\u043B\u043A\u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443 \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 96 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u2014 180 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 800 \u0433. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 8 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0441 \u0442\u0440\u0435\u043C\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u043C\u0438 \u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u0438 \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u043E\u0439 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439 HK \u0434\u043B\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043F\u043E\u043B\u043D\u043E\u0440\u0430\u0437\u043C\u0435\u0440\u043D\u044B\u043C USP45 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u043C\u0438, \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430."
