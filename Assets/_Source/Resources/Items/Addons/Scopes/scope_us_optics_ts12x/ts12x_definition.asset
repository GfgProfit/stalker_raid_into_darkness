  m_Name: ts12x
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3692a31afb1686341add931beeea3d2c
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B U.S. Optics TS-12X 3\u201312\xD744"
  _shortName: TS-12X
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 3\xD7 \u0434\u043E 12\xD7, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 U.S. Optics \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0438\u0445, \u043C\u0430\u0440\u043A\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0445 \u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 44-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C \u0438 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0441 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u043C \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u0435\u043D\u0438\u0435\u043C \u043B\u0438\u043D\u0437, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u044C \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u0441\u0432\u0435\u0442\u043E\u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u0435. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0441 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 MHR, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0439 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u0444\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 (FFP), \u043B\u0438\u0431\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 Triplex \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0444\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 (SFP). \u0412 \u0432\u0435\u0440\u0441\u0438\u0438 FFP \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438 \u0441\u0435\u0442\u043A\u0430 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0443\u0433\u043B\u043E\u0432\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F \u043F\u043E\u043F\u0440\u0430\u0432\u043E\u043A. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430\u043C\u0438 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u044B\u0432\u0435\u0440\u043A\u0438 \u0441 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0438 \u0438 \u0446\u0435\u043D\u043E\u0439 \u0434\u0435\u043B\u0435\u043D\u0438\u044F 0,1 MIL, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u043F\u0430\u0440\u0430\u043B\u043B\u0430\u043A\u0441\u0430 \u043E\u0442 10 \u044F\u0440\u0434\u043E\u0432 \u0434\u043E \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430 \u0441 \u0447\u0451\u0440\u043D\u044B\u043C \u0430\u043D\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C. \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0443\u0431\u043A\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 30 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u2014 244 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 513 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0432\u0435\u0441\u043E\u043C \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u043E\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
