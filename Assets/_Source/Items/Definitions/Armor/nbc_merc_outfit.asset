  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: nbc_merc_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 60557825c96354c48811474d8c0cbe7e
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417
    \u041D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417
    \u041D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _description: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417
    (\u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439, \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0438 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B) \u0441 \u0436\u0438\u043B\u0435\u0442\u043E\u043C
    \u0438\u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438,
    \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u043C\u0438
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B.
    \u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B
    \u043C\u0430\u0441\u0441\u043E\u0432\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0442\u0441\u044F
    \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0430\u0445 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438
    \u0417\u043E\u043D\u044B \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F\u0445
    \u0438 \u043F\u0440\u0438 \u043B\u0438\u043A\u0432\u0438\u0434\u0430\u0446\u0438\u0438
    \u0442\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0445 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444.
    \u0418\u0434\u0451\u0442 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435
    \u0441 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u043E\u043C
    \u0413\u041F-5, \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u043C
    \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0441 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438
    \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u043C\u0438. \u0425\u043E\u0442\u044C
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0438 \u043D\u0435
    \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0441 \u0443\u0447\u0451\u0442\u043E\u043C
    \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u043A \u0417\u043E\u043D\u044B, \u0430
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0430 \u0435\u0449\u0451
    \u0438 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0435\u0433\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u0435, \u043E\u043D \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
    \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C\u044E
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0441\u0432\u043E\u0435\u0439
    \u043F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435
    \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0432\u0435\u0441\u0430."
