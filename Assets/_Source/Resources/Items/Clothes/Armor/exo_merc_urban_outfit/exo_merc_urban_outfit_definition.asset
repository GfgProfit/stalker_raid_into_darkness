  m_Name: exo_merc_urban_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 8825169c4d93abe4b9b79eb9bbb6f534
  _displayName: "\u0422\u0411-1 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432 \xAB\u0413\u043E\u0440\u043E\u0434\xBB"
  _shortName: HEAVY
  _description: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432, \u043F\u043E \u0441\u0443\u0442\u0438, \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u043C\u0441\u044F \u043F\u043E\u0434\u0434\u043E\u0441\u043F\u0435\u0448\u043D\u0438\u043A\u043E\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430. \u041F\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u043C \u0441\u0445\u043E\u0436 \u0441 \u043E\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432 \u0438 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u0441\u0438\u043B\u044B. \u0421 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043E\u043D \u0431\u043E\u043B\u0435\u0435 \u0434\u0435\u0448\u0451\u0432 \u0432 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438 \u0438 \u043D\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0431\u0435\u0433\u0430 \u0432 \u043D\u0451\u043C.\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0443\u0441\u043F\u0435\u0445\u043E\u043C \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u043E\u0432 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0438 \u0442\u0435\u043B\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u0439, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u0432\u043E\u0438\u0445 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u0432 \u041B\u0438\u043C\u0430\u043D\u0441\u043A\u0435 \u0438\u043B\u0438 \u041F\u0440\u0438\u043F\u044F\u0442\u0438."
