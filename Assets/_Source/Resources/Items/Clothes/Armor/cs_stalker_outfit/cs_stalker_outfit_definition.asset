  m_Name: cs_stalker_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: b3528743a440a6847966e90c440bc2e8
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0427\u041D-2\u0431"
  _shortName: MEDIUM
  _description: "\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u0434\u0440\u0443\u0433\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u0435\u0440\u0438\u0438 \u0427\u041D, \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0427\u041D-2\u0431 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0447\u0430\u043B\u044C\u043D\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0440\u044B\u0432\u0430 \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB \u043A \u0427\u0410\u042D\u0421, \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u043E\u0433\u0438\u0431\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0447\u043B\u0435\u043D\u043E\u0432 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0437\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0435\u043C\u043D\u0438\u043A\u043E\u043C \u0427\u041D-1, \u0442\u0430\u043A \u043A\u0430\u043A \u0432 \u043C\u043E\u0434\u0435\u043B\u0438 2\u0431 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442 \u0431\u044B\u043B \u043E\u0442\u0434\u0430\u043D \u0437\u0430\u0449\u0438\u0442\u0435 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u043E\u0442 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u043D\u0435\u0436\u0435\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u0435 \u0432 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0430\u0445. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0430\u0434\u0435\u043A\u0432\u0430\u0442\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043A\u0430\u043A \u043F\u0440\u043E\u0442\u0438\u0432 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0442\u0430\u043A \u0438 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u0417\u043E\u043D\u044B."
