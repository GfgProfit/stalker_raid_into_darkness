  m_Name: bandit_patch
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c72208606a6c0824f8da1a06b7832279
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
  _shortName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
  _description: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0432 \u0432\u0438\u0434\u0435 \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u043E\u0433\u043E \u0447\u0435\u0440\u0435\u043F\u0430 \u043D\u0430 \u0444\u043E\u043D\u0435 \u0431\u0435\u043B\u043E\u0433\u043E \u0449\u0438\u0442\u0430. \u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u0441\u0438\u043C\u0432\u043E\u043B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0438\u0434\u0435\u043D\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043B\u0438\u0434\u0435\u0440\u044B \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u0438\u0440\u0430 \u0417\u043E\u043D\u044B - \u0447\u0442\u043E \u043E\u043D\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u043E\u043B\u043E\u0432\u043E\u0440\u0435\u0437\u044B, \u0430 \u0445\u043E\u0437\u044F\u0435\u0432\u0430 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u043D\u0430\u0432\u043E\u0434\u044F\u0449\u0438\u0435 \u0441\u0432\u043E\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u044B\u043C, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435 \xAB\u0437\u0430\u0449\u0438\u0442\u0443\xBB \u0442\u0435\u043C, \u043A\u0442\u043E \u0433\u043E\u0442\u043E\u0432 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043C, \u0438 \u0432\u0435\u0440\u0448\u0430\u0449\u0438\u0445 \u0431\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E\u0435 \u0432\u043E\u0437\u043C\u0435\u0437\u0434\u0438\u0435 \u043B\u044E\u0431\u043E\u043C\u0443, \u043A\u0442\u043E \u043F\u043E\u0441\u043C\u0435\u0435\u0442 \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0438\u043C \u0432\u044B\u0437\u043E\u0432."
