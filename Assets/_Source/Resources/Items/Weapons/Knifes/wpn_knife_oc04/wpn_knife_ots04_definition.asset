  m_Name: wpn_knife_ots04_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3f003e06ca6b7f644abdcca4690baf8f
  _displayName: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043D\u043E\u0436 \u041E\u0426-04"
  _shortName: "\u041E\u0426-04"
  _description: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043D\u043E\u0436, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 \u043A\u043E\u043D\u0446\u0435 1980-\u0445 \u2014 \u043D\u0430\u0447\u0430\u043B\u0435 1990-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0442\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0431\u044E\u0440\u043E \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F (\u0426\u041A\u0418\u0411 \u0421\u041E\u041E) \u0434\u043B\u044F \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445 \u0432\u043E\u0439\u0441\u043A \u041C\u0412\u0414. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C \u043A\u043E\u043F\u044C\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u0441 \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439 \u0437\u0430\u0442\u043E\u0447\u043A\u043E\u0439, \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u043D\u044B\u043C \u0444\u0430\u043B\u044C\u0448\u043B\u0435\u0437\u0432\u0438\u0435\u043C \u0432 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043E\u0431\u0443\u0445\u0430 \u0438 \u0434\u0432\u0443\u0445\u0440\u044F\u0434\u043D\u043E\u0439 \u043F\u0438\u043B\u043E\u0439 \u0441 \u043C\u0435\u043B\u043A\u0438\u043C\u0438 \u0437\u0443\u0431\u044C\u044F\u043C\u0438. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043D\u043E\u0436\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 310 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u043A\u043B\u0438\u043D\u043A\u0430 \u2014 195 \u043C\u043C, \u0448\u0438\u0440\u0438\u043D\u0430 \u2014 30 \u043C\u043C, \u0442\u043E\u043B\u0449\u0438\u043D\u0430 \u043E\u0431\u0443\u0445\u0430 \u2014 7 \u043C\u043C. \u0421\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u0430\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430, \u0438\u043C\u0435\u0435\u0442 \u043A\u0440\u0443\u043F\u043D\u043E\u0435 \u0440\u0438\u0444\u043B\u0435\u043D\u0438\u0435 \u0438 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044E\u044E \u0433\u0430\u0440\u0434\u0443, \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0443\u044E \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u043D\u0438\u0435 \u043A\u0438\u0441\u0442\u0438 \u043D\u0430 \u043A\u043B\u0438\u043D\u043E\u043A. \u0412 \u043D\u0430\u0432\u0435\u0440\u0448\u0438\u0438 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0434\u043B\u044F \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0442\u0435\u043C\u043B\u044F\u043A\u0430. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043D\u043E\u0436\u043D\u0430\u043C\u0438 \u0441 \u043F\u043E\u0434\u043F\u0440\u0443\u0436\u0438\u043D\u0435\u043D\u043D\u044B\u043C \u0444\u0438\u043A\u0441\u0430\u0442\u043E\u0440\u043E\u043C \u0438 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438 \u043A\u043E\u0436\u0430\u043D\u044B\u043C\u0438 \u0440\u0435\u043C\u0435\u0448\u043A\u0430\u043C\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u043D\u0430 \u043F\u043E\u044F\u0441\u0435 \u0438 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0437\u0430\u0434\u0430\u0447."
