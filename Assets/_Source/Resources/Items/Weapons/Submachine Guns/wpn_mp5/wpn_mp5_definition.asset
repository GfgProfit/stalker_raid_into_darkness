  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_mp5_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 4cd2a00bef5c93d4c9b75259fb1817a6
  _displayName: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 Heckler & Koch MP5"
  _shortName: H&K MP5
  _description: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442-\u043F\u0443\u043B\u0435\u043C\u0451\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x19 \u043C\u043C Parabellum, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Heckler & Koch \u0432 1964 \u0433\u043E\u0434\u0443 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 HK G3. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u0438\u043C\u0435\u043B \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u0435 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 HK54, \u0432 1966 \u0433\u043E\u0434\u0443 \u0431\u044B\u043B \u043F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u0438\u0446\u0438\u0438 \u0438 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0439 \u0441\u043B\u0443\u0436\u0431\u044B \u0424\u0420\u0413 \u043F\u043E\u0434 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C MP5 (Maschinenpistole 5). \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u043E\u043B\u0443\u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0430 \u0441 \u0440\u043E\u043B\u0438\u043A\u043E\u0432\u044B\u043C \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435\u043C, \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0430 \u0432\u0435\u0434\u0451\u0442\u0441\u044F \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0430. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C, \u0430 \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u0445 \u2014 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u044F\u043C\u0438 \u043F\u043E \u0442\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430. \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0435\u043C\u043F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 800 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u0421\u0442\u0432\u043E\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0448\u0442\u0430\u043C\u043F\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u0438, \u0446\u0435\u0432\u044C\u0451 \u0438 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u0430\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u2014 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0438\u0437 \u0443\u0434\u0430\u0440\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430. \u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 225 \u043C\u043C. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 15 \u0438\u043B\u0438 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0432 \u0432\u0438\u0434\u0435 \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u043E\u0439 \u043C\u0443\u0448\u043A\u0438 \u0438 \u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u0438\u043E\u043F\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0446\u0435\u043B\u0438\u043A\u0430. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C \u0438\u043B\u0438 \u0432\u044B\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043A\u0443\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043B\u0430\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0438. \u041F\u043E\u043B\u0443\u0447\u0438\u043B \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0445, \u0430\u043D\u0442\u0438\u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043C\u0438\u0440\u0443."
