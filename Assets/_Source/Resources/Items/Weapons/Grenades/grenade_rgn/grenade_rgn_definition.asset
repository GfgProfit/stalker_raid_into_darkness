  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: grenade_rgn_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7fe4f5ce5b4f63643890ee48cbf1bddc
  _displayName: "\u0420\u0443\u0447\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0420\u0413\u041D"
  _shortName: "\u0420\u0413\u041D"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u0440\u0443\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u0435\u0445\u043E\u0442\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0443\u0434\u0430\u0440\u043D\u043E-\u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u0443\u0447\u043D\u043E-\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\u043C \xAB\u0411\u0430\u0437\u0430\u043B\u044C\u0442\xBB \u0432 \u043A\u043E\u043D\u0446\u0435 1970-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u0430\u044F \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0432 1981 \u0433\u043E\u0434\u0443. \u0421\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0431\u043E\u043B\u0435\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u044B \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u0435 \u0420\u0413\u0414-5. \u0418\u043C\u0435\u0435\u0442 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437 \u0434\u0432\u0443\u0445 \u043F\u043E\u043B\u0443\u0441\u0444\u0435\u0440 \u0441 \u0433\u043B\u0430\u0434\u043A\u043E\u0439 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E. \u041C\u0430\u0441\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 310 \u0433, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 60 \u043C\u043C. \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u043C\u0438 \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C\u0438 \u0444\u0430\u043A\u0442\u043E\u0440\u0430\u043C\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043E\u0441\u043A\u043E\u043B\u043A\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0438 \u0443\u0434\u0430\u0440\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u0420\u0413\u041D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u043D\u043E-\u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u043B\u0430 \u0423\u0414\u0417, \u043E\u0431\u0449\u0435\u0433\u043E \u0441 \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0439 \u0420\u0413\u041E. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430 \u0432\u043C\u0435\u0441\u0442\u043E \u0441\u0442\u0430\u043B\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u043C\u0430\u0441\u0441\u0443 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0449\u0438\u0445\u0441\u044F \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0442\u044C \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438\u0445 \u0440\u0430\u0437\u043B\u0451\u0442\u0430. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0420\u0413\u041E \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u043E\u0431\u0449\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u043C\u0435\u043D\u0435\u0435 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C. \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0420\u043E\u0441\u0441\u0438\u0438 \u0438 \u0440\u044F\u0434\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432 \u043F\u043E\u0441\u0442\u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430."
