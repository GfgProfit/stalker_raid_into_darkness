  m_Name: ammo_12x70_buck
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7df1b314a51042f4686949594cf6b6e7
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12x70 \xAB\u041A\u0430\u0440\u0442\u0435\u0447\u044C\xBB"
  _shortName: "\u041A\u0430\u0440\u0442\u0435\u0447\u044C"
  _description: "\u0413\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 12-\u0433\u043E \u043A\u0430\u043B\u0438\u0431\u0440\u0430 \u0441 \u043A\u0430\u0440\u0442\u0435\u0447\u043D\u044B\u043C \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u043C, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043A\u0430\u0440\u0442\u0435\u0447\u0438\u043D\u0430\u043C\u0438, \u0440\u0430\u0437\u043C\u0435\u0449\u0451\u043D\u043D\u044B\u043C\u0438 \u0432 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u043E\u0439 \u0433\u0438\u043B\u044C\u0437\u0435 \u0434\u043B\u0438\u043D\u043E\u0439 70 \u043C\u043C \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u043F\u044B\u0436\u0430 \u0438\u043B\u0438 \u043F\u044B\u0436\u0430-\u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0438 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u043A\u0430\u0440\u0442\u0435\u0447\u0438\u043D \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442 5,6 \u0434\u043E 8,6 \u043C\u043C, \u0430 \u043E\u0431\u0449\u0430\u044F \u043C\u0430\u0441\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0434\u0430 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 28\u201336 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043A\u0430\u0440\u0442\u0435\u0447\u0438 \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 380\u2013430 \u043C/\u0441. \u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u043A\u0430\u0440\u0442\u0435\u0447\u0438\u043D\u044B \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F \u0441\u043D\u043E\u043F \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439 \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C \u0446\u0435\u043B\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F\u043C\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E. \u041D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u043E \u043C\u0435\u0440\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u0438\u0437-\u0437\u0430 \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u043D\u0438\u044F \u043A\u0430\u0440\u0442\u0435\u0447\u0438 \u0438 \u043F\u043E\u0442\u0435\u0440\u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043C\u0435\u043B\u043A\u043E\u0439 \u0434\u0440\u043E\u0431\u044C\u044E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043A\u0430\u0440\u0442\u0435\u0447\u0438\u043D, \u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0438\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u043C\u043F\u043E\u0432\u044B\u0445, \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0445 \u0438 \u0434\u0432\u0443\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0440\u0443\u0436\u044C\u044F\u0445 12-\u0433\u043E \u043A\u0430\u043B\u0438\u0431\u0440\u0430 \u0441 \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u0438\u043A\u043E\u043C, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u043C \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u0433\u0438\u043B\u044C\u0437\u044B. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E, \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
