  m_Name: ammo_11.43x23_fmj
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 36cd6c3dec18660488edfb31fd3936f6
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .45 ACP (11,43x23 \u043C\u043C) FMJ"
  _shortName: FMJ
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 .45 ACP (11,43x23 \u043C\u043C) \u0441 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 FMJ, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0414\u0436\u043E\u043D\u0430 \u0411\u0440\u0430\u0443\u043D\u0438\u043D\u0433\u0430 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0438\u0439 \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u044F \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 Colt M1911 \u0432 1911 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 14,9 \u0433\u0440\u0430\u043C\u043C\u0430 (230 \u0433\u0440\u0430\u043D) \u0441\u043E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u0437\u0430\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C \u0432 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 250\u2013270 \u043C/\u0441, \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u2014 \u043E\u043A\u043E\u043B\u043E 470\u2013540 \u0414\u0436 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0438 \u0434\u043B\u0438\u043D\u044B \u0441\u0442\u0432\u043E\u043B\u0430. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u0435 \u0438 \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u0443 \u043F\u0443\u043B\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u043C \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043A\u0440\u0443\u0442\u043E\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043F\u043E\u043B\u0451\u0442\u0430. \u0414\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0430\u0442\u0440\u043E\u043D \u0432 \u043E\u0440\u0443\u0436\u0438\u0438 \u0441 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u043C. \u041E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0432 \u043C\u044F\u0433\u043A\u0438\u0435 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445 Colt M1911, HK USP .45, FNX-45, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 HK UMP45 \u0438 Thompson. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u043C \u0440\u0430\u0431\u043E\u0447\u0438\u043C \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C, \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0440\u0435\u0434\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432."
