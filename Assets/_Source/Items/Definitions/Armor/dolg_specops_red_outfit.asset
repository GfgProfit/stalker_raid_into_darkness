  _definitionId: 55c8002d20a8627419c5457f8fde5c4f
  _displayName: "\u041F\u0421\u0417-\u04112 \xAB\u0412\u0438\u0442\u044F\u0437\u044C\xBB"
  _shortName: "\u041F\u0421\u0417-\u04112 \xAB\u0412\u0438\u0442\u044F\u0437\u044C\xBB"
  _description: "\u0411\u044B\u0432\u0448\u0438\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u043D\u044B\u0445 \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u0430\u044F \u0431\u043E\u0439\u0446\u0430\u043C\u0438 \xAB\u0414\u043E\u043B\u0433\u0430\xBB. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0443\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u0432 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445, \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C \u0431\u043E\u0435\u0432\u044B\u043C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u043E\u043C. \u041F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0440\u0435\u0434\u0438 \u0432\u0435\u0442\u0435\u0440\u0430\u043D\u043E\u0432 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0447\u0438\u0442\u0430\u044E\u0442, \u0447\u0442\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u043D\u0438\u0432\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043E\u043F\u044B\u0442\u043E\u043C \u0438 \u043D\u0430\u043C\u0451\u0442\u0430\u043D\u043D\u044B\u043C \u0433\u043B\u0430\u0437\u043E\u043C, \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0449\u0438\u043C\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439 \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u044F \u043A \u043D\u0438\u043C."
