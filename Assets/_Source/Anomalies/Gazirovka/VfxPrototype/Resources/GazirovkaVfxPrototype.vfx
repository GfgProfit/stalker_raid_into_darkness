  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966679753}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966679815}
  - {fileID: 114350483966679816}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966679814}
  m_BlockName: Apply source curves and constraints
  m_HLSLCode: "void UpdateGazirovka3(inout VFXAttributes attributes, in VFXSampler2D curves, in float stepTime)\r\n{\r\n    float u = (saturate(attributes.age / attributes.lifetime) * 255.0f + 0.5f) / 256.0f;\r\n    float4 sizeAndAngular = SampleTexture(curves, float2(u, 0.2384615f), 0.0f);\r\n    float3 linearVelocity = SampleTexture(curves, float2(u, 0.2538462f), 0.0f).xyz;\r\n    float4 sizeAndAngularMax = SampleTexture(curves, float2(u, 0.2692308f), 0.0f);\r\n    float3 linearVelocityMax = SampleTexture(curves, float2(u, 0.2846154f), 0.0f).xyz;\r\n    uint particleSeed = attributes.seed;\r\n    float sizeChoice = ToFloat01(AnotherHash(particleSeed ^ 8293u));\r\n    float spinChoice = ToFloat01(AnotherHash(particleSeed ^ 72103u));\r\n    float3 velocityChoice = float3(ToFloat01(AnotherHash(particleSeed ^ 987823u)), ToFloat01(AnotherHash(particleSeed ^ 76447u)), ToFloat01(AnotherHash(particleSeed ^ 98117u)));\r\n    sizeAndAngular = lerp(sizeAndAngular, sizeAndAngularMax, float4(sizeChoice, sizeChoice, sizeChoice, spinChoice));\r\n    linearVelocity = lerp(linearVelocity, linearVelocityMax, velocityChoice);\r\n    float4 tint = SampleTexture(curves, float2(u, 0.3f), 0.0f);\r\n    attributes.scaleX = sizeAndAngular.x;\r\n    attributes.scaleY = sizeAndAngular.y;\r\n    attributes.angularVelocityZ = sizeAndAngular.w;\r\n    attributes.color = tint.rgb;\r\n    attributes.alpha = tint.a;\r\n    uint seed = attributes.seed ^ (uint)(attributes.age * 100000.0f);\r\n    float3 forceSample = float3(ToFloat01(AnotherHash(seed ^ 16411u)), ToFloat01(AnotherHash(seed ^ 7669u)), ToFloat01(AnotherHash(seed ^ 583679u)));\r\n    attributes.gazirovkaForceVelocity += stepTime * lerp(float3(-2.0f, -1.7f, -2.0f), float3(2.0f, 2.3f, 2.0f), forceSample);\r\n    linearVelocity += attributes.gazirovkaForceVelocity;\r\n    attributes.velocity = linearVelocity;\r\n    if (all(abs(attributes.position + linearVelocity * stepTime - float3(0.0f, -1.5f, 0.0f)) <= float3(4.0f, 1.5f, 4.0f)))\r\n    {\r\n        attributes.alive = false;\r\n    }\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: UpdateGazirovka3
    selectedIndex: 0
