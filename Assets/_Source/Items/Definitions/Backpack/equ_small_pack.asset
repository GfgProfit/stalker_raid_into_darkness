  _displayName: "\u041F\u043E\u0445\u043E\u0434\u043D\u044B\u0439 \u0440\u044E\u043A\u0437\u0430\u043A (T1)"
  _shortName: "\u041F\u043E\u0445\u043E\u0434\u043D\u044B\u0439 \u0440\u044E\u043A\u0437\u0430\u043A (T1)"
  _description: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0440\u044E\u043A\u0437\u0430\u043A \u0441\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C \u043F\u043E\u0434\u0441\u0443\u043C\u043A\u043E\u0432 \u0438 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0439, \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435, \u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0435\u0449\u0438, \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438. \u041E\u0434\u043D\u043E \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0439 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430-\u043D\u043E\u0432\u0438\u0447\u043A\u0430.\n\n\u0425\u0410\u0420\u0410\u041A\u0422\u0415\u0420\u0418\u0421\u0422\u0418\u041A\u0418:\n\u2022  \u043F\u043E\u0432\u0441\u0435\u043C\u0435\u0441\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\n\u2022  \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432\n\u2022  \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D \u043A\u0430\u043A \u0442\u0430\u0439\u043D\u0438\u043A"
