  m_Name: sil_pbs4_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 36e7be2258d542fc8b350b2abb99ea64
  _displayName: "\u041F\u0440\u0438\u0431\u043E\u0440 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0439 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u041F\u0411\u0421-4"
  _shortName: "\u041F\u0411\u0421-4"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0431\u043E\u0440 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0439 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,45x39 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 \u041D\u0418\u0418-61 (\u0426\u041D\u0418\u0418\u0442\u043E\u0447\u043C\u0430\u0448) \u0434\u043B\u044F \u0443\u043A\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0410\u041A\u0421-74\u0423\u0411 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E-\u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 6\u04211 \xAB\u041A\u0430\u043D\u0430\u0440\u0435\u0439\u043A\u0430\xBB. \u041F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0432 1980 \u0433\u043E\u0434\u0443 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0438 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u043F\u0440\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u0441\u043A\u0440\u044B\u0442\u043D\u044B\u0445 \u0431\u043E\u0435\u0432\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043C\u043D\u043E\u0433\u043E\u043A\u0430\u043C\u0435\u0440\u043D\u044B\u0439 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u0441\u0435\u043F\u0430\u0440\u0430\u0442\u043E\u0440\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u0438 \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u041F\u0411\u0421-1, \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u043E\u0433\u043E \u043E\u0431\u0442\u044E\u0440\u0430\u0442\u043E\u0440\u0430, \u0447\u0442\u043E \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043A\u0430\u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435 \u043F\u0430\u0442\u0440\u043E\u043D\u044B 7\u04231, \u0442\u0430\u043A \u0438 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B 5,45x39 \u043C\u043C. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432 7\u04231 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0448\u0443\u043C\u043E\u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0443\u0447\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0410\u041A\u0421-74\u0423\u0411 \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430. \u0421\u043E \u0448\u0442\u0430\u0442\u043D\u044B\u043C\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u043D\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0439 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0445\u043B\u043E\u043F\u043E\u043A \u043F\u0443\u043B\u0438. \u0414\u043B\u0438\u043D\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 220 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 610 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u043E\u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0442\u0438\u043F\u043E\u0432 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0438 \u0432\u043E\u0439\u0441\u043A\u0430\u043C\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0421\u0421\u0421\u0420."
