  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: ammo_m209
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 1c042c1da4d1ccf409566d75019fe278
  _displayName: "\u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B 40x46 \u043C\u043C M433 HEDP"
  _shortName: M433
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 40-\u043C\u043C \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F M433 HEDP (High Explosive Dual Purpose), \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043B\u0435\u0433\u043A\u043E\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u0438 \u0446\u0435\u043B\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0438 \u0440\u0443\u0447\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430\u0445 M79, M203 \u0438 M320. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0439 \u0441 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u044B\u043C \u0432\u0437\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u043C M550, \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0449\u0435\u0439 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u0430 \u0441 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445 \u0446\u0435\u043B\u0435\u0439 \u043E\u0441\u043A\u043E\u043B\u043A\u0430\u043C\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u041F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u0432 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435 \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0434\u0435\u0442\u043E\u043D\u0438\u0440\u0443\u0435\u0442, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u0443\u044E \u0441\u0442\u0440\u0443\u044E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0443\u044E \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E \u0431\u0440\u043E\u043D\u044E \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439 \u0434\u043E 50 \u043C\u043C \u043F\u0440\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439. \u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 \u043E\u043A\u043E\u043B\u043E 5 \u043C\u0435\u0442\u0440\u043E\u0432. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 76 \u043C/\u0441, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u2014 400 \u043C\u0435\u0442\u0440\u043E\u0432. \u041C\u0430\u0441\u0441\u0430 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 230 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E, \u0441\u043E\u0447\u0435\u0442\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0446\u0435\u043B\u0435\u0439 \u0438 \u043B\u0451\u0433\u043A\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u0442\u0435\u0445\u043D\u0438\u043A\u0438."
