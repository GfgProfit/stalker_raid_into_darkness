  m_Name: wpn_knife_extreme_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 287c129712d73ae4e81ab26cf99ef03c
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043D\u043E\u0436 MTech USA Xtreme"
  _shortName: MTech Xtreme
  _description: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043D\u043E\u0436 \u0438\u0437 \u0441\u0435\u0440\u0438\u0438 MTech USA Xtreme, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u043E\u0439 \u043F\u043E\u0434 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Master Cutlery. \u0421\u0435\u0440\u0438\u044F \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043D\u0430 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0439 \u0440\u044B\u043D\u043E\u043A \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0430 \u0434\u043B\u044F \u0442\u0443\u0440\u0438\u0437\u043C\u0430, \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447 \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0412 \u043C\u043E\u0434\u0435\u043B\u044F\u0445 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043A\u043E\u0440\u0440\u043E\u0437\u0438\u043E\u043D\u043D\u043E\u0441\u0442\u043E\u0439\u043A\u0438\u0435 \u0441\u0442\u0430\u043B\u0438, \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0438 \u0446\u0435\u043B\u044C\u043D\u043E\u0445\u0432\u043E\u0441\u0442\u043E\u0432\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F (Full Tang), \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u0438\u043A \u043A\u043B\u0438\u043D\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u043E \u0432\u0441\u0435\u0439 \u0434\u043B\u0438\u043D\u0435 \u0440\u0443\u043A\u043E\u044F\u0442\u0438. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043B\u0438\u043D\u043E\u043A \u0438\u043C\u0435\u0435\u0442 \u043F\u0440\u043E\u0444\u0438\u043B\u044C Tanto \u0438\u043B\u0438 Drop Point, \u0433\u043B\u0430\u0434\u043A\u0443\u044E \u043B\u0438\u0431\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0440\u0435\u0436\u0443\u0449\u0443\u044E \u043A\u0440\u043E\u043C\u043A\u0443. \u0414\u043B\u044F \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043D\u0430\u043A\u043B\u0430\u0434\u043E\u043A \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0441\u0442\u0435\u043A\u043B\u043E\u0442\u0435\u043A\u0441\u0442\u043E\u043B\u0438\u0442 G10 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u041D\u043E\u0436\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0442\u0441\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C\u0438 \u043D\u043E\u0436\u043D\u0430\u043C\u0438 \u0438\u0437 \u043D\u0435\u0439\u043B\u043E\u043D\u0430 \u0438\u043B\u0438 \u0444\u043E\u0440\u043C\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0442\u0435\u0440\u043C\u043E\u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0430. \u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043D\u043E\u0436\u0430\u043C, \u0430 \u043D\u0435 \u043A \u0448\u0442\u0430\u0442\u043D\u043E\u043C\u0443 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u043C\u0443 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043C\u0443 \u043E\u0440\u0443\u0436\u0438\u044E."
