  m_Name: okp
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 0b93f4aac0bbd7944b0047106f240e27
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041E\u041A\u041F-7 (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435: \u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442)"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041E\u041A\u041F-7 (\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435: \u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442)"
  _description: "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432 \u041E\u041A\u041F \u0434\u0430\u0451\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u0435\u0441\u0442\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C \u0438\u0437 \u043D\u0435\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u0438 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0435\u043D\u044F\u044E\u0449\u0435\u0439\u0441\u044F \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438, \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0443\u0442\u043E\u043C\u043B\u044F\u0435\u043C\u043E\u0441\u0442\u044C, \u0430 \u0442\u0430\u043A\u0436\u0435, \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0448\u0442\u0430\u0442\u043D\u043E\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u0435. \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B\u0430 - \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0440\u0435\u0444\u043B\u0435\u043A\u0442\u043E\u0440\u0430 \u0431\u0435\u0437 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u043F\u0440\u0430\u0432\u044B, \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0435\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0441\u0435\u043A\u0442\u043E\u0440\u043E\u0432 \u043E\u0431\u0441\u0442\u0440\u0435\u043B\u0430. \u0417\u0430\u0449\u0438\u0442\u0430 \u0440\u0435\u0444\u043B\u0435\u043A\u0442\u043E\u0440\u0430 \u0432 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043D\u043A\u0438\u043C \u0438 \u043F\u0440\u043E\u0447\u043D\u044B\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C, \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435 \u043C\u0435\u0448\u0430\u044E\u0449\u0438\u043C \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435."
