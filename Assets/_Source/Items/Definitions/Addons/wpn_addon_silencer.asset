  m_Name: wpn_addon_silencer
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 07e8e5df315f2fe408bb7abde12c01c2
  _displayName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0430\u0440\u043C\u0438\u0438
    \u0421\u0428\u0410 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,56"
  _shortName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0430\u0440\u043C\u0438\u0438
    \u0421\u0428\u0410 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,56"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C> 5,56x45 \u043A\u0430\u043B\u0438\u0431\u0440.\n\n<color=#AAAAAA>\u041F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u0439
    \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0434\u043B\u044F \u043C\u0430\u043B\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0445
    \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A, \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u0432 \u0421\u0428\u0410. \u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u0438\u0445
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C \xAB\u0438\u0441\u0447\u0435\u0437\u043B\u043E\xBB
    \u0438\u0437 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432
    \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0439
    \u0430\u0440\u043C\u0438\u0438. \u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043F\u0443\u0441\u0430
    \u0441 \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u0430\u043C\u0435\u0440\u0430\u043C\u0438, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
    \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0441\u0435\u0440\u0438\u044F \u0442\u0438\u0442\u0430\u043D\u043E\u0432\u044B\u0445
    \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C Z-\u0442\u0438\u043F\u0430.
    \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
    \u0434\u0443\u043B\u044C\u043D\u043E\u0435 \u043F\u043B\u0430\u043C\u044F \u0438
    \u0437\u0432\u0443\u043A \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430. \u0422\u0440\u0435\u0431\u0443\u0435\u0442
    \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F.
    \u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u0438 \u044D\u0442\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430 \u0448\u0438\u0440\u043E\u043A\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043C\u0430\u043B\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0445
    \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 \u0441\u0442\u0440\u0430\u043D
    \u041D\u0410\u0422\u041E.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0413\u043B\u0443\u0448\u0435\u043D\u0438\u0435
    \u0437\u0432\u0443\u043A\u0430: <color=#AAAAAA>\u0441\u0440\u0435\u0434\u043D\u0435\u0435"
