  m_Name: marchf
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 08d2445712ad56048aadf75a7e8f2979
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B March-F Tactical 3\u201324x42 FFP"
  _shortName: March
  _description: "\u042F\u043F\u043E\u043D\u0441\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 3x \u0434\u043E 24x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 DEON Optical Design Corporation \u043F\u043E\u0434 \u0431\u0440\u0435\u043D\u0434\u043E\u043C March Scopes. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u043C\u0430\u0440\u043A\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0435 \u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 42-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C, \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438 \u043B\u0438\u043D\u0437\u0430\u043C\u0438 \u0438\u0437 \u0441\u0442\u0435\u043A\u043B\u0430 ED \u0441\u043E \u0441\u0432\u0435\u0440\u0445\u043D\u0438\u0437\u043A\u043E\u0439 \u0434\u0438\u0441\u043F\u0435\u0440\u0441\u0438\u0435\u0439 \u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0439 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u0444\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 (FFP). \u041F\u0440\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438 \u0441\u0435\u0442\u043A\u0430 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0435 \u0443\u0433\u043B\u043E\u0432\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u043F\u0440\u0430\u0432\u043E\u043A. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u0441\u0435\u0442\u043A\u0430\u043C\u0438 FML, FML-1 \u0438 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438, \u0441 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439 \u0438\u043B\u0438 \u0431\u0435\u0437 \u043D\u0435\u0451. \u0418\u043C\u0435\u0435\u0442 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u044B \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u044B\u0432\u0435\u0440\u043A\u0438 \u0441 \u0446\u0435\u043D\u043E\u0439 \u0434\u0435\u043B\u0435\u043D\u0438\u044F 0,1 MIL \u0438\u043B\u0438 1/4 MOA, \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0443\u043B\u0435\u0432\u043E\u0439 \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u0438 \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0443 \u043F\u0430\u0440\u0430\u043B\u043B\u0430\u043A\u0441\u0430 \u043E\u0442 10 \u044F\u0440\u0434\u043E\u0432 \u0434\u043E \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0439 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438, \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D \u0430\u0440\u0433\u043E\u043D\u043E\u043C \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0437\u0430\u043F\u043E\u0442\u0435\u0432\u0430\u043D\u0438\u044F \u0438 \u043E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u043C \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u044F\u044E\u0449\u0438\u043C \u0438 \u0432\u043E\u0434\u043E\u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C \u043B\u0438\u043D\u0437. \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0443\u0431\u043A\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 30 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u2014 312 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 600\u2013640 \u0433\u0440\u0430\u043C\u043C\u043E\u0432 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u0441\u044C\u043C\u0438\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u043E\u043C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F, \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u044C\u044E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438."
