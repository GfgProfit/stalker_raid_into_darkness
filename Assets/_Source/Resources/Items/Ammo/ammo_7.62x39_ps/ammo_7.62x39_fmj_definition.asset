  m_Name: ammo_7.62x39_fmj
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ac99525ad0e2061408aef8e58a9cda73
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7.62\xD739 \u043C\u043C \u041F\u0421"
  _shortName: "\u041F\u0421"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62\xD739 \u043C\u043C \u043E\u0431\u0440\u0430\u0437\u0446\u0430 1943 \u0433\u043E\u0434\u0430 \u0441 \u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u041F\u0421 \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u0432 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0438 \u0440\u0443\u0447\u043D\u044B\u0445 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432 \u0420\u041F\u0414 \u0438 \u0420\u041F\u041A. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0439\u0441\u044F \u0437\u0430 \u043B\u0451\u0433\u043A\u0438\u043C\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 7,9 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0438\u0437 \u043C\u0430\u043B\u043E\u0443\u0433\u043B\u0435\u0440\u043E\u0434\u0438\u0441\u0442\u043E\u0439 \u0441\u0442\u0430\u043B\u0438, \u043E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u043E\u0439 \u0440\u0443\u0431\u0430\u0448\u043A\u043E\u0439. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 710\u2013725 \u043C/\u0441 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B. \u0421\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u043E \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u0430\u0442\u0440\u043E\u043D \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0438\u043B\u0438 \u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430. \u041F\u0443\u043B\u044F \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u043C\u0443 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443 \u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u043C\u0443 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044E \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u043E\u0434 \u043A\u0430\u043B\u0438\u0431\u0440 7,62\xD739 \u043C\u043C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0445 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0432 \u043C\u0438\u0440\u0435."
