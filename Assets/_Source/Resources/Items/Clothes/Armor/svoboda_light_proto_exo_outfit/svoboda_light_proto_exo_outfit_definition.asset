  m_Name: svoboda_light_proto_exo_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 41fdabb1491cbe54aa4e4ffa9d40af3d
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0442\u0435\u0440 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB \u0441 \u043F\u0440\u043E\u0442\u043E\u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u043C"
  _shortName: EXO
  _description: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0442\u0435\u0440 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB, \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0441 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u043E\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u0438\u043C\u0435\u044E\u0449\u0438\u043C \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0438 \u043F\u0430\u0440\u0443 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u0441\u0438\u043B\u0443 \u0438 \u0433\u0440\u0443\u0437\u043E\u043F\u043E\u0434\u044A\u0451\u043C\u043D\u043E\u0441\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430, \u043D\u043E, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u0443\u0440\u043E\u0432\u043D\u044F \u0437\u0430\u0449\u0438\u0442\u044B, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0433\u043E \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u043C. \u0421 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0435\u0433\u043E \u0442\u0435\u0445\u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0434\u0435\u0448\u0435\u0432\u043B\u0435."
