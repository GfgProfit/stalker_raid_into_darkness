  m_Name: ammo_5.7x28_fmj
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 1295b970c791ff842b83ee27d1d724a4
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B FN 5,7x28 \u043C\u043C SB193"
  _shortName: SB193
  _description: "\u0411\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,7x28 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 FN Herstal \u0434\u043B\u044F \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432 FN P90 \u0438 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432 FN Five-seveN. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0433\u043E \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0433\u043D\u044F \u0441 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u0439, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0437\u0430 \u0441\u0447\u0451\u0442 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0443\u0434\u0430\u0440\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0443\u0442\u044F\u0436\u0435\u043B\u0451\u043D\u043D\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 3,9 \u0433\u0440\u0430\u043C\u043C\u0430, \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 300 \u043C/\u0441. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u043C SS190 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u043A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439, \u0431\u043E\u043B\u0435\u0435 \u043A\u0440\u0443\u0442\u043E\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043F\u043E\u043B\u0451\u0442\u0430 \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E. \u041D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u0435\u043D \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u0433\u0434\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0438 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u043A\u0430. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u0431\u0435\u043B\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439 \u043A\u043E\u043D\u0447\u0438\u043A\u0430 \u043F\u0443\u043B\u0438."
