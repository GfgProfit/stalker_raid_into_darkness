  _displayName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0417\u0430\u043A\u0430\u0442\xBB"
  _shortName: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0417\u0430\u043A\u0430\u0442\xBB"
  _description: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0437\u0430 \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u0437\u044F\u0442\u044B \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0430\u0440\u043C\u0438\u0439. \u041C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0432 \u0431\u043E\u043B\u0435\u0435 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0445 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F\u0445 \u0441 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C. \u0421\u0440\u0435\u0434\u0438 \u0436\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043D\u043E\u0448\u0435\u043D\u0438\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u0432 \u0437\u043E\u043D\u0430\u0445 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438. \u041D\u043E \u0432\u0441\u0451 \u0436\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443 \u0432\u044B\u0448\u0435 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438 \u043C\u043E\u0436\u0435\u0442 \u0434\u0430\u0436\u0435 \u0431\u044B\u0442\u044C \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043E\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0441\u0442\u044E\u043C\u0430\u043C \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u043C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438."
