  m_Name: wpn_walther_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: e0e21222c55f19b42a300dabb8b881c0
  _displayName: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 Walther P99"
  _shortName: P99
  _description: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x19 \u043C\u043C Parabellum, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Carl Walther GmbH \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432 1997 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432 Walther P5 \u0438 P88. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0440\u0433\u0430\u043D\u043E\u0432, \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u044B\u043D\u043A\u0430. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0445\u043E\u0434\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430 \u043F\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0411\u0440\u0430\u0443\u043D\u0438\u043D\u0433\u0430. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA), \u0431\u0435\u0437 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u043A\u0443\u0440\u043A\u0430. \u0420\u0430\u043C\u043A\u0430 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0430, \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u0438 \u0441\u0442\u0432\u043E\u043B \u2014 \u0438\u0437 \u0443\u0433\u043B\u0435\u0440\u043E\u0434\u0438\u0441\u0442\u043E\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u043E\u0439 Tenifer. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0441\u043C\u0435\u043D\u043D\u044B\u0435 \u0442\u044B\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443 \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430, \u043A\u043D\u043E\u043F\u043A\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u043D\u044F\u0442\u0438\u044F \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430 \u0441 \u0431\u043E\u0435\u0432\u043E\u0433\u043E \u0432\u0437\u0432\u043E\u0434\u0430, \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u044B \u0432\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430 \u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u044F \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u0432 \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u0438\u043A\u0435. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 102 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u2014 180 \u043C\u043C. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u0434\u0432\u0443\u0445\u0440\u044F\u0434\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 15 \u0438\u043B\u0438 16 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u043C\u0438 \u043C\u0435\u0442\u043A\u0430\u043C\u0438, \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439 \u0437\u0430\u0449\u0451\u043B\u043A\u043E\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439 \u0434\u043B\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u043E\u043B\u0443\u0447\u0438\u043B \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439 \u0413\u0435\u0440\u043C\u0430\u043D\u0438\u0438, \u041F\u043E\u043B\u044C\u0448\u0438 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0445 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432."
