  m_Name: greh_ps5_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 4c33b849866575045a5b6e3dc2678d92
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u044F \xAB\u0412\u0435\u043B\u0435\u0441\xBB"
  _shortName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u044F \xAB\u0412\u0435\u043B\u0435\u0441\xBB"
  _description: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u041F\u04215-\u041C
    \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB, \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0439\u0441\u044F
    \u0432 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438
    \xAB\u0413\u0440\u0435\u0445\u0430\xBB \u0438 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0435\u0433\u043E \u0442\u0435\u0445\u043D\u0438\u043A\u0430\u043C\u0438. \u041A\u0430\u043A
    \u0431\u044B \u0442\u0430\u043C \u043D\u0438 \u0431\u044B\u043B\u043E, \xAB\u0414\u043E\u043B\u0433\u0443\xBB
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u043D\u0435
    \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u043E, \u0447\u0442\u043E
    \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0432 \u0440\u0443\u043A\u0430\u0445
    \u0444\u0430\u043D\u0430\u0442\u0438\u0447\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0445
    \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u0431\u043E\u0433\u043E\u0442\u0432\u043E\u0440\u044F\u0449\u0438\u0445
    \u0417\u043E\u043D\u0443, \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u043E\u0439\u0446\u044B
    \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0442\u0441\u044F
    \xAB\u0438\u0437\u044A\u044F\u0442\u044C\xBB \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u043E\u0435
    \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0447\u043B\u0435\u043D\u043E\u0432
    \xAB\u0413\u0440\u0435\u0445\u0430\xBB. \u0427\u0442\u043E \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
    \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u043E\u0441\u0442\u044E\u043C\u0430,
    \u0442\u043E \u043E\u043D \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B \u0438 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C
    \u0445\u043E\u0440\u043E\u0448 \u0434\u043B\u044F \u0441\u0443\u0440\u043E\u0432\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0417\u043E\u043D\u044B."
