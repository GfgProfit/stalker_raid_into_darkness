  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: dolg_scientific_red_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 51cd8adf48d116c46b2ea3f4047154b4
  _displayName: "\u041F\u04215-9\u041C\u0434 \xAB\u0415\u0433\u0435\u0440\u044C\xBB"
  _shortName: "\u041F\u04215-9\u041C\u0434 \xAB\u0415\u0433\u0435\u0440\u044C\xBB"
  _description: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0414\u043E\u043B\u0433\u0430\xBB \u043A\u043B\u0430\u0441\u0441\u0430 \xAB\u0421\u0415\u0412\u0410\xBB, \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043B\u0451\u0433\u043A\u0438\u0445 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0438\u0445 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438. \u0421\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0439 \u0432\u0435\u0441, \u043F\u043E\u043C\u0438\u043C\u043E \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439, \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u0431\u044E\u0440\u0435\u0440\u0430\u043C\u0438. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u043F\u0441\u0438-\u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0443\u0434\u0430\u0440\u043E\u0432 \u0438 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0433\u0440\u043E\u0437, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u0443\u0434\u0443\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u043C \u043F\u043E\u0434\u0441\u043F\u043E\u0440\u044C\u0435\u043C \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u043F\u043E\u043B\u0442\u0435\u0440\u0433\u0435\u0439\u0441\u0442\u0430\u043C\u0438. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0436\u0435\u043B\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0435\u0433\u043E, \u0440\u0430\u0432\u043D\u043E \u043A\u0430\u043A \u0438 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u043A \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u043C, \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u043E\u0439\u0446\u0430\u043C \xAB\u0414\u043E\u043B\u0433\u0430\xBB, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u043C \u041F\u04215-9\u041C\u0434 \xAB\u0415\u0433\u0435\u0440\u044C\xBB, \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0432\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u0432 \u0431\u043E\u0439 \u0441 \u043A\u0440\u043E\u0432\u043E\u0441\u043E\u0441\u0430\u043C\u0438, \u0445\u0438\u043C\u0435\u0440\u0430\u043C\u0438 \u0438\u043B\u0438 \u043F\u0441\u0435\u0432\u0434\u043E\u0433\u0438\u0433\u0430\u043D\u0442\u0430\u043C\u0438."
