  m_Name: merc_combat_scientific_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7cc16643795ba9f47af7ccac62520a29
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432
    \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432
    \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB"
  _description: "\u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0436\u0435\u0441\u0442\u0430
    \u0434\u043E\u0431\u0440\u043E\u0439 \u0432\u043E\u043B\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0440\u0430\u0434\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432
    \u0432 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445,
    \xAB\u0427\u0438\u0441\u0442\u043E\u0435 \u043D\u0435\u0431\u043E\xBB \u0432\u0440\u0435\u043C\u044F
    \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u043D\u0430 \u0437\u0430\u043A\u0430\u0437 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0432\u0435\u0440\u0441\u0438\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u0427\u041D-\xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\xBB.
    \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u043C
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u043E\u043C \xAB\u0421\u0415\u0412\u0410\xBB
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
    \u043C\u043E\u0434\u0435\u043B\u044C \u041C2 \u0432\u043E \u043C\u043D\u043E\u0433\u043E\u043C
    \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430,
    \u0430 \u0432\u043E\u0442 \u0432 \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0438
    \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u0427\u041D-4\u0430 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB
    - \u043D\u0435 \u0432\u0441\u0451 \u0442\u0430\u043A \u0440\u0430\u0434\u0443\u0436\u043D\u043E:
    \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
    \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438, \u043F\u0441\u0438-\u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0438 \u0443\u0434\u0430\u0440\u043E\u0432. \u0422\u0435\u043C \u043D\u0435
    \u043C\u0435\u043D\u0435\u0435, \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
    \u0447\u0442\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043B\u0435\u0433\u0447\u0435
    \u0438 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043B\u0443\u0447\u0448\u0435 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0430,
    \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u043E
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0435\u0451 \u043E\u0431\u0449\u0443\u044E
    \u0437\u0430\u0449\u0438\u0442\u0443."
