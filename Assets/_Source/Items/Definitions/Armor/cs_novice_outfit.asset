  m_Name: cs_novice_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: a0b82fa3616409243abe19a8f5b00d6a
  _displayName: "\u041A\u043E\u0436\u0430\u043D\u0430\u044F \u043A\u0443\u0440\u0442\u043A\u0430
    \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB"
  _shortName: "\u041A\u043E\u0436\u0430\u043D\u0430\u044F \u043A\u0443\u0440\u0442\u043A\u0430
    \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB"
  _description: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u0430\u043D\u043E\u0440\u0430\u043A
    \u0431\u0435\u043B\u043E-\u0433\u043E\u043B\u0443\u0431\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430,
    \u043D\u0430\u0434\u0435\u0442\u044B\u0439 \u043F\u043E\u0432\u0435\u0440\u0445
    \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u043E\u043B\u0430\u0437\u043D\u043E\u0433\u043E
    \u0441\u0432\u0438\u0442\u0435\u0440\u0430 \u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u0434\u0436\u0438\u043D\u0441\u044B
    \u0438 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435 \u0431\u043E\u0442\u0438\u043D\u043A\u0438.
    \u041F\u043E\u0440\u0442\u043D\u044B\u0435 \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E
    \u043D\u0435\u0431\u0430\xBB \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
    \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043A\u0443\u0440\u0442\u043A\u0438
    \u0434\u043B\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u0441\u0442\u0443\u043F\u0438\u0432\u0448\u0438\u0445
    \u0432 \u0440\u044F\u0434\u044B \u0438\u0445 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438.
    \u041C\u043E\u0436\u0435\u0442 \u0441\u043E\u0433\u0440\u0435\u0442\u044C \u0441\u0432\u043E\u0435\u0433\u043E
    \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0434\u043E\u0436\u0434\u044F \u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
    \u0432\u0435\u0442\u0440\u0430, \u043D\u043E \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442
    \u043A\u0430\u043A\u043E\u0439-\u043B\u0438\u0431\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u0441\u0435\u0432\u0435\u0440\u043D\u0435\u0435
    \u044E\u0436\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0438\u0446 \u0417\u043E\u043D\u044B."
