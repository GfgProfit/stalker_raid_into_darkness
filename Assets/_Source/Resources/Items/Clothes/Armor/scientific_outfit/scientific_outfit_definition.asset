  m_Name: scientific_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: c4ab56fdf02e3244e9c1b1e7c25486d2
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0421\u0415\u0412\u0410\xBB"
  _shortName: HEAVY
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u044B\u0439 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0445 \u043A\u0438\u0435\u0432\u0441\u043A\u0438\u0445 \u041D\u0418\u0418 \u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0443 \u0434\u0440\u0443\u0433\u0438\u043C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u043C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C \u0432 \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0434\u044B\u0445\u0430\u043D\u0438\u044F \u0441 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u043C \u0446\u0438\u043A\u043B\u043E\u043C, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u0435\u0439. \u0417\u0430 \u0441\u0447\u0451\u0442 \u0443\u0434\u0430\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u0431\u043E\u0440\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 - \u0435\u0433\u043E \u0446\u0435\u043D\u0430 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B: \u0434\u0430\u0436\u0435 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430 \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0430\u0445."
