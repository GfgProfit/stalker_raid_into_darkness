  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5a4d6eaf7960b8e4ea1c7b65e69b2c43
  _displayName: "\u041F\u0421\u0417-9\u0434 \xAB\u0411\u0440\u043E\u043D\u044F \"\u0414\u043E\u043B\u0433\u0430\"\xBB \u0441 \u043F\u0440\u043E\u0442\u043E\u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u043C"
  _shortName: "\u041F\u0421\u0417-9\u0434 \xAB\u0411\u0440\u043E\u043D\u044F \"\u0414\u043E\u043B\u0433\u0430\"\xBB \u0441 \u043F\u0440\u043E\u0442\u043E\u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u043E\u043C"
  _description: "\u0411\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u041F\u0421\u0417-9\u0434 \xAB\u0411\u0440\u043E\u043D\u044F \"\u0414\u043E\u043B\u0433\u0430\"\xBB, \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0441 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u043E\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u0438\u043C\u0435\u044E\u0449\u0438\u043C \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0438 \u043F\u0430\u0440\u0443 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u0441\u0438\u043B\u0443 \u0438 \u0433\u0440\u0443\u0437\u043E\u043F\u043E\u0434\u044A\u0451\u043C\u043D\u043E\u0441\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u0441\u0432\u0435\u0440\u0445 \u0435\u0433\u043E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439. \u041F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C \u0437\u0430\u0449\u0438\u0442\u044B \u0433\u043E\u043B\u043E\u0432\u044B - \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u044D\u043A\u0437\u043E\u0448\u043B\u0435\u043C\u0430, \u0447\u0442\u043E, \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u043C\u043E\u0436\u0435\u0442 \u0441\u044B\u0433\u0440\u0430\u0442\u044C \u043D\u0430 \u0440\u0443\u043A\u0443 \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u0430 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0448\u043B\u0435\u043C\u0430. \u041E\u0434\u043D\u0430\u043A\u043E \u0441\u0442\u043E\u0438\u0442 \u0443\u0447\u0435\u0441\u0442\u044C, \u0447\u0442\u043E \u0438\u043C\u0435\u044E\u0449\u0430\u044F\u0441\u044F \u0447\u0430\u0441\u0442\u044C \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432 \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E \u0443\u0441\u0442\u0430\u0440\u0435\u043B\u0430, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u0438 \u043C\u0435\u043D\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430."
