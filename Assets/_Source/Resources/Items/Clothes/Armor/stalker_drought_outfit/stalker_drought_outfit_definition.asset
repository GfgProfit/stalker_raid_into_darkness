  m_Name: stalker_drought_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: fe7d9845f91a4d94eaef8df201f72b46
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0421\u043A\u0438\u0442\u0430\u043B\u0435\u0446\xBB"
  _shortName: MEDIUM
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439 \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D. \u041C\u0435\u043D\u0435\u0435 \u0443\u0434\u043E\u0431\u0435\u043D \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \xAB\u0417\u0430\u0440\u0451\u0439\xBB, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u0443\u044E \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0438\u043C\u0435\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439 \u0434\u043B\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u043E\u0434\u0443\u043B\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B, \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432 \u0434\u043B\u044F \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u043E\u0432. \u041E\u0434\u043D\u0430\u043A\u043E \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E \u0432\u043C\u0435\u0441\u0442\u043E \u043D\u0438\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \xAB\u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438 \u0433\u043E\u0440\u0431\u044B\xBB \u0434\u043B\u044F \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u0432\u0435\u0441\u0430 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u0447\u0442\u043E, \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E, \u0438 \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u043B\u043E \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430. \u0412 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0435, \u043A\u0430\u043A \u0438 \xAB\u0417\u0430\u0440\u044F\xBB, \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u0432\u0438\u0434\u0443 \u0441\u0432\u043E\u0435\u0439 \u0434\u0435\u0448\u0435\u0432\u0438\u0437\u043D\u044B \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439 \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
