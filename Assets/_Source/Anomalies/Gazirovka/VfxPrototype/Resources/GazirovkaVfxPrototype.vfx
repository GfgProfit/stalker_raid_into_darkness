  m_BlockName: Retire idle particles
  m_HLSLCode: "void RetireGazirovkaIdle7(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float stepTime)\n{\n    attributes.alive = attributes.alive && attributes.age + stepTime <= attributes.lifetime;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[counterOffset + 7u], 0xffffffffu);\n    }\n}"
