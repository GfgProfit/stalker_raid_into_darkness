  m_Name: specops_dolg_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5932f6618ef752043a61ef5c77f0a221
  _displayName: "\u041F\u04215-\u0411 \xAB\u0411\u0435\u0440\u0438\u043B\u043B\u0438\u0435\u0432\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _shortName: "\u041F\u04215-\u0411 \xAB\u0411\u0435\u0440\u0438\u043B\u043B\u0438\u0435\u0432\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _description: "\u041C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u0417\u043E\u043D\u044B \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0441\u0435\u0440\u0438\u0438
    \u041F\u04215 \u0441 \u0431\u0435\u0440\u0438\u043B\u043B\u0438\u0435\u0432\u044B\u043C
    \u043D\u0430\u043F\u044B\u043B\u0435\u043D\u0438\u0435\u043C. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0441\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u043C
    \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043A\u043E\u0441\u0442\u044E\u043C\u043E\u043C
    \u041F\u04215-\u041C \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0431\u043E\u043B\u0435\u0435 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u043C
    \u0438, \u0432 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435
    \u0441\u0432\u043E\u0451\u043C, \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u043C.
    \u0418\u0437 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
    \u0436\u0435 \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C
    \u0441\u043B\u0430\u0431\u044B\u0435 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0438 \u043D\u0438\u0437\u043A\u0443\u044E
    \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A \u0441\u0438\u043B\u044C\u043D\u044B\u043C
    \u0443\u0434\u0430\u0440\u0430\u043C, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0442\u0435\u043B\u0435\u043A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0430\u0442\u0430\u043A\u0430\u043C \u043F\u043E\u043B\u0442\u0435\u0440\u0433\u0435\u0439\u0441\u0442\u043E\u0432."
