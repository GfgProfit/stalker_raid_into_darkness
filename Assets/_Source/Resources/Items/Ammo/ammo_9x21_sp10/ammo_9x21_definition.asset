  m_Name: ammo_9x21
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: f9261bf56e8a2c1428740f66c0596005
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9\xD721 \u043C\u043C \u0421\u041F-10"
  _shortName: "\u0421\u041F-10"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9\xD721 \u043C\u043C \u0441 \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u0421\u041F-10, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u041D\u0418\u0418\u0442\u043E\u0447\u043C\u0430\u0448 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 1990-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445 \u0421\u0420-1 \xAB\u0413\u044E\u0440\u0437\u0430\xBB, \u0421\u041F\u0421 \xAB\u0412\u0435\u043A\u0442\u043E\u0440\xBB \u0438 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 \u0421\u0420-2 \xAB\u0412\u0435\u0440\u0435\u0441\u043A\xBB. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 6,7 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441 \u0442\u0435\u0440\u043C\u043E\u0443\u043F\u0440\u043E\u0447\u043D\u0451\u043D\u043D\u044B\u043C \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u043F\u043E\u043B\u0438\u044D\u0442\u0438\u043B\u0435\u043D\u043E\u0432\u043E\u0439 \u0440\u0443\u0431\u0430\u0448\u043A\u043E\u0439 \u0438 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439. \u0413\u043E\u043B\u043E\u0432\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u0432 \u0442\u0432\u0451\u0440\u0434\u044B\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 410 \u043C/\u0441 \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0438 \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0442\u044C 440 \u043C/\u0441 \u0438\u0437 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430. \u0421\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C \u0446\u0435\u043B\u0438, \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0435 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430\u043C\u0438 \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430, \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0434\u043E 50 \u043C\u0435\u0442\u0440\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C \u043B\u0451\u0433\u043A\u0438\u0435 \u0443\u043A\u0440\u044B\u0442\u0438\u044F \u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u0447\u0451\u0440\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u0448\u0438\u043D\u044B \u043F\u0443\u043B\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u0439 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438 9\xD721 \u043C\u043C \u0421\u041F-11 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043A\u0443\u0447\u043D\u043E\u0441\u0442\u044C \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u0434\u043E 200 \u043C\u0435\u0442\u0440\u043E\u0432."
