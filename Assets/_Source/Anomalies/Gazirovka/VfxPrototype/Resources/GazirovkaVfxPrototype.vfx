  m_ActivationSlot: {fileID: 114350483966680356}
  m_BlockName: Initialize particle
  m_HLSLCode: "void InitGazirovka8(inout VFXAttributes attributes)\r\n{\r\n    uint seed = attributes.seed;\r\n    float3 randomValue = float3(ToFloat01(AnotherHash(seed ^ 543341u)), ToFloat01(AnotherHash(seed ^ 311743u)), ToFloat01(AnotherHash(seed ^ 98867u)));\r\n    attributes.lifetime = 3.0f;\r\n    attributes.size = 1.0f;\r\n    attributes.angleZ = lerp(-300.0f, 300.0f, randomValue.z);\r\n    attributes.position = 0.0f;\r\n    attributes.texIndex = floor(randomValue.x * 4.0f);\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitGazirovka8
    selectedIndex: 0
