  m_Name: ghillie_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 0c2721a4906ed8146a388d87ec7e80ff
  _displayName: "\u041C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C"
  _shortName: LIGHT
  _description: "\u041C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0440\u0430\u0437\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C \u043A\u0430\u043C\u0443\u0444\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u043E\u0434\u0435\u0436\u0434\u044B, \u0438\u043C\u0438\u0442\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u043E\u043F\u0430\u0432\u0448\u0438\u0435 \u043B\u0438\u0441\u0442\u044C\u044F. \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0430\u0448\u0438\u0442\u044B \u043F\u043E\u043B\u043E\u0441\u043A\u0438 \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u044B, \u0442\u043A\u0430\u043D\u0435\u0439 \u0438 \u0432\u0435\u0440\u0451\u0432\u043E\u043A - \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442, \u043A\u0430\u043A \u043B\u0438\u0441\u0442\u044C\u044F \u0438 \u0432\u0435\u0442\u043A\u0438. \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442 \u043E\u0434\u0435\u0432\u0430\u0442\u044C \u044D\u0442\u043E\u0442 \u043A\u043E\u0441\u0442\u044E\u043C \u0447\u0442\u043E \u0431\u044B \u0441\u043B\u0438\u0442\u044C\u0441\u044F \u0441 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C \u0444\u043E\u043D\u043E\u043C, \u0442\u0435\u043C \u0441\u0430\u043C\u044B\u043C \u0434\u0435\u043B\u0430\u044F \u0441\u0435\u0431\u044F \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u044B\u043C\u0438 \u0432\u0440\u0430\u0433\u0430\u043C. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0441\u0432\u043E\u044E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C, \u043A\u043E\u0441\u0442\u044E\u043C \u0442\u044F\u0436\u0451\u043B \u0438 \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u043D\u0435\u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0435\u043D: \u0434\u0430\u0436\u0435 \u0432 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u043C \u043A\u043B\u0438\u043C\u0430\u0442\u0435 \u0432 \u043D\u0451\u043C \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0436\u0430\u0440\u043A\u043E."
