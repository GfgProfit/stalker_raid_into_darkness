  m_Name: helm_spartan
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: f084b08c85e267c45a1230dbc741a48b
  _displayName: "\u0428\u043B\u0435\u043C M10 \xAB\u0421\u043F\u0430\u0440\u0442\u0430\u043D\u0435\u0446\xBB"
  _shortName: "\u0428\u043B\u0435\u043C M10 \xAB\u0421\u043F\u0430\u0440\u0442\u0430\u043D\u0435\u0446\xBB"
  _description: "\u0411\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0448\u043B\u0435\u043C \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0448\u043B\u0435\u043C\u0430 \u041F\u0414 (\xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0434\u0435\u043D\u044C\xBB), \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439 \u043F\u043E \u0437\u0430\u043A\u0430\u0437\u0443 \u0440\u044F\u0434\u0430 \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u043E\u043C \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u044C\u044E, \u043D\u043E \u0438 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u043C\u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438. \u0410 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043D\u0430\u043B\u0438\u0447\u0438\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u0435\u0449\u0451 \u0438 \u0432\u044B\u0433\u043E\u0434\u043D\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0442\u0430\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439 \u0431\u043E\u0435\u0432\u044B\u0445 \u0448\u043B\u0435\u043C\u043E\u0432, \u043A\u0430\u043A \xAB\u0421\u0444\u0435\u0440\u0430\xBB, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u043C \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u0435\u0431\u0435 \u0435\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C."
