  m_Name: ammo_12.7x55_ap
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: e990ce0a7d2806a4b8fa43c78febbdcc
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12,7x55 \u043C\u043C
    \u0421\u0426-130 \u0412\u041F\u0421"
  _shortName: "12,7x55 \u0421\u0426-130 \u0412\u041F\u0421"
  _description: "\u041A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439
    \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D
    \u0421\u0426-130 \u0412\u041F\u0421 (\u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438)
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u044B\u043C
    \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C \u0436\u0438\u0432\u043E\u0439
    \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
    \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u043D\u043E\u0439 \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438
    \u0421\u0418\u0411 (5-6 \u0443\u0440\u043E\u0432\u043D\u044F \u0437\u0430\u0449\u0438\u0442\u044B
    \u043F\u043E \u0413\u041E\u0421\u0422 \u042050744-95) \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044F\u0445
    \u0434\u043E 200 \u043C\u0435\u0442\u0440\u043E\u0432 \u0438\u043B\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0439\u0441\u044F
    \u0437\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0430\u043C\u0438
    (\u043E\u0431\u0448\u0438\u0432\u043A\u0430 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F,
    \u0434\u0432\u0435\u0440\u044C, \u0441\u0442\u0435\u043A\u043B\u043E, \u0437\u0430\u0431\u043E\u0440
    \u0438 \u0442.\u0434.) \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0434\u043E 600 \u043C\u0435\u0442\u0440\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043B\u0435\u0433\u043A\u043E\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0438 \u043D\u0435\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>V
    (53)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (349)"
