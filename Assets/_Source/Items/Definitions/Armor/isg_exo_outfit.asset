  _definitionId: 89e4890a2628ad3419bdd9b284f85704
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0418\u0418\u0413"
  _shortName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u0418\u0418\u0413"
  _description: "\u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430 \u0418\u043D\u0442\u0435\u0440\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439 \u0413\u0440\u0443\u043F\u043F\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u043E\u043C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043F\u0430\u0440\u0442\u0438\u0438, \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439 \u0438\u0437 \u0421\u0428\u0410. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432, \u043F\u0440\u0438\u0441\u0443\u0449\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430\u043C, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u0440\u0430\u0432\u043D\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u043E\u0439 \u043B\u0451\u0433\u043A\u043E\u0439 \u0440\u0430\u0437\u0432\u0435\u0434\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u0438\u0441\u043F\u044B\u0442\u0430\u043B\u0430 \u0431\u044B \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0438 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0432 \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B."
