  m_Name: wpn_addon_grenade_launcher_gl1_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b673ffb1d82392e41a70f0d952debdba
  _displayName: "40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 FN GL1"
  _shortName: FN GL1
  _description: "\u0411\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 FN Herstal \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 FN F2000. \u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u043E \u0448\u0442\u0430\u0442\u043D\u043E\u0433\u043E \u0446\u0435\u0432\u044C\u044F, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u0443 \u0438 \u0431\u0430\u043B\u0430\u043D\u0441 \u043E\u0440\u0443\u0436\u0438\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u044B 40\xD746 \u043C\u043C \u043D\u0438\u0437\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0435, \u0434\u044B\u043C\u043E\u0432\u044B\u0435 \u0438 \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C \u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u043E-\u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F \u0438 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C. \u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043A\u0440\u044E\u0447\u043E\u043A \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0435\u0441\u0442\u0438 \u043E\u0433\u043E\u043D\u044C \u0438\u0437 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430, \u043D\u0435 \u043C\u0435\u043D\u044F\u044F \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0440\u0443\u043A\u0438 \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u043E 350 \u043C\u0435\u0442\u0440\u043E\u0432."
