  m_Name: okp
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 0b93f4aac0bbd7944b0047106f240e27
  _displayName: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u041E\u041A\u041F-7"
  _shortName: "\u041E\u041A\u041F-7"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u0432 2006 \u0433\u043E\u0434\u0443 \u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0441 \u0431\u0435\u0437\u0440\u0430\u043C\u043D\u043E\u0439 \u043B\u0438\u043D\u0437\u043E\u0439-\u0440\u0435\u0444\u043B\u0435\u043A\u0442\u043E\u0440\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043E\u0431\u0437\u043E\u0440 \u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u043F\u043E\u043B\u044F \u0437\u0440\u0435\u043D\u0438\u044F. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u0432 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0446\u0432\u0435\u0442\u0430\u0445 \u0438 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044F\u0445, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0442\u043E\u0447\u043A\u0443, \u043A\u043E\u043B\u044C\u0446\u043E \u0441 \u0442\u043E\u0447\u043A\u043E\u0439 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0439 \u0448\u0435\u0432\u0440\u043E\u043D. \u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0434\u0430\u0442\u0447\u0438\u043A \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u043C\u0430\u0440\u043A\u0438 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439. \u041B\u0438\u043D\u0437\u0430 \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u0430 \u0442\u043E\u043D\u043A\u0438\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C, \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u043E\u0431\u0437\u043E\u0440. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0432 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u0445 \u0441 \u0431\u043E\u043A\u043E\u0432\u044B\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0410\u041A \u0438 \xAB\u0421\u0430\u0439\u0433\u0430\xBB, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C Weaver. \u041F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 14\xB0, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 300 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u0434\u0432\u0443\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 AG13, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 40 \u0447\u0430\u0441\u043E\u0432 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u044F\u0440\u043A\u043E\u0441\u0442\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0441\u0442\u044C\u044E, \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0433\u043D\u044F \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
