  m_Name: ammo_50ae
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 376cdf241c6a592478af7514fed63a15
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .50 Action Express (12,7x33 \u043C\u043C)"
  _shortName: AE
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D .50 Action Express, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u043E\u043C \u042D\u0432\u0430\u043D\u043E\u043C \u0423\u0430\u0439\u043B\u0434\u0438\u043D\u043E\u043C \u0438\u0437 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Action Arms \u0432 1988 \u0433\u043E\u0434\u0443 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 Desert Eagle. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u043E\u0442\u043B\u0438\u0447\u0430\u044F\u0441\u044C \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0434\u043B\u044F \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u043E\u0433\u043E \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439. \u041E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438 \u043F\u0443\u043B\u044F\u043C\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u0435, \u043F\u043E\u043B\u0443\u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u0435 \u0438 \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u044B\u0435, \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u0442 19,4 \u0434\u043E 26 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u0412 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u0441 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 19,4 \u0433\u0440\u0430\u043C\u043C\u0430 (300 \u0433\u0440\u0430\u043D) \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 450 \u043C/\u0441, \u0430 \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 1965 \u0414\u0436. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043B\u0430\u0442\u0443\u043D\u043D\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0434\u043B\u0438\u043D\u043E\u0439 32,6 \u043C\u043C \u0441 \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u043A\u0440\u0430\u0438\u043D\u043E\u0439, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0437\u0430\u0442\u0432\u043E\u0440\u0430 Desert Eagle \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043A\u0430\u043B\u0438\u0431\u0440\u0430\u043C\u0438 \u043F\u0440\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u043C\u0435\u043D\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043A\u0440\u0443\u043F\u043D\u043E\u043C\u0443 \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u0443 \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0441\u0441\u0435 \u043F\u0443\u043B\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C \u043B\u0451\u0433\u043A\u0438\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F, \u043E\u0434\u043D\u0430\u043A\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0432 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445 Desert Eagle Mark XIX, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0445 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u0430\u0445. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043C\u043E\u0449\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439, \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u043E\u0439 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430."
