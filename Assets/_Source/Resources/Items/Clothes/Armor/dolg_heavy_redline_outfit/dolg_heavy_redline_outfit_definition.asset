  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: dolg_heavy_redline_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: dba3ed1b52041624d85c4e381374ae73
  _displayName: "\u041F\u0421\u0417-9\u041A\u043B \xAB\u0429\u0438\u0442 \"\u0414\u043E\u043B\u0433\u0430\"\xBB"
  _shortName: MEDIUM
  _description: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u041F\u0421\u0417, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u043D\u0430 \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u0440\u0430\u0434\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043A \u0432\u0437\u0440\u044B\u0432\u0430\u043C \u0438 \u0443\u0434\u0430\u0440\u0430\u043C. \xAB\u0429\u0438\u0442 \"\u0414\u043E\u043B\u0433\u0430\"\xBB \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u043B\u044E\u0431\u0438\u043C\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u043E\u043C \u043F\u043E\u0434\u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A\u0430 \u0428\u0443\u043B\u044C\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0435\u0434\u043A\u043E \u043F\u043E\u043A\u0438\u0434\u0430\u043B \u0441\u0442\u0430\u043D\u0446\u0438\u044E \xAB\u042F\u043D\u043E\u0432\xBB, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C \u043A\u0438\u043B\u043B\u0435\u0440\u043E\u0432 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB. \u041C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0431\u0440\u043E\u043D\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0435\u0433\u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u043E \u0438\u0440\u043E\u043D\u0438\u0438 \u0441\u0443\u0434\u044C\u0431\u044B, \u0435\u0441\u043B\u0438 \u0432\u0435\u0440\u0438\u0442\u044C \u0441\u043B\u0443\u0445\u0430\u043C, \u043F\u043E\u0434\u043F\u043E\u043B\u043A\u043E\u0432\u043D\u0438\u043A \u043F\u043E\u0433\u0438\u0431 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0440\u044B\u0432\u0430 \u0432 \u041F\u0440\u0438\u043F\u044F\u0442\u044C \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0431\u043E\u0439\u0446\u0430\u043C\u0438 \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\xBB. \u0421\u0440\u0435\u0434\u0438 \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435 \xAB\u0414\u043E\u043B\u0433\u0443\xBB \u0432 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u043E\u0442\u0435\u0440\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430, \u043D\u0435\u0440\u0435\u0434\u043A\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044F, \u0447\u0442\u043E \u0435\u0433\u043E \u0436\u0435\u0440\u0442\u0432\u0430, \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0432\u0448\u0430\u044F \u0448\u0442\u0443\u0440\u043C \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0445 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0439 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u043E\u043C\xBB, \u0434\u0430\u043B\u0430 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0443 \u0441\u0438\u043B \u0438\u043B\u0438 \u0438\u0445 \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435. \u0410 \u0432\u0435\u0442\u0435\u0440\u0430\u043D\u044B \xAB\u0414\u043E\u043B\u0433\u0430\xBB \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442 \xAB\u0429\u0438\u0442 \"\u0414\u043E\u043B\u0433\u0430\"\xBB \u0432 \u0431\u043E\u044E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0442\u0438\u0442\u044C \u043F\u0430\u043C\u044F\u0442\u044C \u043F\u043E\u0433\u0438\u0431\u0448\u0435\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430."
