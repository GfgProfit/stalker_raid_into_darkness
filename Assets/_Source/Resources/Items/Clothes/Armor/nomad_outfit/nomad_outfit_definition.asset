  m_Name: nomad_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: f4424ae2157c27842a8fac3b158d5c61
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\xBB"
  _shortName: MEDIUM
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u0448\u0438\u0442\u044B\u043C \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C, \u044D\u0442\u043E\u0442 \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043B\u0451\u0433\u043E\u043A \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0435\u043D \u043F\u0440\u0438 \u043D\u043E\u0448\u0435\u043D\u0438\u0438 - \u0438 \u044D\u0442\u043E \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u044C \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0441\u043A\u0438\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u043C\u0438. \u0422\u043E\u0442, \u043A\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u043B \u0435\u0433\u043E, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u043A\u043E\u043C \u0441 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438 \u0417\u043E\u043D\u044B \u0438, \u043F\u043E\u0445\u043E\u0436\u0435, \u0432\u043B\u043E\u0436\u0438\u043B \u0432 \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C \u0438 \u043B\u044E\u0431\u043E\u0432\u044C - \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u043C\u0443 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430. \u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435, \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \xAB\u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430\xBB \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0435\u0433\u043E \u0446\u0435\u043D\u0435."
