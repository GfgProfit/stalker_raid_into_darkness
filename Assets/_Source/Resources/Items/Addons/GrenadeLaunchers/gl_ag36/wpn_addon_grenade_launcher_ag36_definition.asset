  m_Name: wpn_addon_grenade_launcher_ag36_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c1cd9bb3b083de34dbdbbbe9d3207714
  _displayName: "40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 HK AG36"
  _shortName: AG36
  _description: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Heckler & Koch \u0434\u043B\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A G36 \u0438 G36K. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u044B 40x46 \u043C\u043C \u043D\u0438\u0437\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0435, \u0434\u044B\u043C\u043E\u0432\u044B\u0435, \u0433\u0430\u0437\u043E\u0432\u044B\u0435 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0442\u043A\u0438\u0434\u043D\u044B\u043C \u0432\u043B\u0435\u0432\u043E \u0441\u0442\u0432\u043E\u043B\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0443\u0434\u043E\u0431\u043D\u043E\u0435 \u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u0435 \u0441 \u043A\u0430\u0437\u0451\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u043C \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u043B\u0438\u043D\u044B. \u0418\u043C\u0435\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u0430\u043C\u043E\u0432\u0437\u0432\u043E\u0434\u043D\u044B\u0439 \u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C, \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 350 \u043C\u0435\u0442\u0440\u043E\u0432, \u043C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 1,5 \u043A\u0433. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0430 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043A\u0430\u043A \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435."
