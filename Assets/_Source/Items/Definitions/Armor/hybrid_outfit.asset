  m_Name: hybrid_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 361745f43395ad94794e4cd946176205
  _displayName: "\u0413\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C"
  _shortName: "\u0413\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C"
  _description: "\u0421\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439 \xAB\u0433\u0430\u0434\u043A\u0438\u0439 \u0443\u0442\u0451\u043D\u043E\u043A\xBB, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043A\u0438\u0435\u0432\u0441\u043A\u0438\u0445 \u043E\u0431\u043E\u0440\u043E\u043D\u043D\u044B\u0445 \u041D\u0418\u0418 \u0441 \u0446\u0435\u043B\u044C\u044E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u043E\u0445\u0440\u0430\u043D\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439 \u043D\u0430\u0443\u043A\u0438 \u0432 \u0417\u043E\u043D\u0435. \u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443, \u043A\u043E\u0441\u0442\u044E\u043C \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u0431\u044E\u0434\u0436\u0435\u0442\u043E\u043C, \u0442\u0430\u043A \u043A\u0430\u043A \u0431\u0440\u043E\u043D\u0435\u0432\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B, \u0432\u0448\u0438\u0442\u044B\u0435 \u0432 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0443, \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0434\u0435\u043B\u0430\u044E\u0442 \u0435\u0451 \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0439 \u043A \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043A\u0443\u0434\u0430 \u043C\u0435\u043D\u044C\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0436\u0438\u043B\u0435\u0442\u043E\u043C \u0441 \u0431\u0435\u0440\u0438\u043B\u043B\u0438\u0435\u0432\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C. \u0418 \u0445\u043E\u0442\u044F \u043D\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u043E\u0432 \u043D\u0435 \u0431\u044B\u043B \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0437\u0430\u043A\u0430\u0437\u0430\u043D \u0443\u043A\u0440\u0430\u0438\u043D\u0441\u043A\u0438\u043C \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437 \u043D\u0438\u0445 \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0443\u0442\u044F\u043C\u0438 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043F\u043E\u043F\u0430\u043B\u0438 \u0432 \u0417\u043E\u043D\u0443.\n\u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0445\u043E\u0442\u044F\u0442 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B, \u043D\u043E \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445 \u043D\u0430\u0439\u0442\u0438 \u0447\u0435\u0433\u043E-\u0442\u043E \u043B\u0443\u0447\u0448\u0435\u0433\u043E."
