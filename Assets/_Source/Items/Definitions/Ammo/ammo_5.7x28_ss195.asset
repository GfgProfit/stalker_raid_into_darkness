  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 5.7x28 \u043C\u043C \u042D\u041F"
  _shortName: "5.7x28 \u043C\u043C \u042D\u041F"
  _description: "5.7x28 \u043C\u043C \u043F\u0430\u0442\u0440\u043E\u043D, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u043F\u043E\u0434 \u0438\u043D\u0434\u0435\u043A\u0441\u043E\u043C SS195LF,
    \u0441 \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u043E\u0439
    \u043F\u0443\u043B\u0435\u0439 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E, \u0447\u0435\u043C
    SS190, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u043C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0438 \u0443\u0431\u043E\u0439\u043D\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>I
    (12)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0441\u0440\u0435\u0434\u043D\u0435\u0435
    (26)"
