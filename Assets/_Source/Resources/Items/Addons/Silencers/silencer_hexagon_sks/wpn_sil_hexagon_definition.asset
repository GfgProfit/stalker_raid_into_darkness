  m_Name: wpn_sil_hexagon_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 1cd45689bff868e4a971a5fd776d956d
  _displayName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \xAB\u0413\u0435\u043A\u0441\u0430\u0433\u043E\u043D\xBB 7,62\xD739 \u043C\u043C \u0434\u043B\u044F \u0421\u041A\u0421"
  _shortName: "\u0413\u0435\u043A\u0441\u0430\u0433\u043E\u043D"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u044A\u0451\u043C\u043D\u044B\u0439 \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0437\u0432\u0443\u043A\u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 \xAB\u0413\u0435\u043A\u0441\u0430\u0433\u043E\u043D\xBB \u0438\u0437 \u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433\u0430 \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0445 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u043E\u0432 \u0421\u0438\u043C\u043E\u043D\u043E\u0432\u0430 (\u0421\u041A\u0421) \u0438 \u0438\u0445 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435-\u043F\u0440\u043E\u043C\u044B\u0441\u043B\u043E\u0432\u044B\u0445 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0439 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 7,62\xD739 \u043C\u043C. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u0434\u043B\u044F \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u0438 \u043C\u0430\u0441\u0441\u0443 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0430, \u0441\u043C\u0435\u0449\u0430\u044F \u0435\u0433\u043E \u0446\u0435\u043D\u0442\u0440 \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0443\u0434\u0430\u0440\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430, \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0449\u0430\u044F \u043F\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u043F\u0443\u043B\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0448\u0443\u043C \u0440\u0430\u0431\u043E\u0442\u044B \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0438 \u043E\u0440\u0443\u0436\u0438\u044F."
