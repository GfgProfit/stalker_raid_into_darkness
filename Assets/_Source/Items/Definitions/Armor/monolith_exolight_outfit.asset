  _definitionId: a6a197a9b3193404b92204c94860bdee
  _displayName: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _shortName: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _description: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB, \u043F\u043E \u0441\u0443\u0442\u0438, \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u043C\u0441\u044F \u043F\u043E\u0434\u0434\u043E\u0441\u043F\u0435\u0448\u043D\u0438\u043A\u043E\u043C \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430. \u041F\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u043C \u0441\u0445\u043E\u0436 \u0441 \u043E\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u043E\u0432 \u0438 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u0441\u0438\u043B\u044B. \u0421 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043E\u043D \u0431\u043E\u043B\u0435\u0435 \u0434\u0435\u0448\u0451\u0432 \u0432 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438 \u0438 \u043D\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0431\u0435\u0433\u0430 \u0432 \u043D\u0451\u043C. \u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0441\u0440\u0435\u0434\u0438 \u043F\u0440\u043E\u043F\u043E\u0432\u0435\u0434\u043D\u0438\u043A\u043E\u0432 \u0438 \u0442\u0430\u043A\u0442\u0438\u043A\u043E\u0432 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0435\u0440\u044F\u0442 \u0432 \u043D\u0435\u0433\u043E \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E, \u043A\u0430\u043A \u0438 \u0432 \u043D\u0435\u043F\u0440\u0438\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C \u0421\u0430\u0440\u043A\u043E\u0444\u0430\u0433\u0430."
