  m_Name: freedom_patch
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 3700746a1e2e2ca49b357e446a2551a1
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: "\u0421\u0432\u043E\u0431\u043E."
  _description: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u043C\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u043D\u0430\u0448\u0438\u0432\u043A\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0432\u043E\u043B\u043A, \u0433\u0435\u0440\u0431 \u0438 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0444\u043B\u0430\u0433 \u0423\u043A\u0440\u0430\u0438\u043D\u044B, \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0435 \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C \u0444\u043E\u043D\u0435. \u0412 \u0446\u0435\u043B\u043E\u043C, \u0434\u0438\u0437\u0430\u0439\u043D \u043F\u0440\u0438\u0437\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB, \u0435\u0451 \u043B\u044E\u0431\u043E\u0432\u044C \u043A \u0440\u043E\u0434\u043D\u043E\u0439 \u0437\u0435\u043C\u043B\u0435, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0442\u0432\u0451\u0440\u0434\u043E\u0441\u0442\u044C, \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u043D\u0435\u043E\u0431\u0443\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0445\u0438\u0449\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0435\u0451 \u0431\u043E\u0439\u0446\u043E\u0432 \u0432 \u0431\u043E\u044E. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0443 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043A\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0442\u043E\u0433\u043E, \u0437\u0430\u0447\u0435\u043C \u0430\u043D\u0430\u0440\u0445\u0438\u0441\u0442\u0430\u043C \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0444\u043B\u0430\u0433 \u043A\u0430\u043A\u043E\u0439-\u043B\u044E\u0431\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u044B, \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u0439\u0441\u044F \u043A \u0442\u043E\u043C\u0443 \u0436\u0435 \u0435\u0449\u0451 \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C \u0438\u0445 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438."
