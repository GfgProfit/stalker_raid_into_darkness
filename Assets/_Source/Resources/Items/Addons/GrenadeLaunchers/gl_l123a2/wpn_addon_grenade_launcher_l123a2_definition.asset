  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 65b64ea245b9dfd4b8381fe224aaef9e
  _displayName: "40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 L123A2 UGL"
  _shortName: L123A2 UGL
  _description: "\u0411\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043D\u0435\u043C\u0435\u0446\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Heckler & Koch \u043D\u0430 \u0431\u0430\u0437\u0435 AG36. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 SA80, \u0432 \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438 L85A2. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u044B 40x46 \u043C\u043C \u043D\u0438\u0437\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0435 \u0438 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0442\u043A\u0438\u0434\u043D\u044B\u043C \u0432\u0431\u043E\u043A \u0441\u0442\u0432\u043E\u043B\u043E\u043C \u0434\u043B\u044F \u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F \u0441 \u043A\u0430\u0437\u0451\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C \u0436\u0438\u0432\u0443\u044E \u0441\u0438\u043B\u0443 \u0438 \u0446\u0435\u043B\u0438 \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0434\u043E 350 \u043C\u0435\u0442\u0440\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E\u043C \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438."
