  m_Name: gauss_sight
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 8181cebeead0e5340b5f73ba278b07f4
  _displayName: "\u0422\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Trijicon REAP-IR"
  _shortName: REAP-IR
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Trijicon \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0435, \u043C\u0430\u0440\u043A\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0435 \u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u0432 \u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u0438 \u043D\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043D\u0435\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0435\u043C\u044B\u043C \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u043C \u0441\u0435\u043D\u0441\u043E\u0440\u043E\u043C VOx \u0441 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C 640\xD7480 \u043F\u0438\u043A\u0441\u0435\u043B\u0435\u0439 \u0438 \u0448\u0430\u0433\u043E\u043C \u043F\u0438\u043A\u0441\u0435\u043B\u044F 12 \u043C\u043A\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u0445 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u0439 \u0432 \u043F\u043E\u043B\u043D\u043E\u0439 \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u0441\u043A\u0432\u043E\u0437\u044C \u043B\u0451\u0433\u043A\u0438\u0439 \u0434\u044B\u043C \u0438 \u043F\u044B\u043B\u044C. \u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 OLED-\u0434\u0438\u0441\u043F\u043B\u0435\u0439 \u0441 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043F\u043B\u043E\u0432\u044B\u0445 \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440, \u0432\u043A\u043B\u044E\u0447\u0430\u044F White Hot \u0438 Black Hot. \u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0434\u043E 8\xD7, \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u044B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0435 \u0441\u0435\u0442\u043A\u0438, \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430\u044F \u0432\u044B\u0432\u0435\u0440\u043A\u0430 \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439. \u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043E\u0442 \u0432\u043B\u0430\u0433\u0438, \u0443\u0434\u0430\u0440\u043E\u0432 \u0438 \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0431\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u044B\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F \u043F\u043B\u0430\u043D\u043A\u0438 Picatinny. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u0434\u0432\u0443\u0445 \u043B\u0438\u0442\u0438\u0435\u0432\u044B\u0445 \u0431\u0430\u0442\u0430\u0440\u0435\u0439 CR123 \u0441 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u0445. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E, \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439."
