  m_Name: bandit_nbc_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: b9737bc8677fb3f49893e35bf1705877
  _displayName: "\u0422\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0420\u0425\u0411\u0417"
  _shortName: MEDIUM
  _description: "\u041E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u0439 \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u043C\u0438 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438 \u0438 \u0438\u043C\u0435\u044E\u0449\u0438\u0439 \u0432 \u0441\u0432\u043E\u0451\u043C \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438 \u043A\u0435\u0432\u043B\u0430\u0440\u043E\u0432\u044B\u0439 \u0436\u0438\u043B\u0435\u0442, \u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0441\u0451 \u0436\u0435 \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u044B\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E. \u0412 \u043F\u043E\u043B\u044C\u0437\u0443 \u044D\u0442\u043E\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u0431\u0449\u0430\u044F \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430, \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0435\u0433\u043E \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u0437\u0430\u043B\u0430\u0442\u0430\u043B\u0438 \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0432 \u043D\u0451\u043C \u0436\u0435 \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E \u0445\u043E\u0437\u044F\u0438\u043D\u0430. \u0417\u0430\u0442\u043E \u0445\u043E\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0413\u041F-5 \u043D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435.\n\u041D\u0435\u043B\u044C\u0437\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043B\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0441 \u043A\u0430\u043A\u043E\u0439-\u043B\u0438\u0431\u043E \u0437\u0430\u0431\u043E\u0442\u043E\u0439 \u0438\u043B\u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C\u044E, \u043D\u043E \u043E\u043D \u0432\u0441\u0451 \u0436\u0435 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0443\u0441\u043F\u0435\u0445\u043E\u043C \u0443 \u0440\u044F\u0434\u0430 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E \u0434\u0443\u0448\u0435 \u0435\u0433\u043E \u0447\u0443\u0434\u043E\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0430\u044F\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0432\u0435\u0441\u0430."
