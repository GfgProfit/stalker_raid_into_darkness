    "m_FunctionName": "GazirovkaDistortion",
    "m_FunctionSource": "",
    "m_FunctionBody": "float4 texel = SAMPLE_TEXTURE2D(Texture.tex, Texture.samplerstate, UV);\nfloat mask = texel.a * Alpha;\n#ifndef SHADERGRAPH_PREVIEW\nclip(mask - 0.001);\n#endif\nDistortion = (texel.rg * 2.0 - 1.0) * Strength * mask;"
}

