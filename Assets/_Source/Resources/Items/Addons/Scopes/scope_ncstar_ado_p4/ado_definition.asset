  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: ado
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: b8f7a32877cf9f944a197c0a2dea0985
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B NcSTAR ADO 3\u20139x42 P4"
  _shortName: ADO P4
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 3x \u0434\u043E 9x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 NcSTAR. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445, \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 42-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C, \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 P4 Sniper \u0441 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u043E\u0439 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0438 \u0441\u0438\u043D\u0435\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u043C \u043E\u0442\u043A\u0438\u0434\u043D\u044B\u043C \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1x. \u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u0438\u0438 \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u043E\u0433\u043E \u0441\u0442\u0435\u043A\u043B\u0430 \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0435\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043D\u0438\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443 \u0442\u043E\u0447\u043D\u044B\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435\u043C \u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u043E\u0439 \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0431\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0438\u043C\u0435\u044E\u0442 \u043F\u044F\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u044F\u0440\u043A\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u043E\u043F\u0442\u0438\u043A\u0430 \u0438\u043C\u0435\u0435\u0442 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u044F\u044E\u0449\u0435\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0431\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u044B\u043C \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F \u043F\u043B\u0430\u043D\u043E\u043A Weaver/Picatinny. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0442\u0438\u0435\u0432\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR123A. \u041C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 595 \u0433\u0440\u0430\u043C\u043C\u043E\u0432."
