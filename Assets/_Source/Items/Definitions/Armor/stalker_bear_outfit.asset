  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: stalker_bear_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 0fc7f86caf35116419fa8e0756782c7d
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u0435\u0434\u0432\u0435\u0434\u044C\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u0435\u0434\u0432\u0435\u0434\u044C\xBB"
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u043D\u0430 \u0431\u0430\u0437\u0435 \xAB\u0417\u0430\u0440\u0438\xBB. \u041E\u0442
    \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u0432 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0432\u0435\u0441\u043E\u043C,
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u0438 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0435\u0439.
    \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u0430\u044F
    \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0435
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E
    \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u0442\u043A\u0430\u043D\u0435\u0439,
    \u0430 \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0431\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u043E\u0433\u043E
    \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u043C\u0435\u0442\u043E\u0434\u043E\u043C \u043F\u0440\u043E\u0431 \u0438 \u043E\u0448\u0438\u0431\u043E\u043A.
    \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u043C
    \xAB\u041C\u0435\u0434\u0432\u0435\u0434\u044F\xBB \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0435\u0433\u043E \u0441\u043B\u0430\u0431\u044B\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430. \u0420\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D
    \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u044E\u0449\u0438\u0445 \u0440\u0435\u0439\u0434\u044B
    \u043A \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F\u043C
    \u043D\u0430 \u042F\u043D\u0442\u0430\u0440\u0435."
