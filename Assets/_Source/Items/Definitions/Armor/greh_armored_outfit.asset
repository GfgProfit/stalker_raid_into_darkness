  m_Name: greh_armored_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 9c16d76436d5b204f939ba87f39137e3
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u044F \xAB\u0413\u0440\u0435\u0445\u0430\xBB"
  _shortName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u044F \xAB\u0413\u0440\u0435\u0445\u0430\xBB"
  _description: "\u0423\u0434\u043E\u0431\u043D\u044B\u0439 \u0438 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439
    \u0434\u043B\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0433\u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439
    \xAB\u0413\u0440\u0435\u0445\u0430\xBB \u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0438\u0437 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430, \u043D\u0430\u0434\u0435\u0442\u043E\u0433\u043E
    \u043F\u043E\u0432\u0435\u0440\u0445 \u043A\u043E\u0441\u0442\u044E\u043C\u0430.
    \u0425\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442
    \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443, \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u044F
    \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u0439\u043A\u0438\u0445
    \u0432\u043E\u0438\u043D\u043E\u0432 \xAB\u0413\u0440\u0435\u0445\u0430\xBB \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043D\u0430\u043B\u0438\u0447\u0438\u044E \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B."
