  m_Name: ammo_og-7b
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 8a330cc03a190084c9e3608c101260eb
  _displayName: "\u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u041E\u0413-7\u0412 \xAB\u041E\u0441\u043A\u043E\u043B\u043E\u043A\xBB (7\u041F50)"
  _shortName: "\u041E\u0413-7\u0412"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 40-\u043C\u043C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u041E\u0413-7\u0412 \xAB\u041E\u0441\u043A\u043E\u043B\u043E\u043A\xBB, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0413\u041D\u041F\u041F \xAB\u0411\u0430\u0437\u0430\u043B\u044C\u0442\xBB \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0432 1999 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0439\u0441\u044F \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0432 \u043E\u043A\u043E\u043F\u0430\u0445, \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u0445 \u0438 \u0437\u0434\u0430\u043D\u0438\u044F\u0445. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0440\u0443\u0447\u043D\u044B\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430\u0445 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0420\u041F\u0413-7. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u043F\u0440\u0438 \u0434\u0435\u0442\u043E\u043D\u0430\u0446\u0438\u0438 \u043F\u043B\u043E\u0442\u043D\u043E\u0435 \u043F\u043E\u043B\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u044B\u0445 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u041F\u0413-7, \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043A\u0443\u043C\u0443\u043B\u044F\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u0430 \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F, \u043F\u043E\u043B\u0443\u0447\u0430\u044F \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043E\u0442 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u0430. \u041C\u0430\u0441\u0441\u0430 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 2 \u043A\u0433. \u041F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 280 \u043C\u0435\u0442\u0440\u043E\u0432 \u0438\u0437 \u0420\u041F\u0413-7\u0412, 350 \u043C\u0435\u0442\u0440\u043E\u0432 \u0438\u0437 \u0420\u041F\u0413-7\u04121 \u0438 700 \u043C\u0435\u0442\u0440\u043E\u0432 \u043F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0423\u041F-7\u0412. \u0417\u0430\u044F\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0439 \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u0432 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430\u0445 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u043E 150 \u043A\u0432. \u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432 \u0433\u0440\u0443\u043F\u043F\u043E\u0432\u044B\u0445 \u0446\u0435\u043B\u0435\u0439 \u0438 \u043D\u0435\u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u043E\u0440\u044C\u0431\u044B \u0441 \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0439."
