#pragma kernel WeatherEnvironment
#define _MONOLITH_ORIGINAL_ENVIRONMENT
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"
#include "../../Runtime/Shaders/MonolithProperties.hlsl"
#include "../../Runtime/Shaders/MonolithMaterial.hlsl"
#include "../../Runtime/Shaders/MonolithTrueStalkerTerrain.hlsl"
#include "../../Runtime/Shaders/MonolithEnvironment.hlsl"

RWStructuredBuffer<float4> Output;

[numthreads(1, 1, 1)]
void WeatherEnvironment(uint3 id : SV_DispatchThreadID)
{
    MonolithEnvironmentData data = MonolithEvaluateEnvironment(float3(0.0, 1.0, 0.0), float3(0.0, 1.0, 0.0), float4(0.5, 0.5, 0.5, 0.2));
    Output[0] = float4(data.diffuseSample, 1.0);
    Output[1] = float4(data.diffuseIrradiance, 1.0);
    Output[2] = float4(data.mipViewHemi, 1.0);
}
