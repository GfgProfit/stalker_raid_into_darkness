  m_Name: merc_scientific_armored_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 60c8e6de1404e704c9b381e31a8bc5df
  _displayName: "\u0411\u043E\u0435\u0432\u0430\u044F \xAB\u0421\u0415\u0412\u0410\xBB \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u0411\u043E\u0435\u0432\u0430\u044F \xAB\u0421\u0415\u0412\u0410\xBB \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _description: "\u0411\u043E\u0435\u0432\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \xAB\u0421\u0415\u0412\u042B\xBB, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u043E \u0437\u0430\u043A\u0430\u0437\u0443 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u0443\u0433\u043E\u0434\u0443 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0431\u0440\u043E\u043D\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u0431\u044B \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u044F \u043D\u0430 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u0432\u0435\u0442\u0435\u0440\u0430\u043D\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u043E\u0445\u0440\u0430\u043D\u043E\u0439 \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439, \u0442\u0430\u043A \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u0437\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\u043C\u0438, \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u044F\u044E\u0449\u0438\u043C\u0438 \u0432 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u0445 \u0417\u043E\u043D\u044B. \u0412 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0442\u0435\u0440\u043C\u043E- \u0438 \u0445\u0438\u043C\u0437\u0430\u0449\u0438\u0442\u044B \u0434\u043B\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u043A\u043B\u0430\u0441\u0441\u0430 \xAB\u0421\u0415\u0412\u0410\xBB, \u043E\u0434\u043D\u0430\u043A\u043E \u0434\u043B\u044F \u0432\u044B\u043B\u0430\u0437\u043E\u043A \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u043E\u043D\u044B \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u043E\u043B\u0443\u0447\u0448\u0435 - \u0431\u043B\u0430\u0433\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0435\u0441\u0442\u044C \u0438\u0437 \u0447\u0435\u0433\u043E."
