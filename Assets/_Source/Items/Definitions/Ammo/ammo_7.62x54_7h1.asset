  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ffb2775c2a07a234d8b65165d2a5d608
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x54 \u043C\u043C
    7\u041D1"
  _shortName: "7,62x54 \u043C\u043C 7\u041D1"
  _description: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430
    7,62x54 \u043C\u043C \u0441 \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u043E-\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u0421\u0412\u0414. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043D\u043E\u0433\u043E
    \u043F\u0430\u0442\u0440\u043E\u043D\u0430, 7\u041D1 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043A\u0443\u0447\u043D\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u044B\u0435
    \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u044B\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>II
    (20)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (115)"
