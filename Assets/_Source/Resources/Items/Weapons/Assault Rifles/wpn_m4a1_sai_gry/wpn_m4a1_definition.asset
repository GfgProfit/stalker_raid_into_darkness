  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_m4a1_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 9fedd9cbfee72a24f9ddd01ad929cb05
  _displayName: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 M4A1 SAI GRY"
  _shortName: "\u041C4\u04101 SAI GRY"
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0430\u044F \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 \u043F\u043E\u0434 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 5,56x45 \u043C\u043C NATO, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F \u0441\u043E\u0431\u043E\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 M4A1 \u0441 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C\u0438 \u0441\u0435\u0440\u0438\u0438 GRY, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u043C\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Salient Arms International (SAI) \u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u0432 2015 \u0433\u043E\u0434\u0443. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435 AR-15 \u0441 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043F\u043E\u0434\u0432\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u043A \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0440\u0430\u043C\u0435 \u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0439 \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u043E\u0439 \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0432\u044B\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u043C \u0431\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u044B\u043C \u0446\u0435\u0432\u044C\u0451\u043C, \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u044B\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C \u0441 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u044B\u043C\u0438 \u0434\u043E\u043B\u0430\u043C\u0438 \u0438 \u0443\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u043E\u0439. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u043E\u0435 \u0434\u0443\u043B\u044C\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E JailBrake, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0435 \u0432 \u0432\u0438\u0434\u0435 \u043A\u043E\u0436\u0443\u0445\u0430, \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0435\u0433\u043E \u0434\u0443\u043B\u044C\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0441\u0442\u0432\u043E\u043B\u0430 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u044F \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0438 \u043E\u0442\u0434\u0430\u0447\u0438. \u041E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C, \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u044F\u0442\u044C\u044E \u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 Picatinny. \u0412 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u043D\u0430 \u0431\u0430\u0437\u0435 M4A1 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C\u044B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 STANAG \u0448\u0442\u0430\u0442\u043D\u043E\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432."
