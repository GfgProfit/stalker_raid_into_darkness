  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: itm_backpack
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 92368dd5413dde24392a0b2a2ec9867a
  _displayName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0432\u0435\u0449\u0435\u0432\u043E\u0439 \u043C\u0435\u0448\u043E\u043A \u0412\u041A\u0411\u041E"
  _shortName: "\u0412\u041A\u0411\u041E"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0432\u0435\u0449\u043C\u0435\u0448\u043E\u043A, \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u0441\u0435\u0441\u0435\u0437\u043E\u043D\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430 \u0431\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u043E\u0431\u043C\u0443\u043D\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F (\u0412\u041A\u0411\u041E) \u0412\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u0441\u0438\u043B \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0439 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0438 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043B\u0438\u0447\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0439 \u0432\u043E\u0435\u043D\u043D\u043E\u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445, \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u043E\u0431\u043C\u0443\u043D\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0439 \u043D\u0430 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u0443\u044E \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0418\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0437 \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0442\u043A\u0430\u043D\u0438, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0439 \u043A \u0438\u0441\u0442\u0438\u0440\u0430\u043D\u0438\u044E \u0438 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u043C\u0443 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u0432\u043B\u0430\u0433\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435\u043C \u0441 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0437\u0430\u0442\u044F\u0436\u043D\u043E\u0439 \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u043E\u0439, \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043A\u043B\u0430\u043F\u0430\u043D\u043E\u043C, \u0440\u0443\u0447\u043A\u0430\u043C\u0438 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043A\u0438 \u0438 \u043F\u043B\u0435\u0447\u0435\u0432\u044B\u043C\u0438 \u043B\u044F\u043C\u043A\u0430\u043C\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u043C\u0438 \u043D\u043E\u0441\u0438\u0442\u044C \u043C\u0435\u0448\u043E\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044E \u0441\u043B\u043E\u0436\u043D\u043E\u0433\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u043A\u0430\u0440\u043A\u0430\u0441\u0430 \u0438 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0434\u043B\u044F \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043B\u0438\u0447\u043D\u043E\u0433\u043E \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u0435, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0443 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0443\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0440\u044E\u043A\u0437\u0430\u043A\u0430\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C\u044E, \u043D\u0435\u043F\u0440\u0438\u0445\u043E\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E \u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439."
