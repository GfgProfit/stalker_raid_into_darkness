  m_Name: wpn_sa58_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 20ef3f26ad5848c48e6cf3429e46fc98
  _displayName: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 DS Arms SA58"
  _shortName: SA-58
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0430\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 7,62x51 \u043C\u043C NATO, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 DS Arms \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0431\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u043E\u0439 FN FAL. \u041F\u0440\u0438 \u0435\u0451 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435, \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0451\u043D\u043D\u043E\u0435 \u0443 \u0430\u0432\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Steyr-Daimler-Puch, \u0440\u0430\u043D\u0435\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0432\u0448\u0435\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 StG 58. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u043E\u0442\u0432\u043E\u0434\u0435 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0445\u043E\u0434\u043E\u043C \u0433\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u043F\u043E\u0440\u0448\u043D\u044F \u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u043E\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u0430. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u044B\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C, \u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u0443\u044E \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u0438, \u0432 \u0440\u044F\u0434\u0435 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0439, \u043A\u043E\u0440\u043F\u0443\u0441 \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430 \u0438\u0437 \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430. \u0412\u043E\u0435\u043D\u043D\u044B\u0435 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B 650\u2013750 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0445 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 FAL \u0448\u0442\u0430\u0442\u043D\u043E\u0439 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 20 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441\u0442\u0432\u043E\u043B\u0430\u043C\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u043B\u0438\u043D\u044B, \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u0438\u043B\u0438 \u0441\u043A\u043B\u0430\u0434\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u0430\u043C\u0438 \u0438 \u043F\u043B\u0430\u043D\u043A\u0430\u043C\u0438 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u0443\u044E \u043E\u0442\u0434\u0430\u0447\u0443, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u0440\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435."
