  m_Name: point_aimpro
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7171929d93afadf4292ef79ac4b0d176
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Aimpoint PRO"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Aimpoint PRO"
  _description: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Aimpoint Patrol Rifle Optic (PRO) \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u043F\u0440\u0438 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u0438\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0442\u043E\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u043E\u0432 \u0441\u043F\u0435\u0446\u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439, \u043A\u0430\u043A \u0431\u044B\u0432\u0448\u0438\u0445, \u0442\u0430\u043A \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445. \u041E\u043D \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u0440\u0430\u043D\u0435\u0435 \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435 \u0432 \u043F\u0440\u0438\u0446\u0435\u043B\u0430\u0445 Aimpoint, \u0434\u043B\u044F \u043C\u0430\u043A\u0441\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438 \u0440\u0430\u0431\u043E\u0447\u0438\u0445 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u043F\u0440\u0438\u0446\u0435\u043B\u0430, \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043E\u0440\u0433\u0430\u043D\u0430\u043C \u043F\u0440\u0430\u0432\u043E\u043F\u043E\u0440\u044F\u0434\u043A\u0430. \u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440 Aimpoint PRO, \u043E\u0441\u043D\u043E\u0432\u0430\u043D \u043D\u0430 \u0437\u0430\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0432\u0448\u0438\u0445 \u0441\u0435\u0431\u044F \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u0445 Aimpoint \u0438 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u0438\u0445 \u0432\u043C\u0435\u0441\u0442\u0435 \u0432 \u0433\u043E\u0442\u043E\u0432\u044B\u0439 \u043A \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441. \u041F\u043E\u043B\u043D\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u043C\u0430\u044F \u0441\u0444\u0435\u0440\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F - \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0434\u043B\u044F \u043F\u0430\u0442\u0440\u0443\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u0440\u0430\u0437\u0443\u043C\u0435\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0435, \u0432\u043E\u0435\u043D\u043D\u043E\u0435 (\u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435) \u043E\u0440\u0443\u0436\u0438\u0435, \u043D\u043E \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430 \u044D\u0442\u0438\u043C! \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0441 \u043B\u0435\u0433\u043A\u043E\u0441\u0442\u044C\u044E \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0430 \u043B\u044E\u0431\u043E\u0435 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435 \u043E\u0440\u0443\u0436\u0438\u0435, \u0438\u043C\u0435\u044E\u0449\u0435\u0435 \u043F\u043B\u0430\u043D\u043A\u0443 \u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438/\u0412\u0438\u0432\u0435\u0440."
