  m_Name: light_freedom_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b18677e3b3f23fe4ea5d79b99bb0bbb9
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \xAB\u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A
    \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \xAB\u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A
    \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _description: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043A\u043E\u0441\u0442\u044E\u043C
    \u0441 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C
    IBA \xAB\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\xBB,
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0441\u043E\u0431\u044B\u0445
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u0417\u043E\u043D\u044B. \u041F\u043E \u0441\u043B\u0443\u0445\u0430\u043C,
    \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0435
    \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u043E\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
    \u0441\u043F\u043E\u043D\u0441\u043E\u0440\u0430. \u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E
    \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
    \u0437\u0430\u0449\u0438\u0442\u044B, \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F,
    \u0447\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0435\u0433\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0417\u043E\u043D\u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0438 \u0434\u043E\u043B\u0436\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043E\u043A
    \u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0439 \u043D\u0430 \u0441\u043B\u0430\u0431\u043E
    \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
