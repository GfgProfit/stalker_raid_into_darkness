  _displayName: "\u0414\u0443\u043B\u044C\u043D\u044B\u0439 \u0442\u043E\u0440\u043C\u043E\u0437
    \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440 \u0420\u043E\u0442\u043E\u0440
    43 7.62x54"
  _shortName: "\u0414\u0443\u043B\u044C\u043D\u044B\u0439 \u0442\u043E\u0440\u043C\u043E\u0437
    \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440 \u0420\u043E\u0442\u043E\u0440
    43 7.62x54"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C> 7.62 \u043A\u0430\u043B\u0438\u0431\u0440\n\n<color=#AAAAAA>\u0414\u0443\u043B\u044C\u043D\u044B\u0439
    \u0442\u043E\u0440\u043C\u043E\u0437-\u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440
    \u0420\u043E\u0442\u043E\u0440 43 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430
    \u0421\u0412\u0414-\u0421 7.62x54. \u041F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0438\u043C\u0435\u043D\u043D\u043E \u043A\u0430\u043A \u0414\u0422\u041A, \u043D\u043E
    \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0442\u0430\u043A \u0436\u0435 \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u0437\u0432\u0443\u043A \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430.\n\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0413\u043B\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u043A\u0430:
    <color=#AAAAAA>\u043D\u0438\u0437\u043A\u043E\u0435"
