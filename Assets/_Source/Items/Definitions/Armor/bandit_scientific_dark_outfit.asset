  m_Name: bandit_scientific_dark_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: be7104b1484c7e84f98de2596cd045f1
  _displayName: "\u041A\u0443\u0441\u0442\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0441 \u0417\u0421\u0414"
  _shortName: "\u041A\u0443\u0441\u0442\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0441 \u0417\u0421\u0414"
  _description: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0441\u0445\u043E\u0436\u0438\u0439 \u0441 \u043E\u043D\u044B\u043C\u0438 \u043A\u043B\u0430\u0441\u0441\u0430 \xAB\u0421\u0415\u0412\u0410\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0441 \u043D\u0443\u043B\u044F \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u0445 \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0432 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u043C\u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442 \u043A \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C \u0432 \u043F\u043E\u0431\u0438\u0442\u043E\u043C \u0432\u0438\u0434\u0435, \u0434\u0430\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445, \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445, \u043F\u0441\u0438- \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0443\u0433\u0440\u043E\u0437. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0441\u0451 \u0436\u0435 \u0434\u0430\u0451\u0442 \u043E \u0441\u0435\u0431\u0435 \u0437\u043D\u0430\u0442\u044C. \u0421\u0442\u0438\u043B\u044C\u043D\u044B\u0439 \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u0438\u0440\u0430."
