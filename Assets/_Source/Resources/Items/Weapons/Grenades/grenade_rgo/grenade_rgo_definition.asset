  m_Name: grenade_rgo_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 0cb36e84d68e52945a05bfd7f37211ae
  _displayName: "\u0420\u0443\u0447\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0420\u0413\u041E"
  _shortName: "\u0420\u0413\u041E"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u0440\u0443\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u0435\u0445\u043E\u0442\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0443\u0434\u0430\u0440\u043D\u043E-\u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u0443\u0447\u043D\u043E-\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\u043C \xAB\u0411\u0430\u0437\u0430\u043B\u044C\u0442\xBB \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u0430\u044F \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0432 1981 \u0433\u043E\u0434\u0443. \u0421\u043E\u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044C \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0431\u043E\u043B\u0435\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u044B \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u0435 \u0424-1. \u0418\u043C\u0435\u0435\u0442 \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C \u0440\u0438\u0444\u043B\u0435\u043D\u0438\u0435\u043C \u043D\u0438\u0436\u043D\u0435\u0439 \u043F\u043E\u043B\u0443\u0441\u0444\u0435\u0440\u044B, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u043C \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0438 \u0442\u0430\u043A\u0442\u0438\u043B\u044C\u043D\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C \u0435\u0451 \u043E\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0420\u0413\u041D. \u041C\u0430\u0441\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 530 \u0433, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 60 \u043C\u043C. \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u043C \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u0438, \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0449\u0438\u0435\u0441\u044F \u043F\u0440\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0434\u0430\u0440\u043D\u043E-\u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u044B\u043C \u0437\u0430\u043F\u0430\u043B\u043E\u043C \u0423\u0414\u0417, \u043E\u0431\u0449\u0438\u043C \u0441 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0439 \u0420\u0413\u041D. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0420\u0413\u041D, \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0437\u0430 \u0441\u0447\u0451\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0424-1 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0438 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C \u0434\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u044F \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0420\u043E\u0441\u0441\u0438\u0438 \u0438 \u0440\u044F\u0434\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432 \u043F\u043E\u0441\u0442\u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430."
