  m_Name: helm_tactic
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 763382b9e65aa424c943568d0ff30e65
  _displayName: "\u0428\u043B\u0435\u043C \xAB\u0421\u0444\u0435\u0440\u0430 08\xBB"
  _shortName: "\u0428\u043B\u0435\u043C \xAB\u0421\u0444\u0435\u0440\u0430 08\xBB"
  _description: "\u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0448\u043B\u0435\u043C \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0433\u043E
    \u043E\u0431\u0440\u0430\u0437\u0446\u0430 \u0441\u043E \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u0438
    \u0432\u043E\u0437\u0434\u0443\u0445\u0430. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0441\u043B\u043E\u0451\u0432 \u043A\u0435\u0432\u043B\u0430\u0440\u0430 \u0434\u043B\u044F
    \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
    \u043E\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0445 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439. \u0421\u0430\u043C
    \u0436\u0435 \u0448\u043B\u0435\u043C \u0441\u0434\u0435\u043B\u0430\u043D \u0438\u0437
    \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0434\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0443\u044E
    \u0437\u0430\u0449\u0438\u0442\u0443 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
    \u043E\u0442 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0442\u043E\u043A\u0430 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E\u043C
    \u0441\u0432\u043E\u0438\u0445 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432.
    \u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D
    \u0441\u0440\u0435\u0434\u0438 \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432
    \u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0448\u043B\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430\u043C\u0438
    \u0441\u0435\u0440\u0438\u0438 \u041F\u0421\u0417."
