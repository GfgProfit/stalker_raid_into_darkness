  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 2f7a847d1c5c7de45ab7978b133b30d8
  _displayName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 IBA-\u0417"
  _shortName: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 IBA-\u0417"
  _description: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u0441 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C IBA \xAB\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\xBB, \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043A \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C \u0417\u043E\u043D\u044B (IBA-\u0417). \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C IBA \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0439 \u043A\u043E\u043C\u0444\u043E\u0440\u0442 \u043F\u0440\u0438 \u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0438 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043B\u0443\u0447\u0448\u0443\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443. \u0420\u0435\u0434\u043A\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0412\u0421\u0423 \u0434\u043B\u044F \u0432\u043E\u0435\u043D\u0441\u0442\u0430\u043B\u043E\u0432, \u0447\u0442\u043E \u0443\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u0430\u0445, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u043C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0432 \u0441\u0432\u043E\u0451 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0431\u0440\u043E\u043D\u0438 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0430."
