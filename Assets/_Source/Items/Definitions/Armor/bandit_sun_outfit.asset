  m_Name: bandit_sun_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5cd4ddbda0f1dba4da739942473b94a4
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0447\u0435\u0440\u043D\u044F\u044F
    \u0437\u0430\u0440\u044F\xBB"
  _shortName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0412\u0435\u0447\u0435\u0440\u043D\u044F\u044F
    \u0437\u0430\u0440\u044F\xBB"
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D.
    \u0414\u0438\u0437\u0430\u0439\u043D \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u0442\u0430\u043A\u043E\u0432\u044B\u0435 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u0441\u0442\u044E\u043C\u0430
    \u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB
    \u0441 \u0442\u043E\u0439 \u043B\u0438\u0448\u044C \u0440\u0430\u0437\u043D\u0438\u0446\u0435\u0439,
    \u0447\u0442\u043E \u0432 \xAB\u0412\u0435\u0447\u0435\u0440\u043D\u0435\u0439
    \u0437\u0430\u0440\u0435\xBB \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u043E\u0431\u0449\u0438\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
    \u0437\u0430\u0449\u0438\u0442\u044B. \u0412\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E
    \u043E\u043D \u0438\u043C\u0435\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E, \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0449\u0443\u044E
    \u043A\u0430\u043A \u043E\u0442 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445,
    \u0442\u0430\u043A \u0438 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0443\u0433\u0440\u043E\u0437. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438
    \u0432 \u0422\u0451\u043C\u043D\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u0435,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u0430\u0440\u0430\u044E\u0442\u0441\u044F
    \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435
    \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043E\u0442 \u043D\u0435\u0437\u0432\u0430\u043D\u044B\u0445
    \u0433\u043E\u0441\u0442\u0435\u0439 \u0432 \u0432\u0438\u0434\u0435 \u043F\u043E\u043B\u0442\u0435\u0440\u0433\u0435\u0439\u0441\u0442\u043E\u0432,
    \u0432\u044B\u043B\u0435\u0437\u0448\u0438\u0445 \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0438\u0437 \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438."
