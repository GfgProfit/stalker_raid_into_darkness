  _definitionId: c0a6c5a727319aa42a8f0b6f659f5842
  _displayName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _shortName: "\u041D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _description: "\u0418\u043C\u0435\u0435\u0442 \u0432 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0436\u0438\u043B\u0435\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u0443\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 - \u0446\u0435\u043D\u043E\u0439 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0442\u0430\u043B\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u0441\u0438-\u0437\u0430\u0449\u0438\u0442\u044B. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 \xAB\u0421\u0415\u0412\u042B\xBB. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0441\u043A\u0438\u043C \u0431\u0430\u0439\u043A\u0430\u043C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C\u0438 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u044B \u043A \xAB\u0412\u044B\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044E \u043C\u043E\u0437\u0433\u043E\u0432\xBB, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0439 \u044D\u0442\u043E\u043C\u0443 \u043D\u0435\u0442."
