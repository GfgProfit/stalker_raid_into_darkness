  m_Name: svoboda_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 53043219be5db474a887bc1928b73d62
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \xAB\u0411\u0430\u0441\u0442\u0438\u043E\u043D \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \xAB\u0411\u0430\u0441\u0442\u0438\u043E\u043D \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _description: "\u041E\u0434\u043D\u0430 \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0430\u0431\u043E\u0442 \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0432 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB. \u041F\u043E\u0441\u043B\u0435 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u0432 \u0441 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0439 \u0438\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u0434\u0430\u0447\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E. \u041F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u043C\u043E\u0449\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C, \u0434\u0430\u0436\u0435 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043B\u0438\u0448\u044C \u0441\u0430\u043C\u044B\u043C\u0438 \u043B\u0443\u0447\u0448\u0438\u043C\u0438 \u0431\u043E\u0439\u0446\u0430\u043C\u0438 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB.\n\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u044B, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u043D\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437 \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u0442\u0435\u0439: \u044D\u043A\u0437\u043E\u0448\u043B\u0435\u043C, \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C \u0438\u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u0430."
