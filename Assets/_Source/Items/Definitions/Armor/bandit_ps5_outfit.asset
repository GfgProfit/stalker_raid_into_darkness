  _displayName: "\u0411\u0430\u043D\u0434\u0438\u0442\u0441\u043A\u0438\u0439 \u041F\u04215-\u041C"
  _shortName: "\u0411\u0430\u043D\u0434\u0438\u0442\u0441\u043A\u0438\u0439 \u041F\u04215-\u041C"
  _description: "\u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0433\u043E \u041F\u04215-\u041C \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043F\u0430\u043B \u0432 \u0440\u0443\u043A\u0438 \u043A \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C \u0447\u0435\u0440\u0435\u0437 \u0440\u044F\u0434 \u0433\u0440\u044F\u0437\u043D\u044B\u0445 \u0441\u0434\u0435\u043B\u043E\u043A \u0441 \u043A\u043E\u0440\u0440\u0443\u043C\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0446\u0435\u043C \xAB\u0414\u043E\u043B\u0433\u0430\xBB \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u041C\u043E\u0440\u0433\u0430\u043D. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0441\u0442\u0430\u043B \u0431\u043E\u043B\u0435\u0435 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432 \u043A \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E, \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0433\u0440\u043E\u0437. \u0422\u0430\u043A \u043A\u0430\u043A \u0441\u0431\u044B\u0442\u044B\u0435 \u041F\u04215-\u041C \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0442\u0435\u043C\u043E\u0439 \xAB\u0414\u043E\u043B\u0433\u0430\xBB, \u0431\u043E\u0439\u0446\u044B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0441\u0442\u0430\u0440\u0430\u044E\u0442\u0441\u044F \u0432\u0441\u0435\u043C\u0438 \u0441\u0438\u043B\u0430\u043C\u0438 \u0438\u0437\u044A\u044F\u0442\u044C \u0443 \u0430\u043D\u0430\u0440\u0445\u0438\u0441\u0442\u043E\u0432, \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0438 \u043F\u0440\u043E\u0447\u0438\u0445 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0434\u0430\u043D\u043D\u044B\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B."
