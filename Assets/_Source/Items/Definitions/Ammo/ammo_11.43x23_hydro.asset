  _definitionId: ef85f1732e538a54c9d3bddaf12ffc3f
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .45 ACP (11,43x23 \u043C\u043C)
    Hydra-shock"
  _shortName: .45 Hydra-shock
  _description: "\u041D\u0435\u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u0442\u0438\u043F \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u0434\u043B\u044F
    \u043A\u0430\u043B\u0438\u0431\u0440\u0430 .45 ACP (11,43x23 \u043C\u043C) -
    \u043F\u043E\u043B\u0443\u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u0430\u044F
    \u043F\u0443\u043B\u044F \u0441 \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u043E\u0439
    \u0432\u044B\u0435\u043C\u043A\u043E\u0439 \u0438 \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u042D\u0442\u043E\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u043F\u043E\u043B\u0443\u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439
    \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u043E\u0439 \u0438
    \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u043E\u0439 \u043F\u0443\u043B\u0438
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B \u043A\u0430\u043A
    \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430, \u0442\u0430\u043A
    \u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u043E\u0431\u043E\u0438\u0445
    \u0442\u0438\u043F\u043E\u0432 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0438: (9)\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (82)"
