  m_Name: monolith_scientific_light_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5770d69719b40ce4d9ebb8d8a5ed3192
  _displayName: "\u041A\u0443\u0441\u0442\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _shortName: "\u041A\u0443\u0441\u0442\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _description: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0441\u0445\u043E\u0436\u0438\u0439 \u0441 \u043E\u043D\u044B\u043C\u0438 \u043A\u043B\u0430\u0441\u0441\u0430 \xAB\u0421\u0415\u0412\u0410\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0441 \u043D\u0443\u043B\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u043C. \u041B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439 \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB, \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0433\u0440\u043E\u0437. \u041D\u0430 \u044D\u0442\u043E\u043C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0432\u0441\u0435 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F.\n\u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043B\u0438\u0448\u044C \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439, \u0432 \u0447\u0451\u043C \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0435\u0433\u043E \u0440\u043E\u043B\u044C, \u043E\u0434\u043D\u0430\u043A\u043E \u0445\u043E\u0434\u044F\u0442 \u0441\u043B\u0443\u0445\u0438, \u0447\u0442\u043E \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043B\u0438\u0448\u044C \u0432 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u043B\u0443\u0447\u0430\u044F\u0445."
