  m_ActivationSlot: {fileID: 114350483966679623}
  m_BlockName: Retire idle particles
  m_HLSLCode: "void RetireGazirovkaIdle1(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float stepTime)\n{\n    attributes.alive = attributes.alive && attributes.age + stepTime <= attributes.lifetime;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[counterOffset + 1u], 0xffffffffu);\n    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: RetireGazirovkaIdle1
    selectedIndex: 0
