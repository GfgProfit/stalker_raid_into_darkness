  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: svoboda_heavy_outfit_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: bdd55cb4621aba64e84c31ac675656d6
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0421\u0442\u0440\u0430\u0436 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: MEDIUM
  _description: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430, \xAB\u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0439\xBB \u043E\u0442 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430. \u0414\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0442\u043A\u0430\u043D\u044C \u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C \xAB\u0421\u0443\u0432\u0435\u0440\u0435\u043D\xBB, \u0442\u0430\u043A \u0447\u0442\u043E \xAB\u0421\u0442\u0440\u0430\u0436 \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB \u0438\u043C\u0435\u0435\u0442 \u0432\u043F\u043E\u043B\u043D\u0435 \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u043E\u0435 \u043A \u043D\u0438\u043C \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435. \u041F\u043E\u043C\u0438\u043C\u043E \u044D\u0442\u043E\u0433\u043E, \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u043C\u0438 \u0431\u043E\u0435\u0432\u044B\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438.\n\u041B\u044E\u0431\u043E\u0439 \u0447\u043B\u0435\u043D \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB, \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0438 \u0437\u0430\u0449\u0438\u0442\u0435 \xAB\u0411\u0430\u0440\u044C\u0435\u0440\u0430\xBB, \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0441\u0442\u0438 \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u043B\u0438\u0431\u043E \u0436\u0435 \u0447\u0442\u043E-\u0442\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0431\u043B\u0438\u0437\u043A\u043E\u0435 \u043A \u043D\u0435\u043C\u0443."
