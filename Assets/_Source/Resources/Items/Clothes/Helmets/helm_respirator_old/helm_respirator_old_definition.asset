  m_Name: helm_respirator_old
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 555b64e59db986f489761be3ccb01c41
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u041F\u0411\u0424"
  _shortName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u041F\u0411\u0424"
  _description: "\u0428\u043B\u0435\u043C-\u043C\u0430\u0441\u043A\u0430 \u0428\u041C\u0411 \u0441 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 40-\u043C\u043C \u0444\u0438\u043B\u044C\u0442\u0440\u0430\u043C\u0438 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u041F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u043F\u0435\u0440\u0435\u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0438\u0437 \u0441\u0442\u0430\u0440\u044B\u0445 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445 \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u0432 \xAB\u0425\u043E\u043C\u044F\u043A\u0430\xBB \u0442\u0430\u043A \u0438 \u043D\u0435 \u0431\u044B\u043B \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D, \u0441\u0440\u0435\u0434\u0438 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u043E\u0432 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B \u043E\u0442\u043B\u0438\u0447\u0438\u044F \u043E\u0431\u0449\u0435\u0433\u043E \u0432\u0435\u0441\u0430 \u043C\u0430\u0441\u043A\u0438 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B. \u041A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043C\u0430\u0441\u043A\u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u0432 \u0437\u043E\u043D\u0430\u0445 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0440\u0430\u0434\u0438\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B \u0438 \u0441\u043A\u043B\u043E\u043D\u043D\u044B \u043A \u043E\u0442\u043A\u0430\u0437\u0430\u043C \u0432 \u0440\u0430\u0431\u043E\u0442\u0435 \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u0432 \u0432 \u0437\u043E\u043D\u0430\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0441\u0442\u0438, \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u044F \u0432 \u043F\u043E\u043B\u043D\u0443\u044E \u043D\u0435\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u044C. \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043E\u043D\u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435 \u0434\u0430\u044E\u0442 \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439."
