  m_Name: equ_small_military_pack
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 7e507339dae8bf440b2d3e2b2cb485e0
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u044E\u043A\u0437\u0430\u043A \xAB\u0413\u0440\u0443\u043F\u043F\u0430 99\xBB \u042220 (\u0423\u043C\u0431\u0440\u0430)"
  _shortName: "\u042220"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u044E\u043A\u0437\u0430\u043A \u043E\u0431\u044A\u0451\u043C\u043E\u043C 22\u201325 \u043B\u0438\u0442\u0440\u043E\u0432, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0431\u0440\u0435\u043D\u0434\u043E\u043C \xAB\u0413\u0440\u0443\u043F\u043F\u0430 99\xBB, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C \u0441 \u043A\u043E\u043D\u0446\u0435\u0440\u043D\u043E\u043C \xAB\u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043A\u0438 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F, \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u043F\u0440\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F \u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u0440\u0430\u0442\u043A\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u0432\u044B\u0445\u043E\u0434\u043E\u0432 \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0437\u0430\u0434\u0430\u0447. \u0418\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u043D\u0435\u0439\u043B\u043E\u043D\u043E\u0432\u043E\u0439 \u0442\u043A\u0430\u043D\u0438 Cordura 500D, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0439 \u043A \u0438\u0441\u0442\u0438\u0440\u0430\u043D\u0438\u044E, \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u043C \u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0439 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439 MOLLE/PALS \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0441\u0443\u043C\u043A\u043E\u0432 \u0438 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u043C \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435\u043C, \u0434\u0432\u0443\u043C\u044F \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u043C\u0438 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u043C\u0438 \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u043E\u0442\u0441\u0435\u043A\u043E\u043C \u0434\u043B\u044F \u043F\u0438\u0442\u044C\u0435\u0432\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u0416\u0451\u0441\u0442\u043A\u0430\u044F \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u043F\u0438\u043D\u043A\u0430 \u0441 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u043C \u043A\u0430\u043D\u0430\u043B\u043E\u043C, \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0435 \u043F\u043B\u0435\u0447\u0435\u0432\u044B\u0435 \u043B\u044F\u043C\u043A\u0438, \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0430\u044F \u0441\u0442\u044F\u0436\u043A\u0430 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u043C\u044B\u0439 \u043F\u043E\u044F\u0441\u043D\u043E\u0439 \u0440\u0435\u043C\u0435\u043D\u044C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0443\u044E \u043F\u043E\u0441\u0430\u0434\u043A\u0443 \u0438 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438. \u0411\u043E\u043A\u043E\u0432\u044B\u0435 \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u043D\u044B\u0435 \u0441\u0442\u0440\u043E\u043F\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u044A\u0451\u043C \u0438 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u044F\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u043E\u0434\u043E\u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445 \u043C\u043E\u043B\u043D\u0438\u0439 YKK \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u0444\u0443\u0440\u043D\u0438\u0442\u0443\u0440\u044B Duraflex. \u0412 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0432\u0445\u043E\u0434\u0438\u0442 \u0441\u044A\u0451\u043C\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u0435\u0432\u043E\u0439 \u0447\u0435\u0445\u043E\u043B, \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u043C\u044B\u0439 \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u043D\u0438\u0436\u043D\u0435\u043C \u043A\u0430\u0440\u043C\u0430\u043D\u0435. \u0420\u0430\u0441\u0446\u0432\u0435\u0442\u043A\u0430 \xAB\u0423\u043C\u0431\u0440\u0430\xBB \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430 \u0432 \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u043E\u043C \u0442\u0451\u043C\u043D\u043E\u043C \u043E\u0442\u0442\u0435\u043D\u043A\u0435, \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u043C \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043B\u0435\u0441\u043D\u043E\u0439 \u0438 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0440\u0435\u0434\u0435. \u0413\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 44x28x25 \u0441\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 1,25 \u043A\u0433. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E, \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0433\u043E \u0440\u0435\u0439\u0434\u043E\u0432\u043E\u0433\u043E \u0440\u044E\u043A\u0437\u0430\u043A\u0430."
