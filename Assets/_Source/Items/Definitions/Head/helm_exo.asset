  m_Name: helm_exo
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: eb6b051c045d28647be7346cfb7ba726
  _displayName: "\u042D\u043A\u0437\u043E\u0448\u043B\u0435\u043C"
  _shortName: "\u042D\u043A\u0437\u043E\u0448\u043B\u0435\u043C"
  _description: "\u0412\u043D\u0435\u0448\u043D\u0435 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0448\u043B\u0435\u043C \u043E\u0442
    \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430, \u043E\u0434\u043D\u0430\u043A\u043E
    \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
    \u043E\u0442 \u0448\u043B\u0435\u043C\u0430, \u0438\u0434\u0443\u0449\u0435\u0433\u043E
    \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u043A \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430\u043C.
    \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
    \u0448\u043B\u0435\u043C\u0430 \u043E\u0442 \u043F\u0443\u043B\u0435\u0432\u044B\u0445
    \u0440\u0430\u043D\u0435\u043D\u0438\u0439 \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438
    \u0441 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439
    \u0434\u0435\u043B\u0430\u044E\u0442 \u0435\u0433\u043E \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0432 \u044D\u0442\u043E\u0439
    \u0446\u0435\u043D\u043E\u0432\u043E\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438."
