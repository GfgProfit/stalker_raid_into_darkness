  m_Name: deltapoint
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: fda774a86032cfa49bb671d46146021c
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Deltapoint PRO"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Deltapoint PRO"
  _description: "\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439
    \u043F\u0440\u0438\u0446\u0435\u043B DeltaPoint PRO \u043E\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    Leupold \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435
    \u0438\u043C\u0435\u0435\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F.
    \u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0439\u0441\u044F
    \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430
    \u043F\u043E\u043C\u043F\u043E\u0432\u044B\u0435 \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0435
    \u0440\u0443\u0436\u044C\u044F \u0434\u043B\u044F \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0439
    \u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u043E\u043D \u043D\u0435\u043F\u043B\u043E\u0445\u043E
    \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0435\u0431\u044F \u043D\u0430
    \u0448\u0438\u0440\u043E\u043A\u043E\u043C \u0441\u043F\u0435\u043A\u0442\u0440\u0435
    \u043E\u0440\u0443\u0436\u0438\u044F. \u041E\u0442 \u0440\u0443\u0436\u044C\u044F
    \u0438 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0434\u043E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B
    AR, \u043A\u0430\u043A \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0438\u043B\u0438
    \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u0438\u0446\u0435\u043B, \u043E\u043D \u0431\u0443\u0434\u0435\u0442
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442."
