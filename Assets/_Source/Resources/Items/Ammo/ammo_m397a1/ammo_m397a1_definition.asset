  m_Name: ammo_m397a1
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: d1e1244809ca465478aa29a1feb2d98b
  _displayName: "\u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B 40x46 \u043C\u043C M397A1 \xABJump-Up\xBB"
  _shortName: M397A1
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 40-\u043C\u043C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E-\u0444\u0443\u0433\u0430\u0441\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B M397A1 \u0441 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u043C \u043F\u043E\u0434\u0440\u044B\u0432\u043E\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438 \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u043C\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430\u0445 M79 \u0438 M203. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u0432\u0443\u0445\u0441\u0442\u0443\u043F\u0435\u043D\u0447\u0430\u0442\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043D\u0438\u044F: \u043F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u0441 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0448\u0438\u0431\u043D\u043E\u0439 \u0437\u0430\u0440\u044F\u0434 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0432\u0432\u0435\u0440\u0445, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0435\u0433\u043E \u0434\u0435\u0442\u043E\u043D\u0430\u0446\u0438\u044F \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u043E\u043A\u043E\u043B\u043E 1,5 \u043C\u0435\u0442\u0440\u0430. \u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u043F\u0440\u0438\u043D\u0446\u0438\u043F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0430\u043C\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u0440\u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u0446\u0435\u043B\u0435\u0439 \u0432 \u043E\u043A\u043E\u043F\u0430\u0445 \u0438 \u0437\u0430 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u043C \u0431\u043E\u0435\u0432\u044B\u043C \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C \u0441 \u0437\u0430\u0440\u044F\u0434\u043E\u043C \u0432\u0437\u0440\u044B\u0432\u0447\u0430\u0442\u043E\u0433\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 32 \u0433\u0440\u0430\u043C\u043C\u043E\u0432 \u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u043C \u0441 \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435\u043C. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 75 \u043C/\u0441, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u2014 400 \u043C\u0435\u0442\u0440\u043E\u0432. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0440\u0430\u0434\u0438\u0443\u0441 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 5 \u043C\u0435\u0442\u0440\u043E\u0432. \u041C\u0430\u0441\u0441\u0430 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 231 \u0433\u0440\u0430\u043C\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432 \u0433\u0440\u0443\u043F\u043F\u043E\u0432\u044B\u0445 \u0446\u0435\u043B\u0435\u0439 \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0449\u0438\u0445 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0443\u043A\u0440\u044B\u0442\u0438\u044F."
