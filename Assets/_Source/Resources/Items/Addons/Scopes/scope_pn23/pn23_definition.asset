  m_Name: pn23
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: d9bd33fd398d5a4439fdf610f79bfd39
  _displayName: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u041D\u041F\u0417 \u041F\u041D23"
  _shortName: "\u041F\u041D-23"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u0430\u043B\u043E\u0433\u0430\u0431\u0430\u0440\u0438\u0442\u043D\u044B\u0439 \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0442\u0440\u0451\u0445\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u041D\u043E\u0432\u043E\u0441\u0438\u0431\u0438\u0440\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C (\u041D\u041F\u0417) \u0438 \u0441\u0435\u0440\u0438\u0439\u043D\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u0441 2011 \u0433\u043E\u0434\u0430. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C\u044E, \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0439 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E-\u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F 2+ \u0438\u043B\u0438 3 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438, \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0441\u043B\u0430\u0431\u044B\u0439 \u0441\u0432\u0435\u0442 \u041B\u0443\u043D\u044B \u0438 \u0437\u0432\u0451\u0437\u0434. \u0418\u043C\u0435\u0435\u0442 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0438\u0437\u043A\u043E\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C, \u0434\u0430\u043B\u044C\u043D\u043E\u043C\u0435\u0440\u043D\u0443\u044E \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0443 \u0438 Mil-Dot. \u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F 12\xB0 \u043F\u0440\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0438 3x. \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F \u042D\u041E\u041F \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u043A\u0440\u043E\u043D\u0448\u0442\u0435\u0439\u043D\u0430\u043C\u0438 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0438\u0434\u044B \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 AA, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0434\u043E 15 \u0447\u0430\u0441\u043E\u0432 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0431\u0435\u0437 \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438. \u041C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 670 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u043C\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C\u0438, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
