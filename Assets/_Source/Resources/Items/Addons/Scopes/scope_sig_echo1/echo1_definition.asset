  m_Name: echo1
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: f31be855ebfe15642a9e098be2a2bd71
  _displayName: "\u0422\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B SIG Sauer ECHO1 1\u20132x30 \u043C\u043C"
  _shortName: ECHO1
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 1x \u0434\u043E 2x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 SIG Sauer. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u0432 \u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u0438 \u043D\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043D\u0435\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0435\u043C\u044B\u043C \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u043C \u0441\u0435\u043D\u0441\u043E\u0440\u043E\u043C VOx \u0441 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C 206x156 \u043F\u0438\u043A\u0441\u0435\u043B\u0435\u0439 \u0438 \u0447\u0430\u0441\u0442\u043E\u0442\u043E\u0439 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F 30 \u0413\u0446. \u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0446\u0432\u0435\u0442\u043D\u043E\u0439 LCD-\u0434\u0438\u0441\u043F\u043B\u0435\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043F\u043B\u043E\u0432\u044B\u0445 \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440, \u0432\u043A\u043B\u044E\u0447\u0430\u044F White Hot, Black Hot \u0438 \u0446\u0432\u0435\u0442\u043E\u0432\u044B\u0435 \u043F\u0430\u043B\u0438\u0442\u0440\u044B, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0435 \u0432\u044B\u0434\u0435\u043B\u044F\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u0442\u0435\u043F\u043B\u0430 \u043D\u0430 \u0444\u043E\u043D\u0435 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B. \u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u043F\u044F\u0442\u044C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u0435\u0442\u043E\u043A, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445 \u043C\u0430\u0440\u043E\u043A \u0438 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0434\u043E 2x. \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043F\u043B\u043E\u0432\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 900 \u043C\u0435\u0442\u0440\u043E\u0432, \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0431\u043E\u043B\u0435\u0435 270 \u043C\u0435\u0442\u0440\u043E\u0432 \u043F\u0440\u0438 \u0431\u043B\u0430\u0433\u043E\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u043C\u0430\u0433\u043D\u0438\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430, \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043E\u0442 \u0432\u043B\u0430\u0433\u0438 \u043F\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443 IPX6 \u0438 \u043E\u0441\u043D\u0430\u0449\u0451\u043D \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C Picatinny. \u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0430 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0446\u0435\u043B\u0430 ROMEO1. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u0434\u0432\u0443\u0445 \u0431\u0430\u0442\u0430\u0440\u0435\u0439 CR123, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 8 \u0447\u0430\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B. \u041C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 417 \u0433\u0440\u0430\u043C\u043C\u043E\u0432."
