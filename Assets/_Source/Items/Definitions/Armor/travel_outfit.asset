  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: travel_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 6b4b27bd9b554864792d986fd76486cf
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0431\u0430\u0440\u0430\u0445\u043E\u043B\u044C\u0449\u0438\u043A\u0430"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0431\u0430\u0440\u0430\u0445\u043E\u043B\u044C\u0449\u0438\u043A\u0430"
  _description: "\u0421\u0448\u0438\u0442\u044B\u0439 \u0432 \u0417\u043E\u043D\u0435
    \u043C\u0435\u0441\u0442\u043D\u044B\u043C \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C
    \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u0445\u043E\u0434\u043E\u0432. \u041C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0441\u043B\u043E\u0436\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0433\u0440\u0443\u0437\u0430 \u043D\u0430\u0440\u044F\u0434\u0443 \u0441 \u0431\u043E\u043B\u0435\u0435
    \u0447\u0435\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u0432 \u0441\u0443\u0440\u043E\u0432\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B, \u0432
    \u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0438 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0443\u0433\u0440\u043E\u0437.
    \u041F\u043E \u044D\u0442\u0438\u043C \u0436\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u043C
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u043E\u043C \u0441\u0440\u0435\u0434\u0438
    \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u0437\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\u043C\u0438
    \u0438 \u043D\u0430 \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432. \u0415\u0433\u043E
    \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A,
    \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044F \u0446\u0435\u043D\u044B -
    \u044D\u0442\u043E \u043F\u043E\u043B\u043D\u0430\u044F \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F\u0445
    \u0441 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u043C.
    \u0412\u0440\u044F\u0434 \u043B\u0438 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439
    \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0441\u044F
    \u0441 \u043D\u0438\u043C \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E."
