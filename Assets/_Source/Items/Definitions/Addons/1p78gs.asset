    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0438\u0437 \u043E\u0440\u0443\u0436\u0438\u044F,
    \u0438\u043C\u0435\u044E\u0449\u0435\u0433\u043E \u0431\u043E\u043A\u043E\u0432\u043E\u0435
    \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
    \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u0430
    \u0442\u0438\u043F\u0430 \u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D
    \u0445\u0432\u043E\u0441\u0442."
