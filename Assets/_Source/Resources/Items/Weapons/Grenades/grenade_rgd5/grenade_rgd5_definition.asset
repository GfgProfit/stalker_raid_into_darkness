  m_Name: grenade_rgd5_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 2743bded193c12b4899602c7e6eb9f7b
  _displayName: "\u0420\u0443\u0447\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0420\u0413\u0414-5"
  _shortName: "\u0420\u0413\u0414-5"
  _description: "\u043E\u0432\u0435\u0442\u0441\u043A\u0430\u044F \u0440\u0443\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u0435\u0445\u043E\u0442\u043D\u0430\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 1950-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u0430\u044F \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0432 1954 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0420\u0413-42. \u0418\u043C\u0435\u0435\u0442 \u0433\u043B\u0430\u0434\u043A\u0438\u0439 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u044F\u0439\u0446\u0435\u0432\u0438\u0434\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B, \u043E\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0439 \u0432 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0446\u0432\u0435\u0442. \u041C\u0430\u0441\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 310 \u0433, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 57 \u043C\u043C. \u041E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u043C \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u0438, \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0449\u0438\u0435\u0441\u044F \u043F\u0440\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0437\u0430\u043F\u0430\u043B\u043E\u043C \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u044B \u0424-1, \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u0438 \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0437\u043B\u0451\u0442\u0430 \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0445 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0447\u0435\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F. \u041F\u0440\u043E\u0441\u0442\u043E\u0442\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0438 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0435 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u043B\u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0420\u0413\u0414-5 \u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u0441\u0438\u043B\u0430\u0445 \u0421\u0421\u0421\u0420, \u0441\u0442\u0440\u0430\u043D \u0412\u0430\u0440\u0448\u0430\u0432\u0441\u043A\u043E\u0433\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430 \u0438 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445 \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043D\u044B\u0445 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432."
