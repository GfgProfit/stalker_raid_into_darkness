        },
        {
            "m_Id": "53271556e2e351aeab89cf22eeafb925"
        },
        {
            "m_Id": "83d96e0c0f675badb213483434b622de"
        },
        {
            "m_Id": "52fa2783068b5dbf916ede3b2d3d1dc1"
        },
        {
            "m_Id": "b5bbed045d075bc3b3a5c3d7dc926329"
        },
        {
            "m_Id": "81ce6a21742b5b6e9fce89bacdafb108"
        },
        {
            "m_Id": "53635be0009754559cad74fe0d1ab806"
        },
        {
            "m_Id": "b6aec0c895985deea677b06d97a1f5ce"
        },
        {
            "m_Id": "84044ed0f0d6507bb553b7d856a3cc41"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GazirovkaParticle",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 frameOrigin = float2(fmod(Frame, AtlasGrid.x), AtlasGrid.y - 1.0 - floor(Frame / AtlasGrid.x));\nfloat2 atlasUv = (frameOrigin + UV) / AtlasGrid;\nfloat4 texel = SAMPLE_TEXTURE2D(Texture.tex, Texture.samplerstate, atlasUv);\nBaseColor = texel.rgb * Color * Intensity;\n#if !defined(SHADERGRAPH_PREVIEW) && !defined(DISABLE_UNLIT_DEEXPOSURE)\nBaseColor /= max(_DeExposureMultiplier, 1.0e-20);\n#endif\nOpacity = texel.a * Alpha;"
}

