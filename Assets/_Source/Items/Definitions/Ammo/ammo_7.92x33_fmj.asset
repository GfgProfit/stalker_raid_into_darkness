  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: a9a9bf1c2acc30b40a2afeaec1138e7f
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,92x57 \u043C\u043C
    Mauser"
  _shortName: "7.92x57 \u043C\u043C Mauser"
  _description: "\u041F\u0430\u0442\u0440\u043E\u043D 7,92x57 Mauser \u0431\u044B\u043B
    \u043F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435
    \u0435\u0449\u0451 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F
    \u0413\u0435\u0440\u043C\u0430\u043D\u0441\u043A\u043E\u0439 \u0418\u043C\u043F\u0435\u0440\u0438\u0435\u0439,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u0422\u0440\u0435\u0442\u044C\u0438\u043C
    \u0420\u0435\u0439\u0445\u043E\u043C. \u042D\u0442\u043E \u0431\u044B\u043B \u043E\u0434\u0438\u043D
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0445
    \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432 \u0432 \u043F\u0435\u0440\u0438\u043E\u0434
    \u0434\u0432\u0443\u0445 \u043C\u0438\u0440\u043E\u0432\u044B\u0445 \u0432\u043E\u0439\u043D.
    \u041E\u0434\u043D\u0430\u043A\u043E, \u0432 \u043D\u0430\u0448\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0430\u0442\u0440\u043E\u043D \u043F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u044F
    \u043E\u0445\u043E\u0442\u044B \u0438 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0445
    \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u0439.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>I
    (17)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (80)"
