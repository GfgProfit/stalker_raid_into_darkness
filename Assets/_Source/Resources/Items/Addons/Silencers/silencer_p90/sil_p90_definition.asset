  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: sil_p90_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 7caa46bfd90d3654696b6df5c363d096
  _displayName: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0434\u043B\u044F FN P90"
  _shortName: FN P90
  _description: "\u0421\u044A\u0451\u043C\u043D\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440 \u043C\u0430\u043B\u043E\u0448\u0443\u043C\u043D\u043E\u0439 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0431\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430 FN P90 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 5,7x28 \u043C\u043C NATO. \u041E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u0439 \u0434\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F GEMTECH SP-90, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Gemini Technologies \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0441 FN Herstal \u0432 \u043A\u043E\u043D\u0446\u0435 1990-\u0445 \u0433\u043E\u0434\u043E\u0432. \u0418\u043C\u0435\u0435\u0442 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u0430\u043D\u0442\u0438\u043A\u043E\u0440\u0440\u043E\u0437\u0438\u043E\u043D\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u043F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430 \u043D\u0430 \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0438 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043D\u0435 \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0443\u0434\u0430\u0440\u043D\u0443\u044E \u0432\u043E\u043B\u043D\u0443, \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0449\u0443\u044E \u043F\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u043F\u0443\u043B\u0438. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u0438 \u043C\u0430\u0441\u0441\u0443 \u043E\u0440\u0443\u0436\u0438\u044F, \u0441\u043C\u0435\u0449\u0430\u044F \u0435\u0433\u043E \u0446\u0435\u043D\u0442\u0440 \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434."
