  m_Name: wpn_mdr_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b1f1c4f2cee8469582aa47a971c6a6b6
  _displayName: "\u0428\u0442\u0443\u0440\u043C\u043E\u0432\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 Desert Tech MDR"
  _shortName: DT MDR
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0430\u044F \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u0430\u044F \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62\xD751 \u043C\u043C \u041D\u0410\u0422\u041E, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Desert Tech \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043D\u0430 \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0435 SHOT Show \u0432 2014 \u0433\u043E\u0434\u0443. \u0421\u0435\u0440\u0438\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u0432 2017 \u0433\u043E\u0434\u0443. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430 \u043F\u043E \u0441\u0445\u0435\u043C\u0435 \u0431\u0443\u043B\u043B-\u043F\u0430\u043F, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0435 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u043F\u0440\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0439 \u0434\u043B\u0438\u043D\u044B \u0441\u0442\u0432\u043E\u043B\u0430. \u041E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0445\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u0448\u043D\u044F, \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C \u0438 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C \u0433\u0430\u0437\u043E\u0432\u044B\u043C \u0443\u0437\u043B\u043E\u043C. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u044B\u0431\u0440\u043E\u0441\u0430 \u0441\u0442\u0440\u0435\u043B\u044F\u043D\u044B\u0445 \u0433\u0438\u043B\u044C\u0437 \u0432\u043F\u0435\u0440\u0451\u0434, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0430\u044F \u0432\u0435\u0441\u0442\u0438 \u043E\u0433\u043E\u043D\u044C \u043A\u0430\u043A \u0441 \u043F\u0440\u0430\u0432\u043E\u0433\u043E, \u0442\u0430\u043A \u0438 \u0441 \u043B\u0435\u0432\u043E\u0433\u043E \u043F\u043B\u0435\u0447\u0430 \u0431\u0435\u0437 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0433\u0438\u043B\u044C\u0437 \u0432 \u043B\u0438\u0446\u043E \u0441\u0442\u0440\u0435\u043B\u043A\u0430. \u0414\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435 \u043E\u0440\u0433\u0430\u043D\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F, \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C, \u0437\u0430\u0449\u0451\u043B\u043A\u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438. \u041C\u043E\u0434\u0443\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0441\u043C\u0435\u043D\u044B \u043A\u0430\u043B\u0438\u0431\u0440\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0437\u0430\u043C\u0435\u043D\u044B \u0441\u0442\u0432\u043E\u043B\u0430, \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u043F\u043B\u0430\u043D\u043A\u0430\u043C\u0438 Picatinny \u0438 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430\u043C\u0438 M-LOK \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432, \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0444\u043E\u043D\u0430\u0440\u0435\u0439, \u043B\u0430\u0437\u0435\u0440\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439 \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0435 \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 20 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0421\u0442\u0432\u043E\u043B \u0434\u043B\u0438\u043D\u043E\u0439 406 \u043C\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 665\u2013705 \u043C\u043C \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 3,8 \u043A\u0433 \u0431\u0435\u0437 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043E\u0433\u043D\u0435\u0432\u043E\u0439 \u043C\u043E\u0449\u044C\u044E, \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E, \u043E\u0434\u043D\u0430\u043A\u043E \u0441\u043B\u043E\u0436\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u044B\u0431\u0440\u043E\u0441\u0430 \u0433\u0438\u043B\u044C\u0437 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044E."
