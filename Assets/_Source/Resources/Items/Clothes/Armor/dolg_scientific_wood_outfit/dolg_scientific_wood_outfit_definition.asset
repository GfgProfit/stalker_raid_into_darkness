  m_Name: dolg_scientific_wood_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: ab483b1c86f1a244c866c29e9efe17b1
  _displayName: "\u041F\u04215-9\u041C\u0434 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB"
  _shortName: HEAVY
  _description: "\u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0436\u0435\u0441\u0442\u0430 \u0434\u043E\u0431\u0440\u043E\u0439 \u0432\u043E\u043B\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0440\u0430\u0434\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u0432 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u0445, \xAB\u0427\u0438\u0441\u0442\u043E\u0435 \u043D\u0435\u0431\u043E\xBB \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u043D\u0430 \u0437\u0430\u043A\u0430\u0437 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u0427\u041D-4\u0430 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\xBB. \u0414\u0430\u043D\u043D\u044B\u0439 \u0436\u0435 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0431\u044B\u043B \u0441\u0434\u0435\u043B\u0430\u043D \u043F\u043E \u0437\u0430\u043A\u0430\u0437\u0443 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0414\u043E\u043B\u0433\xBB, \u0441\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C\u0438 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0430\u043C\u0438: \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u043D\u0430 \u0432 \u0436\u0435\u0440\u0442\u0432\u0443 \u0440\u0430\u0434\u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0445\u0438\u043C\u0437\u0430\u0449\u0438\u0442\u044B, \u0434\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0431\u044B\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B \u043D\u0430 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435, \u0430 \u0442\u043A\u0430\u043D\u0438 \u0438 \u0432\u0441\u0442\u0430\u0432\u043A\u0438 \u0441\u0442\u0430\u043B\u0438 \u043C\u0435\u043D\u0435\u0435 \u0443\u0434\u0430\u0440\u043E\u0441\u0442\u043E\u0439\u043A\u0438\u043C\u0438 \u043F\u043E\u0441\u043B\u0435 \u0438\u0445 \u0437\u0430\u043C\u0435\u043D\u044B \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432. \u0412 \u0446\u0435\u043B\u043E\u043C, \u041F\u04215-9\u041C\u0434 \xAB\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C \u0438 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0434\u043B\u044F \u0431\u043E\u0439\u0446\u043E\u0432 \xAB\u0414\u043E\u043B\u0433\u0430\xBB."
