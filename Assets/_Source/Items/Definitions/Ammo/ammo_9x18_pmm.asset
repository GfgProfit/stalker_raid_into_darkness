  m_Name: ammo_9x18_pmm
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: af3d7a2dc1f22004395af0427ea92489
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9x18 \u043C\u043C +P+"
  _shortName: "9x18 \u043C\u043C +P+"
  _description: "\u041F\u0430\u0442\u0440\u043E\u043D \u0441 \u043F\u0443\u043B\u0435\u0439
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F 7\u041D16. \u0415\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0430\u044F
    \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u0430 +\u0420+ \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
    \xAB\u043E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u0435
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432 \u0441\u0442\u0432\u043E\u043B\u0435\xBB.
    \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C
    \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043F\u0443\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430
    \u043D\u0430 30%. \u041C\u0430\u043B\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u0435\u043D
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0438: (7)\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0448\u0435
    \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E (36)"
