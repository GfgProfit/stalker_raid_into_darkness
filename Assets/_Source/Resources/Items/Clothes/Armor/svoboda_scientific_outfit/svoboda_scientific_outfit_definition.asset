  _definitionId: f1e4bdfb537421a4492362a491c0e186
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0418\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: HEAVY
  _description: "\u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u043F\u043E\u0434\u043F\u043E\u043B\u044C\u043D\u043E \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445 \u043D\u0443\u0436\u0434 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u0430\xBB. \u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 \u043D\u0430\u0443\u0447\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0421\u0415\u0412\u0410\xBB. \u0412 \u043D\u0430\u043B\u0438\u0447\u0438\u0438: \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0437\u0430\u0449\u0438\u0442\u044B \u0441 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u043C \u0446\u0438\u043A\u043B\u043E\u043C \u0438 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u0435\u0439. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043E\u0442 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438. \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u0443\u043B\u0435\u0432\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u0430 \u0434\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u0431\u043E\u0435\u0432\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439."
