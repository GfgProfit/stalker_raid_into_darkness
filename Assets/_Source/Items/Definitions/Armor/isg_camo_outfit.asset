  m_Name: isg_camo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7afa10466a8545449b02db82d88a40cf
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0418\u0418\u0413 Mk.2"
  _shortName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0418\u0418\u0413 Mk.2"
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430 \u0418\u0418\u0413 \u043C\u043E\u0434\u0435\u043B\u0438 Mk.1, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B. \u041C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u043C\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B, \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u0442\u043E\u0438\u0442 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C, \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u043C \u0438 \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0433\u0440\u043E\u0437\u0430\u043C. \u041F\u043E \u0438\u043C\u0435\u044E\u0449\u0438\u043C\u0441\u044F \u0434\u0430\u043D\u043D\u044B\u043C, \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 Mk.2 \u0431\u044B\u043B \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0437\u0430\u043A\u0430\u0437\u0430\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u0418\u0418\u0413 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u044B\u0445 \u0434\u0430\u043D\u043D\u044B\u0445 \u0432 \u043B\u0438\u0446\u0435 \u043F\u043E\u0442\u0435\u0440\u044C \u043B\u0438\u0447\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u0430\u0432\u0430.\n\u041E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044F\u043C \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0438 \u0432\u0441\u0442\u0440\u0435\u0447 \u0441 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C\u0438."
