  m_Name: renegade_scientific_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 67ecd89e48776244e98a83dc5f78d8a7
  _displayName: "\xAB\u0421\u0415\u0412\u0410\xBB \u0440\u0435\u043D\u0435\u0433\u0430\u0442\u043E\u0432"
  _shortName: MEDIUM
  _description: "\u042D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0439 \u0432 \u0417\u043E\u043D\u0435, \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043E\u0439 \u043B\u0451\u0433\u043A\u043E\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u0438\u043B\u0438 \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0435. \u041D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u043C\u0435\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0442\u0435\u0440\u043C\u043E- \u0438 \u0445\u0438\u043C\u0437\u0430\u0449\u0438\u0442\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043A \u0443\u0434\u0430\u0440\u0430\u043C. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0434\u043B\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u043A\u043B\u0430\u0441\u0441\u0430 \xAB\u0421\u0415\u0412\u0410\xBB, \u0432 \u0446\u0435\u043B\u043E\u043C, \u0438\u043C\u0435\u0435\u0442 \u043D\u0438\u043A\u0443\u0434\u044B\u0448\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438."
