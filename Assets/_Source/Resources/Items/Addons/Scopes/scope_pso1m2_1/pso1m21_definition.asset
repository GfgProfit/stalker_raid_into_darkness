  _definitionId: 6e7cc0c05a37df24abfa823d367bb86f
  _displayName: "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u041F\u0421\u041E-1\u041C2-1 (4x24)"
  _shortName: "\u041F\u0421\u041E-1\u041C2-1"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043A\u0440\u0430\u0442\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u0431\u0430\u0437\u0435 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u041F\u0421\u041E-1. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0443\u044E \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0443 \u0412\u0421\u0421 \xAB\u0412\u0438\u043D\u0442\u043E\u0440\u0435\u0437\xBB \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u0410\u0421 \xAB\u0412\u0430\u043B\xBB. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 24-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 \u0441 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u043C, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u0438 \u0441\u0442\u0430\u0434\u0438\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0434\u0430\u043B\u044C\u043D\u043E\u043C\u0435\u0440\u043E\u043C \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0434\u043E \u0446\u0435\u043B\u0438 \u043F\u043E \u0435\u0451 \u0432\u0438\u0434\u0438\u043C\u044B\u043C \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C. \u0412 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u0434\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x39 \u043C\u043C \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0448\u043A\u0430\u043B\u0430 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043E\u0442 100 \u0434\u043E 400 \u043C\u0435\u0442\u0440\u043E\u0432 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u043F\u0443\u043B\u044C. \u0418\u043C\u0435\u0435\u0442 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u044B\u0432\u0435\u0440\u043A\u0438, \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0443 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0438 \u0448\u0442\u0430\u0442\u043D\u043E\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0442\u0438\u043F\u0430 \xAB\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442\xBB. \u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F 6\xB0 \u043F\u0440\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0438 4x. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043E\u0442 \u0432\u043B\u0430\u0433\u0438, \u043F\u044B\u043B\u0438 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430 AA \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C 1,5 \u0412. \u041C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 620 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u043E\u0439, \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0434\u043B\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F."
