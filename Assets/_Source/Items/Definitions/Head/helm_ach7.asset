  m_Name: helm_ach7
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 0653943dc20c2c8428ac76ac44479d94
  _displayName: "\u0428\u043B\u0435\u043C ACH-7"
  _shortName: "\u0428\u043B\u0435\u043C ACH-7"
  _description: "\u0423\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u0437\u0430\u0449\u0438\u0442\u044B \u0433\u043E\u043B\u043E\u0432\u044B \u0441 7 \u0447\u0430\u0441\u0442\u044F\u043C\u0438 - ACH-7 (Advanced Compound Headgear, 7 Parts) - \u044D\u0442\u043E \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0448\u043B\u0435\u043C\u0430. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442 \u0441\u0435\u0431\u044F \u043F\u0440\u0438 \u0437\u0430\u0449\u0438\u0442\u0435 \u043E\u0442 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u0436\u0435 \u0435\u0433\u043E \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C - \u044D\u0442\u043E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u043F\u0441\u0438-\u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u0438 \u043D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0438\u0437\u043A\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C. \u0422\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043A\u0430\u043A\u043E\u0433\u043E-\u043B\u0438\u0431\u043E \u0440\u0435\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u044B\u043C \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432-\u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u044E\u0442 \u043B\u0435\u0437\u0442\u044C \u043D\u0430 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0435 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u0451 \u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0441\u0432\u043E\u0451 \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
