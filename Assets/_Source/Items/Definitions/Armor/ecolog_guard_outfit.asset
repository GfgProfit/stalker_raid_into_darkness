  m_Name: ecolog_guard_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 67f3e847a0524ce4e97e45e13a84051e
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0418\u0441\u043A\u0440\u0430\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0418\u0441\u043A\u0440\u0430\xBB"
  _description: "\u041F\u043E \u0441\u0443\u0442\u0438, \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0440\u0430\u043D\u0435\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0447\u043B\u0435\u043D\u043E\u0432 \u043D\u0430\u0443\u0447\u043D\u043E-\u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B \xAB\u0418\u0441\u043A\u0440\u0430\xBB, \u0442\u0435\u043F\u0435\u0440\u044C \u0436\u0435 - \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u044B\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438 \u043E\u0445\u0440\u0430\u043D\u044B \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u0433\u0440\u0443\u043F\u043F. \u0417\u0430 \u0441\u0432\u043E\u044E \u0446\u0435\u043D\u0443 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E-\u0442\u0430\u043A\u0438 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443, \u043E\u0434\u043D\u0430\u043A\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u0435\u043D \u0432 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043A\u0430\u0445, \u0442\u0430\u043A \u043A\u0430\u043A \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u0443\u043B\u044E \u043A\u0430\u043B\u0438\u0431\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u043E\u0433\u043E. \u0414\u0430 \u0438 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043C\u0435\u043D\u044F\u0442\u044C \u0435\u0433\u043E \u043D\u0430 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u044B \xAB\u0421\u0415\u0412\u0410\xBB \u0438 \u0421\u0421\u041F-99\u041C \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u0439 \u0436\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438. \u0422\u0435\u043C \u0436\u0435, \u043A\u0442\u043E \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430\u0445, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0443 \u0432 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u043C \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438."
