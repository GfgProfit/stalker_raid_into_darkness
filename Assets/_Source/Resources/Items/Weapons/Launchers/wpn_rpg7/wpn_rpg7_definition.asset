  m_Name: wpn_rpg7_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 5c12ccb43c1addb4e9e70227bd628b4c
  _displayName: "\u0420\u0443\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u0420\u041F\u0413-7"
  _shortName: "\u0420\u041F\u0413-7"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 40-\u043C\u043C \u0440\u0443\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043C\u043D\u043E\u0433\u043E\u0440\u0430\u0437\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0441\u043E\u044E\u0437\u043D\u044B\u043C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u0438\u043C \u0431\u044E\u0440\u043E \u2116 47 (\u043D\u044B\u043D\u0435 \u041D\u041F\u041E \xAB\u0411\u0430\u0437\u0430\u043B\u044C\u0442\xBB) \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0441 \u043A\u043E\u0432\u0440\u043E\u0432\u0441\u043A\u0438\u043C \u041E\u041A\u0411-575 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0432 1961 \u0433\u043E\u0434\u0443. \u0421\u043E\u0437\u0434\u0430\u043D \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430 \u0420\u041F\u0413-2. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u0443\u044E \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u0443\u044E \u0431\u0435\u0437\u043E\u0442\u043A\u0430\u0442\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0434\u0438\u043D\u0430\u043C\u043E\u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0432\u043E\u043B \u0441 \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u043E\u0439 \u0438 \u043A\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0440\u0430\u0441\u0442\u0440\u0443\u0431\u043E\u043C \u0432 \u043A\u0430\u0437\u0451\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438, \u0442\u0435\u043F\u043B\u043E\u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438, \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u0443\u044E \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0438 \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 950 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u2014 6,3 \u043A\u0433. \u0428\u0442\u0430\u0442\u043D\u043E \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u041F\u0413\u041E-7 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C\u044E 2,7x \u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438. \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0434\u043B\u044F \u0431\u043E\u0440\u044C\u0431\u044B \u0441 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0442\u0435\u0445\u043D\u0438\u043A\u043E\u0439, \u043E\u0434\u043D\u0430\u043A\u043E \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0435\u0433\u043E \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0437\u0430 \u0441\u0447\u0451\u0442 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0445 \u0438 \u0442\u0435\u0440\u043C\u043E\u0431\u0430\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432. \u041F\u0440\u043E\u0441\u0442\u043E\u0442\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C, \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043C\u0430\u0441\u0441\u0430 \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0420\u041F\u0413-7 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0445 \u0440\u0443\u0447\u043D\u044B\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0442\u0430\u043D\u043A\u043E\u0432\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043E\u0432 \u0432 \u043C\u0438\u0440\u0435."
