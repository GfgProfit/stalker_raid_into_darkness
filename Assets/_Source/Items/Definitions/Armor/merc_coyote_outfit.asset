  _displayName: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \xAB\u041A\u043E\u0439\u043E\u0442\xBB"
  _shortName: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \xAB\u041A\u043E\u0439\u043E\u0442\xBB"
  _description: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C, \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u0439\u0441\u044F
    \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439
    \xAB\u0428\u0430\u043A\u0430\u043B\u0430\xBB. \u0414\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443
    \u043E\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0438 \u0438\u043C\u0435\u0435\u0442 \u0435\u0449\u0451 \u043B\u0443\u0447\u0448\u0443\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0432\u0435\u0441\u0430. \u041A\u0430\u043A \u0438 \u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u043E\u0436\u0438\u0434\u0430\u0442\u044C, \u0435\u0433\u043E \u0446\u0435\u043D\u0430
    \u043A\u0443\u0434\u0430 \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u0443
    \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430,
    \u043D\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442
    \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432
    \u043E\u0442 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F
    \u043A\u043E\u0441\u0442\u044E\u043C\u0430, \u0435\u0441\u043B\u0438 \u0438\u043C
    \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0442\u0430\u043A\u0430\u044F
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C."
