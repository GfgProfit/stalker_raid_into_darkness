  m_Name: wpn_knife_km2000_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 9316eaeff48f8c640b50a91114cfd4a4
  _displayName: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043D\u043E\u0436 Eickhorn KM2000"
  _shortName: KM2000
  _description: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u043C\u043D\u043E\u0433\u043E\u0446\u0435\u043B\u0435\u0432\u043E\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u043D\u043E\u0436 (Kampfmesser 2000), \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Eickhorn-Solingen \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0411\u0443\u043D\u0434\u0435\u0441\u0432\u0435\u0440\u0430 \u0432 2003 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E \u043D\u043E\u0436\u0430 \u043E\u0431\u0440\u0430\u0437\u0446\u0430 1968 \u0433\u043E\u0434\u0430. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043E\u0434\u043D\u043E\u043B\u0435\u0437\u0432\u0438\u0439\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u043F\u0440\u043E\u0444\u0438\u043B\u044F American Tanto \u0441 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0439 \u0441\u0435\u0440\u0440\u0435\u0439\u0442\u043E\u0440\u043D\u043E\u0439 \u0437\u0430\u0442\u043E\u0447\u043A\u043E\u0439 \u0432\u0431\u043B\u0438\u0437\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0439 \u0434\u043B\u044F \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u043D\u0438\u044F \u043A\u0430\u043D\u0430\u0442\u043E\u0432, \u0440\u0435\u043C\u043D\u0435\u0439 \u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0445 \u0442\u043A\u0430\u043D\u0435\u0439. \u041A\u043B\u0438\u043D\u043E\u043A \u0440\u0430\u043D\u043D\u0438\u0445 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u043A\u043E\u0440\u0440\u043E\u0437\u0438\u043E\u043D\u043D\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0439 \u0441\u0442\u0430\u043B\u0438 X55CrMo14 (DIN 1.4110) \u0441 \u0447\u0451\u0440\u043D\u044B\u043C \u0430\u043D\u0442\u0438\u0431\u043B\u0438\u043A\u043E\u0432\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C Kalgard. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043D\u043E\u0436\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 305 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u043A\u043B\u0438\u043D\u043A\u0430 \u2014 172 \u043C\u043C, \u0442\u043E\u043B\u0449\u0438\u043D\u0430 \u043E\u0431\u0443\u0445\u0430 \u2014 5 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u043D\u043E\u0436\u0435\u043D \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 320 \u0433. \u042D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u0430\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0430 \u0438\u0437 \u043F\u043E\u043B\u0438\u0430\u043C\u0438\u0434\u0430, \u0430\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u0435\u043A\u043B\u043E\u0432\u043E\u043B\u043E\u043A\u043D\u043E\u043C, \u0438 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439, \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435\u043C \u0434\u043B\u044F \u0442\u0435\u043C\u043B\u044F\u043A\u0430 \u0438 \u0441\u0442\u0435\u043A\u043B\u043E\u0431\u043E\u0435\u043C \u0432 \u043D\u0430\u0432\u0435\u0440\u0448\u0438\u0438. \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C\u0438 \u043D\u043E\u0436\u043D\u0430\u043C\u0438 \u0441 \u0430\u043B\u043C\u0430\u0437\u043D\u044B\u043C \u0430\u0431\u0440\u0430\u0437\u0438\u0432\u043E\u043C \u0434\u043B\u044F \u043F\u0440\u0430\u0432\u043A\u0438 \u0440\u0435\u0436\u0443\u0449\u0435\u0439 \u043A\u0440\u043E\u043C\u043A\u0438 \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F, \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0439 \u0441\u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430 MOLLE. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0438 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447 \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
