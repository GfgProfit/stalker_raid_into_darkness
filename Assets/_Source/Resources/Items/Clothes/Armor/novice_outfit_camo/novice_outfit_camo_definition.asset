  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 18402c1da25269947b698208614ffd41
  _displayName: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0430"
  _shortName: LIGHT
  _description: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0430\u043D\u043E\u0440\u0430\u043A, \u043D\u0430\u0434\u0435\u0442\u044B\u0439 \u043F\u043E\u0432\u0435\u0440\u0445 \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u043E\u043B\u0430\u0437\u043D\u043E\u0433\u043E \u0441\u0432\u0438\u0442\u0435\u0440\u0430 \u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432 \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u0434\u0436\u0438\u043D\u0441\u044B \u0438 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435 \u0431\u043E\u0442\u0438\u043D\u043A\u0438. \u041F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B \u0442\u0438\u043F\u0438\u0447\u043D\u043E\u043C\u0443 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044E \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0432\u0441\u0435\u0433\u043E \u0441 \u043D\u0438\u043C \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0433\u043E. \u0412 \u043D\u0430\u043B\u0438\u0447\u0438\u0438: \u043A\u0430\u043C\u0443\u0444\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C, \u0431\u043E\u043B\u0435\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0435\u043F\u043B\u043E\u0445\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0432\u0435\u0441\u0430. \u041C\u043E\u0436\u0435\u0442 \u0441\u043E\u0433\u0440\u0435\u0442\u044C \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u0436\u0434\u044F \u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430, \u043D\u043E \u043D\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u043A\u0430\u043A\u043E\u0439-\u043B\u0438\u0431\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B."
