  _definitionId: bb42dc9b48c7cee4e82a8b3b37f82fe9
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B \u043D\u043E\u0447\u043D\u043E\u0439
    1\u041F\u041D93-1"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B \u043D\u043E\u0447\u043D\u043E\u0439
    1\u041F\u041D93-1"
  _description: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438 (4 \u0434\u0438\u043E\u043F\u0442\u0440\u0438\u0439).
    \u0412\u0430\u0440\u0438\u0430\u043D\u0442 1\u041F\u041D93-1 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0431\u043E\u044F
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043F\u043B\u043E\u0445\u043E\u0439
    \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0441 \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0430\u043C\u0438
    \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430, \u0410\u041D-94,
    \u0410\u0421, \u0412\u0421\u0421... \u0414\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0435 \u0432 \u0441\u0442\u0440\u0430\u043D\u0430\u0445
    - \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u0446\u0430\u0445 \u0412\u0430\u0440\u0448\u0430\u0432\u0441\u043A\u043E\u0433\u043E
    \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u0442\u0438\u043F\u0430 \xAB\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D
    \u0445\u0432\u043E\u0441\u0442\xBB."
