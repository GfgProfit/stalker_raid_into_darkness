  m_BlockName: Retire idle particles
  m_HLSLCode: "void RetireGazirovkaIdle6(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float stepTime)\n{\n    attributes.alive = attributes.alive && attributes.age + stepTime <= attributes.lifetime;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[counterOffset + 6u], 0xffffffffu);\n    }\n}"
  m_ShaderFile: {fileID: 0}
