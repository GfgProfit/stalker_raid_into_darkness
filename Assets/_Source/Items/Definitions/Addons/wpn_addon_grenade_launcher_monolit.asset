  _definitionId: 57e21f205ef898e4aba3ca70bf8f3111
  _displayName: "\u041F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439
    \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442 \"\u0421\u0442\u0440\u0430\u0436\""
  _shortName: "\u041F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439
    \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0435\u0442 \"\u0421\u0442\u0440\u0430\u0436\""
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C> \u0410\u041A-12 \u041C\u043E\u043D\u043E\u043B\u0438\u0442
    \u0441 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043D\u0430\u0431\u043E\u0440\u043E\u043C\n\n<color=#AAAAAA>
    30\u043C\u043C \u043B\u0451\u0433\u043A\u0438\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u0430\u043C\u0451\u0442,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430\u043C\u0438
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u041C\u043E\u043D\u043E\u043B\u0438\u0442,
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u043D\u0430\u0442\u0430\u043C\u0451\u0442\u0430
    6\u041317 \"\u041A\u0430\u043D\u0430\u0440\u0435\u0439\u043A\u0430\".\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B:
    <color=#AAAAAA>\u0433\u0440\u0430\u043D\u0430\u0442\u0430 \u0412\u041E\u0413-30
    30 \u043C\u043C"
