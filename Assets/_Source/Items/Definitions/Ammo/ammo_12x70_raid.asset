  m_Name: ammo_12x70_raid
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b464615b8806ccb47a222b5410a25e97
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12x70 \u043C\u043C \u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0435\u0447\u044C"
  _shortName: "12x70 \u043C\u043C \u0413\u0440\u0430\u0432\u0438 \u043A\u0430\u0440\u0442\u0435\u0447\u044C"
  _description: "\u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0435\u0447\u044C \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u043F\u043E \u0441\u043F\u0435\u0446-\u0437\u0430\u043A\u0430\u0437\u0443 \u0417\u0432\u0435\u0440\u043E\u0431\u043E\u044F. \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u043A\u0430\u043F\u0441\u0443\u043B\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432 \u0441\u0435\u0431\u044F 10 \u043A\u0430\u043C\u0435\u0440, \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u044B \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430 \u0413\u0440\u0430\u0432\u0438. \u041D\u0438\u0436\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0430 \u0434\u0435\u0442\u043E\u043D\u0438\u0440\u0443\u044E\u0449\u0438\u043C \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 425 \u043C\\\u0441 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0438 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0434\u043E \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438. \u041A\u0430\u043A \u043D\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430 \u043D\u0435\u043F\u043B\u043E\u0445\u043E \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0442 \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0431\u0440\u043E\u043D\u044E, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0430\u043D\u043E\u0441\u044F \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u043D\u044B\u0435 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u043F\u043B\u043E\u0442\u0438 \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432.\n\n<color=#AAAAAA>\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C:\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u043B\u0430\u043A\u043E \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \"\u0413\u0440\u0430\u0432\u0438\", \u0441\u0440\u0435\u0434\u043D\u044F\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0438: (3)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 (3780)[420x9]"
