  m_Name: helm_rp_bala
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 2451dd9c3cc420045a09a6616a476723
  _displayName: "\u0411\u0430\u043B\u0430\u043A\u043B\u0430\u0432\u0430"
  _shortName: "\u0411\u0430\u043B\u0430\u043A\u043B\u0430\u0432\u0430"
  _description: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0431\u0430\u043B\u0430\u043A\u043B\u0430\u0432\u0430
    \u0438\u0437 \u0447\u0451\u0440\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u0438.
    \u0418\u0437 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u043F\u043B\u044E\u0441\u043E\u0432
    \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043A\u043E\u043C\u0444\u043E\u0440\u0442
    \u043F\u0440\u0438 \u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0431\u0430\u043B\u0430\u043A\u043B\u0430\u0432\u044B
    \u0437\u0438\u043C\u043E\u0439. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439
    \u043A\u0443\u0441\u043E\u043A \u0442\u043A\u0430\u043D\u0438 \u043D\u0438\u0447\u0443\u0442\u044C
    \u043D\u0435 \u0445\u0443\u0436\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0445
    \u043C\u0430\u0440\u043B\u0435\u0432\u044B\u0445 \u043F\u043E\u0432\u044F\u0437\u043E\u043A,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C\u0438,
    \u043E\u043D \u043D\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0434\u043E\u043B\u0436\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B,
    \u0430 \u043F\u0440\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0438 \u0432\u043E\u0432\u0441\u0435 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
    \u0442\u043E\u043A\u0441\u0438\u043D\u044B. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043A\u0440\u0430\u0439\u043D\u0435 \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043C\u0435\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E
    \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u044B."
