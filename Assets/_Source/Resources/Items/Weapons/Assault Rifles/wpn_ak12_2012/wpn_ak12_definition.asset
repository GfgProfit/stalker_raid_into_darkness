  m_Name: wpn_ak12_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 00af6f0dfb5f4d5283839a51be3f6cff
  _displayName: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0410\u041A-12"
  _shortName: "\u0410\u041A-12"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,45\xD739 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0418\u0436\u0435\u0432\u0441\u043A\u0438\u043C \u043C\u0430\u0448\u0438\u043D\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440\u0430 \u0417\u043B\u043E\u0431\u0438\u043D\u0430. \u041F\u0435\u0440\u0432\u044B\u0439 \u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0432 2011 \u0433\u043E\u0434\u0443 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043F\u0443\u0431\u043B\u0438\u043A\u0435 \u0432 \u044F\u043D\u0432\u0430\u0440\u0435 2012 \u0433\u043E\u0434\u0430 \u043A\u0430\u043A \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0437\u0430\u043C\u0435\u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0443 \u0410\u041A-74\u041C. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0443 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0451\u043D\u043D\u043E\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u043E\u0439, \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u043E\u0439 \u0438 \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u0448\u043D\u044F, \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C \u0438 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C\u0438 \u043E\u0440\u0433\u0430\u043D\u0430\u043C\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C\u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0448\u0430\u043C\u0438, \u0442\u0430\u043A \u0438 \u043B\u0435\u0432\u0448\u0430\u043C\u0438. \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C\u0430\u044F \u043D\u0430 \u043B\u044E\u0431\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F, \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u0430\u044F \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430, \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A-\u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0433\u043D\u044F \u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u044F\u043C\u0438. \u0420\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0438\u0437\u043C\u0435\u043D\u0451\u043D\u043D\u0430\u044F \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F \u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u043D\u043E\u0435 \u043F\u043B\u0435\u0447\u043E \u043E\u0442\u0434\u0430\u0447\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044E\u0442 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438 \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435. \u0418\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u043B\u0430\u043D\u043A\u0438 Picatinny \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044B, \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0444\u043E\u043D\u0430\u0440\u0438, \u043B\u0430\u0437\u0435\u0440\u043D\u044B\u0435 \u0446\u0435\u043B\u0435\u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0438 \u0434\u0440\u0443\u0433\u043E\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B \u0410\u041A-74 \u043D\u0430 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u0438. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 415 \u043C\u043C, \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0435\u043C\u043F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u2014 \u043E\u043A\u043E\u043B\u043E 650 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443, \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 3,2 \u043A\u0433. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u0438, \u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u0410\u041A-12 \u043D\u0435 \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E\u043B\u043D\u044B\u0439 \u0446\u0438\u043A\u043B \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439 \u0438 \u043D\u0435 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E. \u0412 2016 \u0433\u043E\u0434\u0443 \u0431\u044B\u043B \u0437\u0430\u043C\u0435\u043D\u0451\u043D \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E \u0438\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0435\u0439 \u043F\u0440\u0435\u0436\u043D\u0435\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435."
