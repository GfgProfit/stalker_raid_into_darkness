  m_Name: merc_wolven_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 4e97a71b5eed66d4fb691faacd407c28
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432 \xAB\u0413\u0438\u0435\u043D\u0430\xBB"
  _shortName: MEDIUM
  _description: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0441\u0442\u044E\u043C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0439 \u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439. \u041F\u0440\u0438\u0433\u043E\u0434\u0435\u043D \u0434\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u0432 \u043F\u043E \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044E \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u043E\u0432, \u0442\u0430\u043A \u043A\u0430\u043A \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430 \u0438\u043C\u0435\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0443\u044E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u043B\u044F \u0438\u043B\u0438 \u0436\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C \u0432 \u043D\u0438\u0445 \u0437\u0430\u0441\u0430\u0434\u044B. \u041F\u0440\u0438\u0447\u0451\u043C \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435, \u0442\u0430\u043A \u043A\u0430\u043A \u044D\u0442\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0443\u0434\u043E\u0431\u043D\u043E, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0435\u0441\u043B\u0438 \u0446\u0435\u043B\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435."
