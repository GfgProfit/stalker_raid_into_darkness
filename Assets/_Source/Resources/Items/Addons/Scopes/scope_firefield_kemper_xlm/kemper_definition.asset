  m_Name: kemper
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: a0811b3d53d02aa4a8fd9b073b6e17d8
  _displayName: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Firefield MG Kemper XL-M"
  _shortName: Kemper
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1x, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Firefield. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u043F\u0440\u0438 \u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0433\u043D\u044F. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u044B\u043C \u043E\u043A\u043D\u043E\u043C \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C 66x55 \u043C\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u0438 \u0443\u0434\u043E\u0431\u043D\u043E\u0435 \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0445\u0441\u044F \u0446\u0435\u043B\u0435\u0439. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 \u0442\u0438\u043F\u0430 Circle-Dot \u0441 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u0434\u043B\u044F \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043F\u0443\u043B\u0438, \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u043C\u043E\u0439 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0438 \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u043E\u0439 \u0438 \u043F\u044F\u0442\u044C\u044E \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438 \u044F\u0440\u043A\u043E\u0441\u0442\u0438. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0441 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u043C \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043A\u043E\u0436\u0443\u0445\u043E\u043C \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0438. \u0418\u043C\u0435\u0435\u0442 \u0432\u043B\u0430\u0433\u043E\u0437\u0430\u0449\u0438\u0442\u0443 \u043F\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443 IPX4 \u0438 \u0434\u0432\u0443\u0445\u0441\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043F\u043B\u0430\u043D\u043A\u0438 Weaver. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0442\u0438\u0435\u0432\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR2032, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0434\u043E 25 \u0447\u0430\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0440\u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u044F\u0440\u043A\u043E\u0441\u0442\u0438. \u041C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 266 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0433\u043D\u044F \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
