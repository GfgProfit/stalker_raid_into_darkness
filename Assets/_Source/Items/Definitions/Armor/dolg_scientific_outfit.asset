  m_Name: dolg_scientific_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: dd25d1065fd3efa46b0d563eef23848c
  _displayName: "\u041F\u04215-9\u041C\u0434 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _shortName: "\u041F\u04215-9\u041C\u0434 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _description: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \xAB\u0414\u043E\u043B\u0433\xBB. \u041E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u043E\u0442\u043C\u0435\u043D\u043D\u043E\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043E\u0439 - \u044D\u0442\u043E-\u0442\u043E
    \u0432\u0434\u043E\u0431\u0430\u0432\u043E\u043A \u043A \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439
    \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439.
    \u0412 \u0441\u043E\u0441\u0442\u0430\u0432\u0435: \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u041F\u04215-\u041C, \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0434\u044B\u0445\u0430\u043D\u0438\u044F
    \u0441 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u043C \u0446\u0438\u043A\u043B\u043E\u043C,
    \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043B\u0435\u0439.
    \u0418\u043C\u0435\u0435\u0442 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435
    \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u0443\u044E \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E
    \u0438 \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432,
    \u0447\u0435\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F
    \xAB\u0421\u0415\u0412\u0410\xBB, \u043F\u0443\u0441\u0442\u044C \u0438 \u0441
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438."
