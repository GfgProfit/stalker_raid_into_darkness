  m_Name: c-more
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 104bb6a1c1150254d833322f80e3ad6a
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B C-MORE Tactical Sight"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B C-MORE Tactical Sight"
  _description: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439
    \u043F\u0440\u0438\u0446\u0435\u043B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430 \xABC-More Railway\xBB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u0441\u0442\u0440\u0435\u043B\u043A\u0443 \u043E\u0431\u0437\u043E\u0440, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0437\u0440\u0435\u043D\u0438\u0435\u043C \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043E\u0431\u043E\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F.
    \u041F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u043C\u0430\u0440\u043A\u0430
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u043E\u0447\u043A\u043E\u0439
    \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430.
    \u041C\u043E\u0436\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043D\u0430 \u043F\u043B\u0430\u043D\u043A\u0443
    \u0412\u0438\u0432\u0435\u0440\u0430 \u0438\u043B\u0438 \xAB\u041F\u0438\u043A\u0430\u0442\u0438\u043D\u043D\u0438\xBB.\n\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435:
    <color=#AAAAAA>\u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    (\u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440)\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435:
    <color=#AAAAAA>\u0445\u043E\u0440\u043E\u0448\u0435\u0435"
