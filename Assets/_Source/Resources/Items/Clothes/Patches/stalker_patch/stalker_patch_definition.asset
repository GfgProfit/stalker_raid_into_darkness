  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 042213a4e9f2a9846a4560793d2df20b
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0441\u043E \u0437\u043D\u0430\u043A\u043E\u043C \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438"
  _shortName: "\u041E\u0434\u0438\u043D."
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u043E\u0439 \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432-\u043E\u0434\u0438\u043D\u043E\u0447\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u043F\u0440\u0438\u0447\u0438\u0441\u043B\u044F\u044E\u0442 \u0441\u0435\u0431\u044F \u043A \u043A\u0430\u043A\u043E\u043C\u0443-\u043B\u0438\u0431\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u043C\u0443 \u043A\u043B\u0430\u043D\u0443, \u0434\u0430\u043D\u043D\u0430\u044F \u043D\u0430\u0448\u0438\u0432\u043A\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C \u0432 \u0437\u0430\u043F\u0430\u0441\u0430\u0445 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0438\u0445 \u0441\u0431\u044B\u0442\u043E\u043C \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\u043C\u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044E. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432 \u0432 \u0417\u043E\u043D\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0438\u0445 \u0447\u0430\u0441\u0442\u044C \u043B\u0438\u0431\u043E \u0440\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u0430 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438, \u043B\u0438\u0431\u043E \u0436\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043B\u0451\u0433\u043A\u043E\u0439 \u0434\u043E\u0431\u044B\u0447\u0435\u0439 \u0434\u043B\u044F \u0431\u043E\u043B\u0435\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0438 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u0433\u0440\u0443\u043F\u043F \u0432 \u0417\u043E\u043D\u0435."
