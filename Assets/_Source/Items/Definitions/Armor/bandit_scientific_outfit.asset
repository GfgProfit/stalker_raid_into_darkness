  m_Name: bandit_scientific_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 38bb45051bf60b141b0d858a80b2cdb5
  _displayName: "\u0422\u0440\u043E\u0444\u0435\u0439\u043D\u0430\u044F \xAB\u0421\u0415\u0412\u0410\xBB"
  _shortName: "\u0422\u0440\u043E\u0444\u0435\u0439\u043D\u0430\u044F \xAB\u0421\u0415\u0412\u0410\xBB"
  _description: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043E\u0441\u043E\u0431\u043E \u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430\u0443\u043A\u043E\u0439 \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438
    \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439, \u043E\u0434\u043D\u0430\u043A\u043E
    \u0432\u0441\u0451 \u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435
    \u043A\u043E\u0441\u0442\u044E\u043C\u044B \u0434\u043B\u044F \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0437\u0430\u0441\u0430\u0434 \u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0439
    \u043D\u0430 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432 \u0441\u0440\u0435\u0434\u0438
    \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u044B\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u043B\u0435\u0439 \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043E\u0447\u0430\u0433\u043E\u0432. \u041A\u043E\u0441\u0442\u044E\u043C \u0438\u043C\u0435\u0435\u0442
    \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u0434\u044B\u0445\u0430\u043D\u0438\u044F \u0438 \u0432\u043D\u0435\u0448\u043D\u0435\u0435
    \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C\u0438
    \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443
    \u043E\u0442 \u0432\u0441\u0435\u0445 \u0432\u0438\u0434\u043E\u0432 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u0418\u0437-\u0437\u0430
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F \u043A\u0430\u043A\u043E\u0439-\u043B\u0438\u0431\u043E
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043A\u043E\u0441\u0442\u044E\u043C,
    \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043C\u0430\u043B\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u0435\u043D
    \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043B\u043E\u043A."
