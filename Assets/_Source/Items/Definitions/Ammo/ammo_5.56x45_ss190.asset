  _definitionId: 81b4403cef6b4204b8e8f5d5351fa42e
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 5,56x45 \u043C\u043C
    EP"
  _shortName: "5,56x45 \u043C\u043C EP"
  _description: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D \u0432\u043E\u0439\u0441\u043A \u0441\u0442\u0440\u0430\u043D
    \u041D\u0410\u0422\u041E, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u043F\u043E\u0434 \u0438\u043D\u0434\u0435\u043A\u0441\u043E\u043C M855, \u043A\u0430\u043B\u0438\u0431\u0440\u0430
    5,56\u044545 \u043C\u043C \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D
    \u043C\u044F\u0433\u043A\u0438\u043C \u0442\u043A\u0430\u043D\u044F\u043C, \u0434\u0430\u043D\u043D\u044B\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>I
    (10)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (55)"
