  m_Name: ammo_9x19_pbp
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 9175845fb68f45e40b051db9b45e9bea
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9\xD719 \u043C\u043C \u041F\u041F \u0433\u0436"
  _shortName: "\u041F\u041F"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9\xD719 \u043C\u043C \u041F\u0430\u0440\u0430\u0431\u0435\u043B\u043B\u0443\u043C \u0441 \u043F\u0443\u043B\u0435\u0439 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u0438 \u041F\u041F, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u041A\u0411 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043B\u0438\u043D\u0438\u0439 \u0438\u043C\u0435\u043D\u0438 \u041B. \u041D. \u041A\u043E\u0448\u043A\u0438\u043D\u0430 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E \u0441 \u0422\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C. \u0421\u0435\u0440\u0438\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u0432 2006 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u0437\u0430\u0449\u0438\u0442\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0446\u0435\u043B\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F \u0437\u0430 \u043B\u0451\u0433\u043A\u0438\u043C\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u0442\u0435\u0440\u043C\u043E\u0443\u043F\u0440\u043E\u0447\u043D\u0451\u043D\u043D\u044B\u043C \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u041C\u0430\u0441\u0441\u0430 \u043F\u0443\u043B\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 5,5\u20135,8 \u0433\u0440\u0430\u043C\u043C\u0430, \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 420\u2013445 \u043C/\u0441. \u041F\u0440\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0435 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430 \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439 4 \u043C\u043C \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0434\u043E 60 \u043C\u0435\u0442\u0440\u043E\u0432 \u0438 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430 \u0416-86-2 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u0434\u043E 25 \u043C\u0435\u0442\u0440\u043E\u0432. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0432 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F\u0445 \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0438 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0433\u0438\u043B\u044C\u0437\u043E\u0439. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445 \u0438 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9\xD719 \u043C\u043C. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u043C\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438 \u041F\u0421\u041E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0431\u0440\u043E\u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0442\u0438\u0432 \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439."
