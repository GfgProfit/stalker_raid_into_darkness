  m_Name: helm_m40
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 5a01cf724e558b747b77d60823ae261e
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 M40"
  _shortName: MEDIUM
  _description: "\u0414\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0438 \u0430\u0440\u043C\u0438\u0438 \u0421\u0428\u0410, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0441\u0440\u0435\u0434\u0438 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043C\u0430\u0441\u043A\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u0430 \u0438 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u0439 40-\u043C\u0438\u043B\u043B\u0438\u043C\u0435\u0442\u0440\u043E\u0432\u044B\u0439 \u0434\u044B\u0445\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0444\u0438\u043B\u044C\u0442\u0440. M40 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u044F \u0432 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438-/ \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E-\u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0451\u043D\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u0435 \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u043C \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0438 \u043C\u0430\u0441\u043A\u0438."
