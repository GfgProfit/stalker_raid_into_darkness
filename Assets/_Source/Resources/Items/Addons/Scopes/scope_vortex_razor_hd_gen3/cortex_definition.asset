  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: cortex
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: d855bb1f921169747b0732aaaa6a69a5
  _displayName: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Vortex Razor HD Gen III 1\u201310\xD724 FFP"
  _shortName: HD Gen III
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0441 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 1\xD7 \u0434\u043E 10\xD7, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Vortex Optics. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0435 \u0438 \u043C\u0430\u0440\u043A\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445, \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D 24-\u043C\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043E\u043C, \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 HD \u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u043E\u0439 EBR-9 \u0441 11 \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438 \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438. \u0421\u0435\u0442\u043A\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0430 \u0432 \u043F\u0435\u0440\u0432\u043E\u0439 \u0444\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 (FFP), \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0447\u0435\u043C\u0443 \u0435\u0451 \u0443\u0433\u043B\u043E\u0432\u044B\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u044B \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438. \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 1\xD7 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0446\u0435\u043B \u0430\u043D\u0430\u043B\u043E\u0433\u0438\u0447\u043D\u043E \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u043E\u043C\u0443, \u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 10\xD7 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043F\u043E \u0443\u0434\u0430\u043B\u0451\u043D\u043D\u044B\u043C \u0446\u0435\u043B\u044F\u043C. \u041A\u043E\u0440\u043F\u0443\u0441 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D \u0438\u0437 \u0430\u0432\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u0430\u043B\u044E\u043C\u0438\u043D\u0438\u044F, \u043E\u0441\u043D\u0430\u0449\u0451\u043D \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C ArmorTek \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D \u0430\u0440\u0433\u043E\u043D\u043E\u043C \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0437\u0430\u043F\u043E\u0442\u0435\u0432\u0430\u043D\u0438\u044F \u043E\u043F\u0442\u0438\u043A\u0438. \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0443\u0431\u043A\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 34 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 610 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR2032. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043F\u043E\u043B\u0435\u043C \u0437\u0440\u0435\u043D\u0438\u044F, \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u044C\u044E \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0431\u043E\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
