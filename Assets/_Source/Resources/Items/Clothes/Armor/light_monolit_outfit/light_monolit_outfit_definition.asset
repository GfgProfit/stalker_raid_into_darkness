  m_Name: light_monolit_outfit_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 20401186a301adc4ba8e325a718c7540
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 IBA-\u0417 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB"
  _shortName: MEDIUM
  _description: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u0441 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C IBA \xAB\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\xBB, \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043A \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C \u0417\u043E\u043D\u044B (IBA-\u0417), \u043A\u0430\u043A\u0438\u043C-\u0442\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u043F\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u0432 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\xBB. \u0412\u043F\u043E\u043B\u043D\u0435 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0447\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u043C, \u0441\u043D\u044F\u0442\u044B\u043C \u0441 \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0435\u0433\u043E \u0440\u0430\u0437\u0443\u043C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0438\u0441\u043A\u043D\u0443\u043B \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C \xAB\u0411\u0430\u0440\u044C\u0435\u0440\xBB. \u041E\u0442 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043C\u043E\u0434\u0435\u043B\u0438 (IBA-\u0417) \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u043E\u0439 \u043F\u0441\u0438-\u0437\u0430\u0449\u0438\u0442\u043E\u0439."
