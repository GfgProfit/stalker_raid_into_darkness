  m_Name: light_merc_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 5dd0e3fa5e8dfbe47b8bae1d32f607e7
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 IBA-\u0417 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 IBA-\u0417 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _description: "\u0425\u043E\u0440\u043E\u0448\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0439\u0441\u044F \u043A\u043E\u0441\u0442\u044E\u043C \u0441 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C IBA \xAB\u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0447\u0438\u043A\xBB, \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u043F\u0440\u043E\u0434\u0430\u043D\u043D\u044B\u0439 \u0427\u0412\u041A \u0438 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C \u0440\u044F\u0434\u043E\u043C \u0417\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0441\u043F\u043E\u043D\u0441\u043E\u0440\u043E\u0432. \u0414\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0445\u043E\u0442\u044C \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u044B\u0439, \u043D\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442, \u0448\u0438\u0440\u043E\u043A\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439 \u0432 \u0417\u043E\u043D\u0435. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0438\u0445 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u0432, \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0449\u0438\u0445 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0430\u0442\u0430\u043A \u043D\u0430 \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0417\u043E\u043D\u044B."
