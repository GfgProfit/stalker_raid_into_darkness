  m_Name: sil_9x21_sr2m_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c01cc671b79e19d448bc0ecfae3869b9
  _displayName: "\u041F\u0440\u0438\u0431\u043E\u0440 \u043C\u0430\u043B\u043E\u0448\u0443\u043C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0420\u0413085 \u0434\u043B\u044F \u0421\u04202\u041C\u041F \xAB\u0412\u0435\u0440\u0435\u0441\u043A\xBB"
  _shortName: "\u0412\u0435\u0440\u0435\u0441\u043A"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u044A\u0451\u043C\u043D\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440 \u043C\u0430\u043B\u043E\u0448\u0443\u043C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u043D\u0430\u0443\u0447\u043D\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u043E\u043C \u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0430\u0448\u0438\u043D\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F (\u0426\u041D\u0418\u0418\u0422\u041E\u0427\u041C\u0410\u0428) \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u043E\u043F\u044B\u0442\u043D\u043E-\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \xAB\u0412\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u0435\xBB \u0434\u043B\u044F \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430 \u0421\u04202\u041C\u041F \xAB\u0412\u0435\u0440\u0435\u0441\u043A\xBB \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x21 \u043C\u043C. \u0412\u0445\u043E\u0434\u0438\u0442 \u0432 \u0448\u0442\u0430\u0442\u043D\u0443\u044E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430\u0446\u0438\u044E \u043E\u0440\u0443\u0436\u0438\u044F, \u0441\u0435\u0440\u0438\u0439\u043D\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u043E\u0433\u043E \u0441 2012 \u0433\u043E\u0434\u0430. \u0418\u043C\u0435\u0435\u0442 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0438 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B \u043D\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0430. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043C\u0430\u0441\u0441\u0443 \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0430 340 \u0433, \u0430 \u043E\u0431\u0449\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u2014 \u043D\u0430 188 \u043C\u043C. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0448\u0442\u0430\u0442\u043D\u044B\u0445 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043D\u0435 \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0443\u0434\u0430\u0440\u043D\u0443\u044E \u0432\u043E\u043B\u043D\u0443 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0448\u0443\u043C \u0440\u0430\u0431\u043E\u0442\u044B \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0438. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u0432-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432 \u0421\u04202 \u0438 \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u043C \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u0435\u043C \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9x21 \u043C\u043C."
