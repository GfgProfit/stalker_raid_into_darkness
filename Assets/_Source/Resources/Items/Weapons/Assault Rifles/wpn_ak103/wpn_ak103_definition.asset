  m_Name: wpn_ak103_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 7c8e507b555f464db2548f29642fcb05
  _displayName: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0410\u041A-103 (6\u041F45)"
  _shortName: "\u0410\u041A-103"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62x39 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0418\u0436\u0435\u0432\u0441\u043A\u0438\u043C \u043C\u0430\u0448\u0438\u043D\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C \u0432 1990-\u0445 \u0433\u043E\u0434\u0430\u0445 \u043D\u0430 \u0431\u0430\u0437\u0435 \u0410\u041A-74\u041C. \u0412\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u043E\u0442\u0443\u044E \u0441\u0435\u0440\u0438\u044E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u0432 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0445 \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439. \u0421\u043E\u0447\u0435\u0442\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0441 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 7,62x39 \u043C\u043C. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u0448\u043D\u044F, \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C \u0438 \u0441\u043A\u043B\u0430\u0434\u043D\u044B\u043C \u0432\u043B\u0435\u0432\u043E \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C. \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C\u044B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C \u043E\u043A\u043E\u043B\u043E 600 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432, \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u0441 \u0440\u0430\u043D\u043D\u0438\u043C\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430\u043C\u0438 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0410\u041A \u043F\u043E\u0434 \u0442\u043E\u0442 \u0436\u0435 \u043A\u0430\u043B\u0438\u0431\u0440. \u0421\u0442\u0432\u043E\u043B \u0434\u043B\u0438\u043D\u043E\u0439 415 \u043C\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u043E\u043A\u043E\u043B\u043E 715 \u043C/\u0441, \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 1000 \u043C\u0435\u0442\u0440\u043E\u0432. \u0414\u043B\u0438\u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u2014 943 \u043C\u043C \u0441 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 705 \u043C\u043C \u0441\u043E \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 \u043E\u043A\u043E\u043B\u043E 3,6 \u043A\u0433. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u0434\u0443\u043B\u044C\u043D\u044B\u043C \u0442\u043E\u0440\u043C\u043E\u0437\u043E\u043C-\u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u043E\u043C, \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u043D\u043E\u0447\u043D\u044B\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0434\u043B\u044F \u0448\u0442\u044B\u043A-\u043D\u043E\u0436\u0430 \u0438 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0410\u041A-74\u041C \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435 \u043C\u043E\u0449\u043D\u044B\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C, \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043F\u043E \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\u043C. \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0443\u044E \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C, \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0443 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438."
