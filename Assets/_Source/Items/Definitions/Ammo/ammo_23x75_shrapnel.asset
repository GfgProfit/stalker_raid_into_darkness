  m_Name: ammo_23x75_shrapnel
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 055b6574b49623a4998785d28abc41b4
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 23x75 \u043C\u043C \"\u0428\u0440\u0430\u043F\u043D\u0435\u043B\u044C-25\""
  _shortName: "23x75 \u043C\u043C \"\u0428\u0440\u0430\u043F\u043D\u0435\u043B\u044C-25\""
  _description: "\u041F\u0430\u0442\u0440\u043E\u043D \u0441 \u0437\u0430\u0440\u044F\u0434\u043E\u043C
    \u043A\u0430\u0440\u0442\u0435\u0447\u0438. \u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0434\u043E 25
    \u043C\u0435\u0442\u0440\u043E\u0432. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0438\u0437
    \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0430 \u041A\u0421-23. \u0418\u0437-\u0437\u0430
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0432 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0435
    \u041A\u0421-23 \u0441\u0442\u0432\u043E\u043B \u0438\u043C\u0435\u0435\u0442
    \u043D\u0430\u0440\u0435\u0437\u044B, \u043A\u0430\u0440\u0442\u0435\u0447\u044C
    \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u043B\u043E\u0449\u0430\u0434\u044C,
    \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
    \u043D\u0430\u0432\u0441\u043A\u0438\u0434\u043A\u0443, \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043D\u0435 \u0446\u0435\u043B\u044F\u0441\u044C.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0440\u043E\u043D\u0438: (5)\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    (2112)[352x6]"
