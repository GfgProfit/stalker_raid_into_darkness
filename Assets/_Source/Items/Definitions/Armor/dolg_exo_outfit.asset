  m_Name: dolg_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 02a6a60e5bcec1542ae053ad99f98fc8
  _displayName: "\u041F\u0421\u0417-10\u0414 \xAB\u041C\u0435\u0445\u0430\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _shortName: "\u041F\u0421\u0417-10\u0414 \xAB\u041C\u0435\u0445\u0430\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _description: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u044F. \u041E\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u041D\u0418\u0418 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u0434\u043B\u044F \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \xAB\u0414\u043E\u043B\u0433\xBB. \u041E\u0434\u043D\u0430\u043A\u043E \u0432
    \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u0432 \u0417\u043E\u043D\u0435,
    \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0445\u0441\u044F
    \u043D\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043C\u0435\u043D\u0435\u0435
    \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u0438 \u0431\u043E\u043B\u0435\u0435
    \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439
    \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u043E\u0439. \u0422\u0430\u043A
    \u0447\u0442\u043E \u043D\u0430 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0432\u0435
    \u0447\u0442\u043E \u0432\u0435\u0442\u0435\u0440\u0430\u043D\u0430\u043C\u0438
    \xAB\u0414\u043E\u043B\u0433\u0430\xBB. \u0421\u0430\u043C \u0436\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u044B,
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C,
    \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437 \u0442\u0440\u0451\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439: \u044D\u043A\u0437\u043E\u0448\u043B\u0435\u043C,
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442
    \u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C
    \u0438\u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u0430."
