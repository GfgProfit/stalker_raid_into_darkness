  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: ammo_vog-25p
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: aa0ec2e16bb3f05489ff84d6a2cc68e3
  _displayName: "\u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0412\u041E\u0413-25\u041F \xAB\u041F\u043E\u0434\u043A\u0438\u0434\u044B\u0448\xBB (7\u041F24)"
  _shortName: "\u0412\u041E\u0413-25\u041F"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 40-\u043C\u043C \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0412\u041E\u0413-25\u041F \xAB\u041F\u043E\u0434\u043A\u0438\u0434\u044B\u0448\xBB, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043E\u0432 \u0413\u041F-25 \xAB\u041A\u043E\u0441\u0442\u0451\u0440\xBB \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0432 1979 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0432 \u043E\u043A\u043E\u043F\u0430\u0445, \u0442\u0440\u0430\u043D\u0448\u0435\u044F\u0445 \u0438 \u0437\u0430 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0439, \u043E\u0441\u043D\u0430\u0449\u0451\u043D\u043D\u043E\u0439 \u0432\u0437\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u0435\u043C \u0412\u0413\u041C-\u041F \u0441 \u0432\u044B\u0448\u0438\u0431\u043D\u044B\u043C \u0437\u0430\u0440\u044F\u0434\u043E\u043C \u0438 \u043F\u0438\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u0435\u043C. \u041F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u0441 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0432\u044B\u0448\u0438\u0431\u043D\u043E\u0439 \u0437\u0430\u0440\u044F\u0434 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0433\u0440\u0430\u043D\u0430\u0442\u0443 \u043D\u0430\u0434 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0434\u0435\u0442\u043E\u043D\u0430\u0446\u0438\u044F \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u0434\u043E 1,5 \u043C\u0435\u0442\u0440\u0430. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E\u043C\u0443 \u043F\u043E\u0434\u0440\u044B\u0432\u0443 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u0440\u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0438 \u043B\u0435\u0436\u0430\u0449\u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0438 \u0446\u0435\u043B\u0435\u0439 \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D \u043F\u043E \u0431\u0435\u0437\u0433\u0438\u043B\u044C\u0437\u043E\u0432\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0441 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u043C\u0435\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0437\u0430\u0440\u044F\u0434\u0430 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0432 \u0434\u043E\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u044B. \u041C\u0430\u0441\u0441\u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 275 \u0433\u0440\u0430\u043C\u043C\u043E\u0432, \u043C\u0430\u0441\u0441\u0430 \u0432\u0437\u0440\u044B\u0432\u0447\u0430\u0442\u043E\u0433\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u2014 42 \u0433\u0440\u0430\u043C\u043C\u0430. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 76 \u043C/\u0441, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u2014 400 \u043C\u0435\u0442\u0440\u043E\u0432. \u0420\u0430\u0434\u0438\u0443\u0441 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 7 \u043C\u0435\u0442\u0440\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u0441\u0430\u043C\u043E\u043B\u0438\u043A\u0432\u0438\u0434\u0430\u0446\u0438\u0438, \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u043C \u0447\u0435\u0440\u0435\u0437 14\u201319 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u0441\u043B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430. \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C \u0441 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430\u043C\u0438 \u0413\u041F-25, \u0413\u041F-30, \u0413\u041F-34 \u0438 \u0420\u0413-6."
