  m_Name: ammo_12x76_dart
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 550905fa1e8700742b064acb9e9a2f07
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12x76 \u043C\u043C \u0418\u043C\u043F\u0443\u043B\u044C\u0441-8
    HP"
  _shortName: "12x76 \u043C\u043C \u0418\u043C\u043F\u0443\u043B\u044C\u0441-8 HP"
  _description: "\u0412\u0440\u0443\u0447\u043D\u0443\u044E \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0439
    \u043F\u0430\u0442\u0440\u043E\u043D 12-\u0433\u043E \u043A\u0430\u043B\u0438\u0431\u0440\u0430,
    \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u043E\u0439
    \u043F\u0443\u043B\u0435\u0439 \"\u0418\u043C\u043F\u0443\u043B\u044C\u0441-8\"
    \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0439
    \u043D\u0430\u0432\u0435\u0441\u043A\u043E\u0439. \u041F\u0443\u043B\u044F \"\u0418\u043C\u043F\u0443\u043B\u044C\u0441-8\"
    \u0438\u043C\u0435\u0435\u0442 \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u0443\u044E
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443 \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0448\u0430\u0440\u0438\u043A\u043E\u043C-\u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C.
    \u041D\u0430 \"\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0437\u0435\u043C\u043B\u0435\"
    \u0442\u0430\u043A\u0438\u0435 \u043F\u0430\u0442\u0440\u043E\u043D\u044B \u043D\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0437\u0430
    \u043D\u0435\u0438\u043C\u0435\u043D\u0438\u0435\u043C \u0441\u043C\u044B\u0441\u043B\u0430
    (\u043F\u043E\u0442\u043E\u043C\u0443 \u043A\u0430\u043A \u043F\u043E\u0441\u043B\u0435
    \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u0441\u0435 \u0447\u0442\u043E
    \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0438\u0437 \u043C\u044F\u0441\u0430
    \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
    \u0444\u0430\u0440\u0448), \u043E\u0434\u043D\u0430\u043A\u043E \u0432 \u0417\u043E\u043D\u0435
    \u044D\u0442\u043E\u0442 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441
    \u0432\u044B\u0441\u043E\u043A\u043E \u0446\u0435\u043D\u0438\u0442\u0441\u044F
    \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u044B \u043D\u0430 \u0441\u0430\u043C\u044B\u0445
    \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432.
    \u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u043A\u0438 \u0432\u043A\u0443\u043F\u0435
    \u0441 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u043C.
    \u0418\u0437 \u043C\u0438\u043D\u0443\u0441\u043E\u0432 - \u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0446\u0435\u043D\u0430 \u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439
    \u0438\u0437\u043D\u043E\u0441 \u043E\u0440\u0443\u0436\u0438\u044F. \u0421\u0442\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A \u043F\u0443\u043B\u0438
    \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043F\u0440\u043E\u0431\u0438\u0442\u044C
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E
    \u043A\u043B\u0430\u0441\u0441\u0430\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>III
    (30)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (157)"
