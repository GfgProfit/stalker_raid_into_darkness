  m_Name: ammo_5.45x39_fmj
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 67a0ab0d08beffe439bcac0b6165bb46
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 5,45x39 \u043C\u043C
    \u041F\u0421"
  _shortName: "5,45x39 \u043C\u043C \u041F\u0421"
  _description: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D
    7\u041D6 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,45x39 \u043C\u043C \u0441
    \u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439
    (\u041F\u0421) \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u044B\u0445
    \u0446\u0435\u043B\u0435\u0439, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445
    \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u0438\u043B\u0438 \u0437\u0430 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0430\u043C\u0438,
    \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u044B\u043C\u0438 \u043F\u0443\u043B\u0435\u0439,
    \u043E\u0433\u043D\u0435\u0432\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
    \u0438 \u043D\u0435\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u043A\u0438. \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u043B\u0443\u0447\u0448\u0443\u044E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u043C
    7,62 \u043C\u043C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u043E\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439
    \u043E\u0442\u0434\u0430\u0447\u0435, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044E
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0433\u043D\u044F \u043D\u0430
    100 \u043C\u0435\u0442\u0440\u043E\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>I
    (17)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0448\u0435
    \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E (41)"
