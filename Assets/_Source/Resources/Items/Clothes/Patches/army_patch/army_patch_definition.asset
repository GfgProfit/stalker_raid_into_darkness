  _definitionId: bfeac5e0f472b8346945870cadffb8f2
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0432\u043E\u0435\u043D\u043D\u044B\u0445"
  _shortName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0432\u043E\u0435\u043D\u043D\u044B\u0445"
  _description: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0412\u0421\u0423 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0432 \u0432\u0438\u0434\u0435 \u0442\u0440\u0451\u0445 \u0449\u0438\u0442\u043E\u0432, \u0441 \u043F\u0430\u0440\u043E\u0439 \u043C\u0435\u0447\u0435\u0439, \u0441\u043A\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u0445 \u043F\u043E\u0437\u0430\u0434\u0438. \u0412\u0441\u0435 \u0442\u0440\u0438 \u0449\u0438\u0442\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u044B \u0432 \u043B\u0430\u0432\u0440\u043E\u0432\u044B\u0439 \u0432\u0435\u043D\u043E\u043A, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0449\u0438\u0442 \u043E\u043A\u0440\u0430\u0448\u0435\u043D \u0432 \u0446\u0432\u0435\u0442\u0430 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0444\u043B\u0430\u0433\u0430 \u0423\u043A\u0440\u0430\u0438\u043D\u044B \u0438 \u043D\u0435\u0441\u0451\u0442 \u043D\u0430 \u0441\u0435\u0431\u0435 \u0435\u0451 \u0433\u0435\u0440\u0431. \u0418\u0441\u0445\u043E\u0434\u044F \u0438\u0437 \u044D\u0442\u043E\u0433\u043E, \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0412\u0421\u0423 \u0432 \u0417\u043E\u043D\u0435, \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C, \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0441\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430\u043C\u0438 \u0438 \u043C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0446\u0430\u043C\u0438. \u042F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0436\u0435 \u043B\u0438 \u043E\u043D\u0438 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0442\u0430\u043A\u043E\u0432\u044B\u043C\u0438 - \u044D\u0442\u043E \u0443\u0436\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445 \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u0439."
