  m_BlockName: Retire idle particles
  m_HLSLCode: "void RetireGazirovkaIdle2(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float stepTime)\n{\n    attributes.alive = attributes.alive && attributes.age + stepTime <= attributes.lifetime;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[counterOffset + 2u], 0xffffffffu);\n    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: RetireGazirovkaIdle2
    selectedIndex: 0
