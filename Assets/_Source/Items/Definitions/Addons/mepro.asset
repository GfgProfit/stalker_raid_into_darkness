  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 25bdd05c99d11e646985d99151e2c847
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Meprolight M21"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Meprolight M21"
  _description: "MEPRO M21 - \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u0432 \u0442\u0435\u0441\u043D\u043E\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u0441 \u0438\u0437\u0440\u0430\u0438\u043B\u044C\u0441\u043A\u0438\u043C \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u043E\u043C. \u041F\u0440\u0438\u0446\u0435\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u0440\u0438 \u0434\u043D\u0435\u0432\u043D\u043E\u043C \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0438 \u043E\u0442 \u0441\u0432\u0435\u0442\u043E\u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0435\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430, \u0430 \u0432 \u043D\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0441\u0443\u0442\u043E\u043A \u043E\u0442 \u0442\u0440\u0438\u0442\u0438\u044F. \u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438. \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u0440\u0438 \u043B\u044E\u0431\u044B\u0445 \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0445 \u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0440\u0443\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041E\u0431\u044A\u0435\u043A\u0442\u0438\u0432 \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C 30\u043C\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0435 \u043F\u043E\u043B\u0435 \u043E\u0431\u0437\u043E\u0440\u0430, \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0437\u0430\u0445\u0432\u0430\u0442 \u0446\u0435\u043B\u0438. \u0421\u0435\u043A\u0442\u043E\u0440 \u043E\u0431\u0437\u043E\u0440\u0430 \u043D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D, \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441 \u0434\u0432\u0443\u043C\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
