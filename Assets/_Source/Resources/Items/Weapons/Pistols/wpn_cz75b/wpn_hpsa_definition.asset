  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: wpn_hpsa_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 4f1a68942f3fcc842a198b76f74b8e0f
  _displayName: "\u0421\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 CZ 75 B"
  _shortName: CZ 75 B
  _description: "\u0427\u0435\u0448\u0441\u043A\u0438\u0439 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x19 \u043C\u043C Parabellum, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 \u010Cesk\xE1 zbrojovka (CZ) \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0423\u0433\u0435\u0440\u0441\u043A\u0438-\u0411\u0440\u043E\u0434. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 CZ 75, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u0440\u0430\u0442\u044C\u044F\u043C\u0438 \u0419\u043E\u0437\u0435\u0444\u043E\u043C \u0438 \u0424\u0440\u0430\u043D\u0442\u0438\u0448\u0435\u043A\u043E\u043C \u041A\u043E\u0443\u0446\u043A\u0438\u043C\u0438 \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0432 1975 \u0433\u043E\u0434\u0443. \u041C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F CZ 75 B \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0432 1993 \u0433\u043E\u0434\u0443. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u043F\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043C \u0445\u043E\u0434\u0435 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441 \u0437\u0430\u043F\u0438\u0440\u0430\u043D\u0438\u0435\u043C \u043A\u0430\u043D\u0430\u043B\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0430 \u043F\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0411\u0440\u0430\u0443\u043D\u0438\u043D\u0433\u0430. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA). \u0420\u0430\u043C\u043A\u0430 \u0438 \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u044B \u0438\u0437 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u0438, \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u2014 \u0438\u0437 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0445 \u0437\u0430\u0442\u0432\u043E\u0440\u0430 \u0432\u043D\u0443\u0442\u0440\u0438 \u0440\u0430\u043C\u043A\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435 \u043D\u0438\u0437\u043A\u043E\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0441\u0438 \u0441\u0442\u0432\u043E\u043B\u0430. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u0434\u0432\u0443\u0445\u0440\u044F\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 16 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0440\u0443\u0447\u043D\u044B\u043C \u0444\u043B\u0430\u0436\u043A\u043E\u0432\u044B\u043C \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u0443\u0434\u0430\u0440\u043D\u0438\u043A\u0430, \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0432\u0437\u0432\u043E\u0434\u043E\u043C \u043A\u0443\u0440\u043A\u0430 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0441 \u043B\u044E\u043C\u0438\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u044B\u043C\u0438 \u043C\u0435\u0442\u043A\u0430\u043C\u0438. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u043C\u0443 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0443 2024 \u0433\u043E\u0434\u0430, \u0434\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 114 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u2014 208 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 1,17 \u043A\u0433. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0439 \u0446\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u043A\u043E\u0439 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043A\u0443\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B. \u041F\u043E\u043B\u0443\u0447\u0438\u043B \u0448\u0438\u0440\u043E\u043A\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0441\u0440\u0435\u0434\u0438 \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432."
