  _definitionId: 3a99c690372ef7243b8bd1590dd0d016
  _displayName: "\u0422\u0440\u044F\u043F\u0438\u0447\u043D\u0430\u044F \u043C\u0430\u0441\u043A\u0430"
  _shortName: LIGHT
  _description: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u0443\u0441\u043E\u043A \u0442\u043A\u0430\u043D\u0438, \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u043C\u0430\u0441\u043A\u0443. \u041E\u043D \u0447\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u0430\u043C\u0438 \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0438\u0446, \u0432 \u0432\u0438\u0434\u0435 \u043C\u0435\u0440\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0442\u044C \u0442\u043E\u043A\u0441\u0438\u043D\u044B, \u0442\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043C\u0435\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u044B."
