  m_Name: wpn_addon_grenade_launcher_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b1767a124f1103b4cb887f0942147804
  _displayName: "40-\u043C\u043C \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u0413\u041F-25 \xAB\u041A\u043E\u0441\u0442\u0451\u0440\xBB"
  _shortName: "\u041A\u043E\u0441\u0442\u0451\u0440"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 40 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 \u0426\u041A\u0418\u0411 \u0421\u041E\u041E \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u0412. \u041D. \u0422\u0435\u043B\u0435\u0448\u0430 \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0432 1978 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432 \u0410\u041A\u041C \u0438 \u0410\u041A-74. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0431\u0435\u0437\u0433\u0438\u043B\u044C\u0437\u043E\u0432\u044B\u0435 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043D\u044B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0412\u041E\u0413-25 \u0438 \u0412\u041E\u0413-25\u041F \u0441 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u043C\u0438 \u0433\u0440\u0430\u043D\u0430\u0442\u0430\u043C\u0438. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u0443\u043B\u044C\u043D\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u0437\u0430\u0440\u044F\u0436\u0430\u043D\u0438\u044F, \u043D\u0430\u0440\u0435\u0437\u043D\u044B\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C \u0438 \u0441\u0430\u043C\u043E\u0432\u0437\u0432\u043E\u0434\u043D\u044B\u043C \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0433\u043D\u044F \u043F\u043E \u043D\u0430\u0441\u0442\u0438\u043B\u044C\u043D\u043E\u0439 \u0438 \u043D\u0430\u0432\u0435\u0441\u043D\u043E\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044F\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438, \u0432 \u043E\u043A\u043E\u043F\u0430\u0445 \u0438 \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u044F\u043C\u0438. \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 400 \u043C\u0435\u0442\u0440\u043E\u0432, \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 1,5 \u043A\u0433."
