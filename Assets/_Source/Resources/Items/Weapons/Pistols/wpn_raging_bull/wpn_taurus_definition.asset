  m_Name: wpn_taurus_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: 692c703b3a25ed742a106e27b525807b
  _displayName: "\u0420\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 Taurus Raging Bull Model 444"
  _shortName: Taurus
  _description: "\u0411\u0440\u0430\u0437\u0438\u043B\u044C\u0441\u043A\u0438\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D .44 Remington Magnum (10,9x33 \u043C\u043C R), \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Forjas Taurus \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 Raging Bull, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0432 1997 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u044B \u0438 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA), \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u043C\u043A\u043E\u0439 \u0438 \u043E\u0442\u043A\u0438\u0434\u043D\u044B\u043C \u0448\u0435\u0441\u0442\u0438\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u043C \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043E\u043C \u0441 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0444\u0438\u043A\u0441\u0430\u0446\u0438\u0438. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C\u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0443\u0442\u044F\u0436\u0435\u043B\u0451\u043D\u043D\u044B\u0439 \u0441\u0442\u0432\u043E\u043B \u0441 \u0432\u0435\u043D\u0442\u0438\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439, \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0434\u0443\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0442\u043E\u0440 \u0438 \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u0430\u044F \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u0430\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0441 \u0430\u043C\u043E\u0440\u0442\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u0432\u0441\u0442\u0430\u0432\u043A\u043E\u0439. \u041E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438 \u0441 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C \u0446\u0435\u043B\u0438\u043A\u043E\u043C. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F \u0432 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F\u0445 \u0441 \u0432\u043E\u0440\u043E\u043D\u0451\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u044C\u044E \u0438 \u043C\u0430\u0442\u043E\u0432\u043E\u0439 \u043D\u0435\u0440\u0436\u0430\u0432\u0435\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043B\u044C\u044E, \u0441\u043E \u0441\u0442\u0432\u043E\u043B\u0430\u043C\u0438 \u0434\u043B\u0438\u043D\u043E\u0439 165 \u0438 213 \u043C\u043C. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 1,5\u20131,79 \u043A\u0433. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u043D\u043E\u0433\u043E \u043F\u0430\u0442\u0440\u043E\u043D\u0430 \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0442\u0434\u0430\u0447\u0443, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u0435\u043C\u0443\u044E \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u0432\u043E\u043B\u0430."
