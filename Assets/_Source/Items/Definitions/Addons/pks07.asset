  m_Name: pks07
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c102ea3c0364621469b4fd611e1636ec
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041F\u041A\u0421-07"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041F\u041A\u0421-07"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF> \u2022 <color=#8C8C8C>\u0432\u0441\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u041D\u0410\u0422\u041E\n\n<color=#AAAAAA>\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u041F\u041A\u0421-07 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430\u043C\u0438 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434\u0441\u043A\u043E\u0433\u043E \u043E\u043F\u0442\u0438\u043A\u043E-\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F (\u041B\u041E\u041C\u041E). \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043B\u0441\u044F \u0432 1997-1998 \u0433\u043E\u0434\u0443 \u041D\u041F\u041E \"\u041F\u0443\u0441\u043A\" (\u0421\u0430\u043D\u043A\u0442-\u041F\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433) \u043F\u043E \u0437\u0430\u043A\u0430\u0437\u0443 \u0424\u0421\u0411 \u0420\u0424. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u041F\u041A\u0421-07 \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C \u0434\u043B\u044F \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439 \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0430\u043D\u0430\u043B\u043E\u0433\u0430\u043C\u0438.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435: <color=#AAAAAA>7.0x\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435: <color=#AAAAAA>\u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0422\u0438\u043F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0438: <color=#AAAAAA>\u041F\u041A\u0421-07"
