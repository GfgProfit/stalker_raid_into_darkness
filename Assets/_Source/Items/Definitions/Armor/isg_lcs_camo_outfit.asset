  m_Name: isg_lcs_camo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 7355fb2d5b2e31b438e41e07a4c90a51
  _displayName: "\u041A\u0430\u043C\u0443\u0444\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0418\u0418\u0413"
  _shortName: "\u041A\u0430\u043C\u0443\u0444\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0418\u0418\u0413"
  _description: "\u0412\u0430\u0440\u0438\u0430\u0446\u0438\u044F \u043B\u0451\u0433\u043A\u043E\u0433\u043E
    \u0431\u043E\u0435\u0432\u043E\u0433\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430,
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0441\u0438\u043B\u0430\u043C\u0438 \u0418\u0418\u0413 \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u0432\u043E\u0438\u043C\u0438 \u0447\u043B\u0435\u043D\u0430\u043C\u0438.
    \u0417\u0430 \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u0437\u044F\u0442\u044B
    \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \u0441\u043F\u0435\u0446\u043D\u0430\u0437\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
    \u0430\u0440\u043C\u0438\u0439. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u043C\u0430\u043B\u044B\u0439 \u0432\u0435\u0441 \u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
    \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C,
    \u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D
    \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F
    \u043F\u0440\u0438\u043B\u0438\u0447\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439
    \u043E\u0442 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0441\u043B\u0430\u0431\u043E
    \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.
    \u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u043C \u0436\u0435
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0438\u0437\u043A\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432,
    \u043F\u043E\u0440\u0435\u0437\u043E\u0432 \u0438 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432."
