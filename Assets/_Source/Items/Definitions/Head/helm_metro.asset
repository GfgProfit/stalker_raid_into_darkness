  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: helm_metro
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: c23d739c3e030e24688d9265e0dc0223
  _displayName: "\u0428\u043B\u0435\u043C-\u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437
    \u041F\u0414"
  _shortName: "\u0428\u043B\u0435\u043C-\u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437
    \u041F\u0414"
  _description: "\u041E\u0447\u0435\u043D\u044C \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u0447\u0435\u0448\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437
    M10, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438.
    \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0437\u0430
    \u0435\u0433\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C \u0441\u0442\u043E\u0438\u0442
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C\xBB, \u043E\u0442\u0447\u0435\u0433\u043E \u043E\u043D
    \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u0441\u0432\u043E\u0435\u0433\u043E
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F: \xAB\u041F\u0414\xBB, \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0434\u0435\u043D\u044C\xBB, \xAB\u0448\u043B\u0435\u043C \u0430\u043F\u043E\u043A\u0430\u043B\u0438\u043F\u0441\u0438\u0441\u0430\xBB
    \u0438 \u0442.\u043F. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430
    \u0442\u043E, \u0447\u0442\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437
    \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u0443\u0434\u043E\u0431\u0435\u043D
    \u0434\u043B\u044F \u043D\u043E\u0448\u0435\u043D\u0438\u044F, \u043E\u043D \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438
    \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439, \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u0449\u0438\u0442.
    \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043B\u0438\u0434\u0435\u0440
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u0431\u044B\u043B
    \u0443\u0431\u0438\u0442 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u043C
    \u043F\u043E \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0443 \u041F\u0440\u0438\u0437\u0440\u0430\u043A,
    \u0430 \u0441\u0430\u043C\u0430 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0430
    \u0440\u0430\u0441\u043F\u0430\u043B\u0430\u0441\u044C, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
    \u043A\u043E\u043F\u0438\u0438 \u0448\u043B\u0435\u043C\u043E\u0432 \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u043E\u043F\u0430\u043B\u0438 \u0432 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u043E\u0433\u0434\u0430\u0448\u043D\u0438\u0445 \u0440\u044F\u0434\u043E\u0432\u044B\u0445
    \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432. \u041D\u043E \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
    \u043E\u0441\u043E\u0431\u0443\u044E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
    M10 \u0432\u043E\u0437\u044B\u043C\u0435\u043B \u0441\u0440\u0435\u0434\u0438
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0435\u0439, \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F
    \u043A \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u043C \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u043C
    \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F\u043C \u043D\u0430
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0417\u043E\u043D\u044B."
