  m_Name: helm_m50
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: a1b83ec0d1f56c74d848517a9f6ca816
  _displayName: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 M50\u0437"
  _shortName: HEAVY
  _description: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437 M50, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u043B\u0443\u0447\u0448\u0435\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0417\u043E\u043D\u044B. \u0418 \u043F\u0443\u0441\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C \u044D\u0442\u0438\u0445 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u0439 \u0441\u0442\u0430\u043B\u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0437\u0430\u0449\u0438\u0442\u044B \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u043E\u043C, \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F \xAB\u0417\xBB \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043E\u0442 \u043F\u0441\u0438-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438. \u041C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u043E\u0432 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 M40, \u0438, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E, \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u0427\u0412\u041A, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043D\u0430\u0431\u0436\u0430\u044E\u0442 \u0438\u043C\u0438 \u0441\u0432\u043E\u0438\u0445 \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432 \u0432 \u0417\u043E\u043D\u0435 \u0438\u043B\u0438 \u0436\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u044E\u0442 \u0434\u0440\u0443\u0433\u0438\u043C \u0433\u0440\u0443\u043F\u043F\u0430\u043C \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432."
