  m_Name: t12
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 116d06cec93c73748938e8e7c294e0d0
  _displayName: "\u0422\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Torrey Pines Logic T12-W 30 \u0413\u0446"
  _shortName: T12W
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u0432\u0435\u0440\u0445\u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u0442\u0435\u043F\u043B\u043E\u0432\u0438\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Torrey Pines Logic \u0434\u043B\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043F\u043B\u043E\u0432\u044B\u0445 \u0446\u0435\u043B\u0435\u0439 \u0432 \u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u0438 \u043D\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043D\u0435\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0435\u043C\u044B\u043C \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0441\u0435\u043D\u0441\u043E\u0440\u043E\u043C FLIR Lepton \u0441 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C 80x60 \u043F\u0438\u043A\u0441\u0435\u043B\u0435\u0439, \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u043C \u0432 \u0441\u043F\u0435\u043A\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u0435 8\u201314 \u043C\u043A\u043C \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F 30 \u0413\u0446. \u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 OLED-\u0434\u0438\u0441\u043F\u043B\u0435\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0447\u0435\u0442\u044B\u0440\u0435 \u0440\u0435\u0436\u0438\u043C\u0430 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0442\u0435\u043F\u043B\u043E\u0432\u044B\u0445 \u0441\u0438\u0433\u043D\u0430\u0442\u0443\u0440: White Hot, Black Hot, \u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u043C\u043E\u043D\u043E\u0445\u0440\u043E\u043C\u043D\u044B\u0439 \u0438 \u0446\u0432\u0435\u0442\u043D\u043E\u0439. \u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0430\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u043C\u0430\u0440\u043A\u0430 \u0441 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F, \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0435\u0451 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u044F \u043D\u0435\u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0441\u0442\u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u044D\u043D\u0435\u0440\u0433\u043E\u0441\u0431\u0435\u0440\u0435\u0433\u0430\u044E\u0449\u0438\u0439 \u0440\u0435\u0436\u0438\u043C. \u0423\u0433\u043B\u043E\u0432\u043E\u0435 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 12,5\xB0, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u0442\u0435\u043F\u043B\u0430 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u043F\u0440\u0438 \u043B\u0451\u0433\u043A\u043E\u043C \u0437\u0430\u0434\u044B\u043C\u043B\u0435\u043D\u0438\u0438 \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438. \u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C 50x45x39 \u043C\u043C \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u043D\u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F Picatinny. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0442\u0438\u0435\u0432\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR123, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0431\u043E\u043B\u0435\u0435 8 \u0447\u0430\u0441\u043E\u0432 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B. \u041C\u0430\u0441\u0441\u0430 \u0431\u0435\u0437 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u0441\u0435\u0433\u043E 64 \u0433\u0440\u0430\u043C\u043C\u0430. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u043D\u044B\u043C\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C\u0438 \u0438 \u043D\u0438\u0437\u043A\u0438\u043C \u044D\u043D\u0435\u0440\u0433\u043E\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0441\u0435\u043D\u0441\u043E\u0440\u0430 \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u0435\u0442 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u0435 \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
