  _displayName: "\u041A\u0443\u0440\u0442\u043A\u0430 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _shortName: "\u041A\u0443\u0440\u0442\u043A\u0430 \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB"
  _description: "\u041A\u0430\u043C\u0443\u0444\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0430\u043D\u043E\u0440\u0430\u043A,
    \u043D\u0430\u0434\u0435\u0442\u044B\u0439 \u043F\u043E\u0432\u0435\u0440\u0445
    \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u043E\u043B\u0430\u0437\u043D\u043E\u0433\u043E
    \u0441\u0432\u0438\u0442\u0435\u0440\u0430 \u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u0434\u0436\u0438\u043D\u0441\u044B
    \u0438 \u0431\u0435\u0440\u0446\u044B. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0447\u043B\u0435\u043D\u0430\u043C\u0438 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \xAB\u0421\u0432\u043E\u0431\u043E\u0434\u044B\xBB, \u043A\u043E\u0433\u0434\u0430
    \u0442\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442 \u0441\u0435\u0431\u044F
    \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
    - \u0442\u043E \u0435\u0441\u0442\u044C \u0432\u0441\u0435\u0433\u0434\u0430."
