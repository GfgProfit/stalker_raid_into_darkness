  m_Name: merc_exo_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 478ac5dcc9352b54d889969a10e1d510
  _displayName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _shortName: "\u042D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432"
  _description: "\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
    \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0434\u043B\u044F
    \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u044F \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
    \u0433\u0440\u0443\u043F\u043F. \u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E
    \u043C\u043E\u0449\u043D\u044B\u0439 \u0438 \u0445\u043E\u0440\u043E\u0448\u043E
    \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C,
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439 \u043A \u0442\u043E\u043C\u0443
    \u0436\u0435 \u0435\u0449\u0451 \u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
    \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443 \u043D\u0435\u0434\u0435\u043B\u044C\u043D\u044B\u0439
    \u0437\u0430\u043F\u0430\u0441 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F.
    \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u0445\u043E\u0440\u043E\u0448\u0438\u0445
    \u0434\u0438\u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u043F\u0440\u0438
    \u0435\u0433\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438, \u0442\u0430\u043A
    \u0438 \u043A\u0440\u0430\u0439\u043D\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E \u0442\u0435\u0445\u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F.
    \u0427\u0430\u0441\u0442\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438-\u0432\u0435\u0442\u0435\u0440\u0430\u043D\u0430\u043C\u0438
    \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430 \u0431\u043E\u0439\u0446\u043E\u0432, \u043A\u043E\u0433\u0434\u0430
    \u043E\u0442\u0440\u044F\u0434\u0430\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 \u0430\u0434\u0441\u043A\u0438\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u0441\u0435\u0440\u0432\u043E\u043F\u0440\u0438\u0432\u043E\u0434\u044B, \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C,
    \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0438\u0437 \u0442\u0440\u0451\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439: \u044D\u043A\u0437\u043E\u0448\u043B\u0435\u043C,
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442
    \u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0441\u0442\u044E\u043C
    \u0438\u0437 \u043A\u0435\u0432\u043B\u0430\u0440\u0430."
