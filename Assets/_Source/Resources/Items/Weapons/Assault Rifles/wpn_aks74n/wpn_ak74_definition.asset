  m_Name: wpn_ak74_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 88a0ea7c5b9d6164bb19b6f8c60227c5
  _displayName: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442 \u041A\u0430\u043B\u0430\u0448\u043D\u0438\u043A\u043E\u0432\u0430 \u0410\u041A\u0421-74\u041D (6\u041F21\u041D)"
  _shortName: "\u0410\u041A\u0421-74\u041D"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,45x39 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u0431\u0430\u0437\u0435 \u0410\u041A-74 \u0438 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0434\u043B\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E-\u0434\u0435\u0441\u0430\u043D\u0442\u043D\u044B\u0445 \u0432\u043E\u0439\u0441\u043A \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044E \u0410\u041A\u0421-74 \u0441\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u044B\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0440\u0430\u043C\u043E\u0447\u043D\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u043C\u043E\u043D\u0442\u0430\u0436\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043D\u043E\u0447\u043D\u044B\u0445 \u0438 \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u0432. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0433\u0430\u0437\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u043E\u0439 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0445\u043E\u0434\u043E\u043C \u043F\u043E\u0440\u0448\u043D\u044F \u0438 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043D\u044B\u043C \u0437\u0430\u0442\u0432\u043E\u0440\u043E\u043C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C\u0438 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438. \u0414\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0433\u043D\u044F \u0441 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0435\u043C\u043F\u043E\u043C \u043E\u043A\u043E\u043B\u043E 600 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043C\u0438\u043D\u0443\u0442\u0443. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0435 \u043E\u0442\u044A\u0451\u043C\u043D\u044B\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u044B \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 30 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u0421\u0442\u0432\u043E\u043B \u0434\u043B\u0438\u043D\u043E\u0439 415 \u043C\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u043F\u043E\u0440\u044F\u0434\u043A\u0430 900 \u043C/\u0441, \u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 500\u2013600 \u043C\u0435\u0442\u0440\u043E\u0432. \u0414\u043B\u0438\u043D\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 940 \u043C\u043C \u0441 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 700 \u043C\u043C \u0441\u043E \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0431\u043E\u043A\u043E\u0432\u043E\u0433\u043E \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438 \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B."
