  m_Name: merc_ace_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: f4934dc0af9022948bbed7b3255bed8a
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u0441 \u0417\u0421\u0414 \xAB\u0410\u0441\xBB"
  _shortName: "\u0411\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \u0441 \u0417\u0421\u0414 \xAB\u0410\u0441\xBB"
  _description: "\u041A\u0440\u0430\u0439\u043D\u0435 \u0443\u0434\u043E\u0431\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C \xAB\u0410\u0441\xBB \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0434\u044B\u0445\u0430\u043D\u0438\u044F \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0445 \u0438 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u0445 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u043E\u0432 \u0432 \u0417\u043E\u043D\u0435. \u0421\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u043E\u0442 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0445 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432 \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B. \xAB\u0410\u0441\xBB \u0441\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u043E\u0432\u0430\u043D \u0442\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u0432 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u0438 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0445 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0435\u0449\u0451 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435 \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0441\u0435\u0431\u0435 \u043B\u0438\u0448\u044C \u0441\u0430\u043C\u044B\u0435 \u043E\u043F\u044B\u0442\u043D\u044B\u0435 \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u0441\u0430\u043C\u044B\u0445 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u0443\u0433\u043E\u043B\u043A\u0430\u0445 \u0417\u043E\u043D\u044B \u043A\u0430\u043A, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0420\u044B\u0436\u0438\u0439 \u043B\u0435\u0441."
