  m_Name: stalker_predator_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ff7ad0c072ebff24f93684fcd1b1ea52
  _displayName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041E\u0445\u043E\u0442\u043D\u0438\u043A\xBB"
  _shortName: "\u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041E\u0445\u043E\u0442\u043D\u0438\u043A\xBB"
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D.
    \u042F\u0432\u043B\u044F\u044F\u0441\u044C, \u043F\u043E \u0441\u0443\u0442\u0438,
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0435\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \xAB\u0421\u043A\u0438\u0442\u0430\u043B\u044C\u0446\u0430\xBB,
    \u0438\u043C\u0435\u0435\u0442 \u0441\u0445\u043E\u0436\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B, \u043E\u0434\u043D\u0430\u043A\u043E \u043F\u0440\u0438
    \u044D\u0442\u043E\u043C \u0431\u044B\u043B\u043E \u0443\u0434\u0435\u043B\u0435\u043D\u043E
    \u0435\u0449\u0451 \u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043A
    \u0443\u0434\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0435\u0433\u043E \u043D\u043E\u0448\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E \u0438 \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u043B\u043E
    \u0435\u0433\u043E \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432-\u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432,
    \u043D\u0443\u0436\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u0439
    \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u0435.
    \u041A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u041E\u0445\u043E\u0442\u043D\u0438\u043A\xBB
    \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0434\u0435\u0448\u0451\u0432
    \u0432 \u043F\u043B\u0430\u043D\u0435 \u0442\u0435\u0445\u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F,
    \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044F \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0434\u043B\u044F \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E
    \u0435\u0433\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
