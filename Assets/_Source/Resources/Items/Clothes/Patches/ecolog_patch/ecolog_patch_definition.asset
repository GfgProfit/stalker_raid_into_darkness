  m_Name: ecolog_patch
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 1b7efe276d5b9e045b2e1bba0423ab29
  _displayName: "\u041D\u0430\u0448\u0438\u0432\u043A\u0430 \u0443\u0447\u0451\u043D\u044B\u0445"
  _shortName: "\u042D\u043A\u043E\u043B."
  _description: "\u041D\u0430 \u0434\u0430\u043D\u043D\u043E\u0439 \u043D\u0430\u0448\u0438\u0432\u043A\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0430 \u043F\u0430\u0440\u0430 \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0445 \u043A\u0440\u044B\u043B\u044C\u0435\u0432 \u043D\u0430 \u0431\u0435\u043B\u043E-\u0431\u0438\u0440\u044E\u0437\u043E\u0432\u043E\u043C \u0444\u043E\u043D\u0435 \u0432\u043E\u0434\u043D\u043E\u0439 \u0433\u043B\u0430\u0434\u0438 \u0441 \u043F\u0430\u0440\u043E\u0439 \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0445 \u0437\u0432\u0451\u0437\u0434 \u0441\u0432\u0435\u0440\u0445\u0443, \u0434\u0430\u044E\u0449\u0438\u0445 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0431 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0446\u0435\u043B\u044F\u0445 \u044D\u043A\u043E\u043B\u043E\u0433\u043E\u0432 \u0438 \u0443\u0447\u0451\u043D\u044B\u0445 \u0432 \u0417\u043E\u043D\u0435. \u0418\u0445 \u043D\u0430\u0448\u0438\u0432\u043A\u0438 \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u0432\u043E\u0441\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u044B \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C \u0440\u044B\u043D\u043A\u0435 \u0417\u043E\u043D\u044B, \u0442\u0430\u043A \u043A\u0430\u043A \u0438\u0445 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043D\u0430 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439 \u0438 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043F\u043E \u0417\u043E\u043D\u0435. \u0420\u0430\u0434\u0438 \u0441\u0432\u043E\u0435\u0439 \u0436\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043D\u0430\u0448\u0438\u0432\u043A\u0430\u043C\u0438 \u043F\u043E \u0441\u0432\u043E\u0435\u0439 \u0432\u043E\u043B\u0435, \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u044D\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u0445, \u0434\u043B\u044F \u043A\u043E\u0433\u043E \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u043C\u043E\u0440\u0430\u043B\u0438."
