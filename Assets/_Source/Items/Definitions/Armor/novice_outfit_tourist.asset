  m_Name: novice_outfit_tourist
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 6244a239000163746ac77a84eebb46e6
  _displayName: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0442\u0443\u0440\u0438\u0441\u0442\u0430"
  _shortName: "\u041A\u0443\u0440\u0442\u043A\u0430 \u0442\u0443\u0440\u0438\u0441\u0442\u0430"
  _description: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
    \u0430\u043D\u043E\u0440\u0430\u043A, \u043D\u0430\u0434\u0435\u0442\u044B\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445 \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E
    \u0432\u043E\u0434\u043E\u043B\u0430\u0437\u043D\u043E\u0433\u043E \u0441\u0432\u0438\u0442\u0435\u0440\u0430
    \u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043F\u0440\u043E\u0447\u043D\u044B\u0435 \u0434\u0436\u0438\u043D\u0441\u044B
    \u0438 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435 \u0431\u043E\u0442\u0438\u043D\u043A\u0438.
    \u0413\u043B\u0430\u0432\u043D\u044B\u043C \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C
    \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0435\u043C\u0443 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0448\u0438\u0442\u044B\u0439
    \u0432 \u0430\u043D\u043E\u0440\u0430\u043A \u0440\u044E\u043A\u0437\u0430\u043A.
    \u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443, \u043F\u0440\u043E\u0448\u043B\u044B\u0439
    \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
    \u0442\u0443\u0440\u0438\u0441\u0442\u043E\u043C: \u0433\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0439
    \u043F\u043E\u0434\u0431\u043E\u0440 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0432\u0435\u0441\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0434\u0430\u043D\u043D\u044B\u0439
    \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u043A\u0443\u0434\u0430
    \u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C,
    \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u043F\u0440\u043E\u0447\u0438\u0445 \u043A\u0443\u0440\u0442\u043E\u043A - \u043D\u043E,
    \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u043E\u043D
    \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u0434\u043B\u044F \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u043B\u0435\u0435
    \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0433\u043E, \u0447\u0435\u043C
    \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438 \u0443 \u0432\u043D\u0435\u0448\u043D\u0438\u0445
    \u0433\u0440\u0430\u043D\u0438\u0446 \u0417\u043E\u043D\u044B."
