  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966679528}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966679614}
  - {fileID: 114350483966679615}
  - {fileID: 114350483966679616}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966679613}
  m_BlockName: Limit new idle particles by quality
  m_HLSLCode: "void AdmitGazirovkaIdle1(inout VFXAttributes attributes, in RWStructuredBuffer<uint> counters, in uint counterOffset, in float density)\n{\n    uint address = counterOffset + 1u;\n    uint limit = max(1u, (uint)ceil(12.0f * saturate(density)));\n    uint previous;\n    InterlockedAdd(counters[address], 1u, previous);\n    attributes.alive = previous < limit;\n    if (!attributes.alive)\n    {\n        InterlockedAdd(counters[address], 0xffffffffu);\n    }\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: AdmitGazirovkaIdle1
    selectedIndex: 0
