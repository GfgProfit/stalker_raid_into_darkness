  m_Name: cs_light_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ebdaf416f3c028743b54b7b4164dbe31
  _displayName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0427\u041D-2\u0430"
  _shortName: "\u0411\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0427\u041D-2\u0430"
  _description: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0439
    \u0447\u043B\u0435\u043D\u0430\u043C\u0438 \xAB\u0427\u0438\u0441\u0442\u043E\u0433\u043E
    \u043D\u0435\u0431\u0430\xBB, \u0434\u0430\u043D\u043D\u044B\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439
    \u043A\u043E\u0441\u0442\u044E\u043C \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439
    \u0432 \u0437\u043E\u043D\u0430\u0445 \u0441 \u043D\u0438\u0437\u043A\u0438\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0440\u0438\u0441\u043A\u0430 - \u0431\u0443\u0434\u044C
    \u0442\u043E \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0438\u043B\u0438
    \u043A\u0430\u043A\u0430\u044F-\u043B\u0438\u0431\u043E \u0435\u0449\u0451 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C.
    \u0427\u041D-2\u0430 \u043D\u0435 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0431\u043E\u0435\u0432\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439
    \u0438\u043B\u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u044F \u0432 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
    \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430\u0445, \u0445\u043E\u0442\u044C
    \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E \u043F\u0440\u043E\u044F\u0432\u0438\u0442
    \u0441\u0435\u0431\u044F \u043B\u0443\u0447\u0448\u0435 \u0442\u043E\u0433\u043E
    \u0436\u0435 \u0427\u041D-1 \u0432 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445
    \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u044F\u0445."
