  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: aim_low
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 9f2fc43076f60a5459bd673f5547bd94
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Aimpoint Micro T1 (\u043D\u0438\u0437\u043A\u043E\u0435
    \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435)"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Aimpoint Micro T1 (\u043D\u0438\u0437\u043A\u043E\u0435
    \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435)"
  _description: "\u041E\u0431\u043B\u0430\u0434\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0430
    \u043F\u0440\u0438\u0446\u0435\u043B\u044B Aimpoint \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0432\u0441\u0435\u043C\u0443 \u043C\u0438\u0440\u0443, \u044D\u0442\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
    \u043F\u0440\u0438\u0446\u0435\u043B\u044B \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B
    \u0442\u0430\u043A \u0436\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
    \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F
    \u043B\u0438\u0448\u044C \u043D\u0435\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0432\u0435\u0441 \u043A \u0412\u0430\u0448\u0435\u043C\u0443 \u043E\u0440\u0443\u0436\u0438\u044E.
    \u0414\u0440\u043E\u0431\u043E\u0432\u044B\u0435 \u0440\u0443\u0436\u044C\u044F,
    \u043D\u0430\u0440\u0435\u0437\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
    \u043B\u044E\u0431\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u0438 \u0440\u0443\u0447\u043D\u043E\u0435
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u043E\u0435
    \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435 - \u044D\u0442\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u0441\u043E \u0432\u0441\u0435\u043C! \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
    \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432, \u0434\u0430\u043D\u043D\u044B\u0435
    \u043F\u0440\u0438\u0446\u0435\u043B\u044B \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441\u0430\u043C\u044B\u043C\u0438 \u043B\u0451\u0433\u043A\u0438\u043C\u0438
    \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u043C\u0438
    \u043F\u0440\u0438\u0446\u0435\u043B\u0430\u043C\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430. \u041E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E\u0435
    \u043D\u0430\u0440\u0435\u0437\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
    \u0441 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
    \u041D-2 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C
    \u0436\u0435 \u043B\u0451\u0433\u043A\u0438\u043C, \u043A\u0430\u043A \u0438
    \u0441 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C, \u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
    <color=#8C8C8C>\u0414\u0430\u043D\u043D\u0430\u044F \u043C\u043E\u0434\u0435\u043B\u044C
    \u0438\u043C\u0435\u0435\u0442 \u043D\u0438\u0437\u043A\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435."
