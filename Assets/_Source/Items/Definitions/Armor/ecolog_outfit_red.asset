  m_Name: ecolog_outfit_red
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 1a6f5992650a9eb4eb60eaa3aa7aa7a8
  _displayName: "\u0421\u0421\u041F-99\u041C \xAB\u0420\u0443\u0431\u0438\u043D\xBB"
  _shortName: "\u0421\u0421\u041F-99\u041C \xAB\u0420\u0443\u0431\u0438\u043D\xBB"
  _description: "\u0412\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \u0421\u0421\u041F-99\u041C \u0441 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u043E\u0442 \u043F\u0443\u043B\u044C \u0438 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0430\u0442\u0430\u043A \u043C\u0443\u0442\u0430\u043D\u0442\u043E\u0432. \u0410 \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u0442 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u044E, \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E \u0437\u0430\u0436\u0438\u0432\u043B\u0435\u043D\u0438\u044E \u0440\u0430\u043D\u044B. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0445\u0440\u0430\u043D\u044B \u043D\u0430\u0443\u0447\u043D\u044B\u0445 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0439. \xAB\u0420\u0443\u0431\u0438\u043D\xBB \u0442\u0430\u043A\u0436\u0435 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438 \u0438 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439, \u0432\u0434\u043E\u0431\u0430\u0432\u043E\u043A \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0445\u0432\u0430\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C\u044E \u043A \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0439 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u0435 \u0438 \u043F\u0440\u043E\u0447\u0438\u043C \u0443\u0433\u0440\u043E\u0437\u0430\u043C \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430."
