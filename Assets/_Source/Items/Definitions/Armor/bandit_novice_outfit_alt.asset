  _definitionId: 633c0f4a6aa0ab34eb5af7dc957ff0ac
  _displayName: "\u041A\u043E\u043B\u044C\u0447\u0443\u0436\u043D\u0430\u044F \u043A\u0443\u0440\u0442\u043A\u0430"
  _shortName: "\u041A\u043E\u043B\u044C\u0447\u0443\u0436\u043D\u0430\u044F \u043A\u0443\u0440\u0442\u043A\u0430"
  _description: "\u041F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u043A\u0443\u0440\u0442\u043A\u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u0442\u044C \u0432 \u0417\u043E\u043D\u0435 \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0435\u0446 \xAB\u0414\u043E\u043B\u0433\u0430\xBB \u041C\u043E\u0440\u0433\u0430\u043D \u043D\u0430\u043B\u0430\u0434\u0438\u043B \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0438 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0443, \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C\u0443\u044E \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u043C \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u0443\u044E \u0434\u043B\u044F \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0417\u043E\u043D\u044B, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043F\u0440\u0438 \u0431\u043E\u0435\u0432\u044B\u0445 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F\u0445 \u0441 \u0434\u043E\u043B\u0433\u043E\u0432\u0446\u0430\u043C\u0438."
