    "m_ObjectId": "ee63a32b5f9b5484b28794698d98d44f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GazirovkaParticle (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 0,
            "y": 110,
            "width": 180,
