  m_Name: pk-a
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 6d9d458bc71e113429a7cf186eedcd34
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041F\u041A-\u0410"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B \u041F\u041A-\u0410"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C> \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F \u0412\u0430\u0440\u0448\u0430\u0432\u0441\u043A\u043E\u0433\u043E
    \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430\n\n<color=#AAAAAA>\u041F\u041A-\u0410
    - \u044D\u0442\u043E \u0431\u0435\u043B\u043E\u0440\u0443\u0441\u0441\u043A\u0438\u0439
    \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439
    \u043F\u0440\u0438\u0446\u0435\u043B \u0434\u043B\u044F \u043B\u0451\u0433\u043A\u043E\u0433\u043E
    \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u0430\u043C\u0438
    \u043C\u0438\u043D\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F
    \xAB\u0411\u0435\u043B\u041E\u041C\u041E\xBB. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0441\u043E \u0448\u0442\u0430\u0442\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435
    \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \u0432 \u0442\u0440\u0438 \u0440\u0430\u0437\u0430
    \u043F\u0440\u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438
    \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0431\u043E\u043B\u0435\u0435
    \u0447\u0435\u043C \u0432 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430. \u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u043F\u0440\u0438\u0446\u0435\u043B\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043F\u043B\u043E\u0445\u043E\u0439
    \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438 \u0438
    \u043D\u043E\u0447\u044C\u044E \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438
    \u0441 \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u043C \u043D\u043E\u0447\u043D\u043E\u0433\u043E
    \u0432\u0438\u0434\u0435\u043D\u0438\u044F.\n\n<color=#5D0074> \u2022 <color=#8C8C8C>
    \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435: <color=#AAAAAA>\u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    (\u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440)\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435:
    <color=#AAAAAA>\u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435"
