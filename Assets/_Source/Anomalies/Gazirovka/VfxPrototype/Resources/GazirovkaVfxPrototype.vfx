  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966680205}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966680305}
  m_BlockName: Stretched rain billboard
  m_HLSLCode: "void StretchedGazirovka(inout VFXAttributes attributes)\n{\n    float speedSquared = dot(attributes.velocity, attributes.velocity);\n    attributes.axisX = -attributes.velocity * rsqrt(max(speedSquared, 1.0e-10f));\n    attributes.axisY = VFXSafeNormalizedCross(attributes.position - GetViewVFXPosition(), attributes.axisX, float3(0.0f, 1.0f, 0.0f));\n    attributes.axisZ = cross(attributes.axisX, attributes.axisY);\n    float width = attributes.scaleX;\n    attributes.scaleX = attributes.scaleY;\n    attributes.scaleY = width;\n    attributes.pivotX = -0.5f;\n    attributes.angleZ = 0.0f;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: StretchedGazirovka
    selectedIndex: 0
