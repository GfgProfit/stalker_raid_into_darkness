  m_Name: wpn_addon_scope_galil
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: fba5685f72303e04a820be595f8c3a32
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Galil 4.0x"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Galil 4.0x"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF> \u2022 <color=#8C8C8C> \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430 Galil AR\n\n<color=#AAAAAA>\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E Galil AR. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0438\u043B\u043E\u043D-\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0442\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0440\u0438\u0446\u0435\u043B \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u043C \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0434\u043B\u044F \u043C\u0430\u043B\u044B\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0439, \u0442\u0430\u043A \u043A\u0430\u043A \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043B\u044C. \u0414\u0430\u043D\u043D\u044B\u0439 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440 \u0438\u043C\u0435\u0435\u0442 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C 4.0x \u0438 \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0434\u043B\u044F \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0433\u043D\u044F \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0435 \u0438 \u0434\u0430\u043B\u044C\u043D\u0438\u0435 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438.\n\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435: <color=#AAAAAA>4.0x\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435: <color=#AAAAAA>\u0445\u043E\u0440\u043E\u0448\u0435\u0435\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0422\u0438\u043F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0438: <color=#AAAAAA>SUSAT"
