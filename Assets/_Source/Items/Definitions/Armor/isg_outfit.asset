  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: isg_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 9042d740729ab4d48b376883982f8d08
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0418\u0418\u0413
    Mk.1"
  _shortName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442 \u0418\u0418\u0413
    Mk.1"
  _description: "\u0411\u0443\u0434\u0443\u0447\u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u043C
    \u043D\u0430 \u0431\u0430\u0437\u0435 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u0432,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0445 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u043C\u0438
    \u0441\u043F\u0435\u0446\u0441\u043B\u0443\u0436\u0431\u0430\u043C\u0438, \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435
    \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u044B
    \u043A\u0440\u0430\u0439\u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u044B
    \u0441\u0440\u0435\u0434\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430
    \u0430\u0440\u043C\u0438\u0439 \u043C\u0438\u0440\u0430. \u041F\u0435\u0440\u0432\u0430\u044F
    \u043C\u043E\u0434\u0435\u043B\u044C (Mark 1) \u0434\u043E\u043B\u0436\u043D\u0430
    \u0431\u044B\u0442\u044C \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u043F\u043E\u0440\u043E\u0433\u043E\u043C \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u044B
    \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0418\u0418\u0413.
    \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0433\u043E
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432
    \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0432\u0435\u0441\u043E\u043C, \u043F\u0440\u0438
    \u044D\u0442\u043E\u043C \u0438\u043C\u0435\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u0437\u0430\u0449\u0438\u0442\u044B \u043A\u0443\u0434\u0430 \u0445\u0443\u0436\u0435
    \u0430\u043D\u0430\u043B\u043E\u0433\u0430, \u0447\u0442\u043E \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043D\u0435 \u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432 \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u0417\u043E\u043D\u044B. \u0421\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
    \u0441\u0432\u043E\u0438\u0445 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
    Mk.1 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435\u0435
    \u0442\u0435\u0445 \u0436\u0435 \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0445
    \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u043E\u0432."
