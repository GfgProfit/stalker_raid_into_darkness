  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Leupold Mark 8 CQBSS 1.1-8x24"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Leupold Mark 8 CQBSS 1.1-8x24"
  _description: "\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u0446\u0435\u043B Leupold Mark 8 1.1-8x24 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440, \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u0439 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u043E\u043C \u043A\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438. \u041C\u043E\u0434\u0435\u043B\u044C \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442 \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043D\u043E \u0432\u0435\u0448\u0430\u0442\u044C \u044F\u0440\u043B\u044B\u043A \"\u0437\u0430\u0433\u043E\u043D\u043D\u044B\u0439\" \u043F\u0440\u0438\u0446\u0435\u043B \u043D\u0435 \u0441\u0442\u043E\u0438\u0442, \u0442\u0430\u043A \u043A\u0430\u043A \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u043F\u043E\u043B\u043D\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C \u0434\u043B\u044F \u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F."
