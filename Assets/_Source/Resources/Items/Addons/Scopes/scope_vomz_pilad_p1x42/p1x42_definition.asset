  m_Name: p1x42
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 55b9e4df57ad16643ae21c0c2a23725e
  _displayName: "\u041A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u0412\u041E\u041C\u0417 \xAB\u041F\u0438\u043B\u0430\u0434\xBB P1x42"
  _shortName: "\u041F\u0438\u043B\u0430\u0434"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u043B\u043B\u0438\u043C\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u0438\u0446\u0435\u043B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435\u043C 1x, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0412\u043E\u043B\u043E\u0433\u043E\u0434\u0441\u043A\u0438\u043C \u043E\u043F\u0442\u0438\u043A\u043E-\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C (\u0412\u041E\u041C\u0417) \u043F\u043E\u0434 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 \xAB\u041F\u0438\u043B\u0430\u0434\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0439 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u044B\u043C \u043E\u043A\u043D\u043E\u043C \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0440\u043A\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0442\u043E\u0447\u043A\u0443, \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u0438 \u0438\u0445 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E. \u0418\u043C\u0435\u0435\u0442 \u0440\u0443\u0447\u043D\u0443\u044E \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0443 \u044F\u0440\u043A\u043E\u0441\u0442\u0438 \u0441 \u0434\u0435\u0432\u044F\u0442\u044C\u044E \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0443\u044E \u0443\u0434\u043E\u0431\u043D\u043E\u0435 \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u0439 \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0437\u0430\u0449\u0438\u0449\u0451\u043D \u043E\u0442 \u0432\u043B\u0430\u0433\u0438 \u0438 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0445 \u043E\u0442 \u221240 \u0434\u043E +50 \xB0C. \u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0432 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u0445 \u0441 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F\u043C\u0438 Weaver/Picatinny, \xAB\u043B\u0430\u0441\u0442\u043E\u0447\u043A\u0438\u043D \u0445\u0432\u043E\u0441\u0442\xBB \u0438 \u0434\u043B\u044F \u0432\u0435\u043D\u0442\u0438\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u0438. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0442\u0438\u0435\u0432\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438 CR2032, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439 \u0434\u043E 70 \u0447\u0430\u0441\u043E\u0432 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u044F\u0440\u043A\u043E\u0441\u0442\u0438. \u041C\u0430\u0441\u0441\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 160 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043F\u043E\u043B\u0435\u043C \u0437\u0440\u0435\u043D\u0438\u044F, \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F \u0441 \u043E\u0431\u043E\u0438\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
