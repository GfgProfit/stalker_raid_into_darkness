  m_Name: wpn_knife_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ef2b115e645b72343aafd77102f2a3f1
  _displayName: "\u0420\u0430\u0437\u0434\u0435\u043B\u043E\u0447\u043D\u044B\u0439 \u043D\u043E\u0436 \xAB\u0411\u0430\u0440\u0441\xBB \u0410-2607"
  _shortName: "\u0411\u0430\u0440\u0441 \u0410-2607"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043D\u043E\u0433\u043E\u0446\u0435\u043B\u0435\u0432\u043E\u0439 \u043D\u043E\u0436 \u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0435\u043C \u041E\u041E\u041E \xAB\u0411\u0430\u0440\u0441\xBB \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0412\u043E\u0440\u0441\u043C\u0430 \u041D\u0438\u0436\u0435\u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0440\u0430\u0437\u0434\u0435\u043B\u043A\u0438 \u0434\u043E\u0431\u044B\u0447\u0438, \u043E\u0445\u043E\u0442\u044B \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447 \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u043E\u0434\u043D\u043E\u043B\u0435\u0437\u0432\u0438\u0439\u043D\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u0441 \u043F\u043B\u0430\u0432\u043D\u043E \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u043E\u0439 \u0440\u0435\u0436\u0443\u0449\u0435\u0439 \u043A\u0440\u043E\u043C\u043A\u043E\u0439. \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u044B \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0438\u0437 \u043A\u043E\u0440\u0440\u043E\u0437\u0438\u043E\u043D\u043D\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0439 \u0441\u0442\u0430\u043B\u0438 95\u042518 \u0438 \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u043E\u0439 \u0441\u0442\u0430\u043B\u0438. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043D\u043E\u0436\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 270 \u043C\u043C, \u0434\u043B\u0438\u043D\u0430 \u043A\u043B\u0438\u043D\u043A\u0430 \u2014 155 \u043C\u043C, \u0448\u0438\u0440\u0438\u043D\u0430 \u2014 40 \u043C\u043C. \u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0437 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u043E\u0440\u043E\u0434, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0432\u0435\u043D\u0433\u0435, \u0438 \u043E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043B\u0430\u0442\u0443\u043D\u043D\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439. \u041F\u0440\u043E\u0441\u0442\u0430\u044F \u043D\u0435\u0441\u043A\u043B\u0430\u0434\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
