  m_Name: ammo_9x19_fmj
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.ItemDefinition
  _definitionId: a727330d9d393784abfb8179a6e2e10b
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 9x19 \u043C\u043C \u041F\u0421\u041E \u0433\u0436"
  _shortName: "\u041F\u0421\u041E"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 9x19 \u043C\u043C \u041F\u0430\u0440\u0430\u0431\u0435\u043B\u043B\u0443\u043C \u0441 \u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u041F\u0421\u041E, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0439, \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B. \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0431\u044B\u043B\u043E \u043E\u0441\u0432\u043E\u0435\u043D\u043E \u0422\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C \u0432 1993 \u0433\u043E\u0434\u0443, \u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u0432\u044B\u043F\u0443\u0441\u043A \u043D\u0430\u043B\u0430\u0436\u0435\u043D \u043D\u0430 \u0411\u0430\u0440\u043D\u0430\u0443\u043B\u044C\u0441\u043A\u043E\u043C, \u041D\u043E\u0432\u043E\u0441\u0438\u0431\u0438\u0440\u0441\u043A\u043E\u043C \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0445 \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u0445. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 7,5 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441\u043E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0438 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 315\u2013400 \u043C/\u0441 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0438 \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F, \u0434\u043B\u044F \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432 \u2014 \u043E\u043A\u043E\u043B\u043E 340 \u043C/\u0441. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439 \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u043C\u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u043F\u0443\u043B\u0435 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439, \u043E\u0434\u043D\u0430\u043A\u043E \u0443\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C 7\u041D21 \u0438 7\u041D31 \u043F\u043E \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445, \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430\u0445-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 \u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0438\u0445 \u043A\u0430\u0440\u0430\u0431\u0438\u043D\u0430\u0445 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x19 \u043C\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430, \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F."
