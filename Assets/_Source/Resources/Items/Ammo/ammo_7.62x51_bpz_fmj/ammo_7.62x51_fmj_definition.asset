  m_Name: ammo_7.62x51_fmj
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 9b3c2293430e50b4c9929088a3dad5b0
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7.62x51 \u043C\u043C \u0411\u041F\u0417 FMJ"
  _shortName: "\u0411\u041F\u0417 FMJ"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 .308 Winchester (7,62x51 \u043C\u043C), \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0439 \u0411\u0430\u0440\u043D\u0430\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043D\u044B\u043C \u0437\u0430\u0432\u043E\u0434\u043E\u043C (\u0411\u041F\u0417) \u043F\u043E\u0434 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u043C\u0430\u0440\u043A\u043E\u0439 Barnaul. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0439, \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0438\u0437 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0445 \u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043D\u044B\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 FMJ \u043C\u0430\u0441\u0441\u043E\u0439 9,4 \u0433\u0440\u0430\u043C\u043C\u0430 (145 \u0433\u0440\u0430\u043D) \u0441 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439 \u0438 \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0443\u043B\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 815 \u043C/\u0441, \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u2014 3122 \u0414\u0436 \u043F\u0440\u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0435 \u0438\u0437 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u0442\u0432\u043E\u043B\u0430 \u0434\u043B\u0438\u043D\u043E\u0439 600 \u043C\u043C. \u0421\u0442\u0430\u043B\u044C\u043D\u0430\u044F \u0433\u0438\u043B\u044C\u0437\u0430 \u0438\u043C\u0435\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435, \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0435\u0435 \u043A\u043E\u0440\u0440\u043E\u0437\u0438\u044E \u043F\u0440\u0438 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438 \u0438 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u043C\u0438 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C\u0438 \u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043F\u043E \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\u043C, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C\u044E, \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439 \u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u044C\u044E \u0434\u043B\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0439 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B."
