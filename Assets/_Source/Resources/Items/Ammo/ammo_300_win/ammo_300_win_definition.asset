  m_Name: ammo_300_win
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: c34b9739c482f2d4f80a903dc7fdf0fd
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B .300 Winchester Magnum (7,62x67 \u043C\u043C)"
  _shortName: Win Mag
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u043C\u043E\u0449\u043D\u044B\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D .300 Winchester Magnum, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Winchester Repeating Arms \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432 1963 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445, \u043E\u0445\u043E\u0442\u044B \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0437\u0432\u0435\u0440\u044F \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445. \u041E\u0441\u043D\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u0443\u043B\u044F\u043C\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043E\u0442 9,7 \u0434\u043E 14,3 \u0433\u0440\u0430\u043C\u043C\u0430 (150\u2013220 \u0433\u0440\u0430\u043D), \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u0435, \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u044B\u0435 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u044B\u0435 \u043C\u0430\u0442\u0447\u0435\u0432\u044B\u0435 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438 \u0441 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 11,7 \u0433\u0440\u0430\u043C\u043C\u0430 (180 \u0433\u0440\u0430\u043D) \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 900\u2013940 \u043C/\u0441, \u0430 \u0434\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 4700 \u0414\u0436. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0443\u0434\u043B\u0438\u043D\u0451\u043D\u043D\u0443\u044E \u0431\u0443\u0442\u044B\u043B\u043E\u0447\u043D\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043F\u043E\u044F\u0441\u043A\u043E\u043C \u0443 \u0434\u043E\u043D\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443 \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442\u0443 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u0443\u043B\u044C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u0441\u0442\u0438\u043B\u044C\u043D\u0443\u044E \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E, \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0438 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439 \u0438 \u043C\u0435\u043D\u044C\u0448\u0438\u043C \u043F\u0430\u0434\u0435\u043D\u0438\u0435\u043C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u043F\u0440\u0438 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C\u044B\u0445 \u043F\u0443\u043B\u044F\u0445, \u043E\u0434\u043D\u0430\u043A\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u043E\u0439 \u043E\u0442\u0434\u0430\u0447\u0435\u0439, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u043E\u0439 \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u043C \u0438\u0437\u043D\u043E\u0441\u043E\u043C \u0441\u0442\u0432\u043E\u043B\u0430. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 M2010 ESR, Accuracy International AWM, Remington 700 \u0438 \u0434\u0440\u0443\u0433\u043E\u043C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u043C \u043E\u0440\u0443\u0436\u0438\u0438."
