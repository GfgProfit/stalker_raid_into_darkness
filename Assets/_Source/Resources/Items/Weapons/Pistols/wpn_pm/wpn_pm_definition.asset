  m_Name: wpn_pm_definition
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: ab22d729c0cef1749a0d523b56668dab
  _displayName: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u041C\u0430\u043A\u0430\u0440\u043E\u0432\u0430"
  _shortName: "\u041F\u041C"
  _description: "\u0421\u043E\u0432\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x18 \u043C\u043C \u041F\u041C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u043C \u0424\u0451\u0434\u043E\u0440\u043E\u0432\u0438\u0447\u0435\u043C \u041C\u0430\u043A\u0430\u0440\u043E\u0432\u044B\u043C \u0432 \u0442\u0443\u043B\u044C\u0441\u043A\u043E\u043C \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E\u043C \u0431\u044E\u0440\u043E \u2116 14 (\u0426\u041A\u0411-14) \u0432 \u043A\u043E\u043D\u0446\u0435 1940-\u0445 \u0433\u043E\u0434\u043E\u0432. \u041F\u0440\u0438\u043D\u044F\u0442 \u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0432 1951 \u0433\u043E\u0434\u0443 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0437\u0430\u043C\u0435\u043D\u044B \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0422\u0422, \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043E \u043D\u0430 \u0418\u0436\u0435\u0432\u0441\u043A\u043E\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0437\u0430\u0432\u043E\u0434\u0435. \u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043E\u0442\u0434\u0430\u0447\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u0432\u043E\u0440\u0430 \u0441 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u0441\u0442\u0432\u043E\u043B\u043E\u043C. \u0423\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F (DA/SA), \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C \u043A\u0443\u0440\u043A\u0430. \u0420\u0430\u043C\u043A\u0430 \u0438 \u0437\u0430\u0442\u0432\u043E\u0440-\u043A\u043E\u0436\u0443\u0445 \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u044B \u0438\u0437 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0439 \u0441\u0442\u0430\u043B\u0438, \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u2014 \u0438\u0437 \u043F\u043B\u0430\u0441\u0442\u043C\u0430\u0441\u0441\u044B. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0440\u0443\u0447\u043D\u044B\u043C \u0444\u043B\u0430\u0436\u043A\u043E\u0432\u044B\u043C \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C \u0441 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u043F\u0443\u0441\u043A\u0430 \u043A\u0443\u0440\u043A\u0430, \u0437\u0430\u0442\u0432\u043E\u0440\u043D\u043E\u0439 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u0438 \u043D\u0435\u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438. \u0414\u043B\u0438\u043D\u0430 \u0441\u0442\u0432\u043E\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 93 \u043C\u043C, \u043E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u2014 161 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u2014 730 \u0433. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438\u0437 \u043E\u0442\u044A\u0451\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u043D\u043E\u0440\u044F\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u0431\u0447\u0430\u0442\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0451\u043C\u043A\u043E\u0441\u0442\u044C\u044E 8 \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u043C\u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u043C\u0438, \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u043D\u0435\u043F\u0440\u0438\u0445\u043E\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E \u0432 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C\u044E. \u041D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u0439 \u044F\u0432\u043B\u044F\u043B\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043B\u0438\u0447\u043D\u044B\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u043E\u0444\u0438\u0446\u0435\u0440\u0441\u043A\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u0430\u0432\u0430 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438 \u0438 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043E\u0440\u0433\u0430\u043D\u043E\u0432 \u0421\u0421\u0421\u0420."
