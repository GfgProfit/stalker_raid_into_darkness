  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966679640}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966679693}
  m_BlockName: Initialize particle
  m_HLSLCode: "void InitGazirovka2(inout VFXAttributes attributes)\r\n{\r\n    uint seed = attributes.seed;\r\n    float3 randomValue = float3(ToFloat01(AnotherHash(seed ^ 543341u)), ToFloat01(AnotherHash(seed ^ 311743u)), ToFloat01(AnotherHash(seed ^ 98867u)));\r\n    attributes.lifetime = 1.0f;\r\n    attributes.size = 1.0f;\r\n    attributes.angleZ = lerp(-180.0f, 180.0f, randomValue.z);\r\n    float3 offset = float3(0.0f, -0.05f, 0.0f);\r\n    float azimuth = randomValue.x * 6.28318531f;\r\n    float radius = sqrt(lerp(0.0f, 1.0f, randomValue.y)) * 1.4f;\r\n    attributes.position = offset + float3(cos(azimuth)*radius, 0.0f, sin(azimuth)*radius);\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitGazirovka2
    selectedIndex: 0
