  _definitionId: 813d6a5ab08f36e46aad8c900da2cca1
  _displayName: "\u041F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B 9x21 \u043C\u043C"
  _shortName: "\u041F\u0411\u0421 9\u044521 \u043C\u043C"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u044A\u0451\u043C\u043D\u044B\u0439 \u043F\u0440\u0438\u0431\u043E\u0440 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0439 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u043E\u043C \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0426\u041D\u0418\u0418\u0422\u041E\u0427\u041C\u0410\u0428 \u0434\u043B\u044F \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u043E\u0433\u043E \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0421\u0435\u0440\u0434\u044E\u043A\u043E\u0432\u0430 \u0421\u04201\u041C\u041F \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D 9x21 \u043C\u043C. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0437\u0430 \u0441\u0447\u0451\u0442 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F \u0438 \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u0445 \u0433\u0430\u0437\u043E\u0432 \u043F\u0435\u0440\u0435\u0434 \u0438\u0445 \u0432\u044B\u0445\u043E\u0434\u043E\u043C \u0432 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443. \u0418\u043C\u0435\u0435\u0442 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0438 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435. \u0428\u0442\u0430\u0442\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0421\u04201\u041C\u041F \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u043F\u0440\u0438\u0431\u043E\u0440\u0430 \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u0440\u0435\u043F\u0451\u0436\u043D\u043E\u0433\u043E \u0443\u0437\u043B\u0430. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0448\u0442\u0430\u0442\u043D\u044B\u0445 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0448\u0443\u043C\u043E\u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0431\u0430\u043B\u043B\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0443\u0434\u0430\u0440\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0443\u044E \u0434\u043B\u0438\u043D\u0443 \u0438 \u043C\u0430\u0441\u0441\u0443 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430, \u0441\u043C\u0435\u0449\u0430\u044F \u0435\u0433\u043E \u0446\u0435\u043D\u0442\u0440 \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434."
