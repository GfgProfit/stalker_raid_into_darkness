  m_Name: sil_nato_762_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 340ebf25beb8402f9f4a819d0dae3b6d
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C AAC 762-SDN-6 7,62 \u043C\u043C"
  _shortName: SDN-6
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62 \u043C\u043C, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Advanced Armament Corporation (AAC) \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0432 2011 \u0433\u043E\u0434\u0443. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430, \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0438\u044F \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u043F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u044B\u0445, \u043C\u0430\u0440\u043A\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0445 \u0438 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0434\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u044F \u043F\u043E\u0434 \u043F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E \u0438 .300 AAC Blackout, \u043E\u0434\u043D\u0430\u043A\u043E \u0442\u0430\u043A\u0436\u0435 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C \u0441 \u0440\u044F\u0434\u043E\u043C \u043C\u0435\u043D\u044C\u0448\u0438\u0445 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432, \u0432\u043A\u043B\u044E\u0447\u0430\u044F 5,56x45 \u043C\u043C \u041D\u0410\u0422\u041E \u0438 6,8 SPC. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043F\u0440\u043E\u0447\u043D\u044B\u043C \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C \u0438 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0432\u0430\u0440\u043D\u044B\u043C \u0431\u043B\u043E\u043A\u043E\u043C \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043E\u043A \u0438\u0437 \u0436\u0430\u0440\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043D\u0438\u043A\u0435\u043B\u0435\u0432\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430 Inconel 718, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u043C \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u043C \u0438 \u044D\u0440\u043E\u0437\u0438\u0438 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u044B\u043C\u0438 \u0433\u0430\u0437\u0430\u043C\u0438. \u0411\u044B\u0441\u0442\u0440\u043E\u0441\u044A\u0451\u043C\u043D\u043E\u0435 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 AAC 51T Ratchet Mount \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043D\u0430 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u0434\u0443\u043B\u044C\u043D\u044B\u0435 \u0430\u0434\u0430\u043F\u0442\u0435\u0440\u044B. \u041F\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0448\u0442\u0430\u0442\u043D\u044B\u0445 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0445 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0437\u0432\u0443\u043A\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0430 25 \u0434\u0411, \u0430 \u0441 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u044B\u043C\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u0430\u043C\u0438 .300 AAC Blackout \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0448\u0443\u043C\u043E\u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0442\u044C 39 \u0434\u0411 \u043F\u0440\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439. \u0414\u043B\u0438\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 195 \u043C\u043C, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u2014 38 \u043C\u043C, \u043C\u0430\u0441\u0441\u0430 \u2014 \u043E\u043A\u043E\u043B\u043E 567 \u0433\u0440\u0430\u043C\u043C\u043E\u0432. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u043D\u043D\u0438\u043C AAC 762-SD \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u0430\u043C\u0438 \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0439 \u0442\u0435\u0440\u043C\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C\u044E. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0439 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u043B\u0438\u043D\u0443 \u0438 \u043C\u0430\u0441\u0441\u0443 \u043E\u0440\u0443\u0436\u0438\u044F, \u0438\u0437\u043C\u0435\u043D\u044F\u044F \u0435\u0433\u043E \u0431\u0430\u043B\u0430\u043D\u0441."
