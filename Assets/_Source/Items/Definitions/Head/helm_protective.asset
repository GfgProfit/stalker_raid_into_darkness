  m_Name: helm_protective
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 24cc07f89bbff384383bb22244c1da5d
  _displayName: "\u0428\u043B\u0435\u043C \u0421\u0421\u041F-99 \xAB\u0417\u0430\u0441\u043B\u043E\u043D\xBB"
  _shortName: "\u0428\u043B\u0435\u043C \u0421\u0421\u041F-99 \xAB\u0417\u0430\u0441\u043B\u043E\u043D\xBB"
  _description: "\u041D\u0435\u0443\u0434\u043E\u0431\u043D\u044B\u0439, \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0448\u043B\u0435\u043C-\u043A\u0430\u043F\u044E\u0448\u043E\u043D, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043C\u044B\u0439 \u0432\u0441\u0451 \u0442\u0435\u043C \u0436\u0435 \u0441\u0430\u043C\u044B\u043C \u041D\u0418\u0418, \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0442\u0430\u043A\u0436\u0435 \u0438 \u0437\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u043E\u0432 \u0441\u0435\u0440\u0438\u0438 \xAB\u0421\u0415\u0412\u0410\xBB. \u0418\u043C\u0435\u0435\u0442 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0443\u044E \u0434\u043B\u044F \u043F\u043E\u043B\u043D\u043E\u0439 \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438 \u043E\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u044B. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438 \u0441 \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u043C\u0438 \u0431\u0440\u043E\u043D\u0435\u043A\u043E\u0441\u0442\u044E\u043C\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u0438\u0445 \u0437\u0430\u0449\u0438\u0442\u044B \u0432 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0437\u043E\u043D\u0430\u0445. \u0422\u0430\u043A\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0432 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430\u0445 \u0421\u0421\u041F."
