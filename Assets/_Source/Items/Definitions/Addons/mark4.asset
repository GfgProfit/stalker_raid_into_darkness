  m_Name: mark4
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: d1f87ac9d7885eb42a25b190eb0bc0e8
  _displayName: "\u041F\u0440\u0438\u0446\u0435\u043B Leupold Mark 4"
  _shortName: "\u041F\u0440\u0438\u0446\u0435\u043B Leupold Mark 4"
  _description: "<color=#8C8C8C>\u0421\u041E\u0412\u041C\u0415\u0421\u0422\u0418\u041C\u041E\u0421\u0422\u042C:\n\n<color=#99FFFF>
    \u2022 <color=#8C8C8C>\u0432\u0441\u0435 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438
    \u041D\u0410\u0422\u041E\n\n<color=#AAAAAA>\u041E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043F\u0440\u0438\u0446\u0435\u043B Leupold Mark 4 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 Leupold Stevens, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
    \u0441\u0432\u043E\u0438\u043C\u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u043E\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C\u0438.
    \u042D\u0442\u043E\u0442 \u043F\u0440\u0438\u0446\u0435\u043B \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
    \u0434\u043B\u044F \u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
    \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445
    \u0438 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u0440\u0435\u0434\u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
    \u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432-\u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u043E\u0432.
    \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 Mark 4 \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442
    \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0443\u0434\u0430\u0440\u043E\u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C,
    \u0447\u0451\u0442\u043A\u043E\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u0438
    \u043A \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C
    \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u043A\u0438 \u0438 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438.\n\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435:
    <color=#AAAAAA>6.5-20.0x\n<color=#5D0074> \u2022 <color=#8C8C8C> \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435:
    <color=#AAAAAA>\u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u0422\u0438\u043F \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0435\u0442\u043A\u0438: <color=#AAAAAA>Mark 4"
