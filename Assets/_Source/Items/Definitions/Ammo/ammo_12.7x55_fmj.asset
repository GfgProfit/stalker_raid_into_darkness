  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12,7x55 \u043C\u043C
    \u0421\u0426-130"
  _shortName: "12,7x55 \u0421\u0426-130"
  _description: "12,7x55 \u043C\u043C \u0421\u0426-130 - \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439
    \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441
    \u0441 \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E
    \u043F\u0443\u043B\u0438, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439
    \u0432 \u0426\u041A\u0418\u0411 \u0421\u041E\u041E \u0434\u043B\u044F \u043C\u0430\u043B\u043E\u0448\u0443\u043C\u043D\u043E\u0433\u043E
    \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u0445
    \u0446\u0435\u043B\u0435\u0439 \u0438 \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u044B
    \u0432 \u0442\u044F\u0436\u0451\u043B\u044B\u0445 \u0431\u0440\u043E\u043D\u0435\u0436\u0438\u043B\u0435\u0442\u0430\u0445
    \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044F\u0445 \u0434\u043E
    600 \u043C\u0435\u0442\u0440\u043E\u0432.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>III
    (30)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u043E\u0447\u0435\u043D\u044C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0435 (361)"
