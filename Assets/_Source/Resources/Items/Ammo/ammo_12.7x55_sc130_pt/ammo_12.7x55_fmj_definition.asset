  m_Name: ammo_12.7x55_fmj
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: e0212a65f4c56474c805f94c40260e66
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 12,7x55 \u043C\u043C \u0421\u0426-130 \u041F\u0422"
  _shortName: "\u041F\u0422"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u044B\u0439 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D 12,7x55 \u043C\u043C \u0441 \u043F\u0443\u043B\u0435\u0439 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u041F\u0422, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 \u0442\u0443\u043B\u044C\u0441\u043A\u043E\u043C \u0426\u041A\u0418\u0411 \u0421\u041E\u041E \u0434\u043B\u044F \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E\u0433\u043E \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u0412\u041A\u0421 \xAB\u0412\u044B\u0445\u043B\u043E\u043F\xBB. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043F\u043E \u0436\u0438\u0432\u043E\u0439 \u0441\u0438\u043B\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u043C \u0446\u0435\u043B\u044F\u043C \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u043F\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 59 \u0433\u0440\u0430\u043C\u043C\u043E\u0432 \u0441 \u0442\u0440\u0451\u0445\u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043D\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439, \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0435\u0439 \u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A, \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u0443\u044E \u0440\u0443\u0431\u0430\u0448\u043A\u0443 \u0438 \u0431\u0438\u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E 290\u2013295 \u043C/\u0441, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0434\u043E\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u043F\u043E\u043B\u0451\u0442 \u0438 \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u044F \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u0441\u0432\u0435\u0440\u0445\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0443\u0434\u0430\u0440\u043D\u043E\u0439 \u0432\u043E\u043B\u043D\u044B. \u0414\u0443\u043B\u044C\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 2500 \u0414\u0436. \u0417\u0430\u044F\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u043C \u043A\u0443\u0447\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 25 \u043C\u043C \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 100 \u043C\u0435\u0442\u0440\u043E\u0432, \u0447\u0442\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0434\u043D\u043E\u0439 \u0443\u0433\u043B\u043E\u0432\u043E\u0439 \u043C\u0438\u043D\u0443\u0442\u0435. \u0422\u044F\u0436\u0451\u043B\u0430\u044F \u043F\u0443\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u0438\u0437-\u0437\u0430 \u043D\u0438\u0437\u043A\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439 \u0434\u0443\u0433\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0439 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439. \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C \u0421\u0426-130 \u0412\u041F\u0421 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D \u043F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B, \u0430 \u043D\u0435 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u043A\u0440\u0443\u043F\u043D\u043E\u043A\u0430\u043B\u0438\u0431\u0435\u0440\u043D\u043E\u0439 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0435 \u0412\u041A\u0421 \xAB\u0412\u044B\u0445\u043B\u043E\u043F\xBB."
