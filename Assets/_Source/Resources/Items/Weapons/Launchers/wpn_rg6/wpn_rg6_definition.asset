  m_Name: wpn_rg6_definition
  m_EditorClassIdentifier: RaidIntoDarkness.Inventory::RaidIntoDarkness.Inventory.Domain.ItemDefinition
  _definitionId: 110f6ff108f2fce4db584fa43a6e9631
  _displayName: "\u0420\u0443\u0447\u043D\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u043D\u044B\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u0420\u0413-6 \xAB\u0413\u043D\u043E\u043C\xBB (6\u041330)"
  _shortName: "\u0420\u0413-6"
  _description: "\u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439 40-\u043C\u043C \u0448\u0435\u0441\u0442\u0438\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0439 \u0440\u0443\u0447\u043D\u043E\u0439 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0432 1993\u20131994 \u0433\u043E\u0434\u0430\u0445 \u0442\u0443\u043B\u044C\u0441\u043A\u0438\u043C \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0441\u043A\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0431\u044E\u0440\u043E \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u0438 \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u0435\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F (\u0426\u041A\u0418\u0411 \u0421\u041E\u041E) \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440\u0430\u043C\u0438 \u0412. \u041D. \u0422\u0435\u043B\u0435\u0448\u0435\u043C \u0438 \u0411. \u0410. \u0411\u043E\u0440\u0437\u043E\u0432\u044B\u043C. \u0421\u0435\u0440\u0438\u0439\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0431\u044B\u043B\u043E \u043D\u0430\u043B\u0430\u0436\u0435\u043D\u043E \u043D\u0430 \u0422\u0443\u043B\u044C\u0441\u043A\u043E\u043C \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u043C \u0437\u0430\u0432\u043E\u0434\u0435. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043E\u0433\u043D\u0435\u0432\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438 \u043F\u0435\u0445\u043E\u0442\u044B \u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0439. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043D\u044B\u0439 \u0431\u043B\u043E\u043A \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u043D\u0430\u0440\u0435\u0437\u043D\u044B\u0445 \u0441\u0442\u0432\u043E\u043B\u043E\u0432, \u0443\u0434\u0430\u0440\u043D\u043E-\u0441\u043F\u0443\u0441\u043A\u043E\u0432\u043E\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0441\u0430\u043C\u043E\u0432\u0437\u0432\u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0438 \u043F\u0440\u0443\u0436\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 40-\u043C\u043C \u0431\u0435\u0437\u0433\u0438\u043B\u044C\u0437\u043E\u0432\u044B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0412\u041E\u0413-25 \u0438 \u0412\u041E\u0413-25\u041F, \u0443\u043D\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0441 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043E\u0432 \u0413\u041F-25 \u0438 \u0413\u041F-30. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u0432\u044B\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0441 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u043C \u0437\u0430\u0442\u044B\u043B\u044C\u043D\u0438\u043A\u043E\u043C, \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u044F\u0442\u044C\u044E \u0438 \u0441\u043A\u043B\u0430\u0434\u043D\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F\u043C\u0438. \u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 680 \u043C\u043C \u0441 \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044B\u043C \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043E\u043C \u0438 520 \u043C\u043C \u0432 \u043F\u043E\u0445\u043E\u0434\u043D\u043E\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438. \u041C\u0430\u0441\u0441\u0430 \u043D\u0435\u0441\u043D\u0430\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 5,6\u20136,2 \u043A\u0433 \u043F\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0445 \u043F\u043E\u0434\u0441\u0442\u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u043C\u0451\u0442\u043E\u0432, \u0420\u0413-6 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043C\u043D\u043E\u0433\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C."
