  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 47a5e94b455c0534982139465ee6e648
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 5,45x39 \u043C\u043C
    \u041F\u041F"
  _shortName: "5,45x39 \u043C\u043C \u041F\u041F"
  _description: "\u0410\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D
    7\u041D10 \u043A\u0430\u043B\u0438\u0431\u0440\u0430 5,45x39 \u043C\u043C \u0441
    \u043F\u0443\u043B\u0435\u0439 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u0438
    (\u041F\u041F) \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 \u043C\u043D\u043E\u0433\u0438\u0445
    \u0441\u0442\u0440\u0430\u043D-\u0443\u0447\u0430\u0441\u0442\u043D\u0438\u0446
    \u0412\u0430\u0440\u0448\u0430\u0432\u0441\u043A\u043E\u0433\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430.
    \u041F\u0443\u043B\u044F \u0441\u043E \u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0442\u0435\u0440\u043C\u043E\u0443\u043F\u0440\u043E\u0447\u043D\u0435\u043D\u043D\u044B\u043C
    \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u043B\u0443\u0447\u0448\u0435\u0435 \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0435
    \u0446\u0435\u043B\u0438.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>I
    (10)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (62)"
