  _definitionId: 9b3c2293430e50b4c9929088a3dad5b0
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7,62x51 \u043C\u043C
    \u041D\u0410\u0422\u041E FMJ"
  _shortName: "7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E FMJ"
  _description: "7,62x51 \u041D\u0410\u0422\u041E - \u0430\u0440\u043C\u0435\u0439\u0441\u043A\u0438\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u0430\u0442\u0440\u043E\u043D\u0430
    .308, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
    \u0441\u0438\u043B\u0430\u043C\u0438 \u041D\u0410\u0422\u041E \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0433\u043E, \u043F\u043E\u043A\u0430
    \u0432 70-\u0445 \u0433\u043E\u0434\u0430\u0445 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
    \u0432\u043E\u0439\u043D\u044B \u0432\u043E \u0412\u044C\u0435\u0442\u043D\u0430\u043C\u0435
    \u043D\u0435 \u0431\u044B\u043B\u0438 \u0432\u0432\u0435\u0434\u0435\u043D\u044B
    \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043A\u0430\u043B\u0438\u0431\u0440\u0430
    5,56 \u043C\u043C. \u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u0432\u0440\u0435\u043C\u044F \u044D\u0442\u0438 \u043F\u0430\u0442\u0440\u043E\u043D\u044B
    \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
    \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0430\u043C\u0438 \u0432\u043E \u0432\u0441\u0451\u043C
    \u043C\u0438\u0440\u0435.\n7,62x51 - \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0439
    \u043A\u0430\u043B\u0438\u0431\u0440 \u0434\u043B\u044F \u0440\u0443\u0447\u043D\u044B\u0445
    \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043E\u0432, \u043D\u043E \u0442\u0430\u043A\u0436\u0435
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D
    \u0432 \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445.\n\n<color=#AAAAAA>\u041F\u0410\u0420\u0410\u041C\u0415\u0422\u0420\u042B:\n<color=#5D0074>
    \u2022 <color=#8C8C8C> \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u043D\u044E \u043A\u043B\u0430\u0441\u0441\u0430: <color=#AAAAAA>II
    (20)\n<color=#5D0074> \u2022 <color=#8C8C8C> \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u043A\u0430\u043D\u0435\u0439: <color=#AAAAAA>\u0432\u044B\u0441\u043E\u043A\u043E\u0435
    (57)"
