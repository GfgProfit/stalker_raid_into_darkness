  m_Name: ammo_7.62x51_ap
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 70148831d771aed4593bd3ecfd55d19b
  _displayName: "\u041F\u0430\u0442\u0440\u043E\u043D\u044B 7.62x51 \u043C\u043C \u041C62"
  _shortName: M62
  _description: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E-\u043F\u0443\u043B\u0435\u043C\u0451\u0442\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u043E\u043D \u043A\u0430\u043B\u0438\u0431\u0440\u0430 7,62x51 \u043C\u043C \u041D\u0410\u0422\u041E \u0441 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0435\u0439 \u043F\u0443\u043B\u0435\u0439 M62, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0435\u0439 \u043F\u043E\u043B\u0451\u0442\u0430 \u043F\u0443\u043B\u0438, \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0433\u043D\u044F \u0438 \u0446\u0435\u043B\u0435\u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F. \u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0441\u0430\u043C\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u044B\u0445 \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0435\u0434\u0438\u043D\u044B\u0445 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 \u043F\u043E\u0434 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D. \u041E\u0441\u043D\u0430\u0449\u0451\u043D \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043F\u0443\u043B\u0435\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 9,3\u20139,5 \u0433\u0440\u0430\u043C\u043C\u0430 \u0441\u043E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u0438\u043A\u043E\u043C \u0438 \u043F\u0438\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C \u0432 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u043E\u0441\u043F\u043B\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F, \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0439 \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F \u0441\u043B\u0435\u0434, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439 \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E \u043F\u0443\u043B\u0438 \u043D\u0430 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0442 90 \u0434\u043E 780 \u043C\u0435\u0442\u0440\u043E\u0432. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E 814 \u043C/\u0441 \u043F\u0440\u0438 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0438 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 24 \u043C\u0435\u0442\u0440\u043E\u0432 \u043E\u0442 \u0434\u0443\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0440\u0435\u0437\u0430. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439 \u0432\u0435\u0440\u0448\u0438\u043D\u044B \u043F\u0443\u043B\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0435\u0439 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0439 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441. \u0421\u043D\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0430\u0442\u0443\u043D\u043D\u0443\u044E \u0433\u0438\u043B\u044C\u0437\u0443 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430\u0445 M14, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u0443\u043B\u0435\u043C\u0451\u0442\u0430\u0445 M60 \u0438 M240. \u041F\u043E \u043F\u043E\u0440\u0430\u0436\u0430\u044E\u0449\u0435\u043C\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C\u0438 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u0447\u043D\u044B\u043C\u0438 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u0431\u0440\u043E\u043D\u0435\u0431\u043E\u0439\u043D\u044B\u043C \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u043C."
