  m_Script: {fileID: 11500000, guid: da0f90c2955673d46b25d465cbe44ed0, type: 3}
  m_Name: merc_sun_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: b94f53cd54f200c489e260feea16cb7a
  _displayName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0421\u0443\u043C\u0440\u0430\u043A\xBB"
  _shortName: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D \xAB\u0421\u0443\u043C\u0440\u0430\u043A\xBB"
  _description: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439
    \u0432 \u0417\u043E\u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
    \u0443\u043C\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D.
    \u041D\u0430\u0451\u043C\u043D\u0438\u043A\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E
    \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u043F\u044B\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E
    \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u0432, \u0442\u0430\u043A \u0447\u0442\u043E
    \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u043B\u0438
    \u043A \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \u0432\u043D\u0443\u0442\u0440\u0438 \u0417\u043E\u043D\u044B. \u0421\u0443\u0434\u044F
    \u043F\u043E \u0432\u0441\u0435\u043C\u0443, \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \xAB\u0421\u0443\u043C\u0440\u0430\u043A\u0430\xBB \u0447\u0435\u0440\u043F\u0430\u043B\u043E\u0441\u044C
    \u0438\u0437 \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430
    \xAB\u041C\u043E\u043D\u043E\u043B\u0438\u0442\u0430\xBB, \u0447\u0442\u043E
    \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E,
    \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u043E\u0442\u0443
    \u0441\u0442\u044B\u0447\u0435\u043A \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
    \u0432 \u0437\u0430\u0431\u044B\u0442\u043E\u043C \u041B\u0438\u043C\u0430\u043D\u0441\u043A\u0435.
    \u0412 \u0446\u0435\u043B\u043E\u043C, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C
    \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0443
    \u0434\u043B\u044F \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u044B\u0445
    \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u044E\u0436\u043D\u0435\u0435
    \u0420\u0430\u0434\u0430\u0440\u0430."
