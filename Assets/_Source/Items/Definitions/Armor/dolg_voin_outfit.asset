  m_Name: dolg_voin_outfit
  m_EditorClassIdentifier: Inventory::Inventory.ItemDefinition
  _definitionId: 1eadc849b1adcbd47800690cf27640e7
  _displayName: "\u041F\u04216-\u0412 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _shortName: "\u041F\u04216-\u0412 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB"
  _description: "\u0411\u043E\u043B\u0435\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
    \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
    \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u0431\u0438\u043D\u0435\u0437\u043E\u043D\u0430 \u041F\u04215-\u041C
    \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB. \u041C\u043E\u0434\u0435\u043B\u044C
    \u041F\u04216-\u0412 \u0438\u043C\u0435\u0435\u0442 \u0431\u043E\u043B\u0435\u0435
    \u0447\u0435\u043C \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438
    \u0437\u0430\u0449\u0438\u0442\u044B \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u0417\u043E\u043D\u044B, \u044F\u0432\u043B\u044F\u044F\u0441\u044C \u043F\u0440\u0438
    \u044D\u0442\u043E\u043C \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E-\u0442\u0430\u043A\u0438
    \u044D\u0440\u0433\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0439 \u0434\u043B\u044F
    \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \xAB\u0414\u043E\u043B\u0433\u0430\xBB.
    \u041F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u043F\u043E\u0434\u0440\u0430\u0437\u0443\u043C\u0435\u0432\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u041F\u04216-\u0412 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0430\u0449\u0438\u0442\u0430\xBB \u0437\u0430\u043C\u0435\u043D\u0438\u0442
    \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u043C\u043E\u0434\u0435\u043B\u044C,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0432\u044B\u0441\u043E\u043A\u0430\u044F
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u044F
    \u0432 \u0436\u0438\u0437\u043D\u0438 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438
    \xAB\u0414\u043E\u043B\u0433\xBB, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438
    \u043B\u0438\u0447\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u0430\u0432\u0430,
    \u043F\u043E\u043A\u0430 \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
    \u043F\u0435\u0440\u0435\u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0435
    \u043D\u0430 \u043F\u0430\u0443\u0437\u0443."
